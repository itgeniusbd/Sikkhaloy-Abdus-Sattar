<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sikkhaloy.SyncApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sikkhaloy.Shared\Sikkhaloy.Shared.csproj" />
  </ItemGroup>

  <!-- Fallback if Directory.Build.targets is not imported -->
  <Target Name="StopLocalSyncApi"
          BeforeTargets="BeforeBuild;BeforeRebuild"
          Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Stop-Process -Name 'Sikkhaloy.SyncApi' -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500&quot;"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>

</Project>
