@inject IJSRuntime JS
@inject AppLocale Locale
@implements IAsyncDisposable

<button type="button" class="go-top @(visible ? "is-on" : null)" title="@Locale.T("go.top")" @onclick="ScrollTop">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 5.8 4.8 13l1.4 1.4 4.8-4.8V20h2V9.6l4.8 4.8 1.4-1.4z"/></svg>
    <span>@Locale.T("go.top")</span>
</button>

@code {
    private bool visible;
    private DotNetObjectReference<GoToTop>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("sikkhaloyGoTop.bind", self); }
        catch { }
    }

    [JSInvokable]
    public Task OnContentScroll(double top)
    {
        var show = top > 220;
        if (show == visible)
            return Task.CompletedTask;
        visible = show;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ScrollTop()
    {
        try { await JS.InvokeVoidAsync("sikkhaloyGoTop.scroll"); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("sikkhaloyGoTop.unbind"); }
        catch { }
        self?.Dispose();
    }
}
