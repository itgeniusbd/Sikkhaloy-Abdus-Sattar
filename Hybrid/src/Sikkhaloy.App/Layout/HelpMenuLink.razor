@inherits LocaleAwareComponent

<div class="menu-help-wrap">
    <NavLink href="support" Match="NavLinkMatch.All" class="menu-help">
        <small class="menu-help-hours">@Locale.T("nav.helpHours")</small>
        <span class="menu-help-top">
            <span class="menu-help-q" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M9.6 9.2a2.5 2.5 0 1 1 3.8 2.1c-.8.5-1.4 1.1-1.4 2.1"/>
                    <circle cx="12" cy="16.4" r=".7" fill="currentColor"/>
                </svg>
            </span>
            <span class="menu-help-copy">
                <strong>@Locale.T("nav.helpNeed")</strong>
                <small>@Locale.T("nav.helpTeam")</small>
            </span>
        </span>
        <span class="menu-help-cta">@Locale.T("nav.helpNow")
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
        </span>
    </NavLink>
</div>
