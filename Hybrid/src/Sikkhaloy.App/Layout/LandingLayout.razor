@inherits LayoutComponentBase
@inject AppLocale Locale
@inject AppSession Session
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="dc-shell">
    <style>
        .dc-shell .dc-hero,
        .dc-shell .hero {
            display: block !important;
            grid-template-columns: none !important;
            width: 100% !important;
        }
        .dc-shell .dc-hero .container,
        .dc-shell .hero .container {
            display: grid !important;
            grid-template-columns: 1.02fr 0.98fr !important;
            max-width: 1180px !important;
            width: 100% !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }
        @@media (max-width: 1080px) {
            .dc-shell .dc-hero .container,
            .dc-shell .hero .container { grid-template-columns: 1fr !important; }
        }
        .dc-shell .dc-hero [data-reveal],
        .dc-shell .hero [data-reveal] { opacity: 1 !important; transform: none !important; animation: none !important; }
        .dc-shell h1:focus, .dc-shell h1:focus-visible { outline: none; }
        .dc-shell .brand { gap: 18px; }
        .dc-shell .brand-cap { border-radius: 13px !important; background: #fff !important; overflow: hidden; }
        .dc-shell .brand-cap img { width: 100%; height: 100%; object-fit: contain; display: block; }
        .dc-shell .hero-orbit { position: relative; z-index: 2; width: min(540px, 100%); }
        .dc-shell .hero-art-disk {
            position: absolute;
            top: 54%;
            left: 51%;
            width: 80%;
            aspect-ratio: 1;
            margin: -41% 0 0 -41%;
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 42%, #3b6793 0 36%, #123b78 68%, #a5abb7 100%);
        }
        .dc-shell .hero-art-disk::after {
            content: ""; position: absolute; inset: -6%; border-radius: 50%;
            border: 16px solid rgba(90, 96, 106, .55); filter: blur(10px);
            animation: dc-edgeBlur 3s ease-in-out infinite alternate;
        }
        @@keyframes dc-edgeBlur { from { filter: blur(7px); opacity: .5; } to { filter: blur(18px); opacity: .95; } }
        .dc-shell .hero-orbit .mock-ring {
            position: absolute;
            top: 60%;
            left: 53%;
            width: 82%;
            aspect-ratio: 1;
            margin: -45.5% 0 0 -45.5%;
            border: 1.8px dashed #86efac;
            border-radius: 50%;
            animation: dc-spin 50s linear infinite;
            z-index: 1;
            pointer-events: none;
        }
        .dc-shell .hero-art-wrap { position: relative; z-index: 2; width: 100%; overflow: visible; }
        .dc-shell .hero-art-wrap img { position: relative; z-index: 2; width: 100%; height: auto; object-fit: contain; display: block; filter: none; }
    </style>
    <div class="progress" @ref="_progress"></div>
    <svg width="0" height="0" style="position:absolute">
        <defs>
            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#22c55e" /><stop offset="1" stop-color="#e11d48" />
            </linearGradient>
            <linearGradient id="topGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#22c55e" /><stop offset="1" stop-color="#e11d48" />
            </linearGradient>
        </defs>
    </svg>

    <div class="nav-wrap">
        <nav class="nav" @ref="_nav">
            <a href="/" class="brand">
                <span class="brand-cap">
                    <img src="_content/Sikkhaloy.App/img/hybrid-logo.png?v=2" alt="Sikkhaloy Hybrid" />
                </span>
                <span class="brand-txt">
                    <span class="en">SIKKHALOY.COM</span>
                    <span class="bn">শিক্ষা<i>লয়</i><b>.</b></span>
                </span>
            </a>
            <div class="nav-links">
                <a href="#home" class="on">@Locale.T("home.nav.home")</a>
                <a href="#features">@Locale.T("home.nav.features")</a>
                <a href="#solutions">@Locale.T("home.nav.solutions")</a>
                <a href="#customers">@Locale.T("home.nav.customers")</a>
                <a href="#contact">@Locale.T("home.nav.contact")</a>
            </div>
            <div class="nav-right">
                <div class="lang-sw">
                    <button type="button" class="@(Locale.IsBengali ? "on" : null)" @onclick='() => Locale.Set("bn")'>BN</button>
                    <button type="button" class="@(!Locale.IsBengali ? "on" : null)" @onclick='() => Locale.Set("en")'>EN</button>
                </div>
                @if (Session.IsAuthenticated)
                {
                    <a href="@Session.HomeHref" class="pill pill-dark pill-sm">@Locale.T("home.goDashboard")</a>
                }
                else
                {
                    <a href="login" class="pill pill-dark pill-sm">@Locale.T("home.loginNow")</a>
                }
                <button type="button" class="burger @(_menuOpen ? "open" : null)" aria-label="@Locale.T("home.menu")" @onclick="ToggleMenu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>
    </div>
    <div class="m-menu @(_menuOpen ? "open" : null)">
        <a href="#home" @onclick="CloseMenu">@Locale.T("home.nav.home")</a>
        <a href="#features" @onclick="CloseMenu">@Locale.T("home.nav.features")</a>
        <a href="#solutions" @onclick="CloseMenu">@Locale.T("home.nav.solutions")</a>
        <a href="#customers" @onclick="CloseMenu">@Locale.T("home.nav.customers")</a>
        <a href="#contact" @onclick="CloseMenu">@Locale.T("home.nav.contact")</a>
        @if (Session.IsAuthenticated)
        {
            <a href="@Session.HomeHref" style="background:var(--k);color:#fff;margin-top:6px">@Locale.T("home.goDashboard")</a>
        }
        else
        {
            <a href="login" style="background:var(--k);color:#fff;margin-top:6px">@Locale.T("home.loginNow")</a>
        }
    </div>

    <main>
        <CascadingValue Name="AppLang" Value="@Locale.Code">
            @Body
        </CascadingValue>
    </main>

    <footer>
        <div class="foot-stripe"></div>
        <div class="container">
            <div class="foot-grid">
                <div class="f-brand">
                    <a href="#home" class="brand">
                        <span class="brand-cap">
                            <img src="_content/Sikkhaloy.App/img/hybrid-logo.png?v=2" alt="Sikkhaloy Hybrid" />
                        </span>
                        <span class="brand-txt">
                            <span class="en">SIKKHALOY.COM</span>
                            <span class="bn">শিক্ষা<i>লয়</i><b>.</b></span>
                        </span>
                    </a>
                    <p>@Locale.T("home.foot.about")</p>
                    <div class="socials">
                        <a href="https://www.facebook.com/Sikkhaloy24" target="_blank" rel="noopener" aria-label="Facebook">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h3l.5-4H13V7.5c0-1.1.3-1.8 1.9-1.8H17V2.2C16.6 2.1 15.4 2 14 2c-2.9 0-4.9 1.8-4.9 5v3H6v4h3.1v8H13z"/></svg>
                        </a>
                        <a href="https://www.youtube.com/channel/UCjyS7P3JSdXwD51IpXGqXAQ" target="_blank" rel="noopener" aria-label="YouTube">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.5s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.3-1C16.6 4 12 4 12 4s-4.6 0-7.8.2c-.4.1-1.4.1-2.3 1-.7.7-.9 2.3-.9 2.3S.8 9.4.8 11.3v1.4c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.2 7.6.2s4.6 0 7.8-.3c.4-.1 1.4-.1 2.3-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.7v-1.4c0-1.9-.2-3.8-.2-3.8zM9.9 15.1V8.4l6.2 3.4-6.2 3.3z"/></svg>
                        </a>
                        <a href="https://itgenius.com.bd/" target="_blank" rel="noopener" aria-label="Website">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        </a>
                    </div>
                </div>
                <div class="f-col c1">
                    <h4>@Locale.T("home.foot.quick")</h4>
                    <ul>
                        <li><a href="#home"><span class="chev">›</span>@Locale.T("home.nav.home")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.nav.features")</a></li>
                        <li><a href="#solutions"><span class="chev">›</span>@Locale.T("home.nav.solutions")</a></li>
                        <li><a href="#customers"><span class="chev">›</span>@Locale.T("home.nav.customers")</a></li>
                        <li><a href="#contact"><span class="chev">›</span>@Locale.T("home.nav.contact")</a></li>
                    </ul>
                </div>
                <div class="f-col c2">
                    <h4>@Locale.T("home.foot.feat")</h4>
                    <ul>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.att.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.exam.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.acc.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.portal.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.inv.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.smsf.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.tport.title")</a></li>
                        <li><a href="#features"><span class="chev">›</span>@Locale.T("home.web.title")</a></li>
                    </ul>
                </div>
                <div class="f-col c3" id="contact">
                    <h4>@Locale.T("home.contact.title")</h4>
                    <div class="itg">
                        <a class="itg-name" href="https://itgenius.com.bd/" target="_blank" rel="noopener">
                            <img class="itg-logo-img" src="_content/Sikkhaloy.App/img/it-genius-logo.png?v=3" alt="IT Genius" />
                        </a>
                        <ul>
                            <li>
                                <span class="itg-ico">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                </span>
                                <span>@Locale.T("home.contact.addr")</span>
                            </li>
                            <li>
                                <span class="itg-ico is-r">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.6a2 2 0 0 1 1.7 2.1z"/></svg>
                                </span>
                                <span><a href="tel:09638669966">09638 66 99 66</a> · <a href="tel:+8801739144141">+88 01739 144 141</a></span>
                            </li>
                            <li>
                                <span class="itg-ico">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                </span>
                                <a href="https://itgenius.com.bd/" target="_blank" rel="noopener">itgenius.com.bd</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="foot-bottom">
                <span>© 2015–@CopyYear <b>Sikkhaloy.com</b> — @Locale.T("home.foot.rights")</span>
                <a class="foot-powered" href="https://itgenius.com.bd/" target="_blank" rel="noopener">
                    <span>@Locale.T("home.foot.powered")</span>
                    <img src="_content/Sikkhaloy.App/img/it-genius-logo.png?v=3" alt="IT Genius" />
                </a>
            </div>
        </div>
    </footer>

    <button type="button" class="to-top" @ref="_toTop" aria-label="@Locale.T("home.top")" @onclick="ScrollTop">
        <svg class="ring" viewBox="0 0 54 54"><circle class="ring-bg2" cx="27" cy="27" r="24"/><circle class="ring-fg2" @ref="_topRing" cx="27" cy="27" r="24" pathLength="100"/></svg>
        <svg class="ar" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
</div>

@code {
    private ElementReference _nav;
    private ElementReference _progress;
    private ElementReference _toTop;
    private ElementReference _topRing;
    private bool _menuOpen;
    private bool _bound;
    private static int CopyYear => Math.Max(DateTime.Now.Year, 2015);

    protected override void OnInitialized() => Locale.Changed += OnLocale;
    private void OnLocale() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            await JS.InvokeVoidAsync("sikkhaloyLanding.bind", _nav, _progress, _toTop, _topRing, null);
            _bound = true;
        }
        catch (JSException)
        {
        }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private async Task ScrollTop()
    {
        try { await JS.InvokeVoidAsync("sikkhaloyLanding.top"); }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Locale.Changed -= OnLocale;
        if (_bound)
        {
            try { await JS.InvokeVoidAsync("sikkhaloyLanding.unbind"); }
            catch (JSException) { }
        }
    }
}
