@inherits LocaleAwareComponent
@inject NavigationManager Nav

<nav class="sidebar-nav">
    <NavLink href="authority" Match="NavLinkMatch.All" class="menu-top">
        @Icon("dashboard")
        <span>@Locale.T("auth.dash")</span>
    </NavLink>
    <NavLink href="authority/institutions" Match="NavLinkMatch.All" class="menu-top">
        @Icon("building")
        <span>@Locale.T("auth.m.instList")</span>
    </NavLink>

    @foreach (var group in GroupsBefore)
    {
        <details class="menu-group" open="@IsOpen(group)">
            <summary>
                <span class="menu-left">
                    @Icon(group.Icon)
                    <span>@Locale.T(group.TitleKey)</span>
                </span>
            </summary>
            <div class="menu-tree">
                @foreach (var link in group.Links)
                {
                    <NavLink href="@link.Href" class="@(IsSoon(link) ? "soon-link" : null)" Match="NavLinkMatch.All">
                        @Icon(link.Icon)
                        <span>@Locale.T(link.TitleKey)</span>
                    </NavLink>
                }
            </div>
        </details>
    }

    <NavLink href="authority/accounts" class="menu-top" Match="NavLinkMatch.All">
        @Icon("card")
        <span>@Locale.T("auth.m.accounts")</span>
    </NavLink>

    @foreach (var group in GroupsAfter)
    {
        <details class="menu-group" open="@IsOpen(group)">
            <summary>
                <span class="menu-left">
                    @Icon(group.Icon)
                    <span>@Locale.T(group.TitleKey)</span>
                </span>
            </summary>
            <div class="menu-tree">
                @foreach (var link in group.Links)
                {
                    <NavLink href="@link.Href" class="@(IsSoon(link) ? "soon-link" : null)" Match="NavLinkMatch.All">
                        @Icon(link.Icon)
                        <span>@Locale.T(link.TitleKey)</span>
                    </NavLink>
                }
            </div>
        </details>
    }

    @foreach (var link in Roots)
    {
        <NavLink href="@link.Href" class="@($"menu-top{(IsSoon(link) ? " soon-link" : "")}")" Match="NavLinkMatch.All">
            @Icon(link.Icon)
            <span>@Locale.T(link.TitleKey)</span>
        </NavLink>
    }
</nav>

@code {
    [Parameter] public string Lang { get; set; } = "";
    private static readonly AuthMenuGroup[] GroupsBefore =
    [
        new("auth.m.basic", "basic",
        [
            Link("auth.m.signupInst", "school", "signup-institution", true),
            Link("auth.m.userInfo", "idcard", "user-info", true),
            Link("auth.m.testimonial", "quote", "testimonial", true),
            Link("auth.m.resetData", "reset", "reset-data", true),
            Link("auth.m.attSignup", "device", "attendance-signup", true),
            Link("auth.m.smsSetting", "sms", "sms-setting", true),
            Link("auth.m.clientSms", "megaphone", "client-sms", true),
            Link("msg.inbox", "mail", "messages", true),
        ]),
        new("auth.m.pageLinks", "links",
        [
            Link("auth.m.linkCategory", "folder", "link-category", true),
            Link("auth.m.createRole", "badge", "create-role", true),
        ]),
        new("auth.m.reference", "share",
        [
            Link("auth.m.addReference", "userplus", "add-reference", true),
            Link("auth.m.referralReport", "percent", "referral-commission", true),
        ]),
        new("auth.m.subAuth", "shield",
        [
            Link("auth.m.signupSub", "userplus", "signup-sub", true),
            Link("auth.m.pageAccess", "key", "page-access", true),
        ]),
    ];

    private static readonly AuthMenuGroup[] GroupsAfter =
    [
        new("auth.m.report", "chart",
        [
            Link("auth.m.progress", "trend", "progress-report", true),
            Link("auth.m.payCollect", "coins", "payment-collection", true),
        ]),
    ];

    private static readonly AuthMenuLink[] Roots =
    [
        Link("auth.m.manageInst", "building", "manage-institution", true),
        Link("auth.m.createInvoice", "fileplus", "create-invoice", true),
        Link("auth.m.paidInvoice", "filecheck", "paid-invoice", true),
        Link("auth.m.printInvoice", "printer", "print-invoice", true),
        Link("auth.m.onlinePay", "globe", "online-payment-report", true),
    ];

    private static IEnumerable<AuthMenuGroup> AllGroups => GroupsBefore.Concat(GroupsAfter);

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Trim('/');

    private bool IsOpen(AuthMenuGroup group) =>
        group.Links.Any(link => CurrentPath.Equals(link.Href, StringComparison.OrdinalIgnoreCase));

    public static string? TitleKeyFor(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug))
            return null;
        if (slug == "accounts")
            return "auth.m.accounts";
        if (slug == "institutions")
            return "auth.m.instList";
        foreach (var group in AllGroups)
        {
            var found = group.Links.FirstOrDefault(x => x.Slug == slug);
            if (found is not null)
                return found.TitleKey;
        }
        return Roots.FirstOrDefault(x => x.Slug == slug)?.TitleKey;
    }

    public static string? GroupKeyFor(string? slug)
    {
        if (string.IsNullOrWhiteSpace(slug))
            return null;
        if (slug == "accounts")
            return "auth.m.accounts";
        foreach (var group in AllGroups)
        {
            if (group.Links.Any(x => x.Slug == slug))
                return group.TitleKey;
        }
        return null;
    }

    private static AuthMenuLink Link(string titleKey, string icon, string slug, bool ready = false) =>
        new(titleKey, icon, slug, ready ? $"authority/{slug}" : $"authority/soon/{slug}");

    private static bool IsSoon(AuthMenuLink link) =>
        link.Href.Contains("/soon/", StringComparison.OrdinalIgnoreCase);

    private static MarkupString Icon(string name)
    {
        var path = name switch
        {
            "dashboard" => "<rect x='3' y='3' width='7' height='7' rx='1.4'/><rect x='14' y='3' width='7' height='7' rx='1.4'/><rect x='3' y='14' width='7' height='7' rx='1.4'/><rect x='14' y='14' width='7' height='7' rx='1.4'/>",
            "basic" => "<circle cx='12' cy='12' r='3'/><path d='M12 1.8v2.4M12 19.8v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M1.8 12h2.4M19.8 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7'/>",
            "school" => "<path d='M3 10.5 12 4l9 6.5V20H3z'/><path d='M9 20v-6h6v6'/>",
            "idcard" => "<rect x='3' y='5' width='18' height='14' rx='2'/><circle cx='9' cy='12' r='2.2'/><path d='M14 10.5h5M14 13.5h4'/>",
            "quote" => "<path d='M8 17H4.5A2.5 2.5 0 0 1 2 14.5V11a7 7 0 0 1 7-7'/><path d='M20 17h-3.5A2.5 2.5 0 0 1 14 14.5V11a7 7 0 0 1 7-7'/>",
            "reset" => "<path d='M3 12a9 9 0 1 0 3-6.7'/><path d='M3 4v5h5'/>",
            "device" => "<rect x='6' y='2.5' width='12' height='19' rx='2'/><path d='M10 18.5h4'/>",
            "sms" => "<path d='M21 14.5a2 2 0 0 1-2 2H8l-5 3.2V5.5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/>",
            "mail" => "<path d='M4 5h16a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 20 19H4a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 4 5z'/><path d='m4 7 8 6 8-6'/>",
            "megaphone" => "<path d='M4 10v4h3l7 4V6L7 10H4z'/><path d='M16.5 8.2A4.2 4.2 0 0 1 16.5 15.8'/>",
            "links" => "<path d='M10 13a5 5 0 0 0 7.5.1l1.9-1.9a5 5 0 0 0-7.1-7.1L11 5.4'/><path d='M14 11a5 5 0 0 0-7.5-.1L4.6 12.8a5 5 0 0 0 7.1 7.1L13 18.6'/>",
            "folder" => "<path d='M3 7.5A2.5 2.5 0 0 1 5.5 5H9l2 2.2h7.5A2.5 2.5 0 0 1 21 9.7V17a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17z'/>",
            "badge" => "<path d='M12 2.8 14.6 8l5.9.5-4.5 3.9 1.4 5.8L12 15.8 6.6 18.2l1.4-5.8L3.5 8.5 9.4 8z'/>",
            "share" => "<circle cx='18' cy='5.5' r='2.4'/><circle cx='6' cy='12' r='2.4'/><circle cx='18' cy='18.5' r='2.4'/><path d='M8.2 11l7.5-4.2M8.2 13l7.5 4.2'/>",
            "userplus" => "<path d='M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'/><circle cx='8.5' cy='7' r='3.2'/><path d='M19 8v6M16 11h6'/>",
            "percent" => "<circle cx='7.5' cy='7.5' r='2.2'/><circle cx='16.5' cy='16.5' r='2.2'/><path d='M17.5 6.5 6.5 17.5'/>",
            "shield" => "<path d='M12 3 5 6.2v5.4c0 4.2 2.9 8.1 7 9.4 4.1-1.3 7-5.2 7-9.4V6.2z'/>",
            "key" => "<circle cx='8' cy='15' r='4'/><path d='M11.7 12.3 20 4l2 2-2 2h-3v3h-2'/>",
            "chart" => "<path d='M4 19.5h16'/><path d='M7 16v-5M12 16V8M17 16v-8'/>",
            "trend" => "<path d='M4 17.5 9.5 12l3.5 3.5L20 8'/><path d='M14 8h6v6'/>",
            "coins" => "<ellipse cx='12' cy='6.5' rx='7.5' ry='2.6'/><path d='M4.5 6.5v4c0 1.4 3.4 2.6 7.5 2.6s7.5-1.2 7.5-2.6v-4'/><path d='M4.5 10.5v4c0 1.4 3.4 2.6 7.5 2.6s7.5-1.2 7.5-2.6v-4'/>",
            "card" => "<rect x='2.5' y='6' width='19' height='13' rx='2'/><path d='M2.5 10h19'/><circle cx='16.5' cy='15.2' r='1.4'/>",
            "building" => "<path d='M4 20V6.5A1.5 1.5 0 0 1 5.5 5H13v15'/><path d='M13 9h5.5A1.5 1.5 0 0 1 20 10.5V20'/><path d='M7.5 9v2M10.5 9v2M7.5 13v2M10.5 13v2M16 13v2M3 20h18'/>",
            "fileplus" => "<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9A1.5 1.5 0 0 0 18 19.5V8z'/><path d='M14 3v5h4M10 13h4M12 11v4'/>",
            "filecheck" => "<path d='M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9A1.5 1.5 0 0 0 18 19.5V8z'/><path d='M14 3v5h4M9 14.2l2 2 4.2-4.2'/>",
            "printer" => "<path d='M7 8V4h10v4'/><rect x='5' y='8' width='14' height='8' rx='1.5'/><path d='M7 16h10v4H7z'/>",
            "globe" => "<circle cx='12' cy='12' r='8.5'/><path d='M3.5 12h17M12 3.5c2.4 2.4 3.6 5.3 3.6 8.5S14.4 18.1 12 20.5C9.6 18.1 8.4 15.2 8.4 12S9.6 5.9 12 3.5z'/>",
            _ => "<path d='M4 5.5h16v14H4z'/><path d='M4 9h16'/>"
        };
        return new MarkupString(
            "<svg class=\"menu-ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">"
            + path + "</svg>");
    }

    private sealed record AuthMenuGroup(string TitleKey, string Icon, AuthMenuLink[] Links);
    private sealed record AuthMenuLink(string TitleKey, string Icon, string Slug, string Href);
}
