@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject SyncEngine Sync
@inject NavigationManager Nav
@inject AppLocale Locale
@inject OfflineAuthService OfflineAuth
@inject ISyncApiClient Api
@inject IJSRuntime JS

@if (Session.IsAuthority)
{
    <div class="year-loading">@Locale.T("auth.redirect")</div>
}
else
{
<CascadingValue Name="AppLang" Value="@Locale.Code" IsFixed="false">
<div class="app-shell">
    @if (menuOpen)
    {
        <div class="nav-back" @onclick="CloseMenu"></div>
    }
    <aside class="app-sidebar @(menuOpen ? "is-open" : null)">
        <div class="sidebar-profile">
            <a class="sidebar-photo-link" href="@(Session.Access.IsBlocked ? "invoice/due" : "dashboard")" title="@Locale.T("nav.dashboard")">
                <span class="sidebar-photo-ring" aria-hidden="true"></span>
                <span class="sidebar-photo-glow" aria-hidden="true"></span>
                <span class="sidebar-photo">
                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                    {
                        <img src="@photoUrl" alt="@displayName" />
                    }
                    else
                    {
                        <span>@Initials</span>
                    }
                </span>
            </a>
            <p class="sidebar-name-row">
                <button type="button" class="sidebar-name-btn" @onclick="ToggleProfileMenu">
                    <span>@displayName</span>
                    <span class="sidebar-caret" aria-hidden="true"></span>
                </button>
                @if (profileMenuOpen)
                {
                    <div class="sidebar-user-menu">
                        @if (!Session.Access.IsBlocked)
                        {
                            <a href="profile/update-info" @onclick="CloseProfileMenu">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg>
                                @Locale.T("profile.updateInfo")
                            </a>
                            <a href="profile/password" @onclick="CloseProfileMenu">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1S15.1 4.3 15.1 6v2z"/></svg>
                                @Locale.T("profile.changePassword")
                            </a>
                        }
                    </div>
                }
            </p>
            <p class="sidebar-role">@role</p>
            <select class="session-ddl" @bind="selectedYearId" @bind:after="OnYearChanged" disabled="@yearBusy">
                @if (years.Count == 0)
                {
                    <option value="0">@Locale.T("sidebar.session", "—")</option>
                }
                @foreach (var year in years)
                {
                    <option value="@year.EducationYearID">@Locale.T("sidebar.session", year.Name)</option>
                }
            </select>
        </div>
        <div class="sidebar-scroll" @onclick="CloseProfileMenu">
            @if (Session.Access.IsBlocked)
            {
                <nav class="sidebar-nav">
                    <NavLink href="invoice/due" Match="NavLinkMatch.Prefix" class="menu-top">
                        <svg class="menu-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2.5" y="6" width="19" height="13" rx="2"/><path d="M2.5 10h19"/><circle cx="16.5" cy="15.2" r="1.4"/>
                        </svg>
                        <span>@Locale.T("inv.dueTitle")</span>
                    </NavLink>
                    <NavLink href="invoice/paid" Match="NavLinkMatch.Prefix" class="menu-top">
                        <svg class="menu-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                        </svg>
                        <span>@Locale.T("inv.paidTitle")</span>
                    </NavLink>
                </nav>
            }
            else
            {
                <SidebarMenu Menu="menu" Lang="@Locale.Code" />
            }
        </div>
    </aside>
    <div class="app-main">
        @if (Session.IsImpersonating)
        {
            <div class="ax-impersonate">
                <span>@Locale.T("auth.viewingAs", Session.Current?.SchoolName ?? "")</span>
                <button type="button" @onclick="ReturnAuthority">@Locale.T("auth.backAuthority")</button>
            </div>
        }
        <header class="app-header @(hasNameLogo ? "has-nameplate" : null)" style="background-color: @headerColor">
            <button type="button" class="menu-toggle" aria-label="@Locale.T("nav.menu")" @onclick="ToggleMenu">
                <span></span><span></span><span></span>
            </button>
            @if (hasNameLogo)
            {
                <a class="header-nameplate" href="@(Session.Access.IsBlocked ? "invoice/due" : "dashboard")" title="@schoolName">
                    <img src="@nameLogoUrl" alt="@schoolName" />
                </a>
            }
            else
            {
                <div class="header-brand">
                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img class="header-logo" src="@logoUrl" alt="" />
                    }
                    else
                    {
                        <span class="header-logo header-logo-fallback">@(schoolName.Length == 0 ? "S" : schoolName[..1])</span>
                    }
                    <div class="header-ins">
                        <a class="header-name" href="@(Session.Access.IsBlocked ? "invoice/due" : "dashboard")">
                            @schoolName
                            @if (!string.IsNullOrWhiteSpace(yearName))
                            {
                                <span>(@yearName)</span>
                            }
                        </a>
                        <p class="header-meta">
                            @if (!string.IsNullOrWhiteSpace(schoolAddress))
                            {
                                <span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                                    @schoolAddress
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(schoolPhone))
                            {
                                <span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"/></svg>
                                    @schoolPhone
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(schoolEmail))
                            {
                                <span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"/></svg>
                                    @schoolEmail
                                </span>
                            }
                        </p>
                    </div>
                </div>
            }
            <div class="header-actions">
                @if (Session.Current is not null)
                {
                    <div class="header-id">
                        <span>@Locale.T("header.institutionId")</span>
                        <strong>@Session.Current.SchoolID</strong>
                    </div>
                }
                <button type="button" class="header-color" title="@Locale.T("header.colorTitle")" @onclick="OpenColorPicker">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M20.71 5.63 18.37 3.29a1 1 0 0 0-1.41 0L9 11.25 11.75 14l8.96-8.96a1 1 0 0 0 0-1.41zM6.5 13.5A2.5 2.5 0 0 0 4 16c0 1.66-1 2.5-1 2.5s2.09.5 3.5.5A3.5 3.5 0 0 0 10 15.5 2.5 2.5 0 0 0 6.5 13.5z"/>
                    </svg>
                </button>
                <LanguageSwitch />
                <span class="badge @(online ? "on" : "off")" title="@StatusHint">@(online ? Locale.T("online") : Locale.T("offline"))</span>
                <span class="badge queue">@Locale.T("sync.queue", pending)</span>
                <button type="button" class="header-logout" title="@Locale.T("logout")" @onclick="Logout">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M10 17v-3H3v-4h7V7l5 5-5 5zm9-14H9c-1.1 0-2 .9-2 2v3h2V5h10v14H9v-3H7v3c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                    </svg>
                </button>
            </div>
        </header>
        @if (adminNotices.Count > 0)
        {
            <button type="button" class="admin-notice no-print" @onclick="OpenAdminNotice">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 10v4h3l7 4V6L7 10H4zm13.5-1.8v7.6A4.2 4.2 0 0 0 17.5 8.2z"/></svg>
                <span class="admin-notice-clip">
                    <span class="admin-notice-marquee" style="--an-speed:@MarqueeDuration">
                        <span class="admin-notice-track">
                            @foreach (var item in MarqueeChips)
                            {
                                <em class="an-chip" style="color:@item.Color">@item.Text</em>
                            }
                        </span>
                        <span class="admin-notice-track" aria-hidden="true">
                            @foreach (var item in MarqueeChips)
                            {
                                <em class="an-chip" style="color:@item.Color">@item.Text</em>
                            }
                        </span>
                    </span>
                </span>
            </button>
        }
        <main class="app-content">
            <PrintHeader FromLayout="true" ShowDate="false" />
            @if (yearBusy)
            {
                <div class="year-loading">@Locale.T("sidebar.yearLoading")</div>
            }
            @Body
        </main>
    </div>
    <GoToTop />
</div>
@if (showAdminNotice)
{
    <div class="acc-result-back" @onclick="CloseAdminNotice">
        <div class="acc-result is-ok sms-modal ad-pop ad-pop-wide an-view" @onclick:stopPropagation="true">
            <h3>@Locale.T("an.viewTitle")</h3>
            <div class="an-view-list">
                @for (var i = 0; i < adminNotices.Count; i++)
                {
                    var item = adminNotices[i];
                    <article class="an-view-card" style="border-left: 6px solid @NoticeColor(i)">
                        @if (!string.IsNullOrWhiteSpace(item.Title))
                        {
                            <strong>@item.Title</strong>
                        }
                        <small>@Locale.T("an.viewDate", FmtDate(item.ShowDate), FmtDate(item.EndDate))</small>
                        <p>@item.Notice</p>
                    </article>
                }
            </div>
            <button type="button" class="acc-btn acc-btn-primary" @onclick="CloseAdminNotice">@Locale.T("acc.ok")</button>
        </div>
    </div>
}
@if (showColorPicker)
{
    <div class="acc-result-back hc-back" @onclick="CloseColorPicker">
        <div class="hc-modal" @onclick:stopPropagation="true">
            <h3>@Locale.T("header.colorTitle")</h3>
            <p class="hc-label">@Locale.T("header.colorPresets")</p>
            <div class="hc-presets">
                @foreach (var color in HeaderPresets)
                {
                    <button type="button" class="hc-swatch @(IsCurrent(color) ? "is-on" : null)"
                            style="background:@color" title="@color" @onclick="() => PickColorAsync(color)"></button>
                }
            </div>
            <p class="hc-label">@Locale.T("header.colorCustom")</p>
            <div class="hc-custom">
                <input type="color" value="@customColor" @oninput="OnCustomInput" />
                <button type="button" class="acc-btn acc-btn-primary" @onclick="ApplyCustomAsync">@Locale.T("header.colorApply")</button>
            </div>
            <div class="hc-foot">
                <button type="button" class="acc-btn" @onclick="ResetColorAsync">@Locale.T("header.colorReset")</button>
                <button type="button" class="acc-btn acc-btn-primary" @onclick="CloseColorPicker">@Locale.T("header.colorClose")</button>
            </div>
        </div>
    </div>
}
</CascadingValue>
}

@code {
    private bool online;
    private int pending;
    private bool yearBusy;
    private bool profileMenuOpen;
    private bool menuOpen;
    private bool enforcingAccess;
    private bool showAdminNotice;
    private bool showColorPicker;
    private DateTime accessAt;
    private string selectedYearId = "0";
    private string? photoUrl;
    private string? logoUrl;
    private string? nameLogoUrl;
    private string schoolName = "";
    private string schoolAddress = "";
    private string schoolPhone = "";
    private string schoolEmail = "";
    private string headerColor = DefaultHeaderColor;
    private string customColor = DefaultHeaderColor;
    private IReadOnlyList<EducationYearDto> years = [];
    private IReadOnlyList<AuthNoticeDto> adminNotices = [];
    private MenuTreeDto menu = new();

    private string displayName =>
        string.IsNullOrWhiteSpace(Session.Current?.DisplayName)
            ? Session.Current?.UserName ?? ""
            : Session.Current!.DisplayName;

    private string yearName =>
        years.FirstOrDefault(x => x.EducationYearID.ToString() == selectedYearId)?.Name
        ?? years.FirstOrDefault(x => x.EducationYearID == Session.Current?.EducationYearID)?.Name
        ?? "";

    private string role => Session.Current?.Role ?? "";
    private bool hasNameLogo => !string.IsNullOrWhiteSpace(nameLogoUrl);
    private string ColorKey => $"headerColor_school_{Session.Current?.SchoolID ?? 0}";
    private string LegacyColorKey => $"headerColor_{Session.Current?.RegistrationID ?? 0}";

    private const string DefaultHeaderColor = "#00a12a";
    private static readonly string[] HeaderPresets =
    [
        "#00a12a", "#1e3c72", "#8b0000", "#4a0e4e", "#0d7377", "#d35400",
        "#16a085", "#2c3e50", "#8e44ad", "#c0392b", "#27ae60", "#f39c12"
    ];

    private string StatusHint
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Sync.LastError))
                return "";
            return Locale.SyncError(Sync.LastError);
        }
    }

    private string Initials
    {
        get
        {
            var name = displayName.Trim();
            if (name.Length == 0)
                return "A";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 1)
                return parts[0][..1].ToUpperInvariant();
            return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        if (Session.IsAuthority)
        {
            Nav.NavigateTo("/authority", replace: true);
            return;
        }

        Sync.StateChanged += OnSyncState;
        Locale.Changed += OnLocale;
        Session.Changed += OnSession;
        Nav.LocationChanged += OnLocation;
        RefreshStatus();
        await LoadOfficeAsync();
        await LoadHeaderColorAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await LoadHeaderColorAsync();
    }

    private void OnSyncState() => _ = InvokeAsync(() =>
    {
        RefreshStatus();
        return LoadOfficeAsync();
    });

    private void OnLocale() => _ = InvokeAsync(StateHasChanged);
    private void OnSession() => _ = InvokeAsync(async () =>
    {
        await LoadOfficeAsync();
        await LoadHeaderColorAsync();
    });
    private void OnLocation(object? sender, LocationChangedEventArgs e)
    {
        EnforceAccess();
        if ((DateTime.UtcNow - accessAt).TotalSeconds > 30)
            _ = InvokeAsync(RefreshAccessAsync);
        if (!menuOpen)
            return;
        _ = InvokeAsync(() =>
        {
            menuOpen = false;
            StateHasChanged();
        });
    }

    private async Task RefreshAccessAsync()
    {
        if (SkipAccessRole())
        {
            Session.SetAccess(new());
            return;
        }
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
                return;
            Session.SetAccess(await Api.GetSubscriptionStatusAsync(Session.AccessToken!));
            accessAt = DateTime.UtcNow;
            EnforceAccess();
        }
        catch
        {
        }
    }

    private void EnforceAccess()
    {
        if (!Session.Access.IsBlocked || enforcingAccess)
            return;
        var path = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (IsInvoiceDuePath(path))
            return;
        enforcingAccess = true;
        Nav.NavigateTo("/invoice/due", replace: true);
        enforcingAccess = false;
    }

    private static bool IsInvoiceDuePath(string path) =>
        path.Equals("invoice", StringComparison.OrdinalIgnoreCase)
        || path.Equals("invoice/due", StringComparison.OrdinalIgnoreCase)
        || path.Equals("invoice/paid", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("invoice/receipt", StringComparison.OrdinalIgnoreCase);

    private bool SkipAccessRole()
    {
        var role = Session.Current?.Role ?? "";
        return role.Equals("Authority", StringComparison.OrdinalIgnoreCase)
            || role.Equals("Sub-Authority", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private void RefreshStatus()
    {
        online = Sync.IsOnline;
        pending = Sync.PendingCount;
        StateHasChanged();
    }

    private async Task LoadOfficeAsync()
    {
        if (Session.Current is null)
            return;

        if (!string.IsNullOrWhiteSpace(Session.AccessToken))
            await Sync.RefreshOfficeAsync(Session.Current, Session.AccessToken);

        years = await Sync.ListYearsAsync(Session.Current.SchoolID);
        menu = await Sync.GetMenuAsync(Session.Current.UserName);
        selectedYearId = Session.Current.EducationYearID.ToString();
        photoUrl = Sync.GetProfilePhotoDataUrl(Session.Current.RegistrationID);
        LoadSchoolHeader();
        await RefreshAccessAsync();
        await LoadAdminNoticesAsync();
        StateHasChanged();
    }

    private async Task LoadAdminNoticesAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
                return;
            adminNotices = await Api.GetAdminNoticesAsync(Session.AccessToken!);
        }
        catch
        {
            adminNotices = [];
        }
    }

    private void LoadSchoolHeader()
    {
        if (Session.Current is null)
            return;

        var header = Sync.GetSchoolHeader(Session.Current.SchoolID);
        schoolName = string.IsNullOrWhiteSpace(header.SchoolName)
            ? Session.Current.SchoolName
            : header.SchoolName;
        schoolAddress = header.Address ?? "";
        schoolPhone = header.Phone ?? "";
        schoolEmail = header.Email ?? "";
        logoUrl = Sync.GetSchoolLogoDataUrl(Session.Current.SchoolID);
        nameLogoUrl = Sync.GetSchoolNameLogoDataUrl(Session.Current.SchoolID);
        if (IsHexColor(header.HeaderColor))
        {
            headerColor = header.HeaderColor!;
            customColor = headerColor;
        }
    }

    private async Task OnYearChanged()
    {
        if (Session.Current is null || yearBusy)
            return;
        if (!int.TryParse(selectedYearId, out var yearId) || yearId <= 0)
            return;
        if (yearId == Session.Current.EducationYearID)
            return;

        yearBusy = true;
        StateHasChanged();
        try
        {
            if (!string.IsNullOrWhiteSpace(Session.AccessToken) && await Api.PingAsync())
            {
                var result = await Api.SwitchYearAsync(Session.AccessToken, yearId);
                if (result.Succeeded && result.Session is not null)
                {
                    result.Session.DeviceId = Session.Current.DeviceId;
                    Session.Set(result, notify: false);
                    await OfflineAuth.UpdateCachedSessionAsync(result);
                }
                else
                {
                    selectedYearId = Session.Current.EducationYearID.ToString();
                    return;
                }
            }
            else
            {
                Session.UpdateYear(yearId, notify: false);
                await Sync.SwitchYearLocalAsync(Session.Current, yearId);
            }

            if (Session.Current is not null && !string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                await Sync.ResetYearPullAsync(Session.Current);
                await Sync.RunOnceAsync(Session.Current, Session.AccessToken, force: true);
            }

            selectedYearId = Session.Current!.EducationYearID.ToString();
            Session.NotifyChanged();
        }
        finally
        {
            yearBusy = false;
            StateHasChanged();
        }
    }

    private void ToggleProfileMenu() => profileMenuOpen = !profileMenuOpen;

    private void CloseProfileMenu() => profileMenuOpen = false;

    private static readonly string[] NoticeColors =
    [
        "#1e3a8a", "#c2410c", "#9f1239", "#0f766e", "#6d28d9", "#7f1d1d"
    ];

    private IEnumerable<(string Text, string Color)> MarqueeChips =>
        adminNotices
            .Select((n, i) => (
                Text: string.IsNullOrWhiteSpace(n.Notice) ? n.Title.Trim() : n.Notice.Trim(),
                Color: NoticeColor(i)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Text));

    private static string NoticeColor(int index) => NoticeColors[index % NoticeColors.Length];

    private string NoticeMarquee =>
        string.Join(" ", MarqueeChips.Select(x => x.Text));

    private string MarqueeDuration
    {
        get
        {
            var seconds = Math.Clamp(NoticeMarquee.Length * 0.08, 18, 90);
            return $"{seconds:0}s";
        }
    }

    private void OpenAdminNotice()
    {
        CloseProfileMenu();
        showAdminNotice = true;
    }

    private void CloseAdminNotice() => showAdminNotice = false;

    private void OpenColorPicker()
    {
        customColor = headerColor;
        showColorPicker = true;
    }

    private void CloseColorPicker() => showColorPicker = false;

    private bool IsCurrent(string color) =>
        string.Equals(headerColor, color, StringComparison.OrdinalIgnoreCase);

    private void OnCustomInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (IsHexColor(value))
            customColor = value!;
    }

    private Task PickColorAsync(string color) => ApplyHeaderColorAsync(color);

    private Task ApplyCustomAsync() => ApplyHeaderColorAsync(customColor);

    private Task ResetColorAsync() => ApplyHeaderColorAsync(DefaultHeaderColor);

    private async Task ApplyHeaderColorAsync(string color)
    {
        if (!IsHexColor(color) || Session.Current is null)
            return;
        headerColor = color;
        customColor = color;
        Sync.SaveHeaderColor(Session.Current.SchoolID, color);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ColorKey, color);
        }
        catch
        {
        }

        if (string.IsNullOrWhiteSpace(Session.AccessToken))
            return;
        try
        {
            if (await Api.PingAsync())
                await Api.SaveHeaderColorAsync(Session.AccessToken, new HeaderColorRequest { Color = color });
        }
        catch
        {
        }
    }

    private async Task LoadHeaderColorAsync()
    {
        if (Session.Current is null)
            return;

        var fromSchool = Sync.GetSchoolHeader(Session.Current.SchoolID).HeaderColor;
        if (IsHexColor(fromSchool))
        {
            headerColor = fromSchool!;
            customColor = headerColor;
            try { await JS.InvokeVoidAsync("localStorage.setItem", ColorKey, headerColor); }
            catch { }
            StateHasChanged();
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", ColorKey);
            if (!IsHexColor(saved))
                saved = await JS.InvokeAsync<string>("localStorage.getItem", LegacyColorKey);
            if (!IsHexColor(saved))
                return;
            headerColor = saved;
            customColor = saved;
            Sync.SaveHeaderColor(Session.Current.SchoolID, saved);
            await JS.InvokeVoidAsync("localStorage.setItem", ColorKey, saved);
            if (!string.IsNullOrWhiteSpace(Session.AccessToken) && await Api.PingAsync())
                await Api.SaveHeaderColorAsync(Session.AccessToken, new HeaderColorRequest { Color = saved });
            StateHasChanged();
        }
        catch
        {
        }
    }

    private static bool IsHexColor(string? value) =>
        value is { Length: 7 } && value[0] == '#' && value[1..].All(Uri.IsHexDigit);

    private static string FmtDate(DateTime? value) => value is DateTime d ? d.ToString("d MMM yyyy") : "";

    private void Logout()
    {
        Session.Clear();
        Nav.NavigateTo("/", replace: true);
    }

    private void ReturnAuthority()
    {
        if (Session.ReturnToAuthority())
            Nav.NavigateTo("/authority", replace: true);
    }

    public void Dispose()
    {
        Sync.StateChanged -= OnSyncState;
        Locale.Changed -= OnLocale;
        Session.Changed -= OnSession;
        Nav.LocationChanged -= OnLocation;
    }
}
