@page "/accounts/concession"
@using System.Globalization
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject SyncEngine Sync

<div class="card sa-page si-info-page acc-page acc-mod-page fc-page pc-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("acc.concession")</p>
            <h1>@Locale.T("acc.concessionTitle")</h1>
            <p class="sa-lead">@Locale.T("acc.concessionHint")</p>
        </div>
    </header>

    <div class="sal-bar no-print">
        <section class="sal-box is-sid acc-grow">
            <span class="sal-box-h">@Locale.T("att.findId")</span>
            <div class="acc-find">
                <input class="si-find-input" type="text" autocomplete="off" placeholder="@Locale.T("att.findId")"
                       value="@findId" disabled="@busy" @oninput="OnFindInput" @onkeydown="OnFindKey" />
                @if (showSuggest)
                {
                    <div class="id-suggest">
                        @foreach (var item in suggestions)
                        {
                            <button type="button" @onclick="() => PickAsync(item.ID)">@item.ID — @item.Name @item.ClassName</button>
                        }
                    </div>
                }
            </div>
        </section>
        <button type="button" class="sal-gen" disabled="@busy" @onclick="() => LoadAsync(findId)">@Locale.T("acc.find")</button>
    </div>

    @if (bundle?.Student is not null)
    {
        var stu = bundle.Student;
        <div class="pc-top">
            <div class="pc-card">
                <div class="pc-photo">
                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                    {
                        <img src="@photoUrl" alt="" />
                    }
                    else
                    {
                        <span>@(stu.Name.Length == 0 ? "S" : stu.Name[..1])</span>
                    }
                </div>
                <div class="pc-info">
                <ul>
                    <li><strong>(@stu.ID) @stu.Name</strong></li>
                    <li><b>@Locale.T("students.class"):</b> @(stu.ClassName ?? "")</li>
                    <li>
                        @Locale.T("att.rollNo"): @(stu.RollNo ?? "")
                        @if (!string.IsNullOrWhiteSpace(stu.Section)) { <text>, @Locale.T("students.section"): @stu.Section</text> }
                        @if (!string.IsNullOrWhiteSpace(stu.Shift)) { <text>, @Locale.T("students.shift"): @stu.Shift</text> }
                    </li>
                    <li><b>@Locale.T("students.phone"):</b> @(stu.Phone ?? "")</li>
                    <li><b>@Locale.T("acc.session"):</b> @(stu.EducationYear ?? "")</li>
                </ul>
                </div>
            </div>
            <div class="pc-recent">
                @if (bundle.Receipts.Count == 0)
                {
                    <p class="muted">@Locale.T("acc.noPayment")</p>
                }
                else
                {
                    <table class="pc-receipt-table">
                        <thead>
                            <tr>
                                <th>@Locale.T("acc.receipt")</th>
                                <th>@Locale.T("acc.paid")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var rec in bundle.Receipts.Take(3))
                        {
                            <tr>
                                <td>
                                    <button type="button" class="link-btn" @onclick="() => OpenReceiptAsync(rec.ReceiptNo)">@rec.ReceiptNo</button>
                                    <small class="pc-time">@rec.PaidDate.ToString("d-MMM-yy (hh:mm tt)")</small>
                                </td>
                                <td>@rec.TotalAmount.ToString("0.##") @Locale.T("acc.tk")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="pc-due-banner">@Locale.T("acc.currentDueBanner", bundle.CurrentDue.ToString("0.##"), Locale.T("acc.tk"))</div>

        @DueTable(bundle.CurrentDues, false)
        @if (bundle.OtherDues.Count > 0)
        {
            <div class="pc-section-title">@Locale.T("acc.othersSession")</div>
            @DueTable(bundle.OtherDues, true)
        }

        @if (bundle.CurrentDues.Count > 0 || bundle.OtherDues.Count > 0)
        {
            <div class="sal-bar acc-actions-only no-print">
                <button type="button" class="sal-gen" disabled="@busy" @onclick="SaveAsync">@Locale.T("acc.concessionBtn")</button>
            </div>
        }
    }
</div>

@if (paidDetail is not null)
{
    <div class="acc-result-back" @onclick="() => paidDetail = null">
        <div class="acc-result is-ok pc-modal oi-cat-modal" @onclick:stopPropagation="true">
            <h3>@Locale.T("acc.paidRecord")</h3>
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>@Locale.T("acc.payFor")</th>
                        <th>@Locale.T("acc.role")</th>
                        <th>@Locale.T("acc.paid")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in paidDetail.Lines)
                {
                    <tr>
                        <td>@line.PayFor</td>
                        <td>@line.Role</td>
                        <td>@line.PaidAmount.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <td></td>
                        <td></td>
                        <td>@paidDetail.Lines.Sum(x => x.PaidAmount).ToString("0.##")</td>
                    </tr>
                </tfoot>
            </table>
            <p class="mr-recv">@Locale.T("acc.recvByLine", paidDetail.ReceivedBy ?? "")</p>
            <div class="pc-modal-btns">
                <a class="acc-btn acc-btn-primary" href="@($"accounts/receipt/{Uri.EscapeDataString(paidDetail.ReceiptNo)}")">@Locale.T("si.print")</a>
                <button type="button" class="acc-btn" @onclick="() => paidDetail = null">@Locale.T("acc.close")</button>
            </div>
        </div>
    </div>
}

@if (busy)
{
    <ExamBusyOverlay Busy="busy" Title="@(busyText ?? Locale.T("acc.loading"))" Message="@Locale.T("emp.wait")" />
}

@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="acc.failed" OnClose="ClosePopup" />
}

@code {
    private readonly List<FeeSuggestDto> suggestions = [];
    private FeeStudentBundleDto? bundle;
    private ReceiptDetailDto? paidDetail;
    private string findId = "";
    private string fillCurrent = "";
    private string fillOther = "";
    private bool busy, showSuggest, popupError;
    private string? error, message, photoUrl, popupText, busyText;
    private CancellationTokenSource? suggestCts;

    private RenderFragment DueTable(List<DueRowDto> rows, bool other) => __builder =>
    {
        <div class="sj-grid fc-grid">
            <table class="mgrid pc-table">
                <thead>
                    <tr>
                        @if (other)
                        {
                            <th>@Locale.T("acc.session")</th>
                            <th>@Locale.T("students.class")</th>
                        }
                        <th>@Locale.T("acc.role")</th>
                        <th>@Locale.T("acc.forShort")</th>
                        <th>@Locale.T("acc.fee")</th>
                        <th>@Locale.T("acc.paid")</th>
                        <th>@Locale.T("acc.due")</th>
                        <th>@Locale.T("acc.endDate")</th>
                        <th>
                            <input type="text" placeholder="@Locale.T("acc.feeConcAll")" value="@(other ? fillOther : fillCurrent)"
                                   disabled="@busy" @oninput="e => FillAll(rows, other, e)" />
                        </th>
                        <th>@Locale.T("acc.lateFee")</th>
                        <th>@Locale.T("acc.lateFeeConc")</th>
                    </tr>
                </thead>
                <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="@(other ? 11 : 9)">@Locale.T("acc.noDue")</td></tr>
                }
                else
                {
                    foreach (var row in rows)
                    {
                        <tr class="@(row.Overdue ? "is-overdue" : null)">
                            @if (other)
                            {
                                <td>@(row.YearName ?? "")</td>
                                <td>@(row.ClassName ?? "")</td>
                            }
                            <td>@row.Role</td>
                            <td>@row.PayFor</td>
                            <td>@row.Amount.ToString("0.##")</td>
                            <td>@row.PaidAmount.ToString("0.##")</td>
                            <td class="acc-due">@row.Due.ToString("0.##")</td>
                            <td>@row.EndDate.ToString("d MMM yy")</td>
                            <td><input type="number" min="0" step="0.01" placeholder="@Locale.T("acc.discount")" @bind="row.Discount" disabled="@busy" /></td>
                            <td>@row.StoredLateFee.ToString("0.##")</td>
                            <td><input type="number" min="0" step="0.01" placeholder="@Locale.T("acc.discount")" @bind="row.LateFeeDiscount" disabled="@busy" /></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    };

    private void FillAll(List<DueRowDto> rows, bool other, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        if (other) fillOther = text; else fillCurrent = text;
        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var value) || value < 0)
            return;
        foreach (var row in rows)
            row.Discount = value;
    }

    private async Task OnFindInput(ChangeEventArgs e)
    {
        findId = e.Value?.ToString() ?? "";
        suggestCts?.Cancel();
        suggestCts = new CancellationTokenSource();
        var token = suggestCts.Token;
        if (findId.Trim().Length < 1) { showSuggest = false; return; }
        try
        {
            await Task.Delay(180, token);
            suggestions.Clear();
            suggestions.AddRange(await Api.SuggestFeeStudentsAsync(Session.AccessToken!, findId.Trim(), token));
            showSuggest = suggestions.Count > 0;
        }
        catch (TaskCanceledException) { }
        catch { showSuggest = false; }
    }

    private Task OnFindKey(KeyboardEventArgs e) => e.Key == "Enter" ? LoadAsync(findId) : Task.CompletedTask;
    private Task PickAsync(string id) { findId = id; showSuggest = false; return LoadAsync(id); }

    private async Task LoadAsync(string id, bool keepStatus = false)
    {
        if (!keepStatus)
        {
            error = message = null;
            ClosePopup();
        }
        showSuggest = false;
        paidDetail = null;
        if (string.IsNullOrWhiteSpace(id)) { Fail(Locale.T("acc.needStudentId")); return; }
        if (!await OnlineAsync()) return;
        var ownBusy = !busy;
        if (ownBusy)
        {
            busy = true;
            busyText = Locale.T("acc.loading");
            await PaintAsync();
        }
        try
        {
            bundle = await Api.GetFeeStudentBundleAsync(Session.AccessToken!, id.Trim());
            if (bundle.Student is null)
            {
                photoUrl = null;
                Fail(Locale.T("acc.empty"));
                return;
            }
            fillCurrent = fillOther = "";
            photoUrl = Session.Current is null ? null : Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, bundle.Student.StudentID);
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally
        {
            if (ownBusy) busy = false;
        }
    }

    private async Task OpenReceiptAsync(string no)
    {
        if (!await OnlineAsync()) return;
        busy = true;
        busyText = Locale.T("acc.loading");
        await PaintAsync();
        try
        {
            paidDetail = await Api.GetMoneyReceiptAsync(Session.AccessToken!, no);
            if (paidDetail is null) Fail(Locale.T("acc.empty"));
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        if (bundle is null) return;
        error = message = null;
        ClosePopup();
        var items = bundle.CurrentDues.Concat(bundle.OtherDues)
            .Select(x => new ConcessionItem
            {
                PayOrderID = x.PayOrderID,
                Discount = x.Discount,
                LateFeeDiscount = x.LateFeeDiscount
            }).ToList();
        if (items.Count == 0) { Fail(Locale.T("acc.needRows")); return; }
        foreach (var row in bundle.CurrentDues.Concat(bundle.OtherDues))
        {
            if (row.Discount > row.Amount || row.LateFeeDiscount > row.StoredLateFee)
            { Fail(Locale.T("acc.overConcession")); return; }
        }
        if (!await OnlineAsync()) return;
        busy = true;
        busyText = Locale.T("acc.savingConcession");
        await PaintAsync();
        try
        {
            var result = await Api.SaveConcessionAsync(Session.AccessToken!, new SaveConcessionRequest { Items = items, Reason = "Concession" });
            if (!result.Succeeded) { Fail(Locale.T(result.Error ?? "acc.failed")); return; }
            message = Locale.T("acc.concessionOk");
            await LoadAsync(bundle.Student!.ID, keepStatus: true);
            ShowPopup(message, false);
        }
        catch (Exception ex) { Fail(ex.Message); }
        finally { busy = false; }
    }

    private async Task PaintAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void ShowPopup(string text, bool isError)
    {
        popupText = text;
        popupError = isError;
        if (isError) error = text;
        else message = text;
    }

    private void Fail(string text) => ShowPopup(text, true);
    private void ClosePopup() => popupText = null;

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        { Fail(Locale.T("subj.needOnline")); return false; }
        return true;
    }
}
