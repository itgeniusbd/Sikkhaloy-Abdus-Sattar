@page "/exam/cumulative-publish"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page exam-publish-page">
    <h1>@Locale.T("exam.cuPublish")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <select @bind="examId" @bind:after="LoadSettingAsync" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.CumulativeExams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        @if (filters.Grades.Count > 1)
        {
            <select @bind="setting.GradeNameID" disabled="@busy">
                @foreach (var item in filters.Grades)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        <button type="button" class="link-btn" disabled="@busy" @onclick="() => showNames = true">@Locale.T("exam.addCuExam")</button>
    </div>

    @if (classId > 0 && examId > 0)
    {
        <div class="exam-card-box is-exam">
            <h2>@Locale.T("exam.examPct")</h2>
            <div class="exam-card-body">
                @foreach (var row in setting.Exams)
                {
                    <div class="exam-pct-row">
                        <label><input type="checkbox" @bind="row.Selected" disabled="@busy" /> @row.ExamName</label>
                        <input type="number" min="0" max="100" step="0.01" @bind="row.Percentage" disabled="@busy" placeholder="@Locale.T("exam.enterExamPct")" />
                        <label><input type="checkbox" @bind="row.EnableFail" disabled="@busy" /> @Locale.T("exam.enableFail")</label>
                    </div>
                }
            </div>
        </div>

        <div class="exam-card-box is-pos">
            <h2>@Locale.T("exam.posSettings")</h2>
            <div class="exam-card-body">
                <div class="exam-radio">
                    <label><input type="radio" name="pos" checked="@(setting.PositionFormat == "Point")" @onchange="@(() => setting.PositionFormat = "Point")" disabled="@busy" /> @Locale.T("exam.posPoint")</label>
                    <label><input type="radio" name="pos" checked="@(setting.PositionFormat == "Mark")" @onchange="@(() => setting.PositionFormat = "Mark")" disabled="@busy" /> @Locale.T("exam.posMark")</label>
                </div>
                <div class="exam-checks">
                    <label><input type="checkbox" @bind="setting.HideSecPosition" disabled="@busy" /> @Locale.T("exam.hideSecPos")</label>
                    <label><input type="checkbox" @bind="setting.HideClassPosition" disabled="@busy" /> @Locale.T("exam.hideClassPos")</label>
                </div>
            </div>
        </div>

        <div class="exam-card-box is-opt">
            <h2>@Locale.T("exam.optSettings")</h2>
            <div class="exam-card-body">
                <div class="exam-radio">
                    <label><input type="radio" name="opt" checked="@(setting.OptionalMode == 0)" @onchange="@(() => setting.OptionalMode = 0)" disabled="@busy" /> @Locale.T("exam.optFull")</label>
                    <label><input type="radio" name="opt" checked="@(setting.OptionalMode == 1)" @onchange="@(() => setting.OptionalMode = 1)" disabled="@busy" /> @Locale.T("exam.optPct")</label>
                    <label><input type="radio" name="opt" checked="@(setting.OptionalMode == 2)" @onchange="@(() => setting.OptionalMode = 2)" disabled="@busy" /> @Locale.T("exam.optNone")</label>
                </div>
                @if (setting.OptionalMode == 1)
                {
                    <input type="number" min="0" max="100" step="0.01" @bind="setting.OptionalPercent" disabled="@busy" placeholder="%" />
                    <p class="exam-hint">@Locale.T("exam.optPctHint")</p>
                }
                <div class="exam-checks">
                    <label><input type="checkbox" @bind="setting.FailOptional" disabled="@busy" /> @Locale.T("exam.failOptional")</label>
                    <label><input type="checkbox" @bind="setting.AddOptionalInFull" disabled="@busy" /> @Locale.T("exam.addOptFull")</label>
                </div>
            </div>
        </div>

        <div class="exam-card-box is-set">
            <h2>@Locale.T("exam.examSettings")</h2>
            <div class="exam-card-body">
                <div class="exam-radio">
                    <label><input type="radio" name="gpa" checked="@setting.GradeOnGpa" @onchange="@(() => setting.GradeOnGpa = true)" disabled="@busy" /> @Locale.T("exam.gradeGpa")</label>
                    <label><input type="radio" name="gpa" checked="@(!setting.GradeOnGpa)" @onchange="@(() => setting.GradeOnGpa = false)" disabled="@busy" /> @Locale.T("exam.gradeAvg")</label>
                </div>
                <div class="exam-checks">
                    <label><input type="checkbox" @bind="setting.GradeAsItIs" disabled="@busy" /> @Locale.T("exam.gradeAsIs")</label>
                    <label><input type="checkbox" @bind="setting.HideSubExam" disabled="@busy" /> @Locale.T("exam.hideSubExam")</label>
                </div>
                <div class="exam-radio">
                    <label><input type="radio" name="cnt" checked="@setting.SameCountable" @onchange="@(() => setting.SameCountable = true)" disabled="@busy" /> @Locale.T("exam.countSame")</label>
                    <label><input type="radio" name="cnt" checked="@(!setting.SameCountable)" @onchange="@(() => setting.SameCountable = false)" disabled="@busy" /> @Locale.T("exam.countDiff")</label>
                </div>
                @if (setting.SameCountable)
                {
                    <input type="number" min="1" @bind="setting.CountableMark" disabled="@busy" placeholder="@Locale.T("exam.publishMark")" />
                }
                else
                {
                    <p class="exam-warn">@Locale.T("exam.uncheckHint")</p>
                    <table class="mgrid">
                        <thead>
                            <tr>
                                <th>@Locale.T("exam.addInExam")</th>
                                <th>@Locale.T("exam.subjects")</th>
                                <th>
                                    @Locale.T("exam.fullMark")
                                    <input type="number" min="1" @bind="allMark" disabled="@busy" placeholder="@Locale.T("exam.marksAll")" @bind:after="SetAllMarks" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in setting.Subjects)
                        {
                            <tr>
                                <td class="act"><input type="checkbox" @bind="row.AddInExam" disabled="@busy" /></td>
                                <td>@row.SubjectName</td>
                                <td><input type="number" min="1" @bind="row.CountableMark" disabled="@busy" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="exam-card-box is-att">
            <h2>@Locale.T("exam.attCount")</h2>
            <div class="exam-card-body filter-row">
                <input type="date" @bind="setting.AttendanceFrom" disabled="@busy" title="@Locale.T("exam.fromDate")" />
                <input type="date" @bind="setting.AttendanceTo" disabled="@busy" title="@Locale.T("exam.toDate")" />
                <select @bind="setting.ScheduleID" disabled="@busy">
                    <option value="0">@Locale.T("exam.allSchedule")</option>
                    @foreach (var item in filters.Schedules)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <p class="exam-hint" style="padding: 0 1rem 1rem;">@Locale.T("exam.attHint")</p>
        </div>

        <button type="button" class="acc-btn acc-btn-primary no-print" disabled="@busy" @onclick="PublishAsync">@Locale.T("exam.submit")</button>
    }
</div>

@if (showNames)
{
    <div class="acc-result-back" @onclick="() => showNames = false">
        <div class="acc-result is-ok exam-cu-names" @onclick:stopPropagation="true">
            <h3>@Locale.T("exam.addCuExam")</h3>
            <div class="inline-add">
                <input type="text" placeholder="@Locale.T("exam.cuExamName")" @bind="newName" disabled="@busy" />
                <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="AddNameAsync">@Locale.T("acc.add")</button>
            </div>
            <table class="mgrid">
                <thead><tr><th>@Locale.T("exam.cuExamName")</th><th class="act"></th></tr></thead>
                <tbody>
                @foreach (var row in filters.CumulativeExams)
                {
                    <tr>
                        <td>
                            @if (editNameId == row.Id) { <input type="text" @bind="editName" disabled="@busy" /> }
                            else { @row.Name }
                        </td>
                        <td class="act">
                            @if (editNameId == row.Id)
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => SaveNameAsync(row)">@Locale.T("si.update")</button>
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => editNameId = 0">@Locale.T("sal.cancel")</button>
                            }
                            else
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => { editNameId = row.Id; editName = row.Name; }">@Locale.T("sal.edit")</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <button type="button" class="acc-btn acc-btn-primary" @onclick="() => showNames = false">@Locale.T("acc.ok")</button>
        </div>
    </div>
}

<ExamBusyOverlay Busy="busy" Title="@busyTitle" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="exam.failed" OnClose="ClosePopup" />
}

@code {
    private ExamFilterDto filters = new();
    private CumulativePublishSettingDto setting = new();
    private int classId, examId, editNameId;
    private double allMark;
    private bool busy, popupError, showNames, onlineOk;
    private string? popupText, newName, editName;
    private string busyTitle = "";

    protected override Task OnInitializedAsync() => LoadFiltersAsync();

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        await ShowBusyAsync(Locale.T("acc.loading"));
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "cumulative-publish", 0, 0); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void OnClassAsync()
    {
        examId = 0;
        setting = new();
    }

    private async Task LoadSettingAsync()
    {
        setting = new();
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        await ShowBusyAsync(Locale.T("acc.loading"));
        try
        {
            setting = await Api.GetCumulativePublishSettingAsync(Session.AccessToken!, classId, examId);
            if (setting.GradeNameID <= 0 && filters.Grades.Count > 0)
                setting.GradeNameID = filters.Grades[0].Id;
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void SetAllMarks()
    {
        if (allMark < 1) return;
        foreach (var row in setting.Subjects) row.CountableMark = allMark;
    }

    private async Task AddNameAsync()
    {
        if (!await OnlineAsync()) return;
        await ShowBusyAsync(Locale.T("exam.loadingCuNames"));
        try
        {
            var result = await Api.CreateCumulativeExamNameAsync(Session.AccessToken!, new SaveCumulativeNameRequest { Name = newName ?? "" });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            newName = "";
            await LoadFiltersAsync();
            Show(Locale.T("exam.saved"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SaveNameAsync(ExamOptionDto row)
    {
        if (!await OnlineAsync()) return;
        await ShowBusyAsync(Locale.T("exam.loadingCuNames"));
        try
        {
            var result = await Api.UpdateCumulativeExamNameAsync(Session.AccessToken!, row.Id, new SaveCumulativeNameRequest { Name = editName ?? "" });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            editNameId = 0;
            await LoadFiltersAsync();
            Show(Locale.T("exam.saved"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task PublishAsync()
    {
        if (!await OnlineAsync()) return;
        await ShowBusyAsync(Locale.T("exam.loadingCuPublish"));
        try
        {
            var request = new CumulativePublishRequest
            {
                ClassID = classId,
                CumulativeNameID = examId,
                PositionFormat = setting.PositionFormat,
                HideSecPosition = setting.HideSecPosition,
                HideClassPosition = setting.HideClassPosition,
                OptionalMode = setting.OptionalMode,
                OptionalPercent = setting.OptionalPercent,
                FailOptional = setting.FailOptional,
                AddOptionalInFull = setting.AddOptionalInFull,
                GradeOnGpa = setting.GradeOnGpa,
                GradeAsItIs = setting.GradeAsItIs,
                SameCountable = setting.SameCountable,
                CountableMark = setting.CountableMark,
                HideSubExam = setting.HideSubExam,
                GradeNameID = setting.GradeNameID,
                AttendanceFrom = setting.AttendanceFrom,
                AttendanceTo = setting.AttendanceTo,
                ScheduleID = setting.ScheduleID,
                Subjects = setting.Subjects,
                Exams = setting.Exams
            };
            var result = await Api.PublishCumulativeResultAsync(Session.AccessToken!, request);
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            Show(Locale.T("exam.publishOk"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void Show(string text, bool err = false) { popupText = text; popupError = err; }
    private void ClosePopup() => popupText = null;
    private async Task ShowBusyAsync(string title)
    {
        busyTitle = title;
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        if (onlineOk) return true;
        if (!await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        onlineOk = true;
        return true;
    }
}
