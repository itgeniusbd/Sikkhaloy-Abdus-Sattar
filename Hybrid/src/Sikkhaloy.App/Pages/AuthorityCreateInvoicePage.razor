    private async Task GenerateCountAsync()
    {
        await SetBusyAsync(Locale.T("ab.saving"));
        try
        {
            if (!await OnlineAsync()) return;
            var result = await Api.GenerateAuthorityStudentCountAsync(Session.AccessToken!, new AuthGenerateCountRequest { Month = genMonth.ToString("yyyy-MM-dd") });
            Show(Msg(result), !result.Succeeded);
            if (result.Succeeded) await LoadAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

