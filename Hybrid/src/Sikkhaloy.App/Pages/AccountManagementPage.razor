@page "/accounts/cash"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page acc-page acc-mod-page acc-cash-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("acc.cash")</p>
            <h1>@Locale.T("acc.cash")</h1>
            <p class="sa-lead">@Locale.T("acc.cashHint")</p>
        </div>
    </header>

    <section class="acc-cash-block no-print">
        <div class="sal-bar">
            <section class="sal-box is-sid acc-grow">
                <span class="sal-box-h">@Locale.T("acc.account")</span>
                <input class="si-find-input" type="text" placeholder="@Locale.T("acc.account")" @bind="newName" disabled="@busy" />
            </section>
            <button type="button" class="sal-gen" disabled="@busy" @onclick="AddAccountAsync">@Locale.T("acc.add")</button>
        </div>
    </section>

    <section class="acc-cash-block no-print">
        <div class="sal-bar">
            <section class="sal-box is-account acc-grow">
                <span class="sal-box-h">@Locale.T("acc.account")</span>
                <select @bind="accountInput" @bind:after="LoadMovesAsync" disabled="@busy">
                    <option value="0">@Locale.T("acc.account")</option>
                    @foreach (var item in accounts)
                    {
                        <option value="@item.AccountID">@item.AccountName (@item.Balance.ToString("0.##"))</option>
                    }
                </select>
            </section>
            @if (SelectedAccount is not null)
            {
                <div class="acc-inline-meta">
                    <span class="acc-balance-pill">@Locale.T("acc.balance"): <strong>@SelectedAccount.Balance.ToString("0.##")</strong></span>
                    @if (SelectedAccount.IsDefault)
                    {
                        <span class="acc-default-badge">@Locale.T("acc.default")</span>
                    }
                </div>
            }
            @if (AccountId > 0)
            {
                <button type="button" class="sal-bonus" disabled="@busy" @onclick="SetDefaultAsync">@Locale.T("acc.setDefault")</button>
            }
        </div>
    </section>

    @if (AccountId > 0)
    {
        <div class="si-tabs no-print">
            <button type="button" class="@(tab == "in" ? "active" : null)" @onclick='() => tab = "in"'>@Locale.T("acc.deposit")</button>
            <button type="button" class="@(tab == "out" ? "active" : null)" @onclick='() => tab = "out"'>@Locale.T("acc.withdraw")</button>
        </div>
        <div class="sal-bar no-print">
            <section class="sal-box is-amt">
                <span class="sal-box-h">@Locale.T("acc.amount")</span>
                <input type="number" min="0" step="0.01" placeholder="@Locale.T("acc.amount")" @bind="amount" disabled="@busy" />
            </section>
            <section class="sal-box is-date">
                <span class="sal-box-h">@Locale.T("att.date")</span>
                <input type="date" @bind="date" disabled="@busy" />
            </section>
            <section class="sal-box is-sid acc-grow">
                <span class="sal-box-h">@Locale.T("acc.details")</span>
                <input class="si-find-input" type="text" placeholder="@Locale.T("acc.details")" @bind="details" disabled="@busy" />
            </section>
            <button type="button" class="sal-gen" disabled="@busy" @onclick="MoveAsync">@(tab == "in" ? Locale.T("acc.deposit") : Locale.T("acc.withdraw"))</button>
        </div>
        <div class="sj-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>@Locale.T("att.date")</th>
                        <th>@Locale.T("acc.amount")</th>
                        <th>@Locale.T("acc.details")</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var list = tab == "in" ? deposits : withdraws;
                }
                @if (list.Count == 0 && !busy)
                {
                    <tr><td colspan="3" class="empty-row">@Locale.T("acc.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in list)
                    {
                        <tr>
                            <td>@row.Date.ToString("dd-MMM-yyyy")</td>
                            <td>@row.Amount.ToString("0.##")</td>
                            <td>@row.Details</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText) && !busy)
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="acc.failed" OnClose="ClosePopup" />
}

@code {
    private readonly List<CashAccountDto> accounts = [];
    private readonly List<AccountMoveDto> deposits = [];
    private readonly List<AccountMoveDto> withdraws = [];
    private string accountInput = "0";
    private string newName = "";
    private string tab = "in";
    private decimal amount;
    private DateTime date = DateTime.Today;
    private string? details;
    private bool busy, popupError;
    private string busyTitle = "";
    private string? popupText;
    private int AccountId => int.TryParse(accountInput, out var n) ? n : 0;
    private CashAccountDto? SelectedAccount => accounts.FirstOrDefault(x => x.AccountID == AccountId);

    protected override Task OnInitializedAsync() => LoadAccountsAsync();

    private async Task LoadAccountsAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.loading");
        try
        {
            accounts.Clear();
            accounts.AddRange(await Api.GetCashAccountsAsync(Session.AccessToken!));
            if (AccountId == 0)
            {
                var def = accounts.FirstOrDefault(x => x.IsDefault) ?? accounts.FirstOrDefault();
                if (def is not null) accountInput = def.AccountID.ToString();
            }
            await LoadMovesAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task LoadMovesAsync()
    {
        deposits.Clear();
        withdraws.Clear();
        if (AccountId <= 0) return;
        deposits.AddRange(await Api.GetCashDepositsAsync(Session.AccessToken!, AccountId));
        withdraws.AddRange(await Api.GetCashWithdrawsAsync(Session.AccessToken!, AccountId));
    }

    private async Task AddAccountAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.CreateCashAccountAsync(Session.AccessToken!, new SaveCashAccountRequest { AccountName = newName });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            newName = "";
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SetDefaultAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.SetDefaultCashAccountAsync(Session.AccessToken!, AccountId);
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task MoveAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var req = new AccountMoveRequest { AccountID = AccountId, Amount = amount, Date = date, Details = details };
            var result = tab == "in"
                ? await Api.DepositCashAsync(Session.AccessToken!, req)
                : await Api.WithdrawCashAsync(Session.AccessToken!, req);
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            amount = 0;
            details = null;
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task ReloadQuietAsync()
    {
        accounts.Clear();
        accounts.AddRange(await Api.GetCashAccountsAsync(Session.AccessToken!));
        await LoadMovesAsync();
    }

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        { Show(Locale.T("subj.needOnline"), true); return false; }
        return true;
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
    }

    private void ClosePopup() => popupText = null;
}
