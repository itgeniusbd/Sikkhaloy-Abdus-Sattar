@page "/exam/input"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime Js

<div class="card structure-page emp-page acc-page exam-page exam-input-page tch-marks-page" id="tm-top">
    <section class="tm-hero">
        <span class="tm-hero-ico" aria-hidden="true">@DocIco</span>
        <div class="tm-hero-txt">
            <h1>@Locale.T("exam.inputTitle")</h1>
            <p>
                @Locale.T("tch.totalStudentLbl")
                <b>@sheet.Students.Count</b>
            </p>
        </div>
        <span class="tm-hero-cap" aria-hidden="true">@CapIco</span>
    </section>

    @if (!string.IsNullOrWhiteSpace(toastText))
    {
        <p class="tm-msg @(toastError ? "is-err" : "is-ok")">@toastText</p>
    }

    <article class="tm-filters">
        <label class="tm-field">
            <span class="tm-ico" aria-hidden="true">@CalIco</span>
            <select @bind="examId" @bind:after="OnExamAsync" disabled="@busy" aria-label="@Locale.T("tch.exam")">
                <option value="0">@Locale.T("exam.selectExamName")</option>
                @foreach (var item in filters.Exams)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </label>
        <div class="tm-row @ClassRowClass">
            <label class="tm-field">
                <span class="tm-ico" aria-hidden="true">@CapIco</span>
                <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy" aria-label="@Locale.T("stu.class")">
                    <option value="0">@Locale.T("si.selectClass")</option>
                    @foreach (var item in filters.Classes)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </label>
            @if (classId > 0 && filters.Sections.Count > 0)
            {
                <label class="tm-field">
                    <span class="tm-ico" aria-hidden="true">@UserIco</span>
                    <select @bind="sectionId" @bind:after="LoadJoinAsync" disabled="@busy" aria-label="@Locale.T("si.section")">
                        <option value="0">@Locale.T("exam.allSection")</option>
                        @foreach (var item in filters.Sections)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
            }
            @if (classId > 0 && filters.Groups.Count > 0)
            {
                <label class="tm-field">
                    <span class="tm-ico" aria-hidden="true">@UsersIco</span>
                    <select @bind="groupId" @bind:after="LoadJoinAsync" disabled="@busy" aria-label="@Locale.T("si.group")">
                        <option value="0">@Locale.T("exam.selectGroup")</option>
                        @foreach (var item in filters.Groups)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
            }
            @if (classId > 0 && filters.Shifts.Count > 0)
            {
                <label class="tm-field">
                    <span class="tm-ico" aria-hidden="true">@ClockIco</span>
                    <select @bind="shiftId" @bind:after="LoadJoinAsync" disabled="@busy" aria-label="@Locale.T("si.shift")">
                        <option value="0">@Locale.T("exam.allShift")</option>
                        @foreach (var item in filters.Shifts)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
            }
        </div>
        <div class="tm-row @(filters.SubExams.Count > 0 ? "is-2" : "is-1")">
            <label class="tm-field">
                <span class="tm-ico" aria-hidden="true">@LeafIco</span>
                <select @bind="subjectId" @bind:after="OnSubjectAsync" disabled="@busy" aria-label="@Locale.T("tch.subject")">
                    <option value="0">@Locale.T("exam.selectSubject")</option>
                    @foreach (var item in filters.Subjects)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </label>
            @if (filters.SubExams.Count > 0)
            {
                <label class="tm-field">
                    <span class="tm-ico" aria-hidden="true">@LayersIco</span>
                    <select @bind="subExamId" @bind:after="OnSubExamAsync" disabled="@busy" aria-label="@Locale.T("tch.subExam")">
                        <option value="0">@Locale.T("exam.selectSub")</option>
                        @foreach (var item in filters.SubExams)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
            }
        </div>
    </article>

    @if (shown)
    {
        @if (!AllSubs && sheet.Students.Count > 0)
        {
            <div class="tm-stats">
                <div class="is-fm">
                    <span aria-hidden="true">@TargetIco</span>
                    <p>@Locale.T("exam.fullMarkLbl", sheet.FullMark)</p>
                </div>
                <div class="is-pm">
                    <span aria-hidden="true">@CheckIco</span>
                    <p>@Locale.T("exam.passMarkLbl", sheet.PassMark)</p>
                </div>
                <div class="is-pp">
                    <span aria-hidden="true">@StarIco</span>
                    <p>@Locale.T("exam.passPctLbl", sheet.PassPercentage)</p>
                </div>
            </div>
        }

        @if (sheet.Students.Count == 0)
        {
            <article class="tm-empty"><p>@Locale.T("stu.empty")</p></article>
        }
        else
        {
            <div class="tm-toolbar">
                <label class="tm-check">
                    <input type="checkbox" @bind="hideName" />
                    <span>@Locale.T("exam.hideName")</span>
                </label>
            </div>
            <div class="tm-table-wrap">
                <table class="tm-table">
                    <thead>
                        <tr>
                            <th class="is-id"><button type="button" @onclick='() => SortBy("id")'>@Locale.T("exam.id") @SortMark("id")</button></th>
                            @if (!hideName)
                            {
                                <th class="is-name"><button type="button" @onclick='() => SortBy("name")'>@Locale.T("exam.name") @SortMark("name")</button></th>
                            }
                            <th class="is-roll"><button type="button" @onclick='() => SortBy("roll")'>@Locale.T("exam.roll") @SortMark("roll")</button></th>
                            <th class="is-mark">@Locale.T("exam.obtain")</th>
                            @if (!AllSubs)
                            {
                                <th class="is-abs">@Locale.T("exam.absence")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var student in Rows)
                    {
                        <tr @key="student.StudentClassID">
                            <td class="is-id">@student.ID</td>
                            @if (!hideName)
                            {
                                <td class="is-name">@student.Name</td>
                            }
                            <td class="is-roll">@student.RollNo</td>
                            <td class="is-mark">
                                @if (AllSubs)
                                {
                                    <div class="tm-subs">
                                        @foreach (var sub in student.Subs)
                                        {
                                            <div class="tm-sub">
                                                <small>@LocalizeSubExam(sub.SubExamName) @Locale.T("exam.fmShort", sub.FullMark)</small>
                                                <div class="tm-sub-in">
                                                    <input class="tm-mark-in" type="number" step="0.01" inputmode="decimal" enterkeyhint="next"
                                                           @bind="sub.MarksObtained" disabled="@(busy || sub.Absent)" />
                                                    <label title="@Locale.T("exam.abs")">
                                                        <input type="checkbox" tabindex="-1" checked="@sub.Absent" disabled="@busy"
                                                               @onchange="e => OnSubAbs(sub, e)" />
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <input class="tm-mark-in" type="number" step="0.01" inputmode="decimal" enterkeyhint="next"
                                           @bind="student.MarksObtained" disabled="@(busy || student.Absent)" />
                                }
                            </td>
                            @if (!AllSubs)
                            {
                                <td class="is-abs">
                                    <input type="checkbox" tabindex="-1" checked="@student.Absent" disabled="@busy"
                                           @onchange="e => OnRowAbs(student, e)" />
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="tm-save-wrap is-sticky no-print">
                <div class="tm-save-row">
                    <button type="button" class="tm-next" disabled="@busy" @onmousedown:preventDefault @onclick="FocusNextMark">@DownIco @Locale.T("tch.nextBox")</button>
                    <button type="button" class="tm-save @(busy ? "is-busy" : null)" disabled="@busy" @onclick="SaveAsync">
                        @if (busy)
                        {
                            <span class="tm-save-spin" aria-hidden="true"></span>
                            @Locale.T("stu.loading")
                        }
                        else
                        {
                            @PenIco @Locale.T("tch.saveMarks")
                        }
                    </button>
                </div>
            </div>
            <button type="button" class="tm-fab no-print" @onclick="ScrollTop">@PenIco @Locale.T("tch.top")</button>
        }
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@busyMessage" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="exam.failed" OnClose="ClosePopup" />
}

@code {
    private static readonly RenderFragment DocIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>;
    private static readonly RenderFragment CapIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c1.5 1.3 3.6 2 6 2s4.5-.7 6-2v-5"/></svg>;
    private static readonly RenderFragment CalIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>;
    private static readonly RenderFragment UserIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 14.5-4 16 0"/></svg>;
    private static readonly RenderFragment UsersIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 19c.8-3.2 6.2-3.2 8 0M14 19c.5-2.2 4.5-2.4 6 0"/></svg>;
    private static readonly RenderFragment ClockIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg>;
    private static readonly RenderFragment LeafIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19c8-1 14-8 14-16-8 0-15 6-16 14 3-1 6-1 9 0"/><path d="M5 19s1-6 7-10"/></svg>;
    private static readonly RenderFragment LayersIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 9 5-9 5-9-5 9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/></svg>;
    private static readonly RenderFragment TargetIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>;
    private static readonly RenderFragment CheckIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>;
    private static readonly RenderFragment StarIco = @<svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 3 2.6 5.4 6 .9-4.3 4.2 1 5.9L12 16.8 6.7 19.4l1-5.9L3.4 9.3l6-.9z"/></svg>;
    private static readonly RenderFragment PenIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>;
    private static readonly RenderFragment DownIco = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M6 13l6 6 6-6"/></svg>;

    private ExamFilterDto filters = new();
    private InputSheetDto sheet = new();
    private int examId, classId, subjectId, subExamId, groupId, sectionId, shiftId;
    private bool busy, popupError, hideName, shown, toastError;
    private string? popupText, toastText;
    private string busyTitle = "";
    private string? busyMessage;
    private string sortKey = "roll";
    private bool sortAsc = true;
    private bool AllSubs => sheet.HasSubExams && subExamId <= 0;

    private string ClassRowClass
    {
        get
        {
            if (classId <= 0)
                return "is-1";
            var n = 1;
            if (filters.Sections.Count > 0) n++;
            if (filters.Groups.Count > 0) n++;
            if (filters.Shifts.Count > 0) n++;
            return n switch { 4 => "is-4", 3 => "is-3", 2 => "is-2", _ => "is-1" };
        }
    }

    private IEnumerable<InputStudentDto> Rows
    {
        get
        {
            IEnumerable<InputStudentDto> rows = sheet.Students;
            rows = sortKey switch
            {
                "id" => sortAsc ? rows.OrderBy(s => s.ID) : rows.OrderByDescending(s => s.ID),
                "name" => sortAsc ? rows.OrderBy(s => s.Name) : rows.OrderByDescending(s => s.Name),
                _ => sortAsc ? rows.OrderBy(RollKey) : rows.OrderByDescending(RollKey)
            };
            return rows;
        }
    }

    [SupplyParameterFromQuery(Name = "examId")] public int QExam { get; set; }
    [SupplyParameterFromQuery(Name = "classId")] public int QClass { get; set; }
    [SupplyParameterFromQuery(Name = "subjectId")] public int QSubject { get; set; }

    private bool _ready;
    private int _lastQExam = -1, _lastQClass = -1, _lastQSubject = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _lastQExam == QExam && _lastQClass == QClass && _lastQSubject == QSubject)
            return;

        var queryChanged = _lastQExam != QExam || _lastQClass != QClass || _lastQSubject != QSubject;
        _lastQExam = QExam;
        _lastQClass = QClass;
        _lastQSubject = QSubject;

        if (QExam > 0) examId = QExam;
        if (QClass > 0) classId = QClass;
        if (QSubject > 0) subjectId = QSubject;

        await LoadFiltersAsync();
        _ready = true;

        if (queryChanged && examId > 0 && classId > 0 && subjectId > 0)
            await ShowStudentsAsync();
    }

    private async Task LoadFiltersAsync()
    {
        await SetBusyAsync(Locale.T("exam.loadingInput"));
        try
        {
            if (!await OnlineAsync()) return;
            filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "input", classId, examId, G(groupId), G(sectionId), G(shiftId), subjectId);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { ClearBusy(); }
    }

    private async Task OnExamAsync()
    {
        classId = subjectId = subExamId = groupId = sectionId = shiftId = 0;
        shown = false;
        sheet = new();
        await LoadFiltersAsync();
    }

    private async Task OnClassAsync()
    {
        subjectId = subExamId = groupId = sectionId = shiftId = 0;
        shown = false;
        sheet = new();
        await LoadFiltersAsync();
    }

    private async Task LoadJoinAsync()
    {
        shown = false;
        sheet = new();
        await LoadFiltersAsync();
        await ShowStudentsIfReadyAsync();
    }

    private async Task OnSubjectAsync()
    {
        subExamId = 0;
        shown = false;
        sheet = new();
        await LoadFiltersAsync();
        await ShowStudentsIfReadyAsync();
    }

    private Task OnSubExamAsync() => ShowStudentsIfReadyAsync();

    private Task ShowStudentsIfReadyAsync() =>
        examId > 0 && classId > 0 && subjectId > 0 ? ShowStudentsAsync() : Task.CompletedTask;

    private async Task ShowStudentsAsync()
    {
        shown = false;
        sheet = new();
        toastText = null;
        if (examId <= 0 || classId <= 0 || subjectId <= 0) { Show(Locale.T("exam.needExamClassSubject"), true); return; }
        await SetBusyAsync(Locale.T("exam.loadingInput"));
        try
        {
            if (!await OnlineAsync()) return;
            sheet = await Api.GetExamInputSheetAsync(Session.AccessToken!, examId, classId, subjectId, subExamId, G(groupId), G(sectionId), G(shiftId));
            ClearAbsentMarks();
            shown = true;
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { ClearBusy(); }
    }

    private async Task SaveAsync()
    {
        await SetBusyAsync(Locale.T("exam.savingMarks"), Locale.T("exam.pleaseWait"));
        try
        {
            if (!await OnlineAsync()) return;
            var result = await Api.SaveExamInputMarksAsync(Session.AccessToken!, new SaveInputMarksRequest
            {
                ClassID = classId,
                ExamID = examId,
                SubjectID = subjectId,
                SubExamID = subExamId,
                AllSubExams = AllSubs,
                Students = sheet.Students
            });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            Show(Locale.T(result.Queued ? "sync.savedOffline" : "exam.inputOk"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { ClearBusy(); }
    }

    private void SortBy(string key)
    {
        if (sortKey == key)
            sortAsc = !sortAsc;
        else
        {
            sortKey = key;
            sortAsc = true;
        }
    }

    private string SortMark(string key) => sortKey == key ? (sortAsc ? "▲" : "▼") : "⇅";
    private static int RollKey(InputStudentDto row) =>
        int.TryParse(row.RollNo?.Replace("$", "").Replace(",", ""), out var n) ? n : 0;

    private static string? G(int id) => id <= 0 ? null : id.ToString();
    private static bool IsChecked(ChangeEventArgs e) =>
        e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static void OnSubAbs(InputSubMarkDto sub, ChangeEventArgs e)
    {
        sub.Absent = IsChecked(e);
        if (sub.Absent)
            sub.MarksObtained = null;
    }

    private static void OnRowAbs(InputStudentDto row, ChangeEventArgs e)
    {
        row.Absent = IsChecked(e);
        if (row.Absent)
            row.MarksObtained = null;
    }

    private void ClearAbsentMarks()
    {
        foreach (var student in sheet.Students)
        {
            if (student.Absent)
                student.MarksObtained = null;
            foreach (var sub in student.Subs)
            {
                if (sub.Absent)
                    sub.MarksObtained = null;
            }
        }
    }

    private string LocalizeSubExam(string name)
    {
        if (!Locale.IsBengali || string.IsNullOrWhiteSpace(name))
            return name;
        return name.Trim().ToUpperInvariant() switch
        {
            "SUB" or "SUBJECTIVE" => Locale.T("exam.sub"),
            "OBJ" or "OBJECTIVE" => Locale.T("exam.obj"),
            "CQ" => Locale.T("exam.cq"),
            "MCQ" => Locale.T("exam.mcq"),
            "WRITTEN" => Locale.T("exam.written"),
            "PRACTICAL" => Locale.T("exam.practical"),
            "ORAL" => Locale.T("exam.oral"),
            "THEORY" => Locale.T("exam.theory"),
            _ => name
        };
    }

    private void Show(string text, bool err = false)
    {
        popupText = text;
        popupError = err;
        toastText = text;
        toastError = err;
    }

    private void ClosePopup() => popupText = null;

    private async Task SetBusyAsync(string title, string? message = null)
    {
        busyTitle = title;
        busyMessage = message;
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void ClearBusy()
    {
        busy = false;
        busyTitle = "";
        busyMessage = null;
    }

    private Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Show(Locale.T("subj.needOnline"), true);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private async Task ScrollTop()
    {
        try { await Js.InvokeVoidAsync("sikkhaloyGoTop.scroll"); }
        catch { }
    }

    private async Task FocusNextMark()
    {
        try { await Js.InvokeVoidAsync("sikkhaloyMarkNav.next"); }
        catch { }
    }
}
