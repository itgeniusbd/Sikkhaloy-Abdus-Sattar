@page "/committee/donation-add"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav

<div class="card structure-page emp-page acc-page exam-page committee-page sms-mod cm-add-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">Committee / @Locale.T("cm.donations")</p>
            <h1>@Locale.T("cm.addDonation")</h1>
            <p class="cm-add-lead">@Locale.T("cm.addDonationSub")</p>
        </div>
        <a class="mr-back" href="/committee/donations">@Locale.T("cm.donations")</a>
    </header>

    <div class="cm-add-stage">
        <section class="cm-add-donor">
            <div class="cm-add-donor-top">
                <div>
                    <span class="cm-add-step">01</span>
                    <h2>@Locale.T("cm.findDonor")</h2>
                    <p>@Locale.T("cm.findDonorHint")</p>
                </div>
                <button type="button" class="cm-add-ghost" disabled="@busy" @onclick="() => showAdd = true">@Locale.T("cm.addNewDonor")</button>
            </div>

            @if (memberId > 0)
            {
                <div class="cm-add-picked">
                    <div class="cm-add-avatar">@Initial(donorName)</div>
                    <div class="cm-add-picked-meta">
                        <strong>@donorName</strong>
                        <span>@donorPhone</span>
                    </div>
                    <button type="button" class="cm-add-change" disabled="@busy" @onclick="ClearDonor">@Locale.T("cm.changeDonor")</button>
                </div>
            }
            else
            {
                <div class="cm-suggest cm-add-search">
                    <input type="text" placeholder="@Locale.T("cm.donorSearchPh")" @bind="donorQ" @bind:event="oninput" @bind:after="SuggestAsync" disabled="@busy" autocomplete="off" />
                    @if (suggests.Count > 0)
                    {
                        <ul>
                            @foreach (var item in suggests)
                            {
                                <li @onclick="() => Pick(item)">
                                    <b>@item.MemberName</b>
                                    <small>@item.SmsNumber</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
                @if (suggests.Count == 0)
                {
                    <p class="cm-add-empty">@Locale.T("cm.noDonor")</p>
                }
            }
        </section>

        <div class="cm-add-cols">
            <section class="cm-add-card is-pledge">
                <header>
                    <span class="cm-add-step">02</span>
                    <div>
                        <h2>@Locale.T("cm.pledgeTitle")</h2>
                        <p>@Locale.T("cm.pledgeSub")</p>
                    </div>
                </header>
                <label class="cm-fld">
                    <span>@Locale.T("cm.donationCategory") <a href="/committee/categories">@Locale.T("cm.addNew")</a></span>
                    <select @bind="categoryId" disabled="@busy">
                        <option value="0">@Locale.T("cm.selectCategory")</option>
                        @foreach (var item in lookups.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <label class="cm-fld">
                    <span>@Locale.T("cm.amount")</span>
                    <input type="number" min="0.01" step="0.01" @bind="amount" disabled="@busy" />
                </label>
                <label class="cm-fld">
                    <span>@Locale.T("cm.promise")</span>
                    <input type="date" @bind="promiseDate" disabled="@busy" />
                </label>
                <label class="cm-fld">
                    <span>@Locale.T("cm.desc")</span>
                    <input type="text" placeholder="@Locale.T("cm.descPh")" @bind="description" disabled="@busy" />
                </label>
            </section>

            <section class="cm-add-card is-pay">
                <header>
                    <span class="cm-add-step">03</span>
                    <div>
                        <h2>@Locale.T("cm.payTitle")</h2>
                        <p>@Locale.T("cm.paySub")</p>
                    </div>
                </header>
                <label class="cm-fld">
                    <span>@Locale.T("cm.paidAmount")</span>
                    <input type="number" min="0" step="0.01" @bind="paidAmount" disabled="@busy" />
                </label>
                <label class="cm-fld">
                    <span>@Locale.T("cm.paidDate")</span>
                    <input type="date" @bind="paidDate" disabled="@(busy || paidAmount <= 0)" />
                </label>
                <label class="cm-fld">
                    <span>@Locale.T("cm.account")</span>
                    <select @bind="accountId" disabled="@busy">
                        @foreach (var item in lookups.Accounts)
                        {
                            <option value="@item.AccountID">@item.AccountName</option>
                        }
                    </select>
                </label>
                <div class="cm-add-meter" title="@PaidPct()%">
                    <div class="cm-add-meter-bar" style="width: @PaidPct()%"></div>
                </div>
            </section>
        </div>

        <div class="cm-add-foot">
            <div class="cm-add-tally">
                <div>
                    <small>@Locale.T("cm.amount")</small>
                    <b>@Tk(amount)</b>
                </div>
                <div>
                    <small>@Locale.T("cm.paid")</small>
                    <b>@Tk(paidAmount)</b>
                </div>
                <div class="is-due">
                    <small>@Locale.T("cm.remaining")</small>
                    <b>@Tk(Remaining)</b>
                </div>
            </div>
            <button type="button" class="cm-add-submit" disabled="@busy" @onclick="SaveAsync">@Locale.T("cm.submitDonation")</button>
        </div>
    </div>
</div>

@if (showAdd)
{
    <div class="acc-result-back" @onclick="() => showAdd = false">
        <div class="acc-result is-ok sms-modal cm-add-modal" @onclick:stopPropagation="true">
            <h3>@Locale.T("cm.addMember")</h3>
            <label>@Locale.T("cm.name")</label>
            <input type="text" @bind="addName" disabled="@busy" />
            <label>@Locale.T("cm.memberType")</label>
            <select @bind="addTypeId" disabled="@busy">
                <option value="0">@Locale.T("cm.selectType")</option>
                @foreach (var item in lookups.Types)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
            <label>@Locale.T("cm.phone")</label>
            <input type="text" @bind="addPhone" disabled="@busy" />
            <label>@Locale.T("cm.address")</label>
            <input type="text" @bind="addAddress" disabled="@busy" />
            <div class="filter-row">
                <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="AddDonorAsync">@Locale.T("cm.addMember")</button>
                <button type="button" class="acc-btn" @onclick="() => showAdd = false">@Locale.T("acc.ok")</button>
            </div>
        </div>
    </div>
}

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("exam.pleaseWait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private CommitteeLookupsDto lookups = new();
    private readonly List<DonorSuggestDto> suggests = [];
    private int memberId, categoryId, accountId, addTypeId;
    private string donorQ = "", donorName = "", donorPhone = "", description = "", addName = "", addPhone = "", addAddress = "";
    private decimal amount, paidAmount;
    private DateTime? promiseDate;
    private DateTime paidDate = DateTime.Today;
    private bool busy, showAdd, popupError;
    private string busyTitle = "", popupText = "";
    private decimal Remaining => Math.Max(0, amount - paidAmount);

    protected override async Task OnInitializedAsync()
    {
        await SetBusyAsync(Locale.T("cm.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            lookups = await Api.GetCommitteeLookupsAsync(Session.AccessToken!);
            accountId = lookups.Accounts.FirstOrDefault(x => x.IsDefault)?.AccountID ?? lookups.Accounts.FirstOrDefault()?.AccountID ?? 0;
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SuggestAsync()
    {
        suggests.Clear();
        if (donorQ.Trim().Length < 1 || memberId > 0) return;
        try
        {
            suggests.AddRange(await Api.SuggestDonorsAsync(Session.AccessToken!, donorQ));
        }
        catch { }
    }

    private void Pick(DonorSuggestDto item)
    {
        memberId = item.CommitteeMemberId;
        donorName = item.MemberName;
        donorPhone = item.SmsNumber;
        donorQ = item.MemberName;
        suggests.Clear();
    }

    private void ClearDonor()
    {
        memberId = 0;
        donorName = donorPhone = donorQ = "";
        suggests.Clear();
    }

    private async Task AddDonorAsync()
    {
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            var result = await Api.SaveCommitteeMemberAsync(Session.AccessToken!, new SaveCommitteeMemberRequest
            {
                CommitteeMemberTypeId = addTypeId,
                MemberName = addName,
                SmsNumber = addPhone,
                Address = addAddress
            });
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            memberId = result.Id;
            donorName = addName;
            donorPhone = addPhone;
            donorQ = addName;
            showAdd = false;
            addName = addPhone = addAddress = "";
            addTypeId = 0;
            lookups = await Api.GetCommitteeLookupsAsync(Session.AccessToken!);
            Show(Locale.T(result.Message ?? "cm.memberAdded"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            if (!await OnlineAsync()) return;
            var result = await Api.AddDonationAsync(Session.AccessToken!, new AddDonationRequest
            {
                CommitteeMemberId = memberId,
                CommitteeDonationCategoryId = categoryId,
                Amount = amount,
                Description = description,
                PromiseDate = promiseDate,
                PaidAmount = paidAmount,
                PaidDate = paidAmount > 0 ? paidDate : null,
                AccountId = accountId
            });
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            if (result.ReceiptId > 0)
            {
                Nav.NavigateTo($"/committee/receipt/{result.ReceiptId}");
                return;
            }
            Show(Locale.T(result.Message ?? "cm.donationAdded"));
            Nav.NavigateTo("/committee/donations");
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private int PaidPct()
    {
        if (amount <= 0) return paidAmount > 0 ? 100 : 0;
        return (int)Math.Clamp(Math.Round(paidAmount / amount * 100m), 0m, 100m);
    }
    private static string Tk(decimal value) => value.ToString("N2");
    private static string Initial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return string.Concat(parts[0].AsSpan(0, 1), parts[^1].AsSpan(0, 1)).ToUpperInvariant();
    }
    private void Show(string value, bool err = false) { popupText = value; popupError = err; }
    private void ClosePopup() => popupText = "";
    private string FormatErr(CommitteeResult result) =>
        string.IsNullOrWhiteSpace(result.Error) ? Locale.T("cm.fail")
        : result.Error.StartsWith("cm.", StringComparison.OrdinalIgnoreCase) ? Locale.T(result.Error) : result.Error;
    private async Task SetBusyAsync(string title) { busyTitle = title; busy = true; await InvokeAsync(StateHasChanged); await Task.Delay(40); }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
