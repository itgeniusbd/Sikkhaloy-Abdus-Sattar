@page "/attendance/schedule"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page students-card att-schedule-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("att.scheduleHint")</p>
            <h1>@Locale.T("att.schedule")</h1>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText) && confirmDeleteId is null)
    {
        <NetBanner Text="@error" />
    }

    <section class="asch-create no-print">
        <div class="asch-create-fields">
            <label class="asch-field is-name">
                <span>@Locale.T("att.scheduleName")</span>
                <input type="text" placeholder="@Locale.T("att.scheduleName")" @bind="newName" disabled="@busy" />
            </label>
            <label class="asch-field is-time">
                <span>@Locale.T("att.start")</span>
                <input type="time" value="@newStart" disabled="@busy"
                       @onchange="e => newStart = e.Value?.ToString() ?? newStart" />
            </label>
            <label class="asch-field is-time">
                <span>@Locale.T("att.late")</span>
                <input type="time" value="@newLate" disabled="@busy"
                       @onchange="e => newLate = e.Value?.ToString() ?? newLate" />
            </label>
            <label class="asch-field is-time">
                <span>@Locale.T("att.end")</span>
                <input type="time" value="@newEnd" disabled="@busy"
                       @onchange="e => newEnd = e.Value?.ToString() ?? newEnd" />
            </label>
        </div>
        <button type="button" class="asch-btn asch-btn-primary" disabled="@busy" @onclick="AddAsync">
            @Locale.T("att.addSchedule")
        </button>
    </section>

    @if (schedules.Count == 0 && !busy)
    {
        <p class="asch-empty">@Locale.T("att.empty")</p>
    }

    <div class="asch-list">
    @foreach (var item in schedules)
    {
        <article class="asch-card" @key="item.ScheduleID">
            <header class="asch-card-head no-print">
                <label class="asch-field is-name">
                    <span>@Locale.T("att.scheduleName")</span>
                    <input type="text" @bind="item.ScheduleName" disabled="@busy" />
                </label>
                <div class="asch-card-actions">
                    <button type="button" class="asch-btn asch-btn-primary" disabled="@busy"
                            @onclick="() => SaveDaysAsync(item)">@Locale.T("att.saveDays")</button>
                    <button type="button" class="asch-btn asch-btn-ghost" disabled="@busy"
                            @onclick="() => RenameAsync(item)">@Locale.T("att.rename")</button>
                    <button type="button" class="asch-btn asch-btn-danger" disabled="@busy"
                            @onclick="() => AskDelete(item)">@Locale.T("si.delete")</button>
                </div>
            </header>
            <div class="asch-table-wrap">
                <table class="asch-day-table">
                    <thead>
                        <tr>
                            <th class="col-day">@Locale.T("att.days")</th>
                            <th class="col-on">@Locale.T("att.onDay")</th>
                            <th>@Locale.T("att.start")</th>
                            <th>@Locale.T("att.late")</th>
                            <th>@Locale.T("att.end")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var day in item.Days)
                    {
                        <tr class="@(day.IsOnDay ? "is-on" : "is-off")">
                            <td class="col-day">@Locale.T($"cal.day.{day.Day}")</td>
                            <td class="col-on">
                                <label class="asch-check">
                                    <input type="checkbox" @bind="day.IsOnDay" disabled="@busy" />
                                    <span class="asch-on-label">@Locale.T("att.onDay")</span>
                                </label>
                            </td>
                            <td data-label="@Locale.T("att.start")">
                                <input type="time" value="@day.StartTime" disabled="@busy || !day.IsOnDay"
                                       @onchange="e => day.StartTime = e.Value?.ToString() ?? day.StartTime" />
                            </td>
                            <td data-label="@Locale.T("att.late")">
                                <input type="time" value="@day.LateEntryTime" disabled="@busy || !day.IsOnDay"
                                       @onchange="e => day.LateEntryTime = e.Value?.ToString() ?? day.LateEntryTime" />
                            </td>
                            <td data-label="@Locale.T("att.end")">
                                <input type="time" value="@day.EndTime" disabled="@busy || !day.IsOnDay"
                                       @onchange="e => day.EndTime = e.Value?.ToString() ?? day.EndTime" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
    }
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (confirmDeleteId is int delId)
{
    <div class="acc-result-back" @onclick="() => confirmDeleteId = null">
        <div class="acc-result is-ok" @onclick:stopPropagation="true">
            <div class="acc-result-icon">!</div>
            <h3>@Locale.T("si.delete")</h3>
            <p>@Locale.T("att.deleteConfirm")</p>
            <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="() => DeleteAsync(delId)">@Locale.T("si.delete")</button>
            <button type="button" class="acc-btn acc-btn-ghost" disabled="@busy" @onclick="() => confirmDeleteId = null">@Locale.T("cls.cancel")</button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private readonly List<AttendanceScheduleDto> schedules = [];
    private string newName = "";
    private string newStart = "08:00";
    private string newLate = "08:15";
    private string newEnd = "14:00";
    private string busyTitle = "";
    private string popupText = "";
    private bool busy;
    private bool popupError;
    private int? confirmDeleteId;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await SetBusyAsync("si.loading");
        try
        {
            await LoadCoreAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadCoreAsync()
    {
        if (!await EnsureOnlineAsync())
            return;
        schedules.Clear();
        schedules.AddRange(await Api.GetAttendanceSchedulesAsync(Session.AccessToken!));
        foreach (var item in schedules)
        {
            item.StartTime = Time(item.StartTime);
            item.LateEntryTime = Time(item.LateEntryTime);
            item.EndTime = Time(item.EndTime);
            foreach (var day in item.Days)
            {
                day.StartTime = Time(day.StartTime);
                day.LateEntryTime = Time(day.LateEntryTime);
                day.EndTime = Time(day.EndTime);
            }
        }
    }

    private Task AddAsync() => RunAsync(() =>
    {
        if (string.IsNullOrWhiteSpace(newName))
            return Task.FromResult(new AttendanceResult { Succeeded = false, Error = "att.scheduleName" });
        return Api.CreateAttendanceScheduleAsync(Session.AccessToken!, new SaveScheduleRequest
        {
            ScheduleName = newName.Trim(),
            StartTime = newStart,
            LateEntryTime = newLate,
            EndTime = newEnd
        });
    }, () => newName = "");

    private Task RenameAsync(AttendanceScheduleDto item) => RunAsync(() =>
        Api.RenameAttendanceScheduleAsync(Session.AccessToken!, item.ScheduleID, new SaveScheduleRequest
        {
            ScheduleName = item.ScheduleName
        }));

    private void AskDelete(AttendanceScheduleDto item) => confirmDeleteId = item.ScheduleID;

    private async Task DeleteAsync(int scheduleId)
    {
        confirmDeleteId = null;
        await RunAsync(() => Api.DeleteAttendanceScheduleAsync(Session.AccessToken!, scheduleId));
    }

    private Task SaveDaysAsync(AttendanceScheduleDto item) => RunAsync(() =>
        Api.SaveAttendanceScheduleDaysAsync(Session.AccessToken!, new SaveScheduleDaysRequest
        {
            ScheduleID = item.ScheduleID,
            Days = item.Days
        }));

    private async Task RunAsync(Func<Task<AttendanceResult>> action, Action? onOk = null)
    {
        error = null;
        popupText = "";
        await SetBusyAsync("si.saving");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            var result = await action();
            if (!result.Succeeded)
            {
                Show(Locale.T(result.Error ?? "att.failed"), true);
                return;
            }
            onOk?.Invoke();
            var ok = Locale.T("att.updated");
            await LoadCoreAsync();
            Show(ok, false);
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
        error = isError ? text : null;
    }

    private void ClosePopup()
    {
        popupText = "";
        error = null;
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }

    private static string Time(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        return value.Length >= 5 ? value[..5] : value;
    }
}
