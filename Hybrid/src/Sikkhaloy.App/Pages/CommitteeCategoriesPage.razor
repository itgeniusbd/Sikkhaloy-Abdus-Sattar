@page "/committee/categories"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page committee-page sms-mod cm-dons-page cm-cat-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">Committee / @Locale.T("cm.categories")</p>
            <h1>@Locale.T("cm.categories")</h1>
            <p class="cm-dons-lead">@Locale.T("cm.categoriesSub")</p>
        </div>
    </header>

    <div class="cm-cat-add no-print">
        <label>
            <span>@Locale.T("cm.categoryName")</span>
            <input type="text" placeholder="@Locale.T("cm.categoryName")" @bind="name" disabled="@busy" @onkeydown="OnAddKey" />
        </label>
        <button type="button" class="cm-act cm-act-success" disabled="@busy" @onclick="SaveAsync">@Locale.T("cm.addCategory")</button>
    </div>

    <div class="cm-dons-table">
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("cm.categoryName")</th>
                    <th>@Locale.T("cm.createDate")</th>
                    <th class="no-print">@Locale.T("sms.tplActions")</th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0)
            {
                <tr><td colspan="3" class="empty-row">@Locale.T("cm.emptyCategories")</td></tr>
            }
            @foreach (var row in rows)
            {
                <tr>
                    <td>
                        @if (editId == row.CommitteeDonationCategoryId)
                        {
                            <input type="text" class="cm-cat-edit" @bind="editName" disabled="@busy" />
                        }
                        else
                        {
                            <strong>@row.DonationCategory</strong>
                        }
                    </td>
                    <td>@(row.InsertDate?.ToString("d MMM yyyy"))</td>
                    <td class="no-print cm-dons-acts">
                        @if (editId == row.CommitteeDonationCategoryId)
                        {
                            <button type="button" class="sms-tpl-act" disabled="@busy" @onclick="UpdateAsync">@Locale.T("cm.update")</button>
                            <button type="button" class="sms-tpl-ghost" @onclick="() => editId = 0">@Locale.T("cm.cancel")</button>
                        }
                        else
                        {
                            <button type="button" class="sms-tpl-act" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("cm.edit")</button>
                            <button type="button" class="sms-tpl-act is-danger" disabled="@busy" @onclick="() => DeleteAsync(row)">@Locale.T("cm.delete")</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (rows.Count > 0)
        {
            <footer class="cm-dons-pager">
                <span>@Locale.T("cm.showingRange", 1, rows.Count, rows.Count)</span>
            </footer>
        }
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("exam.pleaseWait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private readonly List<DonationCategoryDto> rows = [];
    private string name = "", editName = "", busyTitle = "", popupText = "";
    private int editId;
    private bool busy, popupError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await SetBusyAsync(Locale.T("cm.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            rows.Clear();
            rows.AddRange(await Api.GetDonationCategoriesAsync(Session.AccessToken!));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveAsync();
    }

    private async Task SaveAsync()
    {
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            var result = await Api.SaveDonationCategoryAsync(Session.AccessToken!, new SaveDonationCategoryRequest { Name = name });
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            name = "";
            await LoadAsync();
            Show(Locale.T(result.Message ?? "cm.categoryAdded"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void StartEdit(DonationCategoryDto row)
    {
        editId = row.CommitteeDonationCategoryId;
        editName = row.DonationCategory;
    }

    private async Task UpdateAsync()
    {
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            var result = await Api.SaveDonationCategoryAsync(Session.AccessToken!, new SaveDonationCategoryRequest
            {
                CommitteeDonationCategoryId = editId,
                Name = editName
            });
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            editId = 0;
            await LoadAsync();
            Show(Locale.T(result.Message ?? "cm.categoryUpdated"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task DeleteAsync(DonationCategoryDto row)
    {
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            var result = await Api.DeleteDonationCategoryAsync(Session.AccessToken!, row.CommitteeDonationCategoryId);
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            await LoadAsync();
            Show(Locale.T(result.Message ?? "cm.categoryDeleted"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void Show(string value, bool err = false) { popupText = value; popupError = err; }
    private void ClosePopup() => popupText = "";
    private string FormatErr(CommitteeResult result) =>
        string.IsNullOrWhiteSpace(result.Error) ? Locale.T("cm.fail")
        : result.Error.StartsWith("cm.", StringComparison.OrdinalIgnoreCase) ? Locale.T(result.Error) : result.Error;
    private async Task SetBusyAsync(string title) { busyTitle = title; busy = true; await InvokeAsync(StateHasChanged); await Task.Delay(40); }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
