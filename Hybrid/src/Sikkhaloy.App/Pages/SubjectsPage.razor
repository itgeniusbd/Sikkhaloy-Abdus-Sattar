@page "/basic-settings/subjects"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card sa-page sj-page">
    <header class="sa-head sj-head">
        <div>
            <p class="sa-kicker">@Locale.T("subj.kicker")</p>
            <h1>@Locale.T("subj.title")</h1>
        </div>
        <a class="btn-ghost" href="/basic-settings/assign-subjects">@Locale.T("asgn.title")</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <NetBanner Text="@error" />
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok">@message</div>
    }

    <div class="sj-add">
        <input type="text" placeholder="@Locale.T("subj.placeholder")" @bind="newName" @onkeydown="OnAddKey" disabled="@busy" />
        <button type="button" class="btn-primary" disabled="@busy" @onclick="AddAsync">@Locale.T("subj.add")</button>
    </div>

    <div class="sj-grid">
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("subj.list")</th>
                    <th>@Locale.T("subj.serial")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0 && !busy && string.IsNullOrWhiteSpace(error))
            {
                <tr><td colspan="3" class="empty-row">@Locale.T("subj.empty")</td></tr>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <tr>
                        <td>
                            @if (editingId == row.SubjectID)
                            {
                                <input type="text" @bind="editName" disabled="@busy" />
                            }
                            else
                            {
                                @row.SubjectName
                            }
                        </td>
                        <td>
                            <input class="sn-input" value="@SerialOf(row)" disabled="@busy"
                                   @onchange="e => SetSerial(row.SubjectID, e.Value?.ToString())" />
                        </td>
                        <td class="act">
                            @if (editingId == row.SubjectID)
                            {
                                <button type="button" class="cls-act cls-act-save" disabled="@busy" @onclick="() => SaveEditAsync(row)">@Locale.T("subj.update")</button>
                                <button type="button" class="cls-act cls-act-cancel" disabled="@busy" @onclick="CancelEdit">@Locale.T("subj.cancel")</button>
                            }
                            else
                            {
                                <button type="button" class="cls-act cls-act-edit" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("subj.edit")</button>
                                <button type="button" class="cls-act cls-act-del" disabled="@busy" @onclick="() => DeleteAsync(row)">@Locale.T("subj.delete")</button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (rows.Count > 0)
    {
        <div class="sj-foot">
            <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveSerialsAsync">@Locale.T("subj.updateSerial")</button>
        </div>
    }
</div>

@code {
    private readonly List<SubjectDto> rows = [];
    private readonly Dictionary<int, string> serials = [];
    private string newName = "";
    private string editName = "";
    private int editingId;
    private bool busy;
    private string? error;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
            {
                error = Locale.T("subj.needOnline");
                return;
            }

            rows.Clear();
            rows.AddRange(await Api.GetSubjectsAsync(Session.AccessToken));
            serials.Clear();
            foreach (var row in rows)
                serials[row.SubjectID] = row.SN?.ToString() ?? "";
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddAsync();
    }

    private async Task AddAsync()
    {
        message = null;
        error = null;
        if (string.IsNullOrWhiteSpace(newName))
        {
            error = Locale.T("subj.required");
            return;
        }

        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.CreateSubjectAsync(Session.AccessToken, new SaveSubjectRequest
            {
                SubjectName = newName.Trim()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            newName = "";
            message = Locale.T("subj.added");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void StartEdit(SubjectDto row)
    {
        editingId = row.SubjectID;
        editName = row.SubjectName;
        message = null;
        error = null;
    }

    private void CancelEdit()
    {
        editingId = 0;
        editName = "";
    }

    private async Task SaveEditAsync(SubjectDto row)
    {
        message = null;
        error = null;
        if (string.IsNullOrWhiteSpace(editName))
        {
            error = Locale.T("subj.required");
            return;
        }

        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.UpdateSubjectAsync(Session.AccessToken, row.SubjectID, new SaveSubjectRequest
            {
                SubjectName = editName.Trim()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            CancelEdit();
            message = Locale.T("subj.updated");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(SubjectDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("subj.deleteConfirm")))
            return;

        message = null;
        error = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.DeleteSubjectAsync(Session.AccessToken, row.SubjectID);
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            if (editingId == row.SubjectID)
                CancelEdit();
            message = Locale.T("subj.deleted");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveSerialsAsync()
    {
        message = null;
        error = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.SaveSubjectSerialsAsync(Session.AccessToken, new SaveSubjectSerialsRequest
            {
                Items = rows.Select(x => new SubjectSerialItem
                {
                    SubjectID = x.SubjectID,
                    SN = ParseSerial(SerialOf(x))
                }).ToList()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            message = Locale.T("subj.serialUpdated");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private string SerialOf(SubjectDto row) =>
        serials.TryGetValue(row.SubjectID, out var value) ? value : row.SN?.ToString() ?? "";

    private void SetSerial(int subjectId, string? value) => serials[subjectId] = value ?? "";

    private static int? ParseSerial(string value) =>
        int.TryParse(value.Trim(), out var sn) ? sn : null;

    private string Translate(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return Locale.T("subj.failed");
        return Locale.T(key);
    }
}
