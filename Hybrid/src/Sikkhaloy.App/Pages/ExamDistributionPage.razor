@page "/exam/distribution"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page">
    <h1>@Locale.T("exam.distTitle")</h1>
    <button type="button" class="acc-btn no-print" disabled="@busy" @onclick="OpenCopy">@Locale.T("exam.copyPrev")</button>
    <div class="filter-row no-print">
        <label>@Locale.T("exam.class")
            <select @bind="classId" @bind:after="LoadSheetAsync" disabled="@busy">
                <option value="0">@Locale.T("si.selectClass")</option>
                @foreach (var item in filters.Classes)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </label>
        <label>@Locale.T("exam.exam")
            <select @bind="examId" @bind:after="LoadSheetAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.selectExam")</option>
                @foreach (var item in filters.Exams)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </label>
        @if (sheet.Subjects.Count > 0)
        {
            <label>@Locale.T("exam.gradingSys")
                <select @bind="gradeId" disabled="@busy">
                    @foreach (var item in sheet.Grades)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </label>
        }
    </div>

    @if (sheet.Subjects.Count > 0)
    {
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("exam.subjects")</th>
                    <th>@ExamLabel</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var subject in sheet.Subjects)
            {
                <tr>
                    <td>@subject.SubjectName</td>
                    <td>
                        <div class="inline-add">
                            <input type="number" step="0.01" placeholder="@Locale.T("exam.examFm")" @bind="subject.FullMarks" disabled="@(busy || subject.UseSubExam)" />
                            <label class="choice-inline">
                                <input type="checkbox" @bind="subject.UseSubExam" disabled="@busy" />
                                <span>@Locale.T("exam.useSub")</span>
                            </label>
                        </div>
                        @if (subject.UseSubExam)
                        {
                            @if (subject.SubExams.Count == 0)
                            {
                                <p>@Locale.T("exam.noSubCreated") <a href="exam/sub-exams">@Locale.T("exam.createSub")</a></p>
                            }
                            else
                            {
                                <table class="mgrid">
                                    <thead><tr><th>@Locale.T("exam.subExam")</th><th>@Locale.T("exam.fullMark")</th></tr></thead>
                                    <tbody>
                                    @foreach (var sub in subject.SubExams)
                                    {
                                        <tr>
                                            <td>
                                                <label class="choice-inline">
                                                    <input type="checkbox" @bind="sub.Selected" disabled="@busy" />
                                                    <span>@sub.SubExamName</span>
                                                </label>
                                            </td>
                                            <td><input type="number" step="0.01" placeholder="@Locale.T("exam.subFm")" @bind="sub.FullMarks" disabled="@(busy || !sub.Selected)" /></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <p class="exam-hint">@Locale.T("exam.distWarn")</p>
        <button type="button" class="acc-btn acc-btn-primary no-print" disabled="@busy" @onclick="SaveAsync">@Locale.T("acc.submit")</button>
    }
</div>

@if (showCopy)
{
    <div class="acc-result-back" @onclick="() => showCopy = false">
        <div class="acc-result is-ok" style="text-align:left; max-width:420px;" @onclick:stopPropagation="true">
            <h3>@Locale.T("exam.copyPrev")</h3>
            <div class="inline-add" style="display:grid; gap:0.55rem;">
                <label>@Locale.T("exam.class")
                    <select @bind="copyClassId" @bind:after="LoadCopyAsync" disabled="@busy">
                        <option value="0">@Locale.T("si.selectClass")</option>
                        @foreach (var item in copyFilters.Classes)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <label>@Locale.T("exam.copyFrom")
                    <select @bind="fromExamId" disabled="@busy">
                        <option value="0">@Locale.T("exam.selectExam")</option>
                        @foreach (var item in copyFilters.Exams)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <label>@Locale.T("exam.copyTo")
                    <select @bind="toExamId" disabled="@busy">
                        <option value="0">@Locale.T("exam.selectExam")</option>
                        @foreach (var item in copyFilters.CopyToExams)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </label>
                <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="CopyAsync">@Locale.T("acc.submit")</button>
            </div>
        </div>
    </div>
}

@if (busy)
{
    <div class="acc-loading-back">
        <div class="acc-loading">
            <div class="acc-spinner"></div>
            <p>@Locale.T("acc.loading")</p>
            <div class="acc-prog-track"><div class="acc-prog-fill is-run"></div></div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="exam.failed" OnClose="ClosePopup" />
}

@code {
    private ExamFilterDto filters = new();
    private ExamFilterDto copyFilters = new();
    private DistSheetDto sheet = new();
    private int classId, examId, gradeId, copyClassId, fromExamId, toExamId;
    private bool busy, popupError, showCopy;
    private string? popupText;
    private string ExamLabel => filters.Exams.FirstOrDefault(x => x.Id == examId)?.Name ?? Locale.T("exam.exam");

    protected override Task OnInitializedAsync() => LoadFiltersAsync();

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "distribution"); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task LoadSheetAsync()
    {
        sheet = new();
        gradeId = 0;
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            sheet = await Api.GetExamDistributionAsync(Session.AccessToken!, classId, examId);
            gradeId = sheet.GradeNameID > 0 ? sheet.GradeNameID : sheet.Grades.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            var result = await Api.SaveExamDistributionAsync(Session.AccessToken!, new SaveDistributionRequest
            {
                ClassID = classId, ExamID = examId, GradeNameID = gradeId, Subjects = sheet.Subjects
            });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            Show(Locale.T(result.Queued ? "sync.savedOffline" : "exam.saved"));
            await LoadSheetAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task OpenCopy()
    {
        showCopy = true;
        copyClassId = classId;
        fromExamId = toExamId = 0;
        await LoadCopyAsync();
    }

    private async Task LoadCopyAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { copyFilters = await Api.GetExamFiltersAsync(Session.AccessToken!, "copy", copyClassId); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task CopyAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            var result = await Api.CopyExamDistributionAsync(Session.AccessToken!, new CopyDistributionRequest
            {
                ClassID = copyClassId, FromExamID = fromExamId, ToExamID = toExamId
            });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            showCopy = false;
            Show(Locale.T("exam.saved"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private string Err(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("exam.failed") : Locale.T(key);

    private void Show(string text, bool err = false) { popupText = text; popupError = err; }
    private void ClosePopup() => popupText = null;
    private Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Show(Locale.T("subj.needOnline"), true);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }
}
