@page "/"
@layout LandingLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@using System.Globalization

<section class="dc-hero" id="home">
    <span class="shape sh1"></span>
    <span class="shape sh2"></span>
    <span class="shape sh3"><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg></span>
    <span class="shape sh4"></span>
    <span class="shape sh5"></span>
    <div class="container hero-grid">
        <div>
            <span class="h-badge" data-reveal="zoom"><span class="dotg"></span> @Locale.T("home.tag") <span class="fire">@FireIcon</span></span>
            <h1 data-reveal="up">@Locale.T("home.title.prefix") <span class="rotator"><span class="rot-word @(_rotSwap ? "swap" : null)">@RotWord</span></span></h1>
            <p class="lead" data-reveal="up" data-delay="1">@Locale.T("home.lead")</p>
            <div class="mini-pills" data-reveal="up" data-delay="2">
                <span class="mp-g">✓ @Locale.T("home.hero.pill1")</span>
                <span class="mp-r">✓ @Locale.T("home.hero.pill2")</span>
                <span class="mp-k">✓ @Locale.T("home.hero.pill3")</span>
            </div>
            <div class="hero-btns" data-reveal="up" data-delay="3">
                @if (Session.IsAuthenticated)
                {
                    <a href="@Session.HomeHref" class="pill pill-green">@Locale.T("home.goDashboard") @ArrowIcon</a>
                }
                else
                {
                    <a href="#features" class="pill pill-green">@Locale.T("home.seeMore") @ArrowIcon</a>
                }
                <a href="#contact" class="pill pill-white">@PhoneIcon @Locale.T("home.nav.contact")</a>
            </div>
            <div class="hero-trust" data-reveal="up" data-delay="4">
                <div class="ava"><span class="a1">স্কু</span><span class="a2">মা</span><span class="a3">কো</span></div>
                <p><span class="stars">★★★★★</span><br><b>@Locale.T("home.hero.trust")</b></p>
            </div>
        </div>
        <div class="mock-zone" data-reveal="right">
            <div class="hero-orbit">
                <span class="hero-art-disk" aria-hidden="true"></span>
                <span class="mock-ring" aria-hidden="true"></span>
                <div class="hero-art-wrap" @ref="_mockWrap">
                    <img class="hero-art" src="_content/Sikkhaloy.App/img/hero-desk.png?v=2" alt="" />
                </div>
            </div>
            <div class="f-chip fc1">
                <span class="f-ic" style="background:linear-gradient(135deg,#15803d,#34d399)">@FeeIcon</span>
                <span>@Locale.T("home.hero.rfid")<small>@Locale.T("home.hero.rfid.sub")</small></span>
            </div>
            <div class="f-chip fc2">
                <span class="f-ic" style="background:linear-gradient(135deg,#be123c,#fb7185)">@ChatIcon</span>
                <span>@Locale.T("home.hero.autosms")<small>@Locale.T("home.hero.autosms.sub")</small></span>
            </div>
            <div class="f-chip fc3">
                <span class="f-ic" style="background:linear-gradient(135deg,#0f172a,#475569)">@SyncIcon</span>
                <span>@Locale.T("home.hero.offsync")<small>@Locale.T("home.hero.offsync.sub")</small></span>
            </div>
        </div>
    </div>
</section>

<div class="ribbons" aria-hidden="true">
    <div class="ribbon rb-green">
        <div class="ribbon-in">
            @for (var i = 0; i < 2; i++)
            {
                <span>✦ @Locale.T("home.rib.rfid") <i>•</i></span><span>@Locale.T("home.rib.bio") <i>•</i></span><span>@Locale.T("home.rib.sms") <i>•</i></span><span>@Locale.T("home.rib.fee") <i>•</i></span><span>@Locale.T("home.rib.exam") <i>•</i></span><span>@Locale.T("home.rib.sync") <i>•</i></span>
            }
        </div>
    </div>
    <div class="ribbon rb-dark rev">
        <div class="ribbon-in">
            @for (var i = 0; i < 2; i++)
            {
                <span>@Locale.T("home.rib.school") <b>✦</b></span><span>@Locale.T("home.rib.college") <b>✦</b></span><span>@Locale.T("home.rib.madrasa") <b>✦</b></span><span>@Locale.T("home.rib.coaching") <b>✦</b></span><span>@Fmt(_targetInst)+ @Locale.T("home.stat.inst") <b>✦</b></span>
            }
        </div>
    </div>
</div>

<div class="stats">
    <div class="container">
        <div class="stats-strip">
            <div class="stat" data-reveal="up">
                <span class="stat-ic">@SchoolIcon</span>
                <div class="stat-num">@Fmt(_shownInst)+</div>
                <div class="stat-lbl">@Locale.T("home.stat.inst")</div>
                <div class="stat-sub">@Locale.T("home.stat.inst.desc")</div>
            </div>
            <div class="stat" data-reveal="up" data-delay="2">
                <span class="stat-ic">@CapIcon</span>
                <div class="stat-num">@Fmt(_shownStu)+</div>
                <div class="stat-lbl">@Locale.T("home.stat.stu")</div>
                <div class="stat-sub">@Locale.T("home.stat.stu.desc")</div>
            </div>
            <div class="stat" data-reveal="up" data-delay="3">
                <span class="stat-ic">@StaffIcon</span>
                <div class="stat-num">@Fmt(_shownTea)+</div>
                <div class="stat-lbl">@Locale.T("home.stat.tea")</div>
                <div class="stat-sub">@Locale.T("home.stat.tea.desc")</div>
            </div>
        </div>
    </div>
</div>

<section class="why" id="why">
    <div class="container">
        <div class="sec-head" data-reveal="up">
            <span class="kick kick-g">✦ @Locale.T("home.why.kick")</span>
            <h2>@Locale.T("home.why.head") <em>@Locale.T("home.why.em")</em></h2>
        </div>
        <div class="why-list">
            @foreach (var note in WhyNotes)
            {
                <div class="why-item" data-reveal="up" data-delay="@note.Delay">
                    <span class="why-ic @note.Tone">@note.Icon</span>
                    <span class="why-n">@Ord(note.N)</span>
                    <h3>@Locale.T(note.Title)</h3>
                    <p>@Locale.T(note.Desc)</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="bento-sec" id="features">
    <div class="container">
        <div class="sec-head" data-reveal="up">
            <span class="kick kick-r">◆ @Locale.T("home.feat.kick")</span>
            <h2>@Locale.T("home.feat.head") <em>@Locale.T("home.feat.em")</em></h2>
            <p>@Locale.T("home.feat.intro")</p>
        </div>
        <div class="fgrid">
            @foreach (var feat in Feats)
            {
                <div class="fcard @feat.Color @(_flipped.Contains(feat.N) ? "flip" : null)" data-reveal="zoom" data-delay="@feat.Delay" @onclick="() => Flip(feat.N)">
                    <div class="finner">
                        <div class="fface ffront">
                            <span class="fnum">@Ord(feat.N)</span>
                            <span class="fic">@feat.Icon</span>
                            <h3>@Locale.T(feat.Title)</h3>
                            <p>@Locale.T(feat.Lead)</p>
                            <span class="fhint">@SyncIcon @Locale.T("home.feat.flip")</span>
                        </div>
                        <div class="fface fback">
                            <h3>@feat.Icon @Locale.T(feat.Title)</h3>
                            <ul>
                                @foreach (var item in feat.Items)
                                {
                                    <li><span class="ck2">@CheckIcon</span>@Locale.T(item)</li>
                                }
                            </ul>
                            <button type="button" class="flink" @onclick="() => OpenContact(Locale.T(feat.Title))" @onclick:stopPropagation="true">@Locale.T("home.details") <span>→</span></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="tabs-sec" id="solutions">
    <div class="container">
        <div class="sec-head" data-reveal="up">
            <span class="kick kick-k">⇄ @Locale.T("home.off.kick")</span>
            <h2>@Locale.T("home.off.head") <em class="red">@Locale.T("home.off.em")</em></h2>
            <div style="margin-top:18px">
                <span class="sync-note">@SyncIcon @Locale.T("home.off.syncNote")</span>
            </div>
        </div>
        <div class="tabbar" data-reveal="up">
            @foreach (var tab in OffTabs)
            {
                <button type="button" class="tab-btn @(_tab == tab.I ? "on" : null)" @onclick="() => _tab = tab.I">
                    <span class="tb-ic" style="@tab.Bg">@tab.Icon</span>@Locale.T(tab.Title)
                </button>
            }
        </div>
        <div class="tab-panels">
            @foreach (var tab in OffTabs)
            {
                <div class="tab-panel @(_tab == tab.I ? "on" : null)">
                    <div class="tp-info">
                        <h3 style="@tab.Color">@Locale.T(tab.Title)</h3>
                        <p>@Locale.T(tab.Desc)</p>
                        <ul class="tp-list">
                            <li><span class="ck @tab.Ck">@CheckIcon</span>@Locale.T(tab.A)</li>
                            <li><span class="ck @tab.Ck">@CheckIcon</span>@Locale.T(tab.B)</li>
                            <li><span class="ck @tab.Ck">@CheckIcon</span>@Locale.T(tab.C)</li>
                        </ul>
                    </div>
                    <div class="sync-art">
                        <span class="sync-orb"></span>
                        @tab.Art
                        <span class="sync-badge sb1">@tab.Badge1</span>
                        <span class="sync-badge sb2">@tab.Badge2</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (_clients.Count > 0)
{
    <section class="cust-sec" id="customers">
        <div class="container">
            <div class="sec-head" data-reveal="up" style="margin-bottom:36px">
                <span class="kick kick-g">✦ @Locale.T("home.clients.kick")</span>
                <h2>@Locale.T("home.clients.head") <em>@Locale.T("home.clients.em")</em></h2>
                <p>@Locale.T("home.clients.sub")</p>
            </div>
        </div>
        <div class="cust-wrap" data-reveal="up">
            <div class="cust-track">
                @foreach (var (item, index) in SlideItems.Select((x, i) => (x, i)))
                {
                    <div class="chip-cust">
                        @if (item.HasLogo && !string.IsNullOrWhiteSpace(item.LogoUrl) && !_brokenLogos.Contains(item.SchoolID))
                        {
                            <img class="cc-logo" src="@item.LogoUrl" alt="" @onerror="() => MarkBroken(item.SchoolID)" />
                        }
                        else
                        {
                            <span class="cc-logo @Tone(index)">@Initials(item.SchoolName)</span>
                        }
                        <span class="cchip-name"><b>@item.SchoolName</b></span>
                    </div>
                }
            </div>
        </div>
        <div class="cust-wrap" data-reveal="up" data-delay="1">
            <div class="cust-track rev">
                @foreach (var (item, index) in SlideItems.Reverse().Select((x, i) => (x, i)))
                {
                    <div class="chip-cust">
                        @if (item.HasLogo && !string.IsNullOrWhiteSpace(item.LogoUrl) && !_brokenLogos.Contains(item.SchoolID))
                        {
                            <img class="cc-logo" src="@item.LogoUrl" alt="" @onerror="() => MarkBroken(item.SchoolID)" />
                        }
                        else
                        {
                            <span class="cc-logo @Tone(index + 1)">@Initials(item.SchoolName)</span>
                        }
                        <span class="cchip-name"><b>@item.SchoolName</b></span>
                    </div>
                }
                <div class="chip-cust">
                    <span class="cc-logo cct">+</span>
                    <span class="cchip-name"><b>@Locale.T("home.clients.join")</b><small>@Locale.T("home.clients.next")</small></span>
                </div>
            </div>
        </div>
    </section>
}

<section class="cta-sec">
    <div class="container">
        <div class="cta-in" data-reveal="up">
            <h2>@Locale.T("home.cta.head") <em>@Locale.T("home.cta.em")</em></h2>
            <p>@Locale.T("home.trusted")</p>
            <div class="cta-btns">
                <button type="button" class="pill pill-green" @onclick="@(() => OpenContact(Locale.T("home.cta.title")))">@Locale.T("home.cta.details") @ArrowIcon</button>
                <a href="tel:09638669966" class="pill pill-white">@PhoneIcon 09638 66 99 66</a>
            </div>
        </div>
    </div>
</section>

@if (_showContact)
{
    <div class="modal-back land-pop dc-pop" @onclick="CloseContact">
        <div class="modal-panel land-pop-panel" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="dc-pop-title">
            <button type="button" class="land-pop-x" @onclick="CloseContact" aria-label="@Locale.T("home.pop.close")">×</button>
            <aside class="land-pop-banner">
                <p class="land-pop-kicker">@Locale.T("home.contact.org")</p>
                <h2 id="dc-pop-title">@Locale.T("home.contact.title")</h2>
                <p class="land-pop-hours"><span>@HeadIcon</span> @Locale.T("home.pop.hours")</p>
                <p class="land-pop-direct">@Locale.T("home.pop.direct")</p>
                <div class="land-pop-cards">
                    <a class="land-pop-card" href="tel:09638669966">
                        <span class="land-pop-ico is-teal">@PhoneIcon</span>
                        <span class="land-pop-card-txt">
                            <small>@Locale.T("home.pop.office")</small>
                            <b>09638 66 99 66</b>
                        </span>
                        <span class="land-pop-act">@Locale.T("home.pop.call")</span>
                    </a>
                    <a class="land-pop-card" href="tel:+8801739144141">
                        <span class="land-pop-ico is-blue">@MobileIcon</span>
                        <span class="land-pop-card-txt">
                            <small>@Locale.T("home.pop.mobile")</small>
                            <b>01739 144 141</b>
                        </span>
                        <span class="land-pop-act">@Locale.T("home.pop.callMobile")</span>
                    </a>
                    <a class="land-pop-card" href="https://wa.me/8801739144141" target="_blank" rel="noopener">
                        <span class="land-pop-ico is-green">@ChatIcon</span>
                        <span class="land-pop-card-txt">
                            <small>@Locale.T("home.pop.whatsapp")</small>
                            <b>01739 144 141</b>
                        </span>
                        <span class="land-pop-act is-wa">@Locale.T("home.pop.chat")</span>
                    </a>
                </div>
            </aside>
            <form class="land-pop-form" @onsubmit="SendContactAsync" @onsubmit:preventDefault="true">
                <h3>@Locale.T("home.pop.form")</h3>
                <p class="land-pop-lead">@Locale.T("home.pop.formLead")</p>
                <div class="land-pop-grid">
                    <label>
                        <span>@Locale.T("home.pop.name")</span>
                        <span class="land-pop-in">
                            <i>@PersonIcon</i>
                            <input type="text" maxlength="120" autocomplete="name" placeholder="@Locale.T("home.pop.name")" @bind="_popName" />
                        </span>
                    </label>
                    <label>
                        <span>@Locale.T("home.pop.phone")</span>
                        <span class="land-pop-in">
                            <i>@MobileIcon</i>
                            <input type="tel" maxlength="30" autocomplete="tel" placeholder="@Locale.T("home.pop.phone")" @bind="_popMobile" />
                        </span>
                    </label>
                    <label>
                        <span>@Locale.T("home.pop.email")</span>
                        <span class="land-pop-in">
                            <i>@MailIcon</i>
                            <input type="email" maxlength="120" autocomplete="email" placeholder="@Locale.T("home.pop.email")" @bind="_popEmail" />
                        </span>
                    </label>
                    <label>
                        <span>@Locale.T("home.pop.subject")</span>
                        <span class="land-pop-in">
                            <i>@PaperIcon</i>
                            <input type="text" maxlength="200" placeholder="@Locale.T("home.pop.subject")" @bind="_popSubject" />
                        </span>
                    </label>
                    <label class="land-pop-full">
                        <span>@Locale.T("home.pop.msg")</span>
                        <span class="land-pop-in is-area">
                            <textarea rows="4" maxlength="4000" placeholder="@Locale.T("home.pop.msg")" @bind="_popMessage"></textarea>
                        </span>
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(_popStatus))
                {
                    <div class="@(_popOk ? "ok" : "error")">@Locale.T(_popStatus)</div>
                }
                <button type="submit" class="pill pill-green land-pop-send" disabled="@_sending">
                    @(_sending ? Locale.T("home.pop.sending") : Locale.T("home.pop.send")) @ArrowIcon
                </button>
            </form>
        </div>
    </div>
}

