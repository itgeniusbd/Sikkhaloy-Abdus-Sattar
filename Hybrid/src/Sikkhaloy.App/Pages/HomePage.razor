    private IEnumerable<PublicInstituteDto> SlideItems
    {
        get
        {
            if (_clients.Count == 0)
                yield break;
            var copies = _clients.Count >= 10 ? 2 : 4;
            for (var i = 0; i < copies; i++)
            {
                foreach (var item in _clients)
                    yield return item;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;
        var statsTask = Api.GetPublicStatsAsync(token);
        var clientsTask = Api.GetPublicInstitutesAsync(token);
        await Task.WhenAll(statsTask, clientsTask);
        _clients = await clientsTask;
        var stats = await statsTask;
        _targetInst = stats.Institutions;
        _targetStu = stats.Students;
        _targetTea = stats.Teachers;
        _ = AnimateCountsAsync(token);
        _ = RotateAsync(token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try { await JS.InvokeVoidAsync("sikkhaloyLanding.bindMock", _mockWrap); }
        catch (JSException) { }
    }

    private async Task RotateAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(2400, token);
                _rotSwap = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(290, token);
                _rot = (_rot + 1) % 3;
                _rotSwap = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task AnimateCountsAsync(CancellationToken token)
    {
        var start = DateTime.UtcNow;
        const int durationMs = 4000;
        while (!token.IsCancellationRequested)
        {
            var t = Math.Clamp((DateTime.UtcNow - start).TotalMilliseconds / durationMs, 0, 1);
            var ease = 1 - Math.Pow(1 - t, 3);
            _shownInst = (int)Math.Round(_targetInst * ease);
            _shownStu = (int)Math.Round(_targetStu * ease);
            _shownTea = (int)Math.Round(_targetTea * ease);
            await InvokeAsync(StateHasChanged);
            if (t >= 1)
                break;
            try { await Task.Delay(20, token); }
            catch (TaskCanceledException) { return; }
        }
    }

    private void Flip(int n)
    {
        if (!_flipped.Add(n))
            _flipped.Remove(n);
    }

    private void MarkBroken(int schoolId)
    {
        if (_brokenLogos.Add(schoolId))
            StateHasChanged();
    }

    private void OpenContact(string? subject = null)
    {
        _showContact = true;
        _popOk = false;
        _popStatus = null;
        if (!string.IsNullOrWhiteSpace(subject))
            _popSubject = subject;
    }

    private void CloseContact()
    {
        if (_sending)
            return;
        _showContact = false;
    }

    private async Task SendContactAsync()
    {
        if (_sending)
            return;
        var name = _popName.Trim();
        var mobile = _popMobile.Trim();
        var message = _popMessage.Trim();
        if (name.Length == 0 || mobile.Length < 8 || message.Length == 0)
        {
            _popOk = false;
            _popStatus = "home.pop.need";
            return;
        }
        _sending = true;
        _popStatus = null;
        try
        {
            var result = await Api.SendPublicContactAsync(new PublicContactRequest
            {
                Name = name, Email = _popEmail.Trim(), MobileNo = mobile,
                Subject = _popSubject.Trim(), Message = message
            });
            if (result.Succeeded)
            {
                _popOk = true;
                _popStatus = "home.pop.ok";
                _popName = _popEmail = _popMobile = _popSubject = _popMessage = "";
            }
            else
            {
                _popOk = false;
                _popStatus = string.IsNullOrWhiteSpace(result.Error) ? "home.pop.fail" : result.Error;
            }
        }
        finally { _sending = false; }
    }

    private string Fmt(int n) => n.ToString("N0", Locale.IsBengali ? CultureInfo.GetCultureInfo("bn-BD") : CultureInfo.InvariantCulture);
    private string Ord(int n) => n.ToString("00", Locale.IsBengali ? CultureInfo.GetCultureInfo("bn-BD") : CultureInfo.InvariantCulture);
    private static string Tone(int i) => LogoTone[Math.Abs(i) % LogoTone.Length];

    private static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "S";
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)];
        return string.Concat(parts[0].AsSpan(0, 1), parts[1].AsSpan(0, 1));
    }

