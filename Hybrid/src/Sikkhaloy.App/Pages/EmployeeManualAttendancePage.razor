@page "/attendance/employee/manual"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page si-id-page sm-cc-page students-card att-manual-page att-emp-manual att-emp-manual-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("att.scheduleHint")</p>
            <h1>@Locale.T("att.manualEmp")</h1>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText))
    {
        <NetBanner Text="@error" />
    }

    <div class="sal-bar no-print">
        <section class="sal-box">
            <span class="sal-box-h">@Locale.T("att.selectSchedule")</span>
            <select @bind="scheduleInput" @bind:after="LoadIfReadyAsync" disabled="@busy">
                <option value="0">@Locale.T("att.selectSchedule")</option>
                @foreach (var item in schedules)
                {
                    <option value="@item.ScheduleID">@item.ScheduleName</option>
                }
            </select>
        </section>
        <section class="sal-box">
            <span class="sal-box-h">@Locale.T("att.date")</span>
            <input type="date" @bind="date" @bind:after="LoadIfReadyAsync" disabled="@busy" />
        </section>
        <section class="sal-box is-type">
            <span class="sal-box-h">@Locale.T("emp.type")</span>
            <span class="readm-type">
                <label class="choice-inline">
                    <input type="radio" name="eman-type" checked="@(type == "%")" @onchange="@(() => ChangeTypeAsync("%"))" />
                    <span>@Locale.T("emp.all")</span>
                </label>
                <label class="choice-inline">
                    <input type="radio" name="eman-type" checked="@(type == "Teacher")" @onchange="@(() => ChangeTypeAsync("Teacher"))" />
                    <span>@Locale.T("emp.teacher")</span>
                </label>
                <label class="choice-inline">
                    <input type="radio" name="eman-type" checked="@(type == "Staff")" @onchange="@(() => ChangeTypeAsync("Staff"))" />
                    <span>@Locale.T("emp.staff")</span>
                </label>
            </span>
        </section>
        @if (rows.Count > 0)
        {
            <div class="sal-actions">
                <button type="button" class="sal-gen" disabled="@busy" @onclick="SaveAsync">@Locale.T("att.submit")</button>
            </div>
        }
        <span class="el-count">@rows.Count</span>
    </div>

    <div class="sj-grid att-table-wrap">
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act">
                        <label class="choice-inline">
                            <input type="checkbox" checked="@allSelected" disabled="@busy" @onchange="ToggleAll" />
                            <span>@Locale.T("att.all")</span>
                        </label>
                    </th>
                    <th>@Locale.T("emp.id")</th>
                    <th class="col-name">@Locale.T("si.name")</th>
                    <th>@Locale.T("emp.designation")</th>
                    <th>@Locale.T("att.status")</th>
                    <th class="col-time">@Locale.T("att.entry")</th>
                    <th class="col-time">@Locale.T("att.exit")</th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0 && !busy)
            {
                <tr><td colspan="7" class="empty-row">@Locale.T("att.empty")</td></tr>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <tr @key="row.EmployeeID" class="@RowClass(row)">
                        <td class="act"><input type="checkbox" checked="@row.Selected" disabled="@busy" @onchange="e => SetSelected(row, e)" /></td>
                        <td>@row.ID</td>
                        <td class="col-name">@row.Name</td>
                        <td>@row.Designation</td>
                        <td class="col-status">
                            <span class="readm-type att-status-row">
                                @foreach (var status in Statuses)
                                {
                                    <label @key="@($"{row.EmployeeID}-{status}")" class="choice-inline">
                                        <input type="radio"
                                               name="@($"emp-att-{ScheduleId}-{date:yyyyMMdd}-{row.EmployeeID}")"
                                               checked="@(row.Attendance == status)"
                                               disabled="@busy"
                                               @onchange="@(() => SetAttendance(row, status))" />
                                        <span>@StatusLabel(status)</span>
                                    </label>
                                }
                            </span>
                        </td>
                        <td class="col-time"><input type="time" value="@Time(row.EntryTime)" @onchange="e => row.EntryTime = e.Value?.ToString()" disabled="@busy" /></td>
                        <td class="col-time"><input type="time" value="@Time(row.ExitTime)" @onchange="e => row.ExitTime = e.Value?.ToString()" disabled="@busy" /></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private static readonly string[] Statuses = ["Pre", "Abs", "Late", "Late Abs", "Leave"];
    private readonly List<AttendanceScheduleDto> schedules = [];
    private readonly List<EmployeeManualRowDto> rows = [];
    private string scheduleInput = "0";
    private string type = "%";
    private string busyTitle = "";
    private string popupText = "";
    private DateTime date = DateTime.Today;
    private bool busy;
    private bool popupError;
    private bool allSelected;
    private string? error;
    private int ScheduleId => int.TryParse(scheduleInput, out var n) ? n : 0;

    protected override async Task OnInitializedAsync()
    {
        await SetBusyAsync("si.loading");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            schedules.Clear();
            schedules.AddRange(await Api.GetAttendanceSchedulesAsync(Session.AccessToken!));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private Task ChangeTypeAsync(string value)
    {
        type = value;
        return LoadIfReadyAsync();
    }

    private Task LoadIfReadyAsync()
    {
        if (ScheduleId <= 0)
        {
            rows.Clear();
            allSelected = false;
            return Task.CompletedTask;
        }
        return LoadRowsAsync();
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        allSelected = e.Value is true or "true";
        foreach (var row in rows)
        {
            row.Selected = allSelected;
            if (allSelected)
                row.Attendance = "Pre";
            else if (!row.HasRecord)
                row.Attendance = "";
        }
    }

    private void SetSelected(EmployeeManualRowDto row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true or "true";
        if (row.Selected && string.IsNullOrWhiteSpace(row.Attendance))
            row.Attendance = "Pre";
        else if (!row.Selected && !row.HasRecord)
            row.Attendance = "";
        allSelected = rows.Count > 0 && rows.All(x => x.Selected);
    }

    private void SetAttendance(EmployeeManualRowDto row, string status)
    {
        row.Attendance = status;
        row.Selected = true;
        allSelected = rows.Count > 0 && rows.All(x => x.Selected);
    }

    private async Task LoadRowsAsync()
    {
        error = null;
        if (ScheduleId <= 0)
        {
            rows.Clear();
            return;
        }
        await SetBusyAsync("si.loading");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            rows.Clear();
            allSelected = false;
            var data = await Api.GetEmployeeManualAsync(Session.AccessToken!, ScheduleId, type, date);
            foreach (var row in data)
                ResetEmpRowDefaults(row);
            rows.AddRange(data);
            allSelected = rows.Count > 0 && rows.All(x => x.Selected);
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private static void ResetEmpRowDefaults(EmployeeManualRowDto row)
    {
        if (row.HasRecord)
        {
            if (string.IsNullOrWhiteSpace(row.Attendance))
                row.Attendance = "Pre";
            row.Selected = true;
            return;
        }

        row.Attendance = "";
        row.Selected = false;
    }

    private async Task SaveAsync()
    {
        error = null;
        popupText = "";
        var selected = rows.Where(x => x.Selected).ToList();
        if (selected.Count == 0)
        {
            Show(Locale.T("att.needRows"), true);
            return;
        }
        if (selected.Any(x => string.IsNullOrWhiteSpace(x.Attendance)))
        {
            Show(Locale.T("att.needStatus"), true);
            return;
        }
        await SetBusyAsync("si.saving");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            var result = await Api.SaveEmployeeManualAsync(Session.AccessToken!, new SaveEmployeeManualRequest
            {
                ScheduleID = ScheduleId,
                AttendanceDate = date,
                Rows = selected.Select(x => new EmployeeManualSaveRow
                {
                    EmployeeID = x.EmployeeID,
                    Attendance = x.Attendance,
                    EntryTime = x.EntryTime,
                    ExitTime = x.ExitTime
                }).ToList()
            });
            if (!result.Succeeded)
            {
                Show(Locale.T(result.Error ?? "att.failed"), true);
                return;
            }
            var ok = Locale.T("att.saved");
            await LoadRowsAsync();
            Show(ok, false);
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private static string RowClass(EmployeeManualRowDto row)
    {
        if (row.Selected)
            return "is-picked";
        return row.HasRecord ? "is-saved" : "";
    }

    private string StatusLabel(string status) => status switch
    {
        "Pre" => Locale.T("att.pre"),
        "Abs" => Locale.T("att.abs"),
        "Late" => Locale.T("att.lateStatus"),
        "Late Abs" => Locale.T("att.lateAbs"),
        "Leave" => Locale.T("att.leave"),
        _ => status
    };

    private static string Time(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        return value.Length >= 5 ? value[..5] : value;
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
        error = isError ? text : null;
    }

    private void ClosePopup() => popupText = "";

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
