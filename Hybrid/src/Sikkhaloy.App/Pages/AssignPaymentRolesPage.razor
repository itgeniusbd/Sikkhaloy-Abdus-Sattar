@page "/accounts/assign-roles"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page emp-page acc-page">
    <h1>@Locale.T("acc.assign")</h1>
    <a class="acc-jump" href="accounts/assign-roles-multi">@Locale.T("acc.multiClass")</a>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="error">@error</div> }
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="ok">@message</div> }

    <div class="filter-row">
        <select @bind="classInput" @bind:after="LoadAssignedAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        <select @bind="roleInput" @bind:after="LoadAssignedAsync" disabled="@busy">
            <option value="0">@Locale.T("acc.roleName")</option>
            @foreach (var item in roles)
            {
                <option value="@item.RoleID">@item.Role (@item.NumberOfPay)</option>
            }
        </select>
    </div>

    @if (ClassId > 0 && RoleId > 0 && drafts.Count > 0)
    {
        <p class="muted">@Locale.T("acc.installments") · @Locale.T("acc.slots"): @drafts.Count</p>
        <div class="filter-row">
            <button type="button" class="btn-serial" disabled="@busy" @onclick="AutoFill">@Locale.T("acc.autoFill")</button>
            <input type="number" min="0" step="0.01" placeholder="@Locale.T("acc.amountAll")" @bind="amountAll" @bind:after="CopyAmount" disabled="@busy" />
            <input type="number" min="0" step="0.01" placeholder="@Locale.T("acc.lateAll")" @bind="lateAll" @bind:after="CopyLate" disabled="@busy" />
        </div>
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act"></th>
                    <th>@Locale.T("acc.payFor")</th>
                    <th>@Locale.T("acc.amount")</th>
                    <th>@Locale.T("acc.start")</th>
                    <th>@Locale.T("acc.end")</th>
                    <th>@Locale.T("acc.lateFee")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in drafts)
            {
                <tr>
                    <td class="act"><input type="checkbox" checked="@row.Selected" disabled="@busy" @onchange="e => Set(row, e)" /></td>
                    <td><input type="text" @bind="row.PayFor" disabled="@busy" /></td>
                    <td><input type="number" min="0" step="0.01" @bind="row.Amount" disabled="@busy" /></td>
                    <td><input type="date" @bind="row.StartDate" disabled="@busy" /></td>
                    <td><input type="date" @bind="row.EndDate" disabled="@busy" /></td>
                    <td><input type="number" min="0" step="0.01" @bind="row.LateFee" disabled="@busy" /></td>
                </tr>
            }
            </tbody>
        </table>
        <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveAsync">@Locale.T("acc.assign")</button>
    }

    <h2 class="emp-list-title">@Locale.T("acc.assigned")</h2>
    <table class="mgrid">
        <thead>
            <tr>
                <th>@Locale.T("acc.payFor")</th>
                <th>@Locale.T("acc.amount")</th>
                <th>@Locale.T("acc.lateFee")</th>
                <th>@Locale.T("acc.start")</th>
                <th>@Locale.T("acc.end")</th>
                <th class="act"></th>
            </tr>
        </thead>
        <tbody>
        @if (assigned.Count == 0 && !busy)
        {
            <tr><td colspan="6" class="empty-row">@Locale.T("acc.empty")</td></tr>
        }
        else
        {
            @foreach (var row in assigned)
            {
                <tr>
                    <td>@row.PayFor</td>
                    <td>@row.Amount.ToString("0.##")</td>
                    <td>@row.LateFee.ToString("0.##")</td>
                    <td>@row.StartDate.ToString("dd-MMM-yyyy")</td>
                    <td>@row.EndDate.ToString("dd-MMM-yyyy")</td>
                    <td class="act">
                        <button type="button" class="link-btn danger" disabled="@busy" @onclick="() => DeleteAsync(row.AssignRoleID)">@Locale.T("sal.delete")</button>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<PaymentRoleDto> roles = [];
    private readonly List<AssignedRoleDto> assigned = [];
    private readonly List<Draft> drafts = [];
    private readonly List<FeeMonth> months = [];
    private string classInput = "0";
    private string roleInput = "0";
    private decimal? amountAll;
    private decimal? lateAll;
    private bool busy;
    private string? error;
    private string? message;
    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int RoleId => int.TryParse(roleInput, out var n) ? n : 0;

    private sealed class Draft
    {
        public bool Selected { get; set; } = true;
        public string PayFor { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal LateFee { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddDays(9);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await OnlineAsync()) return;
        var structure = await Api.GetClassStructureAsync(Session.AccessToken!);
        classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
        roles.AddRange(await Api.GetPaymentRolesAsync(Session.AccessToken!));
        var years = await Api.GetYearsAsync(Session.AccessToken!);
        var year = years.FirstOrDefault(x => x.IsCurrent) ?? years.FirstOrDefault();
        if (year?.StartDate is DateTime start && year.EndDate is DateTime end)
            months.AddRange(FeeMonthHelper.FromSession(start, end));
        if (months.Count == 0)
            months.AddRange(FeeMonthHelper.FromSession(new DateTime(DateTime.Today.Year, 1, 1), new DateTime(DateTime.Today.Year, 12, 31)));
    }

    private static void Set(Draft row, ChangeEventArgs e) =>
        row.Selected = e.Value is true or "true";

    private void CopyAmount()
    {
        if (amountAll is not decimal n) return;
        foreach (var row in drafts)
            row.Amount = n;
    }

    private void CopyLate()
    {
        if (lateAll is not decimal n) return;
        foreach (var row in drafts)
            row.LateFee = n;
    }

    private void AutoFill()
    {
        if (drafts.Count == 0) return;
        var used = assigned.Select(x => x.PayFor.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var available = months.Where(m => !used.Contains(m.Name)
            && !used.Contains(m.Name.Split(' ')[0])).ToList();
        if (available.Count == 0)
            available = months.ToList();
        var picked = FeeMonthHelper.Pick(available, drafts.Count);
        for (var i = 0; i < drafts.Count && i < picked.Count; i++)
        {
            drafts[i].Selected = true;
            drafts[i].PayFor = picked[i].Name;
            drafts[i].StartDate = picked[i].Start;
            drafts[i].EndDate = picked[i].End;
            if (amountAll is decimal a) drafts[i].Amount = a;
            if (lateAll is decimal l) drafts[i].LateFee = l;
        }
    }

    private void RebuildDrafts()
    {
        drafts.Clear();
        var role = roles.FirstOrDefault(x => x.RoleID == RoleId);
        var remaining = Math.Max(0, (role?.NumberOfPay ?? 0) - assigned.Count);
        for (var i = 0; i < remaining; i++)
            drafts.Add(new Draft());
    }

    private async Task LoadAssignedAsync()
    {
        assigned.Clear();
        drafts.Clear();
        if (ClassId <= 0 || RoleId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            assigned.AddRange(await Api.GetAssignedRolesAsync(Session.AccessToken!, ClassId, RoleId));
            RebuildDrafts();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        error = message = null;
        var items = drafts.Where(x => x.Selected).Select(x => new BulkAssignItem
        {
            RoleID = RoleId,
            PayFor = x.PayFor,
            Amount = x.Amount,
            LateFee = x.LateFee,
            StartDate = x.StartDate,
            EndDate = x.EndDate
        }).ToList();
        if (items.Count == 0) { error = Locale.T("acc.needRows"); return; }
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            var result = await Api.BulkAssignRolesAsync(Session.AccessToken!, new BulkAssignRoleRequest
            {
                ClassIDs = [ClassId],
                Items = items
            });
            if (!result.Succeeded) { error = Locale.T(result.Error ?? "acc.failed"); return; }
            amountAll = lateAll = null;
            message = Locale.T("acc.saved");
            await LoadAssignedAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task DeleteAsync(int id)
    {
        error = message = null;
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("acc.confirmDelete")))
            return;
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            var result = await Api.DeleteAssignedRoleAsync(Session.AccessToken!, id);
            if (!result.Succeeded) { error = Locale.T(result.Error ?? "acc.failed"); return; }
            message = Locale.T("acc.saved");
            await LoadAssignedAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }
}
