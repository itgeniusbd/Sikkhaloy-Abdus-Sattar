@page "/exam/marks-check"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page exam-check-page">
    <h1>@Locale.T("exam.checkTitle")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="LoadAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <select @bind="examId" @bind:after="LoadAsync" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.Exams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </div>

    @if (rows.Count > 0)
    {
        <div class="exam-legend">
            <span class="exam-ok">@Locale.T("exam.complete")</span>
            <span class="exam-bad">@Locale.T("exam.incomplete")</span>
        </div>
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("exam.subject")</th>
                    <th>@Locale.T("rpt.totalStudent")</th>
                    <th>@Locale.T("exam.inputted")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in rows)
            {
                <tr class="@RowClass(row)">
                    <td>
                        <a href="@InputHref(row)" class="exam-subject-link">@row.SubjectName</a>
                    </td>
                    <td>@row.TotalStudent</td>
                    <td>
                        @foreach (var sub in row.Subs)
                        {
                            <p class="@SubClass(row, sub)">@LocalizeSubExam(sub.SubExamName) <b>@sub.TotalStudent</b></p>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else if (!busy && classId > 0 && examId > 0)
    {
        <p class="muted">@Locale.T("exam.empty")</p>
    }
</div>

@if (busy)
{
    <div class="acc-loading-back">
        <div class="acc-loading">
            <div class="acc-spinner"></div>
            <p>@Locale.T("acc.loading")</p>
            <div class="acc-prog-track"><div class="acc-prog-fill is-run"></div></div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="exam.failed" OnClose="ClosePopup" />
}

@code {
    private ExamFilterDto filters = new();
    private readonly List<MarksCheckRowDto> rows = [];
    private int classId, examId;
    private bool busy, popupError;
    private string? popupText;

    protected override Task OnInitializedAsync() => LoadFiltersAsync();

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "check"); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task LoadAsync()
    {
        rows.Clear();
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try { rows.AddRange(await Api.GetExamMarksCheckAsync(Session.AccessToken!, classId, examId)); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private string InputHref(MarksCheckRowDto row) =>
        $"/exam/input?examId={examId}&classId={classId}&subjectId={row.SubjectID}";

    private static string RowClass(MarksCheckRowDto row)
    {
        if (row.Subs.Count == 0) return "exam-bad";
        var complete = row.Subs.Count(x => x.TotalStudent >= row.TotalStudent && row.TotalStudent > 0);
        var none = row.Subs.Count(x => x.TotalStudent <= 0);
        if (complete == row.Subs.Count) return "exam-ok";
        if (none == row.Subs.Count) return "exam-bad";
        return "exam-part";
    }

    private static string SubClass(MarksCheckRowDto row, MarksCheckSubDto sub)
    {
        if (row.TotalStudent > 0 && sub.TotalStudent >= row.TotalStudent) return "sub-ok";
        if (sub.TotalStudent <= 0) return "sub-none";
        return "sub-part";
    }

    private string LocalizeSubExam(string name)
    {
        if (!Locale.IsBengali || string.IsNullOrWhiteSpace(name))
            return name;
        return name.Trim().ToUpperInvariant() switch
        {
            "SUB" or "SUBJECTIVE" => Locale.T("exam.sub"),
            "OBJ" or "OBJECTIVE" => Locale.T("exam.obj"),
            "CQ" => Locale.T("exam.cq"),
            "MCQ" => Locale.T("exam.mcq"),
            "WRITTEN" => Locale.T("exam.written"),
            "PRACTICAL" => Locale.T("exam.practical"),
            "ORAL" => Locale.T("exam.oral"),
            "THEORY" => Locale.T("exam.theory"),
            "MARKS" => Locale.T("exam.marks"),
            _ => name
        };
    }

    private void Show(string text, bool err = false) { popupText = text; popupError = err; }
    private void ClosePopup() => popupText = null;
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
