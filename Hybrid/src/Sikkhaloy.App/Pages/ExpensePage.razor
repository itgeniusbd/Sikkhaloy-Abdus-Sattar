    private object PrintOpts() => new { size = printSize, topSpace, fontSize, hideIns, hideDue = false };
    private static string NormalizeWidth(string? size) => size switch
    {
        "half" => "4",
        "quarter" => "3",
        "full" => "6",
        _ when size is not null && Widths.Contains(size) => size,
        _ => "4"
    };
    private Task OnHideIns(ChangeEventArgs e)
    {
        hideIns = e.Value is true or "true" or "True";
        return PersistOptsAsync();
    }

    private static DateTime? ParseDay(string? text) =>
        DateTime.TryParse(text, out var day) ? day.Date : null;
    private void OnFromChanged(ChangeEventArgs e) => fromText = e.Value?.ToString() ?? "";
    private void OnToChanged(ChangeEventArgs e) => toText = e.Value?.ToString() ?? "";

    private async Task PaintAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void ShowPopup(string text, bool isError)
    {
        popupText = text;
        popupError = isError;
        if (isError) error = text;
        else message = text;
    }
    private void Fail(string text) => ShowPopup(text, true);
    private void ClosePopup() => popupText = null;

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        { Fail(Locale.T("subj.needOnline")); return false; }
        return true;
    }

    private string AmountInWords(decimal amount)
    {
        var fraction = (int)Math.Round((double)(amount % 1m) * 100d, MidpointRounding.AwayFromZero);
        var text = ConvertNumber((double)amount);
        if (Locale.IsBengali)
            return fraction > 0 ? $"{text} টাকা এবং {ConvertNumber(fraction)} পয়সা মাত্র" : $"{text} টাকা মাত্র";
        return fraction > 0 ? text + " Tk And " + ConvertNumber(fraction) + " Paisa Only" : text + " Tk Only";
    }

    private string ConvertNumber(double number)
    {
        if (number < 0 || number > 999999999) return Locale.IsBengali ? "সীমার বাইরে" : "NUMBER OUT OF RANGE!";
        var bn = Locale.IsBengali;
        var crore = (long)Math.Floor(number / 10000000);
        number -= crore * 10000000;
        var lakh = (long)Math.Floor(number / 100000);
        number -= lakh * 100000;
        var thousand = (long)Math.Floor(number / 1000);
        number -= thousand * 1000;
        var hundred = (long)Math.Floor(number / 100);
        number %= 100;
        var tn = (int)Math.Floor(number / 10);
        var one = (int)Math.Floor(number % 10);
        var res = "";
        if (crore > 0) res += ConvertNumber(crore) + (bn ? " কোটি" : " Crore");
        if (lakh > 0) res += (res.Length == 0 ? "" : " ") + ConvertNumber(lakh) + (bn ? " লক্ষ" : " Lakh");
        if (thousand > 0) res += (res.Length == 0 ? "" : " ") + ConvertNumber(thousand) + (bn ? " হাজার" : " Thousand");
        if (hundred > 0) res += (res.Length == 0 ? "" : " ") + ConvertNumber(hundred) + (bn ? " শত" : " Hundred");
        string[] onesEn = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten",
            "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
        string[] tensEn = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];
        string[] onesBn = ["", "এক", "দুই", "তিন", "চার", "পাঁচ", "ছয়", "সাত", "আট", "নয়", "দশ",
            "এগারো", "বারো", "তেরো", "চৌদ্দ", "পনেরো", "ষোলো", "সতেরো", "আঠারো", "উনিশ"];
        string[] tensBn = ["", "", "বিশ", "ত্রিশ", "চল্লিশ", "পঞ্চাশ", "ষাট", "সত্তর", "আশি", "নব্বই"];
        var ones = bn ? onesBn : onesEn;
        var tens = bn ? tensBn : tensEn;
        if (tn > 0 || one > 0)
        {
            if (res.Length == 0) { }
            else res += bn ? " " : " And ";
            if (tn < 2) res += ones[tn * 10 + one];
            else res += tens[tn] + (one > 0 ? (bn ? " " : "-") + ones[one] : "");
        }
        return res.Length == 0 ? (bn ? "শূন্য" : "zero") : res;
    }

