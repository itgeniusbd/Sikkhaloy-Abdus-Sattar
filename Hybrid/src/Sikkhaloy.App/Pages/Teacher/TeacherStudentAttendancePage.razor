@page "/teacher/student-attendance"
@layout TeacherLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav

<div class="sp-page tch-stu-page">
    <h1>@Locale.T("tch.studentAtt")</h1>
    <article class="sp-card">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="sp-empty" style="color:#b91c1c">@error</p>
        }
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="tch-att-ok">@message</p>
        }
        @if (meta is not null && !meta.AllowBackDate)
        {
            <p class="sp-empty">@Locale.T("tch.attTodayOnly")</p>
        }
        <div class="tch-filter-row">
            <label class="auth-field">@Locale.T("stu.class")
                <select @bind="classId" @bind:after="OnFilterChanged" disabled="@busy">
                    <option value="0">@Locale.T("tch.pickClass")</option>
                    @if (meta is not null)
                    {
                        @foreach (var cls in meta.Classes)
                        {
                            <option value="@cls.Id">@cls.Name</option>
                        }
                    }
                </select>
            </label>
            <label class="auth-field">@Locale.T("tch.schedule")
                <select @bind="scheduleId" @bind:after="OnFilterChanged" disabled="@busy">
                    <option value="0">@Locale.T("tch.pickSchedule")</option>
                    @if (meta is not null)
                    {
                        @foreach (var sch in meta.Schedules)
                        {
                            <option value="@sch.Id">@sch.Name</option>
                        }
                    }
                </select>
            </label>
        </div>
        <label class="auth-field tch-att-date">@Locale.T("stu.date")
            <span class="tch-date-wrap">
                <input type="date" @bind="date" @bind:after="OnDateChanged" disabled="@(busy || meta is { AllowBackDate: false })" />
            </span>
        </label>
        <div class="tch-sms-lang">
            <button type="button" class="@(englishSms ? "is-on" : null)" disabled="@busy" @onclick="() => SetSmsLang(true)">@Locale.T("att.englishSms")</button>
            <button type="button" class="@(englishSms ? null : "is-on")" disabled="@busy" @onclick="() => SetSmsLang(false)">@Locale.T("att.banglaSms")</button>
        </div>
        @if (busy && rows.Count == 0)
        {
            <div class="tch-progress" role="progressbar" aria-label="@Locale.T("stu.loading")"><span></span></div>
        }
    </article>

    @if (busy && rows.Count == 0)
    {
        <p class="sp-empty tch-att-wait">@Locale.T("stu.loading")</p>
    }

    @if (rows.Count > 0)
    {
        <div class="tch-att-bar">
            <label>
                <input type="checkbox" checked="@allSelected" disabled="@busy" @onchange="ToggleAll" />
                @Locale.T("att.all")
            </label>
            <button type="button" disabled="@busy" @onclick="MarkAllPresent">@Locale.T("tch.allPresent")</button>
        </div>
        @foreach (var row in rows)
        {
            <article @key="row.StudentClassID" class="tch-stu-card @(row.HasRecord || row.Selected ? "is-done" : null)">
                <label class="is-check">
                    <input type="checkbox" checked="@row.Selected" disabled="@busy" @onchange="e => SetSelected(row, e)" />
                </label>
                <div class="is-name">
                    <b>@row.Name</b>
                    <small>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</small>
                </div>
                <span class="is-roll">@Locale.T("att.rollNo") @(string.IsNullOrWhiteSpace(row.RollNo) ? "—" : row.RollNo)</span>
                <small class="is-meta">ID @row.ID</small>
                <small class="is-taken">@(string.IsNullOrWhiteSpace(row.TakenBy) ? "—" : row.TakenBy)</small>
                <div class="tch-status">
                    @foreach (var st in Statuses)
                    {
                        <button type="button" class="is-@st.ToLowerInvariant() @(row.Attendance == st ? "is-on" : null)"
                                disabled="@busy" @onclick="() => SetAttendance(row, st)">@st</button>
                    }
                </div>
                @if (ShowExtra(row))
                {
                    <div class="tch-extra">
                        @if (!string.IsNullOrWhiteSpace(row.LeaveRange))
                        {
                            <small>@row.LeaveRange</small>
                        }
                        @if (NeedsSms(row.Attendance))
                        {
                            <label class="tch-sms-check @(row.HasRecord ? (row.SmsSent ? "is-sent" : "is-pending") : null)">
                                <input type="checkbox" checked="@(row.HasRecord ? row.SmsSent : row.SendSms)"
                                       disabled="@(busy || row.SmsSent)"
                                       @onchange="e => SetSendSms(row, e)" />
                                <span>@Locale.T(SmsCaption(row))</span>
                            </label>
                        }
                        <textarea rows="3" @bind="row.Reason" disabled="@busy"></textarea>
                    </div>
                }
            </article>
        }
        <div class="tch-att-submit">
            @if (busy)
            {
                <div class="tch-progress" role="progressbar" aria-label="@Locale.T("stu.loading")"><span></span></div>
            }
            <button type="button" class="tch-att-load @(busy ? "is-busy" : null)" disabled="@busy" @onclick="SaveAsync">
                @if (busy)
                {
                    <span class="tch-submit-dot" aria-hidden="true"></span>
                }
                @(busy ? Locale.T("stu.loading") : Locale.T("att.submit"))
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="att.failed" OnClose="ClosePopup" />
}

@code {
    private static readonly string[] Statuses = ["Pre", "Abs", "Late", "Leave", "Bunk"];
    private TeacherPortalAttendanceMetaDto? meta;
    private readonly List<StudentManualRowDto> rows = [];
    private int classId;
    private int scheduleId;
    private DateTime date = DateTime.Today;
    private bool busy;
    private bool englishSms = true;
    private bool allSelected;
    private bool popupError;
    private string? error;
    private string? message;
    private string? popupText;

    private string ScheduleName =>
        meta?.Schedules.FirstOrDefault(x => x.Id == scheduleId)?.Name ?? "class";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsTeacher) { Nav.NavigateTo(Session.HomePath, replace: true); return; }
        try
        {
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                meta = await Api.GetTeacherPortalStudentAttendanceMetaAsync(Session.AccessToken);
                if (meta is { AllowBackDate: false })
                    date = DateTime.Today;
            }
        }
        catch { }
    }

    private Task OnFilterChanged()
    {
        date = DateTime.Today;
        return LoadIfReadyAsync();
    }

    private Task OnDateChanged() => LoadIfReadyAsync();

    private async Task LoadIfReadyAsync()
    {
        if (classId <= 0 || scheduleId <= 0)
        {
            rows.Clear();
            allSelected = false;
            error = message = null;
            return;
        }
        await LoadAsync();
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        allSelected = e.Value is true or "true";
        foreach (var row in rows)
            row.Selected = allSelected;
    }

    private void SetSelected(StudentManualRowDto row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true or "true";
        allSelected = rows.Count > 0 && rows.All(x => x.Selected);
    }

    private void MarkAllPresent()
    {
        foreach (var row in rows)
            SetAttendance(row, "Pre");
        allSelected = rows.Count > 0;
    }

    private void SetSmsLang(bool english)
    {
        englishSms = english;
        foreach (var row in rows.Where(x => x.Attendance is "Abs" or "Late" or "Bunk" && IsGeneratedComment(x.Reason)))
            row.Reason = BuildComment(row, row.Attendance);
    }

    private void SetSendSms(StudentManualRowDto row, ChangeEventArgs e)
    {
        if (row.SmsSent)
            return;
        row.SendSms = e.Value is true or "true";
    }

    private void SetAttendance(StudentManualRowDto row, string status)
    {
        row.Attendance = status;
        row.Selected = true;
        allSelected = rows.Count > 0 && rows.All(x => x.Selected);
        if (status == "Pre")
        {
            if (!row.HasRecord)
                row.Reason = "";
            row.SendSms = false;
            return;
        }
        if (status == "Leave")
        {
            if (IsGeneratedComment(row.Reason))
                row.Reason = "";
            row.SendSms = false;
            return;
        }
        row.Reason = BuildComment(row, status);
        row.SendSms = !row.SmsSent;
    }

    private async Task LoadAsync()
    {
        if (classId <= 0 || scheduleId <= 0)
        {
            error = Locale.T("tch.pickAll");
            return;
        }
        error = message = null;
        busy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var data = await Api.GetTeacherPortalStudentAttendanceAsync(Session.AccessToken, scheduleId, classId, date);
            rows.Clear();
            foreach (var row in data)
                ResetRowDefaults(row);
            rows.AddRange(data);
            allSelected = rows.Count > 0 && rows.All(x => x.Selected);
            if (rows.Count == 0)
                error = Locale.T("stu.empty");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveAsync()
    {
        error = message = null;
        var selected = rows.Where(x => x.Selected).ToList();
        if (selected.Count == 0)
        {
            ShowPopup(Locale.T("att.needRows"), true);
            return;
        }
        busy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Api.SaveTeacherPortalStudentAttendanceAsync(Session.AccessToken, new SaveStudentManualRequest
            {
                ClassID = classId,
                ScheduleID = scheduleId,
                AttendanceDate = date,
                Rows = selected.Select(x => new StudentManualSaveRow
                {
                    StudentID = x.StudentID,
                    StudentClassID = x.StudentClassID,
                    Attendance = x.Attendance,
                    Reason = x.Reason,
                    SendSms = x.SendSms && !x.SmsSent && x.Attendance is "Abs" or "Late" or "Bunk",
                    ID = x.ID,
                    Phone = x.Phone,
                    Name = x.Name
                }).ToList()
            });
            if (!result.Succeeded)
            {
                ShowPopup(Locale.T(result.Error ?? "att.failed"), true);
                return;
            }
            ApplySavedRows(selected);
            ShowPopup(BuildSaveSummary(selected), false);
        }
        catch (Exception ex)
        {
            ShowPopup(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private static void ResetRowDefaults(StudentManualRowDto row)
    {
        if (row.HasRecord)
        {
            if (string.IsNullOrWhiteSpace(row.Attendance) || Array.IndexOf(Statuses, row.Attendance) < 0)
                row.Attendance = "Pre";
            row.Selected = true;
            row.SendSms = false;
            return;
        }
        if (!string.IsNullOrWhiteSpace(row.LeaveRange))
        {
            row.Attendance = "Leave";
            row.Selected = false;
            row.SendSms = false;
            return;
        }
        row.Attendance = "Pre";
        row.Selected = false;
        row.SendSms = false;
        if (string.IsNullOrWhiteSpace(row.Reason) || IsGeneratedComment(row.Reason))
            row.Reason = "";
    }

    private string BuildComment(StudentManualRowDto row, string status)
    {
        var day = date.ToString("dd MMM yyyy");
        var who = $"{row.Name} ID:{row.ID}";
        var schedule = ScheduleName;
        if (englishSms)
        {
            return status switch
            {
                "Abs" => $"Respected Guardian, {who}, Today({day}) was absent in {schedule} schedule. Please send to class regularly.",
                "Late" => $"Respected Guardian, {who}, Today({day}) was late in {schedule} schedule.",
                "Bunk" => $"Respected Guardian, {who}, Today({day}) bunked from {schedule} schedule.",
                _ => row.Reason ?? ""
            };
        }
        return status switch
        {
            "Abs" => $"সম্মানিত অভিভাবক, {who}, আজ({day}) {schedule} শিডিউলে অনুপস্থিত। অনুগ্রহ করে নিয়মিত ক্লাসে পাঠান।",
            "Late" => $"সম্মানিত অভিভাবক, {who}, আজ({day}) {schedule} শিডিউলে যথাসময় আসেনি।",
            "Bunk" => $"সম্মানিত অভিভাবক, {who}, আজ({day}) {schedule} শিডিউল থেকে পলায়ন করেছে।",
            _ => row.Reason ?? ""
        };
    }

    private void ShowPopup(string text, bool isError)
    {
        popupText = text;
        popupError = isError;
        if (isError)
            error = text;
        else
            message = text;
    }

    private void ClosePopup()
    {
        popupText = null;
        popupError = false;
    }

    private string BuildSaveSummary(List<StudentManualRowDto> saved)
    {
        static int CountOf(List<StudentManualRowDto> rows, string status) =>
            rows.Count(x => string.Equals(x.Attendance, status, StringComparison.OrdinalIgnoreCase));

        var parts = new List<string>
        {
            $"{Locale.T("att.pre")} {CountOf(saved, "Pre")}",
            $"{Locale.T("att.abs")} {CountOf(saved, "Abs")}",
            $"{Locale.T("att.lateStatus")} {CountOf(saved, "Late")}",
            $"{Locale.T("att.lateAbs")} {CountOf(saved, "Late Abs")}",
            $"{Locale.T("att.leave")} {CountOf(saved, "Leave")}",
            $"{Locale.T("att.bunk")} {CountOf(saved, "Bunk")}"
        };
        return $"{Locale.T("tch.attSavedCount", saved.Count)} {string.Join(", ", parts)}.";
    }

    private void ApplySavedRows(List<StudentManualRowDto> saved)
    {
        var who = Session.Current?.DisplayName;
        foreach (var row in saved)
        {
            row.HasRecord = true;
            row.Selected = true;
            if (row.SendSms && NeedsSms(row.Attendance))
                row.SmsSent = true;
            row.SendSms = false;
            if (!string.IsNullOrWhiteSpace(who))
                row.TakenBy = who;
        }
        allSelected = rows.Count > 0 && rows.All(x => x.Selected);
    }

    private static bool NeedsSms(string status) =>
        status is "Abs" or "Late" or "Bunk";

    private static bool ShowExtra(StudentManualRowDto row) =>
        NeedsSms(row.Attendance) || row.Attendance == "Leave" || !string.IsNullOrWhiteSpace(row.LeaveRange);

    private static string SmsCaption(StudentManualRowDto row) =>
        row.HasRecord
            ? (row.SmsSent ? "tch.smsSent" : "tch.smsNotSent")
            : "tch.sendSms";

    private static bool IsGeneratedComment(string? text) =>
        !string.IsNullOrWhiteSpace(text)
        && (text.StartsWith("Respected Guardian", StringComparison.OrdinalIgnoreCase)
            || text.StartsWith("সম্মানিত অভিভাবক", StringComparison.Ordinal));
}
