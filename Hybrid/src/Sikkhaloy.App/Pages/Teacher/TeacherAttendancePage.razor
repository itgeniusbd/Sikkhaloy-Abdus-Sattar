@page "/teacher/attendance"
@layout TeacherLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav

<div class="sp-page sp-att-page">
    <h1>@Locale.T("tch.myAttendance")</h1>
    @if (loading)
    {
        <article class="sp-card"><p class="sp-empty">@Locale.T("stu.loading")</p></article>
    }
    else
    {
        <div class="sp-att-cards">
            <div class="sp-att-chip is-pre"><i></i><div><span>@Locale.T("stu.present")</span><strong>@data.Present</strong></div></div>
            <div class="sp-att-chip is-abs"><i></i><div><span>@Locale.T("stu.absent")</span><strong>@data.Absent</strong></div></div>
            <div class="sp-att-chip is-late"><i></i><div><span>@Locale.T("stu.late")</span><strong>@data.Late</strong></div></div>
            <div class="sp-att-chip is-lateabs"><i></i><div><span>@Locale.T("stu.lateAbs")</span><strong>@data.LateAbsent</strong></div></div>
            <div class="sp-att-chip is-leave"><i></i><div><span>@Locale.T("stu.leave")</span><strong>@data.Leave</strong></div></div>
            <div class="sp-att-chip is-hol"><i></i><div><span>@Locale.T("stu.holidays")</span><strong>@HolidayCount</strong></div></div>
        </div>
        <article class="sp-card sp-cal-card">
            <div class="sp-cal-nav">
                <button type="button" @onclick="PrevMonth" aria-label="@Locale.T("stu.prevMonth")">‹</button>
                <strong>@MonthTitle</strong>
                <button type="button" @onclick="NextMonth" aria-label="@Locale.T("stu.nextMonth")">›</button>
            </div>
            <div class="sp-cal">
                <div class="sp-cal-head">
                    @foreach (var day in WeekDays)
                    {
                        <span class="@(day is "শুক্র" or "Fri" ? "is-friday" : null)">@day</span>
                    }
                </div>
                <div class="sp-cal-grid">
                    @foreach (var cell in CalendarCells)
                    {
                        @if (cell.Date is null)
                        {
                            <div class="sp-cal-cell is-empty"></div>
                        }
                        else
                        {
                            <button type="button" class="sp-cal-cell @cell.Css" title="@cell.Title" @onclick="() => OpenDay(cell)">
                                <span class="sp-cal-num">@cell.Date.Value.Day</span>
                                @if (!string.IsNullOrWhiteSpace(cell.Status))
                                {
                                    <span class="sp-cal-st">@cell.Status</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(cell.Entry) || !string.IsNullOrWhiteSpace(cell.Exit))
                                {
                                    <div class="sp-cal-times">
                                        @if (!string.IsNullOrWhiteSpace(cell.Entry))
                                        {
                                            <small>@cell.Entry</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cell.Exit))
                                        {
                                            <small>@cell.Exit</small>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(cell.Note))
                                {
                                    <small class="sp-cal-note">@cell.Note</small>
                                }
                            </button>
                        }
                    }
                </div>
            </div>
        </article>
    }
</div>

@if (selected is { Date: not null })
{
    <div class="sp-day-back" @onclick="CloseDay">
        <div class="sp-day-pop @selected.Css" @onclick:stopPropagation="true">
            <header class="sp-day-head">
                <div>
                    <small>@Locale.T("stu.dayDetails")</small>
                    <h3>@DayTitle(selected)</h3>
                </div>
                <button type="button" class="sp-day-x" @onclick="CloseDay" aria-label="@Locale.T("stu.close")">×</button>
            </header>
            <dl class="sp-day-rows">
                <div>
                    <dt>@Locale.T("stu.status")</dt>
                    <dd><span class="sp-day-st">@(StatusLabel(selected.Status)
                        ?? (selected.Css.Contains("is-hol") ? Locale.T("stu.holidays") : Locale.T("stu.empty")))</span></dd>
                </div>
                <div>
                    <dt>@Locale.T("stu.entryTime")</dt>
                    <dd>@(selected.Entry ?? "—")</dd>
                </div>
                <div>
                    <dt>@Locale.T("stu.exitTime")</dt>
                    <dd>@(selected.Exit ?? "—")</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(selected.Note))
                {
                    <div>
                        <dt>@NoteLabel(selected)</dt>
                        <dd>@selected.Note</dd>
                    </div>
                }
            </dl>
            <button type="button" class="sp-day-ok" @onclick="CloseDay">@Locale.T("stu.close")</button>
        </div>
    </div>
}

@code {
    private StudentPortalAttendanceDto data = new();
    private bool loading = true;
    private DateTime calMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private CalCell? selected;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsTeacher) { Nav.NavigateTo(Session.HomePath, replace: true); return; }
        try
        {
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                data = await Api.GetTeacherPortalAttendanceAsync(Session.AccessToken);
                var last = data.Days.LastOrDefault()?.Date;
                calMonth = last is DateTime d && d > DateTime.MinValue
                    ? new DateTime(d.Year, d.Month, 1)
                    : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            }
        }
        catch { }
        loading = false;
    }

    private int HolidayCount => data.Holidays
        .Where(x => x.Date > DateTime.MinValue)
        .Select(x => x.Date.Date)
        .Distinct()
        .Count();

    private void PrevMonth() => calMonth = calMonth.AddMonths(-1);
    private void NextMonth() => calMonth = calMonth.AddMonths(1);
    private void OpenDay(CalCell cell) => selected = cell;
    private void CloseDay() => selected = null;

    private string DayTitle(CalCell cell) =>
        cell.Date?.ToString("dddd, d MMMM yyyy", Locale.IsBengali
            ? new System.Globalization.CultureInfo("bn-BD")
            : System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private string? StatusLabel(string? status)
    {
        var key = (status ?? "").Trim();
        if (key.Length == 0) return null;
        if (key.Equals("Pre", StringComparison.OrdinalIgnoreCase) || key.Equals("Present", StringComparison.OrdinalIgnoreCase))
            return Locale.T("stu.present");
        if (key.Equals("Abs", StringComparison.OrdinalIgnoreCase))
            return Locale.T("stu.absent");
        if (key.Equals("Late", StringComparison.OrdinalIgnoreCase))
            return Locale.T("stu.late");
        if (key.Equals("Leave", StringComparison.OrdinalIgnoreCase) || key == Locale.T("stu.leave"))
            return Locale.T("stu.leave");
        if (key.Contains("Late", StringComparison.OrdinalIgnoreCase))
            return Locale.T("stu.lateAbs");
        return key;
    }

    private string NoteLabel(CalCell cell) =>
        cell.Css.Contains("is-hol") ? Locale.T("stu.holidays")
        : cell.Css.Contains("is-leave") ? Locale.T("stu.leave")
        : Locale.T("stu.notice");

    private string MonthTitle =>
        calMonth.ToString("MMMM yyyy", Locale.IsBengali
            ? new System.Globalization.CultureInfo("bn-BD")
            : System.Globalization.CultureInfo.InvariantCulture);

    private string[] WeekDays => Locale.IsBengali
        ? ["শনি", "রবি", "সোম", "মঙ্গল", "বুধ", "বৃহস্পতি", "শুক্র"]
        : ["Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri"];

    private List<CalCell> CalendarCells
    {
        get
        {
            var first = new DateTime(calMonth.Year, calMonth.Month, 1);
            var startOffset = ((int)first.DayOfWeek - (int)DayOfWeek.Saturday + 7) % 7;
            var daysInMonth = DateTime.DaysInMonth(calMonth.Year, calMonth.Month);
            var att = data.Days
                .Where(x => x.Date > DateTime.MinValue)
                .GroupBy(x => x.Date.Date)
                .ToDictionary(g => g.Key, MergeDay);
            var hol = data.Holidays
                .Where(x => x.Date > DateTime.MinValue)
                .GroupBy(x => x.Date.Date)
                .ToDictionary(g => g.Key, g => g.First());
            var cells = new List<CalCell>(42);
            for (var i = 0; i < startOffset; i++)
                cells.Add(new CalCell());
            for (var d = 1; d <= daysInMonth; d++)
            {
                var date = new DateTime(calMonth.Year, calMonth.Month, d);
                var cell = new CalCell { Date = date };
                var css = date.Date == DateTime.Today ? "is-today" : "";
                if (att.TryGetValue(date, out var day) && !string.IsNullOrWhiteSpace(day.Status))
                {
                    cell.Status = day.Status;
                    cell.Entry = CompactTime(day.EntryTime);
                    cell.Exit = CompactTime(day.ExitTime);
                    css = $"{css} {Css(day.Status)}".Trim();
                }
                if (hol.TryGetValue(date, out var holiday))
                {
                    css = $"{(date.Date == DateTime.Today ? "is-today " : "")}is-hol";
                    cell.Note = holiday.Name;
                }
                else if (string.IsNullOrWhiteSpace(cell.Status))
                {
                    var lv = data.Leaves.FirstOrDefault(x =>
                        x.StartDate > DateTime.MinValue && date >= x.StartDate.Date && date <= x.EndDate.Date);
                    if (lv is not null)
                    {
                        css = $"{(date.Date == DateTime.Today ? "is-today " : "")}is-leave";
                        cell.Status = Locale.T("stu.leave");
                        if (!string.IsNullOrWhiteSpace(lv.LeaveType))
                            cell.Note = lv.LeaveType;
                    }
                }
                if (date.DayOfWeek == DayOfWeek.Friday)
                    css = $"{css} is-friday".Trim();
                cell.Css = css.Trim();
                cell.Title = string.Join(" · ", new[] { date.ToString("d MMM yyyy"), cell.Status, cell.Entry, cell.Exit, cell.Note }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
                cells.Add(cell);
            }
            while (cells.Count % 7 != 0)
                cells.Add(new CalCell());
            return cells;
        }
    }

    private static string Css(string status)
    {
        var key = (status ?? "").Trim();
        if (key.Equals("Pre", StringComparison.OrdinalIgnoreCase) || key.Equals("Present", StringComparison.OrdinalIgnoreCase))
            return "is-pre";
        if (key.Equals("Abs", StringComparison.OrdinalIgnoreCase))
            return "is-abs";
        if (key.Equals("Late", StringComparison.OrdinalIgnoreCase))
            return "is-late";
        if (key.Equals("Leave", StringComparison.OrdinalIgnoreCase))
            return "is-leave";
        if (key.Contains("Late", StringComparison.OrdinalIgnoreCase))
            return "is-lateabs";
        return "";
    }

    private sealed class CalCell
    {
        public DateTime? Date { get; set; }
        public string Css { get; set; } = "";
        public string? Status { get; set; }
        public string? Entry { get; set; }
        public string? Exit { get; set; }
        public string? Note { get; set; }
        public string Title { get; set; } = "";
    }

    private static StudentPortalAttendanceDayDto MergeDay(IGrouping<DateTime, StudentPortalAttendanceDayDto> rows)
    {
        var list = rows.ToList();
        var pick = list.Last();
        var entries = list.Select(x => CompactTime(x.EntryTime)).OfType<string>().ToList();
        var exits = list.Select(x => CompactTime(x.ExitTime)).OfType<string>().ToList();
        pick.EntryTime = entries.FirstOrDefault();
        pick.ExitTime = exits.LastOrDefault();
        if (string.IsNullOrWhiteSpace(pick.Status))
            pick.Status = list.Select(x => x.Status).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";
        return pick;
    }

    private static string? CompactTime(string? value)
    {
        var text = (value ?? "").Trim();
        if (text.Length == 0) return null;
        if (!DateTime.TryParse(text, out var time) &&
            !DateTime.TryParseExact(text, ["HH:mm:ss", "HH:mm", "h:mm tt", "hh:mm tt"],
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out time))
            return text;

        if (time.TimeOfDay == TimeSpan.Zero)
            return null;
        return time.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
    }
}
