@page "/teacher/more"
@layout TeacherLayout
@inherits LocaleAwareComponent
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav
@inject TeacherFeedbackInbox FeedbackInbox

<div class="sp-page">
    <h1>@Locale.T("stu.more")</h1>
    <article class="sp-card sp-more">
        <a href="teacher/report">
            <i class="is-purple">@ReportIco</i>
            <span>@Locale.T("tch.report")</span>
            <em>→</em>
        </a>
        <a href="teacher/feedback">
            <i class="is-orange">@FbIco</i>
            <span>@Locale.T("fb.title")</span>
            @if (FeedbackInbox.UnreadCount > 0)
            {
                <b class="sp-nbadge sp-more-badge">@FeedbackInbox.BadgeText</b>
            }
            <em>→</em>
        </a>
        <a href="teacher/subjects">
            <i class="is-purple">@BookIco</i>
            <span>@Locale.T("tch.classSubjects")</span>
            <em>→</em>
        </a>
        <a href="teacher/cv">
            <i class="is-teal">@CvIco</i>
            <span>@Locale.T("tch.cv")</span>
            <em>→</em>
        </a>
        <a href="teacher/cv/print">
            <i class="is-orange">@PrintIco</i>
            <span>@Locale.T("tch.cvPrint")</span>
            <em>→</em>
        </a>
        <a href="teacher/password">
            <i class="is-slate">@LockIco</i>
            <span>@Locale.T("stu.password")</span>
            <em>→</em>
        </a>
    </article>
    <button type="button" class="sp-out" @onclick="Logout">@Locale.T("stu.logout")</button>
</div>

@code {
    private static readonly MarkupString BookIco = Ico("""<path d="M5 5.2A2.2 2.2 0 0 1 7.2 3H12v16.5H7.4A2.4 2.4 0 0 0 5 21.9V5.2Z"/><path d="M19 5.2A2.2 2.2 0 0 0 16.8 3H12v16.5h4.6A2.4 2.4 0 0 1 19 21.9V5.2Z"/>""");
    private static readonly MarkupString ReportIco = Ico("""<path d="M4 19.2A2.4 2.4 0 0 1 6.4 16.8H20"/><path d="M6.4 3h13.6v18H6.4A2.4 2.4 0 0 1 4 18.6V5.4A2.4 2.4 0 0 1 6.4 3Z"/>""");
    private static readonly MarkupString FbIco = Ico("""<path d="M4.5 6.2h15A1.5 1.5 0 0 1 21 7.7v8.6a1.5 1.5 0 0 1-1.5 1.5H9.2L4 21v-3.2H4.5A1.5 1.5 0 0 1 3 16.3V7.7A1.5 1.5 0 0 1 4.5 6.2Z"/>""");
    private static readonly MarkupString CvIco = Ico("""<rect x="5" y="3.2" width="14" height="17.6" rx="2"/><path d="M9 7.2h6M9 11h6M9 14.8h4"/>""");
    private static readonly MarkupString PrintIco = Ico("""<path d="M7 9V4.5h10V9M7 15H5.4A1.4 1.4 0 0 1 4 13.6V10.4A1.4 1.4 0 0 1 5.4 9h13.2A1.4 1.4 0 0 1 20 10.4v3.2A1.4 1.4 0 0 1 18.6 15H17M7 13h10v7H7z"/>""");
    private static readonly MarkupString LockIco = Ico("""<rect x="5.2" y="10.5" width="13.6" height="9.3" rx="2"/><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"/>""");

    protected override void OnInitialized()
    {
        if (!Session.IsTeacher)
            Nav.NavigateTo(Session.HomePath, replace: true);
        FeedbackInbox.Changed += OnInbox;
        _ = FeedbackInbox.RefreshAsync();
    }

    private void OnInbox() => _ = InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Session.Clear();
        Nav.NavigateTo("/login", replace: true);
    }

    public override void Dispose()
    {
        FeedbackInbox.Changed -= OnInbox;
        base.Dispose();
    }

    private static MarkupString Ico(string inner) =>
        (MarkupString)$"""<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{inner}</svg>""";
}
