@page "/basic-settings/assign-subjects"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page">
    <h1>@Locale.T("asgn.title")</h1>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok">@message</div>
    }

    <div class="filter-row">
        <select @bind="classInput" @bind:after="OnClassChanged" disabled="@busy">
            <option value="0">@Locale.T("asgn.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        @if (groups.Count > 0)
        {
            <select @bind="groupInput" @bind:after="OnGroupChanged" disabled="@busy">
                <option value="0">@Locale.T("asgn.selectGroup")</option>
                @foreach (var item in groups)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
    </div>

    @if (classReady)
    {
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("asgn.subjects")</th>
                    <th class="act">@Locale.T("asgn.select")</th>
                    <th>@Locale.T("asgn.subjectIs")</th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0)
            {
                <tr><td colspan="3" class="empty-row">@Locale.T("asgn.empty")</td></tr>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <tr class="@(row.Selected ? "is-allowed" : null)">
                        <td>@row.SubjectName</td>
                        <td class="act">
                            <input type="checkbox" checked="@row.Selected" disabled="@busy"
                                   @onchange="e => Toggle(row, e)" />
                        </td>
                        <td>
                            <span class="readm-type">
                                <label class="choice-inline">
                                    <input type="radio" name="type-@row.SubjectID" disabled="@busy"
                                           checked="@(row.SubjectType == "Compulsory")"
                                           @onchange="@(() => row.SubjectType = "Compulsory")" />
                                    <span>@Locale.T("readm.compulsory")</span>
                                </label>
                                <label class="choice-inline">
                                    <input type="radio" name="type-@row.SubjectID" disabled="@busy"
                                           checked="@(row.SubjectType == "Optional")"
                                           @onchange="@(() => row.SubjectType = "Optional")" />
                                    <span>@Locale.T("readm.optional")</span>
                                </label>
                            </span>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>

        <div class="asgn-actions">
            <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveAsync">@Locale.T("asgn.assign")</button>
            <button type="button" class="link-btn danger" disabled="@busy" @onclick="ClearAsync">@Locale.T("asgn.removeAll")</button>
        </div>
    }
</div>

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [];
    private readonly List<ClassSubjectRowDto> rows = [];
    private string classInput = "0";
    private string groupInput = "0";
    private bool busy;
    private string? error;
    private string? message;

    private int ClassId => int.TryParse(classInput, out var id) ? id : 0;
    private int GroupId => groups.Count == 0 ? 0 : int.TryParse(groupInput, out var id) ? id : 0;
    private bool classReady => ClassId > 0 && (groups.Count == 0 || GroupId > 0);

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        await LoadStructureAsync();
    }

    private async Task LoadStructureAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
            {
                error = Locale.T("subj.needOnline");
                return;
            }

            var structure = await Api.GetClassStructureAsync(Session.AccessToken);
            classes.Clear();
            classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnClassChanged()
    {
        message = null;
        groupInput = "0";
        rows.Clear();
        groups.Clear();
        if (ClassId <= 0)
            return;

        try
        {
            var structure = await Api.GetClassStructureAsync(Session.AccessToken);
            groups.AddRange(structure.Groups.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
            if (groups.Count == 0)
                await LoadRowsAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
    }

    private Task OnGroupChanged() => LoadRowsAsync();

    private async Task LoadRowsAsync()
    {
        if (!classReady || string.IsNullOrWhiteSpace(Session.AccessToken))
            return;

        busy = true;
        error = null;
        try
        {
            rows.Clear();
            rows.AddRange(await Api.GetClassSubjectsAsync(Session.AccessToken, ClassId, GroupId));
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void Toggle(ClassSubjectRowDto row, ChangeEventArgs e)
    {
        row.Selected = e.Value is bool flag && flag || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!row.Selected)
            row.SubjectType = null;
    }

    private async Task SaveAsync()
    {
        message = null;
        error = null;
        var selected = rows.Where(x => x.Selected).ToList();
        if (selected.Count == 0)
        {
            error = Locale.T("asgn.needSubject");
            return;
        }

        if (selected.Any(x => string.IsNullOrWhiteSpace(x.SubjectType)))
        {
            error = Locale.T("asgn.needType");
            return;
        }

        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.SaveClassSubjectsAsync(Session.AccessToken, new SaveClassSubjectsRequest
            {
                ClassID = ClassId,
                SubjectGroupID = GroupId,
                Items = selected.Select(x => new ClassSubjectChoice
                {
                    SubjectID = x.SubjectID,
                    SubjectType = x.SubjectType ?? ""
                }).ToList()
            });
            if (!result.Succeeded)
            {
                error = Locale.T(result.Error ?? "asgn.failed");
                return;
            }

            message = Locale.T("asgn.ok");
            await LoadRowsAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ClearAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("asgn.removeConfirm")))
            return;

        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        message = null;
        error = null;
        try
        {
            var result = await Api.ClearClassSubjectsAsync(Session.AccessToken, ClassId, GroupId);
            if (!result.Succeeded)
            {
                error = Locale.T(result.Error ?? "asgn.failed");
                return;
            }

            message = Locale.T("asgn.cleared");
            await LoadRowsAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
