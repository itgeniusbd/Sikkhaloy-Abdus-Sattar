@page "/student-mgmt/edit"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject SyncEngine Sync
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="card structure-page emp-page">
    <h1>@Locale.T("sm.editInfo")</h1>
    <p class="muted">@Locale.T("sm.crumb")</p>
    <p class="muted">@Locale.T("sm.editHint")</p>
    <p class="muted">@Locale.T("sm.photoHint")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok">@message</div>
    }

    <div class="filter-row">
        <select @bind="classInput" @bind:after="OnClassChanged" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        @if (groups.Count > 0)
        {
            <select @bind="groupInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allGroup")</option>
                @foreach (var item in groups)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (sections.Count > 0)
        {
            <select @bind="sectionInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allSection")</option>
                @foreach (var item in sections)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (shifts.Count > 0)
        {
            <select @bind="shiftInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allShift")</option>
                @foreach (var item in shifts)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        <input class="id-find" type="text" placeholder="@Locale.T("si.enterId")" @bind="findId" disabled="@busy" />
        <button type="button" class="btn-serial" disabled="@busy" @onclick="FindByIdAsync">@Locale.T("si.find")</button>
        <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveAsync">@Locale.T("si.update")</button>
    </div>

    <table class="mgrid">
        <thead>
            <tr>
                <th>@Locale.T("sm.photo")</th>
                <th>@Locale.T("si.id")</th>
                <th>@Locale.T("si.name")</th>
                <th>@Locale.T("si.father")</th>
                <th>@Locale.T("si.phone")</th>
                <th>@Locale.T("si.roll")</th>
                <th>@Locale.T("sm.seat")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (rows.Count == 0 && !busy)
        {
            <tr><td colspan="8" class="empty-row">@Locale.T("si.empty")</td></tr>
        }
        else
        {
            @foreach (var row in rows)
            {
                <tr @key="row.StudentID">
                    <td>
                        <label class="sm-photo">
                            @if (!string.IsNullOrWhiteSpace(row.PhotoDataUrl))
                            {
                                <img src="@row.PhotoDataUrl" alt="" />
                            }
                            else
                            {
                                <span class="sm-photo-empty">@Locale.T("si.noPhoto")</span>
                            }
                            <span class="sm-photo-edit" title="@Locale.T("sm.photo")">✎</span>
                            <InputFile class="sm-photo-file"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       OnChange="e => OnPhotoAsync(row, e)"
                                       disabled="@(busy || photoBusy.Contains(row.StudentID))" />
                            @{
                                var kb = PhotoKb(row.PhotoDataUrl);
                            }
                            @if (kb > 0)
                            {
                                <span class="sm-photo-kb">@kb KB</span>
                            }
                        </label>
                    </td>
                    <td>@row.ID</td>
                    <td>@row.StudentsName</td>
                    <td>@row.FathersName</td>
                    <td>@row.Phone</td>
                    <td><input class="sm-cell" @bind="row.RollNo" disabled="@busy" /></td>
                    <td><input class="sm-cell" @bind="row.SeatNo" disabled="@busy" /></td>
                    <td><button type="button" class="link-btn" disabled="@busy" @onclick="() => OpenEdit(row)">@Locale.T("sm.updateInfo")</button></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [];
    private readonly List<ClassPartDto> sections = [];
    private readonly List<ClassPartDto> shifts = [];
    private readonly List<SmStudentRowDto> rows = [];
    private ClassStructureDto? structure;
    private string classInput = "0";
    private string groupInput = "0";
    private string sectionInput = "0";
    private string shiftInput = "0";
    private string findId = "";
    private bool busy;
    private readonly HashSet<int> photoBusy = [];
    private string? error;
    private string? message;

    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int GroupId => int.TryParse(groupInput, out var n) ? n : 0;
    private int SectionId => int.TryParse(sectionInput, out var n) ? n : 0;
    private int ShiftId => int.TryParse(shiftInput, out var n) ? n : 0;

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureOnlineAsync())
            return;
        structure = await Api.GetClassStructureAsync(Session.AccessToken);
        classes.Clear();
        classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
    }

    private async Task OnClassChanged()
    {
        groupInput = sectionInput = shiftInput = "0";
        findId = "";
        ApplyParts();
        await LoadAsync();
    }

    private void ApplyParts()
    {
        groups.Clear();
        sections.Clear();
        shifts.Clear();
        if (structure is null || ClassId <= 0)
            return;
        groups.AddRange(structure.Groups.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        sections.AddRange(structure.Sections.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        shifts.AddRange(structure.Shifts.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
    }

    private async Task FindByIdAsync()
    {
        classInput = "0";
        groupInput = sectionInput = shiftInput = "0";
        groups.Clear();
        sections.Clear();
        shifts.Clear();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        if (string.IsNullOrWhiteSpace(findId) && ClassId <= 0)
        {
            rows.Clear();
            return;
        }

        busy = true;
        try
        {
            var data = await Api.GetSmStudentsAsync(Session.AccessToken, ClassId, GroupId, SectionId, ShiftId, findId, null);
            rows.Clear();
            rows.AddRange(data);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnPhotoAsync(SmStudentRowDto row, InputFileChangeEventArgs e)
    {
        error = message = null;
        var file = e.File;
        if (file is null)
            return;

        var name = (file.Name ?? "").ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        var ok = type.Contains("jpeg") || type.Contains("jpg") || type.Contains("png") || type.Contains("webp")
                 || name.EndsWith(".jpg") || name.EndsWith(".jpeg") || name.EndsWith(".png") || name.EndsWith(".webp");
        if (!ok)
        {
            error = Locale.T("sm.badPhoto");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;

        photoBusy.Add(row.StudentID);
        try
        {
            IBrowserFile work = file;
            try
            {
                work = await file.RequestImageFileAsync("image/jpeg", 800, 800);
            }
            catch (NotSupportedException)
            {
                // Browser resize is optional; JS compression still runs below.
            }

            await using var stream = work.OpenReadStream(2_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var raw = ms.ToArray();
            if (raw.Length == 0)
            {
                error = Locale.T("sm.needPhoto");
                return;
            }

            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(raw)}";
            var compressed = await JS.InvokeAsync<string>("sikkhaloyCompressImage", dataUrl, 250, 0.7, 40_960);
            if (string.IsNullOrWhiteSpace(compressed) || !compressed.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            {
                error = Locale.T("sm.badPhoto");
                return;
            }

            var kb = PhotoKb(compressed);
            var result = await Api.SaveStudentPhotoAsync(Session.AccessToken, new SaveStudentPhotoRequest
            {
                StudentID = row.StudentID,
                ImageBase64 = compressed
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            row.PhotoDataUrl = compressed;
            if (result.Count > 0)
                row.StudentImageID = result.Count;
            if (Session.Current is not null)
                Sync.SaveStudentPhoto(Session.Current.SchoolID, row.StudentID, compressed);
            message = Locale.T("sm.okPhoto", kb);
        }
        catch (JSException)
        {
            error = Locale.T("sm.badPhoto");
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            photoBusy.Remove(row.StudentID);
        }
    }

    private static int PhotoKb(string? dataUrl)
    {
        if (string.IsNullOrWhiteSpace(dataUrl))
            return 0;
        var comma = dataUrl.IndexOf(',');
        var b64 = comma >= 0 ? dataUrl[(comma + 1)..] : dataUrl;
        return Math.Max(1, (int)Math.Round(b64.Length * 0.75 / 1024.0));
    }

    private async Task SaveAsync()
    {
        error = message = null;
        if (rows.Count == 0)
        {
            error = Locale.T("sm.needStudents");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            var result = await Api.SaveSmRollsAsync(Session.AccessToken, new SaveRollSeatRequest
            {
                Items = rows.Select(x => new SaveRollSeatItem
                {
                    StudentClassID = x.StudentClassID,
                    RollNo = x.RollNo,
                    SeatNo = x.SeatNo
                }).ToList()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            message = Locale.T("sm.okRolls", result.Count);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OpenEdit(SmStudentRowDto row)
    {
        error = null;
        if (Session.Current is null)
            return;
        var locals = await Sync.ListStudentsAsync(Session.Current.SchoolID, Session.Current.EducationYearID);
        var match = locals.FirstOrDefault(x => x.ServerId == row.StudentID);
        if (match is null)
        {
            error = Locale.T("sm.needSync");
            return;
        }

        Nav.NavigateTo($"students/{match.LocalId}");
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("si.failed") : Locale.T(key);
}
