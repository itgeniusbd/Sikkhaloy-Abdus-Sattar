@page "/basic-settings/institution"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject SyncEngine Sync
@inject ISyncApiClient Api

<div class="card sa-page ii-page">
    <header class="sa-head">
        <p class="sa-kicker">@Locale.T("inst.kicker")</p>
        <h1>@Locale.T("inst.title")</h1>
        <p class="sa-lead">@Locale.T("inst.lead")</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText))
    {
        <NetBanner Text="@error" />
    }

    <div class="sa-form">
        <label class="sa-field">@Locale.T("inst.name")<input @bind="form.SchoolName" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.dialog")<input @bind="form.InstitutionDialog" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.established")<input @bind="form.Established" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.principal")<input @bind="form.Principal" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.staff")<input @bind="form.AcadamicStaff" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.students")<input @bind="form.Students" disabled="@busy" /></label>
        <label class="sa-field span-2">@Locale.T("inst.address")<input @bind="form.Address" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.city")<input @bind="form.City" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.state")<input @bind="form.State" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.local")<input @bind="form.LocalArea" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.postal")<input @bind="form.PostalCode" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.phone")<input @bind="form.Phone" disabled="@busy" /></label>
        <label class="sa-field">@Locale.T("inst.email")<input @bind="form.Email" disabled="@busy" /></label>
        <label class="sa-field span-2">@Locale.T("inst.website")<input @bind="form.Website" disabled="@busy" /></label>
    </div>

    <div class="ii-media">
        <article class="ii-card">
            <h3>@Locale.T("inst.logo")</h3>
            <div class="ii-preview is-square">
                @if (!string.IsNullOrWhiteSpace(logoPreview))
                {
                    <img src="@logoPreview" alt="" />
                }
                else
                {
                    <em>@Locale.T("inst.noLogo")</em>
                }
            </div>
            <label class="ii-pick">
                <span>@(string.IsNullOrWhiteSpace(logoPreview) ? Locale.T("inst.chooseFile") : Locale.T("inst.changeFile"))</span>
                <InputFile OnChange="OnLogo" accept=".png,.jpg,.jpeg" disabled="@busy" />
            </label>
            <small>@Locale.T("inst.logoHint")</small>
        </article>

        <article class="ii-card ii-nameplate">
            <h3>@Locale.T("inst.nameLogo")</h3>
            <div class="ii-preview is-wide">
                @if (!string.IsNullOrWhiteSpace(nameLogoPreview))
                {
                    <img src="@nameLogoPreview" alt="" />
                }
                else
                {
                    <em>@Locale.T("inst.noNameLogo")</em>
                }
            </div>
            <div class="ii-name-act">
                <label class="ii-pick">
                    <span>@(string.IsNullOrWhiteSpace(nameLogoPreview) ? Locale.T("inst.chooseFile") : Locale.T("inst.changeFile"))</span>
                    <InputFile OnChange="OnNameLogo" accept=".png,.jpg,.jpeg" disabled="@busy" />
                </label>
                @if (!string.IsNullOrWhiteSpace(nameLogoPreview))
                {
                    <button type="button" class="link-btn danger" disabled="@busy" @onclick="ClearNameLogoAsync">@Locale.T("inst.deleteNameLogo")</button>
                }
            </div>
            <div class="ii-guide">
                <p class="ii-guide-title">@Locale.T("inst.guide.title")</p>
                <ul>
                    <li><b>@Locale.T("inst.guide.format")</b> @Locale.T("inst.guide.formatVal")</li>
                    <li><b>@Locale.T("inst.guide.size")</b> @Locale.T("inst.guide.sizeVal")</li>
                    <li><b>@Locale.T("inst.guide.ratio")</b> @Locale.T("inst.guide.ratioVal")</li>
                    <li><b>@Locale.T("inst.guide.res")</b> @Locale.T("inst.guide.resVal")</li>
                    <li><b>@Locale.T("inst.guide.max")</b> @Locale.T("inst.guide.maxVal")</li>
                    <li><b>@Locale.T("inst.guide.example")</b> @Locale.T("inst.guide.exampleVal")</li>
                </ul>
                <p class="ii-guide-tip">@Locale.T("inst.guide.tip")</p>
            </div>
        </article>
    </div>

    <div class="sa-foot">
        <button type="button" class="btn-primary @(saving ? "is-busy" : null) @(saved ? "is-done" : null)"
                disabled="@busy" @onclick="SaveAsync">
            @if (saving)
            {
                <i class="ii-spin"></i>
            }
            @(saving ? Locale.T("inst.updating") : saved ? Locale.T("inst.updated") : Locale.T("inst.update"))
        </button>
        @if (saved)
        {
            <span class="ii-save-ok">@Locale.T("inst.ok")</span>
        }
    </div>
</div>

<ExamBusyOverlay Busy="saving" Title="@Locale.T("inst.updating")" Message="@Locale.T("inst.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private InstitutionDto form = new();
    private string? logoPreview;
    private string? nameLogoPreview;
    private string? newLogo;
    private string? newNameLogo;
    private bool clearNameLogo;
    private bool busy;
    private bool saving;
    private bool saved;
    private string? error;
    private string popupText = "";
    private bool popupError;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
            {
                error = Locale.T("subj.needOnline");
                return;
            }

            form = await Api.GetInstitutionAsync(Session.AccessToken);
            logoPreview = form.LogoDataUrl;
            nameLogoPreview = form.NameLogoDataUrl;
            newLogo = null;
            newNameLogo = null;
            clearNameLogo = false;
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnLogo(InputFileChangeEventArgs e) =>
        (newLogo, logoPreview) = await ReadImageAsync(e, 1_500_000, "inst.badLogo");

    private async Task OnNameLogo(InputFileChangeEventArgs e)
    {
        (newNameLogo, nameLogoPreview) = await ReadImageAsync(e, 1_000_000, "inst.badNameLogo");
        if (newNameLogo is not null)
            clearNameLogo = false;
    }

    private async Task<(string? b64, string? preview)> ReadImageAsync(InputFileChangeEventArgs e, long maxBytes, string errorKey)
    {
        var file = e.File;
        if (file is null)
            return (null, null);
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var b64 = Convert.ToBase64String(bytes);
            var mime = file.ContentType is { Length: > 0 } t ? t : "image/jpeg";
            return (b64, $"data:{mime};base64,{b64}");
        }
        catch (Exception)
        {
            error = Locale.T(errorKey);
            return (null, null);
        }
    }

    private async Task ClearNameLogoAsync()
    {
        clearNameLogo = true;
        newNameLogo = null;
        nameLogoPreview = null;
        await SaveAsync();
    }

    private void ClosePopup() => popupText = "";

    private void Show(string value, bool err = false)
    {
        popupText = value;
        popupError = err;
        saved = !err;
        error = err ? value : null;
    }

    private async Task BeginSaveAsync()
    {
        saving = true;
        busy = true;
        saved = false;
        popupText = "";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private async Task SaveAsync()
    {
        error = null;
        saved = false;
        if (string.IsNullOrWhiteSpace(form.SchoolName))
        {
            Show(Locale.T("inst.needName"), true);
            return;
        }

        await BeginSaveAsync();
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
            {
                Show(Locale.T("subj.needOnline"), true);
                return;
            }

            form.LogoBase64 = newLogo;
            form.NameLogoBase64 = newNameLogo;
            form.ClearNameLogo = clearNameLogo;
            var result = await Api.SaveInstitutionAsync(Session.AccessToken, form);
            if (!result.Succeeded || result.Data is null)
            {
                Show(Locale.T(result.Error ?? "inst.failed"), true);
                return;
            }

            form = result.Data;
            logoPreview = form.LogoDataUrl;
            nameLogoPreview = form.NameLogoDataUrl;
            newLogo = null;
            newNameLogo = null;
            clearNameLogo = false;
            if (Session.Current is not null)
                Session.Current.SchoolName = form.SchoolName;
            Sync.RefreshSchoolHeader(new OfficeProfileDto
            {
                SchoolID = form.SchoolID,
                SchoolName = form.SchoolName,
                Address = form.Address ?? "",
                Phone = form.Phone ?? "",
                Email = form.Email ?? "",
                LogoBase64 = form.LogoDataUrl,
                NameLogoBase64 = form.NameLogoDataUrl,
                ClearNameLogo = string.IsNullOrWhiteSpace(form.NameLogoDataUrl)
            });
            Session.NotifyChanged();
            Show(Locale.T("inst.ok"));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            saving = false;
            busy = false;
        }
    }
}
