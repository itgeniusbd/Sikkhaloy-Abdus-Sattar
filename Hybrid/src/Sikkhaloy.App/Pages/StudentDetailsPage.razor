    private async Task SaveFaultBulkAsync()
    {
        if (student is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            faultModalError = Locale.T("report.needOnline");
            return;
        }

        var items = faultBulkRows
            .Select(x => new StudentFaultReportLineRequest
            {
                Title = x.Title.Trim(),
                Body = x.Body.Trim()
            })
            .Where(x => x.Title.Length > 0 && x.Body.Length > 0)
            .ToList();
        if (items.Count == 0)
        {
            faultModalError = Locale.T("report.faultNeedBody");
            return;
        }

        faultSaving = true;
        faultModalError = null;
        try
        {
            var result = await Api.SaveStudentFaultReportsBulkAsync(Session.AccessToken, new SaveStudentFaultReportsBulkRequest
            {
                StudentCode = student.StudentCode,
                Date = faultBulkDate,
                Items = items
            });
            if (!result.Succeeded)
            {
                faultModalError = FaultResultMessage(result.Error);
                return;
            }

            showFaultBulkModal = false;
            faultOk = Locale.T("report.bulkSaved", result.Count > 0 ? result.Count : items.Count);
            faultLoaded = false;
            await SaveFaultBulkDraftsAsync();
            await LoadFaultReportsAsync();
        }
        catch (HttpRequestException ex)
        {
            faultModalError = FaultErrorMessage(ex);
        }
        catch (Exception ex)
        {
            faultModalError = FaultErrorMessage(ex);
        }
        finally
        {
            faultSaving = false;
        }
    }

