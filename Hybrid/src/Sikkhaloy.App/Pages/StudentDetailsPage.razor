        }
        finally
        {
            faultBusy = false;
        }
    }

    private static string FmtFaultDate(DateTime? value) =>
        value is DateTime d ? d.ToString("d MMM yyyy") : "—";

    private string FaultResultMessage(string? errorKey)
    {
        if (string.IsNullOrWhiteSpace(errorKey))
            return Locale.T("report.faultFailed");
        if (errorKey.Equals("si.failed", StringComparison.OrdinalIgnoreCase))
            return Locale.T("report.faultFailed");
        return Locale.T(errorKey);
    }

    private string FaultErrorMessage(Exception ex)
    {
        if (ex is HttpRequestException http)
        {
            if (http.StatusCode == System.Net.HttpStatusCode.NotFound)
                return Locale.T("report.faultApiMissing");
            if (http.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
                return Locale.T("login.expired");
            if (!Sync.IsOnline)
                return Locale.T("report.needOnline");
        }
        else if (ex is TaskCanceledException && !Sync.IsOnline)
        {
            return Locale.T("report.needOnline");
        }

        return Locale.T("report.faultFailed");
    }

    private string FaultBulkDraftKey()
    {
        if (student is null || Session.Current is null || string.IsNullOrWhiteSpace(student.StudentCode))
            return "";
        return $"{Session.Current.SchoolID}:{Session.Current.EducationYearID}:{student.StudentCode.Trim()}";
    }

    private async Task LoadFaultBulkDraftsAsync()
    {
        var key = FaultBulkDraftKey();
        if (key.Length == 0)
            return;

        try
        {
            var draft = await JS.InvokeAsync<FaultBulkDraft?>("sikkhaloyFaultBulkLoad", key);
            if (draft?.Rows is { Count: > 0 } savedRows)
            {
                faultBulkRows = savedRows.Select(x => new FaultBulkRow
                {
                    Key = x.Key ?? "",
                    Title = x.Title ?? "",
                    Body = x.Body ?? ""
                }).ToList();
                return;
            }

            if (draft?.Bodies is { Count: > 0 } legacyBodies)
            {
                foreach (var row in faultBulkRows)
                {
                    if (row.Key.Length > 0 && legacyBodies.TryGetValue(row.Key, out var body))
                        row.Body = body;
                }
            }
        }
        catch
        {
        }
    }

    private async Task SaveFaultBulkDraftsAsync()
    {
        var key = FaultBulkDraftKey();
        if (key.Length == 0)
            return;

        var draft = new FaultBulkDraft
        {
            Rows = faultBulkRows.Select(x => new FaultBulkDraftRow
            {
                Key = x.Key,
                Title = x.Title ?? "",
                Body = x.Body ?? ""
            }).ToList()
        };

        try
        {
            await JS.InvokeVoidAsync("sikkhaloyFaultBulkSave", key, draft);
        }
        catch
        {
        }
    }

    private sealed class FaultBulkRow
    {
        public string Key { get; set; } = "";
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
    }

    private sealed class FaultBulkDraft
    {
        public List<FaultBulkDraftRow> Rows { get; set; } = [];
        public Dictionary<string, string> Bodies { get; set; } = new(StringComparer.Ordinal);
    }

    private sealed class FaultBulkDraftRow
    {
        public string Key { get; set; } = "";
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
    }
}
