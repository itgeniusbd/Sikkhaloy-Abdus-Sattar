                    <label>
                        <span>@Locale.T("stu.toDate")</span>
                        <input type="date" @bind="faultTo" disabled="@faultBusy" />
                    </label>
                    <button type="button" class="fault-go" disabled="@faultBusy" @onclick="LoadFaultReportsAsync">
                        @(faultBusy ? Locale.T("report.loading") : Locale.T("stu.submit"))
                    </button>
                    <button type="button" class="fault-print" @onclick="PrintAsync" disabled="@(faultRows.Count == 0)">@Locale.T("stu.print")</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(faultError))
                {
                    <div class="error no-print">@faultError</div>
                }
                @if (!string.IsNullOrWhiteSpace(faultOk))
                {
                    <div class="ok no-print">@faultOk</div>
                }
                @if (faultBusy)
                {
                    <p class="muted">@Locale.T("report.loading")</p>
                }
                else if (faultRows.Count == 0)
                {
                    <p class="muted">@Locale.T("stu.reportEmpty")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="mgrid fault-grid">
                            <thead>
                                <tr>
                                    <th>@Locale.T("stu.reportTitle")</th>
                                    <th>@Locale.T("stu.reportBody")</th>
                                    <th>@Locale.T("report.date")</th>
                                    <th>@Locale.T("report.addedBy")</th>
                                    <th class="no-print">@Locale.T("stu.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in faultRows)
                                {
                                    <tr>
                                        <td>@row.Title</td>
                                        <td class="fault-body">@row.Body</td>
                                        <td>@FmtFaultDate(row.Date)</td>
                                        <td>@OrDash(row.PostBy)</td>
                                        <td class="fault-acts no-print">
                                            <button type="button" class="fault-edit" @onclick="() => EditFault(row)">@Locale.T("students.edit")</button>
                                            <button type="button" class="fault-del" @onclick="() => ConfirmDeleteFault(row.StudentFaultID)">@Locale.T("cls.delete")</button>
                                        </td>
