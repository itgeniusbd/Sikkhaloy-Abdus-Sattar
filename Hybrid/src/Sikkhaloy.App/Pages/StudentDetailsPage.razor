            </tbody>
        </table>
    </div>;

    private async Task LoadFaultReportsAsync()
    {
        if (student is null || string.IsNullOrWhiteSpace(student.StudentCode))
            return;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            faultError = Locale.T("report.needOnline");
            return;
        }

        faultBusy = true;
        faultError = null;
        faultOk = null;
        try
        {
            faultRows = await Api.GetStudentFaultReportsAsync(Session.AccessToken, student.StudentCode, faultFrom, faultTo);
            faultLoaded = true;
        }
        catch (HttpRequestException ex)
        {
            faultError = FaultErrorMessage(ex);
            faultRows = [];
        }
        catch (Exception ex)
        {
            faultError = FaultErrorMessage(ex);
            faultRows = [];
        }
        finally
        {
            faultBusy = false;
        }
    }

