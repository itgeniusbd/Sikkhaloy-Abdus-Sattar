@code {
    [Parameter] public Guid LocalId { get; set; }

    private StudentDto? student;
    private StudentReportDto? report;
    private IReadOnlyList<SchoolClassDto> classes = [];
    private string idInput = "";
    private string? error;
    private string? reportError;
    private string tab = "profile";
    private string attTab = "details";
    private string accTab = "due";
    private bool reportBusy;
    private string busyTitle = "";
    private bool resultLoaded;
    private bool attLoaded;
    private bool subLoaded;
    private bool accLoaded;
    private bool faultLoaded;
    private bool faultBusy;
    private bool faultSaving;
    private bool showFaultModal;
    private bool showFaultBulkModal;
    private int faultEditId;
    private int? confirmFaultDeleteId;
    private string faultTitle = "";
    private string faultBody = "";
    private DateTime? faultDate = DateTime.Today;
    private DateTime? faultBulkDate = DateTime.Today;
    private List<FaultBulkRow> faultBulkRows = [];
    private DateTime? faultFrom;
    private DateTime? faultTo;
    private string? faultError;
    private string? faultOk;
    private string? faultModalError;
    private IReadOnlyList<StudentPortalFaultReportDto> faultRows = [];
    private bool idInvalid;
    private string idErrorKey = "report.needId";
    private DateTime calMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private Guid loadedLocalId;
    private string schoolName = "";
    private string schoolAddress = "";
    private string schoolPhone = "";
    private string? logoUrl;
    private string? nameLogoUrl;

    private string Initial =>
        student is null || student.StudentsName.Length == 0 ? "S" : student.StudentsName[..1];

    private string TabTitle => tab switch
    {
        "result" => Locale.T("report.result"),
        "attendance" => Locale.T("report.attendance"),
        "subjects" => Locale.T("report.subjects"),
        "accounts" => Locale.T("report.payorder"),
        "studentreport" => Locale.T("report.studentReport"),
        _ => ""
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated || Session.Current is null)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        LoadSchool();
        classes = await Sync.ListClassesAsync(Session.Current.SchoolID);
        if (LocalId == Guid.Empty)
        {
            student = null;
            ResetReport();
            return;
        }

        student = await Sync.GetStudentAsync(LocalId);
        if (student is null)
        {
            error = Locale.T("report.notFound");
            ResetReport();
            return;
        }

        if (loadedLocalId != LocalId)
        {
            ResetReport();
            loadedLocalId = LocalId;
            tab = "profile";
        }

        idInput = student.StudentCode;
        error = null;
        idInvalid = false;
        if (student.ServerId is int sid && sid > 0)
            student.PhotoDataUrl ??= Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, sid);
        if (tab == "studentreport")
            await LoadFaultReportsAsync();
        else if (tab != "profile")
            await LoadPartAsync(tab);
    }

    private void ResetReport()
    {
        report = null;
        reportError = null;
        resultLoaded = attLoaded = subLoaded = accLoaded = faultLoaded = false;
        faultRows = [];
        faultError = faultOk = faultModalError = null;
    }

    private async Task SelectTabAsync(string name)
    {
        tab = name;
        if (name == "profile")
            return;
        if (name == "studentreport")
        {
            if (!faultLoaded)
                await LoadFaultReportsAsync();
            return;
        }
        await LoadPartAsync(name);
    }

    private async Task LoadPartAsync(string part)
    {
        if (Session.Current is null || student is null || string.IsNullOrWhiteSpace(student.StudentCode))
            return;
        if (part == "result" && resultLoaded)
            return;
        if (part == "attendance" && attLoaded)
            return;
        if (part == "subjects" && subLoaded)
            return;
        if (part == "accounts" && accLoaded)
            return;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            reportError = Locale.T("report.needOnline");
            return;
        }

        reportError = null;
        busyTitle = Locale.T("report.loading");
        reportBusy = true;
        try
        {
            var chunk = await Api.GetStudentReportAsync(Session.AccessToken, student.StudentCode, part);
            report ??= new StudentReportDto();
            report.Found = chunk.Found;
            report.StudentID = chunk.StudentID;
            report.StudentClassID = chunk.StudentClassID;
            report.ClassID = chunk.ClassID;
            if (part == "result")
            {
                report.Result = chunk.Result;
                resultLoaded = true;
            }
            else if (part == "attendance")
            {
                report.Attendance = chunk.Attendance;
                attLoaded = true;
                var last = chunk.Attendance.Days.LastOrDefault()?.Date;
                calMonth = last is DateTime d
                    ? new DateTime(d.Year, d.Month, 1)
                    : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            }
            else if (part == "subjects")
            {
                report.Subjects = chunk.Subjects;
                subLoaded = true;
            }
            else if (part == "accounts")
            {
                report.Accounts = chunk.Accounts;
                accLoaded = true;
            }
        }
        catch (HttpRequestException)
        {
            reportError = Locale.T("report.needOnline");
        }
        catch (Exception)
        {
            reportError = Locale.T("report.needOnline");
        }
        finally
        {
            reportBusy = false;
        }
    }

    private void LoadSchool()
    {
        if (Session.Current is null)
            return;
        var header = Sync.GetSchoolHeader(Session.Current.SchoolID);
        schoolName = string.IsNullOrWhiteSpace(header.SchoolName) ? Session.Current.SchoolName : header.SchoolName;
        schoolAddress = header.Address ?? "";
        schoolPhone = header.Phone ?? "";
        logoUrl = Sync.GetSchoolLogoDataUrl(Session.Current.SchoolID);
        nameLogoUrl = Sync.GetSchoolNameLogoDataUrl(Session.Current.SchoolID);
    }

    private async Task OnIdKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await FindAsync();
    }

    private async Task FindAsync()
    {
        if (Session.Current is null)
            return;

        var code = idInput.Trim();
        if (code.Length == 0)
        {
            idInvalid = true;
            idErrorKey = "report.needId";
            error = Locale.T("report.needId");
            return;
        }

        var found = await Sync.FindStudentByCodeAsync(
            Session.Current.SchoolID, Session.Current.EducationYearID, code);
        if (found is null)
        {
            idInvalid = true;
            idErrorKey = "report.notFound";
            error = Locale.T("report.notFound");
            return;
        }

        idInvalid = false;
        Nav.NavigateTo($"students/details/{found.LocalId}");
    }

    private void ClearIdError()
    {
        idInvalid = false;
        if (error == Locale.T("report.needId") || error == Locale.T("report.notFound"))
            error = null;
    }

    private async Task PrintAsync() =>
        await JS.InvokeVoidAsync("sikkhaloyPrint");

    private string ClassOf(StudentDto row)
    {
        if (!string.IsNullOrWhiteSpace(row.ClassName))
            return row.ClassName;
        return classes.FirstOrDefault(x => x.ClassID == row.ClassID)?.Name ?? "-";
    }

    private string GenderLabel(string? gender)
    {
        if (string.Equals(gender, "Male", StringComparison.OrdinalIgnoreCase) || gender == "ছেলে")
            return Locale.T("male");
        if (string.Equals(gender, "Female", StringComparison.OrdinalIgnoreCase) || gender == "মেয়ে")
            return Locale.T("female");
        return string.IsNullOrWhiteSpace(gender) ? "-" : gender;
    }

    private static string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string Num(decimal? value) => value is null ? "-" : value.Value.ToString("0.##");

    private static string Pct(decimal? value) => value is null ? "-" : value.Value.ToString("0.##") + "%";

    private static string PctOf(int part, int total) =>
        total <= 0 ? "0%" : (100.0 * part / total).ToString("0.#") + "%";

    private static string Money(decimal? value) => (value ?? 0).ToString("N0");

    private static string D(DateTime? value) => value?.ToString("dd MMM yyyy") ?? "-";

    private void PrevMonth() => calMonth = calMonth.AddMonths(-1);
    private void NextMonth() => calMonth = calMonth.AddMonths(1);

    private string MonthTitle =>
        calMonth.ToString("MMMM yyyy", Locale.IsBengali
            ? new System.Globalization.CultureInfo("bn-BD")
            : System.Globalization.CultureInfo.InvariantCulture);

    private string[] WeekDays => Locale.IsBengali
        ? ["শনি", "রবি", "সোম", "মঙ্গল", "বুধ", "বৃহস্পতি", "শুক্র"]
        : ["Sat", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri"];

    private List<CalCell> CalendarCells
    {
        get
        {
            var first = new DateTime(calMonth.Year, calMonth.Month, 1);
            var startOffset = ((int)first.DayOfWeek - (int)DayOfWeek.Saturday + 7) % 7;
            var daysInMonth = DateTime.DaysInMonth(calMonth.Year, calMonth.Month);
            var att = (report?.Attendance.Days ?? [])
                .GroupBy(x => x.Date.Date)
                .ToDictionary(g => g.Key, g => g.Last());
            var hol = (report?.Attendance.Holidays ?? [])
                .GroupBy(x => x.Date.Date)
                .ToDictionary(g => g.Key, g => g.First());
            var leaves = report?.Attendance.Leaves ?? [];
            var cells = new List<CalCell>(42);
            for (var i = 0; i < startOffset; i++)
                cells.Add(new CalCell());
            for (var d = 1; d <= daysInMonth; d++)
            {
                var date = new DateTime(calMonth.Year, calMonth.Month, d);
                var cell = new CalCell { Date = date, IsToday = date.Date == DateTime.Today };
                var css = cell.IsToday ? "is-today" : "";
                if (att.TryGetValue(date, out var day) && !string.IsNullOrWhiteSpace(day.Attendance))
                {
                    cell.Status = day.Attendance;
                    var time = day.EntryTime;
                    if (!string.IsNullOrWhiteSpace(day.ExitTime))
                        time = string.IsNullOrWhiteSpace(time) ? day.ExitTime : $"{time} - {day.ExitTime}";
                    cell.Time = time;
                    css = $"{css} {CalAttClass(day.Attendance)}".Trim();
                }
                if (hol.TryGetValue(date, out var holiday))
                {
                    css = $"{(cell.IsToday ? "is-today " : "")}is-hol";
                    cell.Note = holiday.Name;
                }
                else if (string.IsNullOrWhiteSpace(cell.Status))
                {
                    var lv = leaves.FirstOrDefault(x => date >= x.StartDate.Date && date <= x.EndDate.Date);
                    if (lv is not null)
                    {
                        css = $"{(cell.IsToday ? "is-today " : "")}is-leave";
                        var note = Locale.T("report.leave");
                        if (!string.IsNullOrWhiteSpace(lv.LeaveType))
                            note += ": " + lv.LeaveType;
                        if (!string.IsNullOrWhiteSpace(lv.Description))
                            note += " — " + lv.Description;
                        cell.Note = note;
                    }
                }
                if (date.DayOfWeek == DayOfWeek.Friday)
                    css = $"{css} is-friday".Trim();
                cell.Css = css.Trim();
                cells.Add(cell);
            }
            while (cells.Count % 7 != 0)
                cells.Add(new CalCell());
            return cells;
        }
    }

    private static string CalAttClass(string? status)
    {
        var key = (status ?? "").Trim();
        if (key.Equals("Pre", StringComparison.OrdinalIgnoreCase)) return "is-pre";
        if (key.Equals("Abs", StringComparison.OrdinalIgnoreCase)) return "is-abs";
        if (key.Equals("Late", StringComparison.OrdinalIgnoreCase)) return "is-late";
        if (key.Equals("Leave", StringComparison.OrdinalIgnoreCase)) return "is-leave";
        if (key.Equals("Bunk", StringComparison.OrdinalIgnoreCase)) return "is-bunk";
        if (key.Contains("Late", StringComparison.OrdinalIgnoreCase)) return "is-lateabs";
        return "";
    }

    private sealed class CalCell
    {
        public DateTime? Date { get; set; }
        public bool IsToday { get; set; }
        public string Css { get; set; } = "";
        public string? Status { get; set; }
        public string? Time { get; set; }
        public string? Note { get; set; }
    }

