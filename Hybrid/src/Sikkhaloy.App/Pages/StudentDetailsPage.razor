            </div>
        }
        else if (tab == "studentreport")
        {
            <div class="report-panel fault-panel">
                <p class="fault-hint no-print">@Locale.T("report.faultHint")</p>
                <div class="fault-toolbar no-print">
                    <button type="button" class="fault-add" @onclick="OpenFaultModal" disabled="@faultBusy">@Locale.T("report.addReport")</button>
                    <button type="button" class="fault-bulk" @onclick="OpenFaultBulkModalAsync" disabled="@faultBusy">@Locale.T("report.bulkAdd")</button>
                    <label>
                        <span>@Locale.T("stu.fromDate")</span>
                        <input type="date" @bind="faultFrom" disabled="@faultBusy" />
