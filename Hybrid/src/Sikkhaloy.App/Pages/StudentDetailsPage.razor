    private async Task SaveFaultAsync()
    {
        if (student is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            faultModalError = Locale.T("report.needOnline");
            return;
        }
        if (string.IsNullOrWhiteSpace(faultTitle.Trim()))
        {
            faultModalError = Locale.T("report.faultNeedTitle");
            return;
        }
        if (string.IsNullOrWhiteSpace(faultBody.Trim()))
        {
            faultModalError = Locale.T("report.faultNeedBody");
            return;
        }

        faultSaving = true;
        faultModalError = null;
        try
        {
            StudentInfoResult result;
            if (faultEditId > 0)
            {
                result = await Api.UpdateStudentFaultReportAsync(Session.AccessToken, new UpdateStudentFaultReportRequest
                {
                    StudentFaultID = faultEditId,
                    Title = faultTitle.Trim(),
                    Body = faultBody.Trim(),
                    Date = faultDate
                });
            }
            else
            {
                result = await Api.SaveStudentFaultReportAsync(Session.AccessToken, new SaveStudentFaultReportRequest
                {
                    StudentCode = student.StudentCode,
                    Title = faultTitle.Trim(),
                    Body = faultBody.Trim(),
                    Date = faultDate
                });
            }

            if (!result.Succeeded)
            {
                faultModalError = FaultResultMessage(result.Error);
                return;
            }

            showFaultModal = false;
            faultOk = Locale.T("report.faultSaved");
            faultLoaded = false;
            await LoadFaultReportsAsync();
        }
        catch (HttpRequestException ex)
        {
            faultModalError = FaultErrorMessage(ex);
        }
        catch (Exception ex)
        {
            faultModalError = FaultErrorMessage(ex);
        }
        finally
        {
            faultSaving = false;
        }
    }

