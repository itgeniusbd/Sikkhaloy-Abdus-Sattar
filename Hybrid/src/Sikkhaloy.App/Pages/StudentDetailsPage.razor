                        <span>@Locale.T("report.totalConc"): @Money(report?.Accounts.TotalDiscount)</span>
                        <span>@Locale.T("report.totalLate"): @Money(report?.Accounts.TotalLateFee)</span>
                        <span>@Locale.T("report.totalPaid"): @Money(report?.Accounts.TotalPaid)</span>
                        <span class="due">@Locale.T("report.totalDue"): @Money(report?.Accounts.TotalDue)</span>
