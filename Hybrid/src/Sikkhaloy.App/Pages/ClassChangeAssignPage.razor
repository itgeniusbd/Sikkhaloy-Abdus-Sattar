@page "/student-mgmt/class-change/{StudentId:int}"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav

<div class="card sa-page si-info-page si-id-page sm-cc-page students-card">
    <header class="sa-head sj-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("sm.crumb")</p>
            <h1>@Locale.T("sm.assignTitle")</h1>
        </div>
        <a class="stu-btn is-sync" href="student-mgmt/class-change">@Locale.T("sm.back")</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText))
    {
        <NetBanner Text="@error" />
    }

    @if (student is not null)
    {
        <div class="si-found no-print">
            <span class="si-found-id">@student.ID</span>
            <div class="si-found-main">
                <strong>@student.StudentsName</strong>
                <span>@Locale.T("si.father"): @student.FathersName</span>
            </div>
            <div class="si-found-meta">
                <em>@Locale.T("si.class"): @student.ClassName</em>
                @if (!string.IsNullOrWhiteSpace(student.GroupName))
                {
                    <em>@Locale.T("si.group"): @student.GroupName</em>
                }
                @if (!string.IsNullOrWhiteSpace(student.SectionName))
                {
                    <em>@Locale.T("si.section"): @student.SectionName</em>
                }
                @if (!string.IsNullOrWhiteSpace(student.ShiftName))
                {
                    <em>@Locale.T("si.shift"): @student.ShiftName</em>
                }
                <em>@Locale.T("si.roll"): @student.RollNo</em>
            </div>
        </div>

        <div class="sal-bar no-print">
            <button type="button" class="sal-gen" disabled="@busy" @onclick="SaveAsync">@Locale.T("si.update")</button>
            <section class="sal-box is-class">
                <span class="sal-box-h">@Locale.T("sm.newClass")</span>
                <select @bind="classInput" @bind:after="OnClassChanged" disabled="@busy">
                    <option value="0">@Locale.T("sm.newClass")</option>
                    @foreach (var item in classes.Where(x => x.ClassID != student.ClassID))
                    {
                        <option value="@item.ClassID">@item.Name</option>
                    }
                </select>
            </section>
            <section class="sal-box is-month">
                <span class="sal-box-h">@Locale.T("si.rollNumber")</span>
                <input class="si-find-input" type="text" placeholder="@Locale.T("si.rollNumber")" @bind="rollNo" disabled="@busy" />
            </section>
            @if (groups.Count > 0)
            {
                <section class="sal-box is-group">
                    <span class="sal-box-h">@Locale.T("si.group")</span>
                    <select @bind="groupInput" @bind:after="LoadSubjectsAsync" disabled="@busy">
                        <option value="0">@Locale.T("si.selectGroup")</option>
                        @foreach (var item in groups)
                        {
                            <option value="@item.ServerId">@item.Name</option>
                        }
                    </select>
                </section>
            }
            @if (sections.Count > 0)
            {
                <section class="sal-box is-section">
                    <span class="sal-box-h">@Locale.T("si.section")</span>
                    <select @bind="sectionInput" disabled="@busy">
                        <option value="0">@Locale.T("si.selectSection")</option>
                        @foreach (var item in sections)
                        {
                            <option value="@item.ServerId">@item.Name</option>
                        }
                    </select>
                </section>
            }
            @if (shifts.Count > 0)
            {
                <section class="sal-box is-shift">
                    <span class="sal-box-h">@Locale.T("si.shift")</span>
                    <select @bind="shiftInput" disabled="@busy">
                        <option value="0">@Locale.T("si.selectShift")</option>
                        @foreach (var item in shifts)
                        {
                            <option value="@item.ServerId">@item.Name</option>
                        }
                    </select>
                </section>
            }
            <section class="sal-box is-type">
                <span class="sal-box-h">@Locale.T("sm.payOrder")</span>
                <label class="choice-inline">
                    <input type="checkbox" @bind="keepPayOrder" disabled="@busy" />
                    <span>@Locale.T("sm.keepPayOrder")</span>
                </label>
            </section>
            <section class="sal-box is-names">
                <span class="sal-box-h">@Locale.T("sm.change")</span>
                <span class="readm-type">
                    <label class="choice-inline">
                        <input type="radio" name="status" checked="@(classStatus == "Promotion")"
                               @onchange="@(() => classStatus = "Promotion")" />
                        <span>@Locale.T("sm.promotion")</span>
                    </label>
                    <label class="choice-inline">
                        <input type="radio" name="status" checked="@(classStatus == "Demotion")"
                               @onchange="@(() => classStatus = "Demotion")" />
                        <span>@Locale.T("sm.demotion")</span>
                    </label>
                </span>
            </section>
        </div>

        @if (ClassId > 0)
        {
            <div class="sj-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>@Locale.T("si.subject")</th>
                        <th class="act">@Locale.T("si.select")</th>
                        <th>@Locale.T("si.subjectType")</th>
                    </tr>
                </thead>
                <tbody>
                @if (subjects.Count == 0 && !busy)
                {
                    <tr><td colspan="3" class="empty-row">@Locale.T("si.empty")</td></tr>
                }
                else
                {
                    @foreach (var subject in subjects)
                    {
                        <tr class="@(subject.Selected ? "is-allowed" : null)">
                            <td>@subject.SubjectName</td>
                            <td class="act"><input type="checkbox" @bind="subject.Selected" disabled="@busy" /></td>
                            <td>
                                <span class="readm-type">
                                    <label class="choice-inline">
                                        <input type="radio" name="type-@subject.SubjectID" checked="@(subject.SubjectType == "Compulsory")"
                                               @onchange="@(() => subject.SubjectType = "Compulsory")" />
                                        <span>@Locale.T("si.compulsory")</span>
                                    </label>
                                    <label class="choice-inline">
                                        <input type="radio" name="type-@subject.SubjectID" checked="@(subject.SubjectType == "Optional")"
                                               @onchange="@(() => subject.SubjectType = "Optional")" />
                                        <span>@Locale.T("si.optional")</span>
                                    </label>
                                </span>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        }
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    [Parameter] public int StudentId { get; set; }
    [SupplyParameterFromQuery(Name = "oldClass")] public int OldClass { get; set; }

    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [];
    private readonly List<ClassPartDto> sections = [];
    private readonly List<ClassPartDto> shifts = [];
    private readonly List<ReAdmissionSubjectDto> subjects = [];
    private ClassStructureDto? structure;
    private StudentPlacementDto? student;
    private string classInput = "0";
    private string groupInput = "0";
    private string sectionInput = "0";
    private string shiftInput = "0";
    private string rollNo = "";
    private string classStatus = "Promotion";
    private string busyTitle = "";
    private string popupText = "";
    private bool keepPayOrder;
    private bool busy;
    private bool popupError;
    private string? error;
    private int loadedId;
    private int oldClassId;

    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int GroupId => int.TryParse(groupInput, out var n) ? n : 0;
    private int SectionId => int.TryParse(sectionInput, out var n) ? n : 0;
    private int ShiftId => int.TryParse(shiftInput, out var n) ? n : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == StudentId && student is not null)
            return;
        loadedId = StudentId;
        error = null;
        popupText = "";
        student = null;
        subjects.Clear();
        if (!await EnsureOnlineAsync())
            return;

        busyTitle = Locale.T("si.loading");
        busy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            structure = await Api.GetClassStructureAsync(Session.AccessToken);
            classes.Clear();
            classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
            student = await Api.GetSmClassChangeStudentAsync(Session.AccessToken, StudentId);
            if (student is null)
            {
                error = Locale.T("sm.needStudent");
                return;
            }
            rollNo = student.RollNo ?? "";
            oldClassId = OldClass > 0 ? OldClass : student.StudentClassID;
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnClassChanged()
    {
        groupInput = sectionInput = shiftInput = "0";
        ApplyParts();
        await LoadSubjectsAsync();
    }

    private void ApplyParts()
    {
        groups.Clear();
        sections.Clear();
        shifts.Clear();
        if (structure is null || ClassId <= 0)
            return;
        groups.AddRange(structure.Groups.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        sections.AddRange(structure.Sections.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        shifts.AddRange(structure.Shifts.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
    }

    private async Task LoadSubjectsAsync()
    {
        subjects.Clear();
        if (ClassId <= 0 || !await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            subjects.AddRange(await Api.GetReAdmissionSubjectsAsync(Session.AccessToken, ClassId, GroupId));
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (student is null)
            return;
        error = null;
        popupText = "";
        if (ClassId <= 0 || ClassId == student.ClassID)
        {
            error = Locale.T("sm.sameClass");
            return;
        }
        var picked = subjects.Where(x => x.Selected).Select(x => new SaveStudentSubjectItem
        {
            SubjectID = x.SubjectID,
            SubjectType = x.SubjectType
        }).ToList();
        if (picked.Count == 0)
        {
            error = Locale.T("si.needSubject");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            var result = await Api.ChangeClassAsync(Session.AccessToken, new ChangeClassRequest
            {
                StudentID = student.StudentID,
                OldStudentClassID = oldClassId > 0 ? oldClassId : student.StudentClassID,
                ClassID = ClassId,
                SubjectGroupID = GroupId,
                SectionID = SectionId,
                ShiftID = ShiftId,
                RollNo = rollNo,
                ClassStatus = classStatus,
                KeepPayOrder = keepPayOrder,
                Subjects = picked
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            Nav.NavigateTo("student-mgmt/class-change");
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
        error = isError ? text : null;
    }

    private void ClosePopup() => popupText = "";

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("si.failed") : Locale.T(key);
}
