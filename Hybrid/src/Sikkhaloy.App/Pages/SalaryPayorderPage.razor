@page "/staff/salary/payorder"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card sa-page emp-list-page sal-page sal-assign-page is-pay">
    <header class="sa-head sj-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("sal.crumb")</p>
            <h1>@Locale.T("sal.payorder")</h1>
            <p class="sa-lead">@Locale.T("sal.payorderLead")</p>
        </div>
        <div class="sal-head-acts">
            <button type="button" class="sal-gen" disabled="@(busy || payorderId <= 0)" @onclick="OpenAssign">
                @Locale.T("sal.assignPayorder")
            </button>
            <button type="button" class="btn-ghost" disabled="@busy" @onclick="OpenNames">
                @Locale.T("sal.manageNames")
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText))
    {
        <NetBanner Text="@error" />
    }

    <div class="sal-bar no-print">
        <section class="sal-box is-names">
            <span class="sal-box-h">@Locale.T("sal.payorderName")</span>
            <select @bind="payorderId" @bind:after="OnFilterChangedAsync" disabled="@busy">
                <option value="0">@Locale.T("sal.selectPayorder")</option>
                @foreach (var row in names)
                {
                    <option value="@row.Id">@row.Name</option>
                }
            </select>
        </section>
        <section class="sal-box is-month">
            <span class="sal-box-h">@Locale.T("sal.month")</span>
            <select @bind="monthName" @bind:after="LoadMonthlyAsync" disabled="@busy">
                <option value="">@Locale.T("sal.selectMonth")</option>
                @foreach (var month in months)
                {
                    <option value="@month.Name">@month.Name</option>
                }
            </select>
        </section>
        <section class="sal-box is-type">
            <span class="sal-box-h">@Locale.T("sal.empType")</span>
            <div class="sal-box-pills">
                <button type="button" class="sal-chip @(type == "%" ? "is-on" : null)" disabled="@busy" @onclick="@(() => SetType("%"))">@Locale.T("emp.all")</button>
                <button type="button" class="sal-chip @(type == "Teacher" ? "is-on" : null)" disabled="@busy" @onclick="@(() => SetType("Teacher"))">@Locale.T("emp.teacher")</button>
                <button type="button" class="sal-chip @(type == "Staff" ? "is-on" : null)" disabled="@busy" @onclick="@(() => SetType("Staff"))">@Locale.T("emp.staff")</button>
            </div>
        </section>
        <span class="el-count">@Locale.T("emp.count", generateRows.Count())</span>
    </div>

    <section class="sal-block">
        <header class="sal-block-h no-print">
            <div>
                <h2>@Locale.T("sal.generateList")</h2>
                <p>@Locale.T("emp.count", generateRows.Count())</p>
            </div>
            <button type="button" class="sal-gen" disabled="@busy" @onclick="GenerateAsync">@Locale.T("sal.generate")</button>
        </header>
        <div class="sj-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th class="act">
                            <input type="checkbox" checked="@AllGenerateChecked" disabled="@(busy || !generateRows.Any())"
                                   @onchange="e => ToggleGenerateAll(e)" />
                        </th>
                        <th>@Locale.T("emp.id")</th>
                        <th>@Locale.T("emp.name")</th>
                        <th>@Locale.T("emp.phone")</th>
                        <th>@Locale.T("emp.designation")</th>
                        <th>@Locale.T("emp.type")</th>
                        <th class="num">@Locale.T("emp.salary")</th>
                        <th>@Locale.T("emp.bank")</th>
                    </tr>
                </thead>
                <tbody>
                @if (!generateRows.Any() && !busy)
                {
                    <tr><td colspan="8" class="empty-row">@Locale.T("sal.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in generateRows)
                    {
                        <tr class="@(row.Selected ? "is-on" : null)">
                            <td class="act"><input type="checkbox" @bind="row.Selected" disabled="@busy" /></td>
                            <td>@row.Emp.ID</td>
                            <td>@row.Emp.Name</td>
                            <td>@row.Emp.Phone</td>
                            <td>@row.Emp.Designation</td>
                            <td>@row.Emp.EmployeeType</td>
                            <td class="num">@Money(row.Emp.Salary)</td>
                            <td>@(row.Emp.BankAccNo ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="sal-block">
        <header class="sal-block-h no-print">
            <div>
                <h2>@(string.IsNullOrWhiteSpace(monthName) ? Locale.T("sal.sheet") : monthName)</h2>
                <p>@Locale.T("emp.count", monthly.Count)</p>
            </div>
            @if (monthly.Count > 0)
            {
                <div class="sal-head-acts">
                    <button type="button" class="sal-del" disabled="@(busy || selectedMonthly.Count == 0)"
                            @onclick="DeleteSelectedMonthlyAsync">@Locale.T("sal.deleteSelected")</button>
                    <button type="button" class="sal-bonus" disabled="@busy" @onclick="UpdateBonusFineAsync">@Locale.T("sal.bonusFineUpdate")</button>
                </div>
            }
        </header>
        <div class="sj-grid sal-month-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th class="act no-print">
                            <input type="checkbox" checked="@AllMonthlyChecked" disabled="@(busy || !CanDeleteMonthly.Any())"
                                   @onchange="ToggleMonthlyAll" />
                        </th>
                        <th>@Locale.T("emp.id")</th>
                        <th>@Locale.T("emp.name")</th>
                        <th class="num">@Locale.T("sal.basic")</th>
                        <th>@Locale.T("sal.wd")</th>
                        <th>@Locale.T("sal.present")</th>
                        <th>@Locale.T("sal.abs")</th>
                        <th>@Locale.T("sal.late")</th>
                        <th>@Locale.T("sal.leave")</th>
                        <th>@Locale.T("sal.fineCount")</th>
                        <th>@Locale.T("sal.allowance")</th>
                        <th>@Locale.T("sal.addBonus")</th>
                        <th class="num">@Locale.T("sal.gross")</th>
                        <th>@Locale.T("sal.deduction")</th>
                        <th>@Locale.T("sal.addFine")</th>
                        <th class="num">@Locale.T("sal.net")</th>
                        <th class="act no-print">@Locale.T("sal.delete")</th>
                    </tr>
                </thead>
                <tbody>
                @if (monthly.Count == 0 && !busy)
                {
                    <tr><td colspan="17" class="empty-row">@Locale.T("sal.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in monthly)
                    {
                        <tr class="@(IsMonthlySelected(row) ? "is-on" : null)">
                            <td class="act no-print">
                                <input type="checkbox" checked="@IsMonthlySelected(row)" disabled="@(busy || row.PaidAmount != 0)"
                                       @onchange="e => SetMonthlySelected(row, e)" />
                            </td>
                            <td>@row.ID</td>
                            <td>@row.Name</td>
                            <td class="num">@Money(row.PayorderAmount)</td>
                            <td>@row.WorkingDays</td>
                            <td>@row.PresentDays</td>
                            <td>@row.AbsDays</td>
                            <td>@row.LateDays</td>
                            <td>@row.LeaveDays</td>
                            <td>@row.FineCountDays</td>
                            <td class="sal-lines">
                                @foreach (var line in VisibleAllowances(row))
                                {
                                    <div>@line.Name: @Money(line.Amount)</div>
                                }
                            </td>
                            <td class="sal-lines no-print">
                                @foreach (var line in row.Bonuses)
                                {
                                    <div class="sal-line">
                                        <span>@line.Name</span>
                                        <input type="number" step="0.01" @bind="line.Amount" disabled="@busy" />
                                    </div>
                                }
                            </td>
                            <td class="num">@Money(row.GrossSalary)</td>
                            <td class="sal-lines">
                                @foreach (var line in VisibleDeductions(row))
                                {
                                    <div>@line.Name: @Money(line.Amount)</div>
                                }
                            </td>
                            <td class="sal-lines no-print">
                                <div class="sal-line">
                                    <span>@Locale.T("sal.attendanceFine")</span>
                                    <input type="number" step="0.01" @bind="row.AttendanceFine" disabled="@busy" />
                                </div>
                                @foreach (var line in row.Fines)
                                {
                                    <div class="sal-line">
                                        <span>@line.Name</span>
                                        <input type="number" step="0.01" @bind="line.Amount" disabled="@busy" />
                                    </div>
                                }
                            </td>
                            <td class="num">@Money(row.NetSalary)</td>
                            <td class="act no-print">
                                @if (row.PaidAmount == 0)
                                {
                                    <button type="button" class="cls-act cls-act-del" disabled="@busy" @onclick="() => DeleteMonthlyAsync(row)">@Locale.T("sal.delete")</button>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (showAssign)
{
    <div class="modal-back cls-modal-back" @onclick="CloseAssign">
        <div class="modal-panel cls-modal sal-name-modal sal-assign-emp-modal" @onclick:stopPropagation="true">
            <div class="modal-head cls-modal-head">
                <strong>@Locale.T("sal.assignPayorder")</strong>
                <span class="el-count">@Locale.T("emp.count", employees.Count)</span>
                <button type="button" class="cls-modal-x" aria-label="@Locale.T("sal.cancel")" @onclick="CloseAssign">×</button>
            </div>
            <p class="sal-assign-hint">@Locale.T("sal.assignPayorderHint")</p>
            @if (!string.IsNullOrWhiteSpace(assignMessage))
            {
                <div class="@(assignError ? "error" : "ok") cls-modal-msg">@assignMessage</div>
            }
            <div class="cls-modal-body">
                <table class="mgrid">
                    <thead>
                        <tr>
                            <th class="act">
                                <input type="checkbox" checked="@AllAssignChecked" disabled="@(busy || employees.Count == 0)"
                                       @onchange="e => ToggleAssignAll(e)" />
                            </th>
                            <th>@Locale.T("emp.id")</th>
                            <th>@Locale.T("emp.name")</th>
                            <th>@Locale.T("emp.designation")</th>
                            <th>@Locale.T("emp.type")</th>
                            <th>@Locale.T("emp.phone")</th>
                            <th>@Locale.T("sal.payorderName")</th>
                            <th>@Locale.T("emp.bank")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (employees.Count == 0 && !busy)
                    {
                        <tr><td colspan="8" class="empty-row">@Locale.T("sal.empty")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in employees)
                        {
                            <tr class="@(row.Selected ? "is-on" : null)">
                                <td class="act"><input type="checkbox" @bind="row.Selected" disabled="@busy" /></td>
                                <td>@row.Emp.ID</td>
                                <td>@row.Emp.Name</td>
                                <td>@row.Emp.Designation</td>
                                <td>@row.Emp.EmployeeType</td>
                                <td>@row.Emp.Phone</td>
                                <td>@(row.Emp.PayorderName ?? "—")</td>
                                <td>@(row.Emp.BankAccNo ?? "—")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="cls-modal-foot">
                <button type="button" class="sal-save" disabled="@(busy || payorderId <= 0)" @onclick="AssignAsync">@Locale.T("sal.update")</button>
                <button type="button" class="btn-serial" @onclick="CloseAssign">@Locale.T("acc.close")</button>
            </div>
        </div>
    </div>
}

@if (showNames)
{
    <div class="modal-back cls-modal-back" @onclick="CloseNames">
        <div class="modal-panel cls-modal sal-name-modal" @onclick:stopPropagation="true">
            <div class="modal-head cls-modal-head">
                <strong>@Locale.T("sal.payorderNames")</strong>
                <button type="button" class="cls-modal-x" aria-label="@Locale.T("sal.cancel")" @onclick="CloseNames">×</button>
            </div>
            <div class="inline-add cls-modal-add">
                <input type="text" placeholder="@Locale.T("sal.payorderPlaceholder")"
                       @bind="newPayorder" disabled="@busy" @onkeydown="OnAddKey" />
                <button type="button" class="primary" disabled="@busy" @onclick="AddPayorderAsync">@Locale.T("sal.addName")</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(modalMessage))
            {
                <div class="@(modalError ? "error" : "ok") cls-modal-msg">@modalMessage</div>
            }
            <div class="cls-modal-body">
                <table class="mgrid">
                    <thead>
                        <tr>
                            <th>@Locale.T("sal.payorderName")</th>
                            <th>@Locale.T("sal.created")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (names.Count == 0 && !busy)
                    {
                        <tr><td colspan="3" class="empty-row">@Locale.T("sal.empty")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in names)
                        {
                            <tr class="@(row.Id == payorderId ? "is-on" : null)">
                                <td>
                                    @if (editingId == row.Id)
                                    {
                                        <input type="text" @bind="editName" disabled="@busy" />
                                    }
                                    else
                                    {
                                        <button type="button" class="link-btn" disabled="@busy" @onclick="() => SelectPayorderAsync(row.Id)">@row.Name</button>
                                    }
                                </td>
                                <td>@(row.Created?.ToString("d MMM yyyy") ?? "—")</td>
                                <td class="act">
                                    @if (editingId == row.Id)
                                    {
                                        <button type="button" class="cls-act cls-act-save" disabled="@busy" @onclick="SavePayorderAsync">@Locale.T("sal.update")</button>
                                        <button type="button" class="cls-act cls-act-cancel" disabled="@busy" @onclick="CancelEdit">@Locale.T("sal.cancel")</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cls-act cls-act-edit" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("sal.edit")</button>
                                        <button type="button" class="cls-act cls-act-del" disabled="@busy" @onclick="() => DeletePayorderAsync(row)">@Locale.T("sal.delete")</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="cls-modal-foot">
                <button type="button" class="btn-serial" @onclick="CloseNames">@Locale.T("acc.close")</button>
            </div>
        </div>
    </div>
}

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private readonly List<SalaryNameDto> names = [];
    private readonly List<SalaryMonthDto> months = [];
    private readonly List<Pick> employees = [];
    private readonly List<MonthlyPayorderDto> monthly = [];
    private readonly HashSet<int> selectedMonthly = [];
    private string newPayorder = "";
    private string editName = "";
    private string type = "%";
    private string monthName = "";
    private string busyTitle = "";
    private string popupText = "";
    private string? error;
    private string? modalMessage;
    private int payorderId;
    private int editingId;
    private bool busy;
    private bool popupError;
    private bool modalError;
    private bool showNames;
    private bool showAssign;
    private string? assignMessage;
    private bool assignError;

    private IEnumerable<Pick> generateRows => employees.Where(x => x.Emp.PayorderNameId == payorderId);
    private IEnumerable<MonthlyPayorderDto> CanDeleteMonthly => monthly.Where(x => x.PaidAmount == 0);
    private bool AllAssignChecked => employees.Count > 0 && employees.All(x => x.Selected);
    private bool AllGenerateChecked => generateRows.Any() && generateRows.All(x => x.Selected);
    private bool AllMonthlyChecked => CanDeleteMonthly.Any() && CanDeleteMonthly.All(IsMonthlySelected);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.loading");
        busy = true;
        try
        {
            await ReloadKeepBusyAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReloadKeepBusyAsync()
    {
        names.Clear();
        months.Clear();
        names.AddRange(await Api.GetSalaryNamesAsync(Session.AccessToken, "payorder"));
        months.AddRange(await Api.GetSalaryMonthsAsync(Session.AccessToken));
        if (payorderId == 0 && names.Count > 0)
            payorderId = names[0].Id;
        if (payorderId > 0 && names.All(x => x.Id != payorderId))
            payorderId = names.FirstOrDefault()?.Id ?? 0;
        if (string.IsNullOrWhiteSpace(monthName) && months.Count > 0)
        {
            var now = DateTime.Today;
            monthName = months.FirstOrDefault(x => x.Date.Year == now.Year && x.Date.Month == now.Month)?.Name
                        ?? months[0].Name;
        }
        await LoadEmployeesCoreAsync();
        await LoadMonthlyCoreAsync();
    }

    private async Task SelectPayorderAsync(int id)
    {
        if (payorderId == id)
            return;
        payorderId = id;
        await OnFilterChangedAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        foreach (var row in employees)
            row.Selected = payorderId > 0 && row.Emp.PayorderNameId == payorderId;
        await LoadMonthlyAsync();
    }

    private async Task SetType(string value)
    {
        type = value;
        error = null;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.loading");
        busy = true;
        try
        {
            await LoadEmployeesCoreAsync();
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadMonthlyAsync()
    {
        error = null;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.loading");
        busy = true;
        try
        {
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadEmployeesCoreAsync()
    {
        employees.Clear();
        var data = await Api.GetPayorderEmployeesAsync(Session.AccessToken, type);
        employees.AddRange(data.Select(x => new Pick
        {
            Emp = x,
            Selected = payorderId > 0 && x.PayorderNameId == payorderId
        }));
    }

    private async Task LoadMonthlyCoreAsync()
    {
        monthly.Clear();
        selectedMonthly.Clear();
        if (payorderId <= 0 || string.IsNullOrWhiteSpace(monthName))
            return;
        monthly.AddRange(await Api.GetMonthlyPayordersAsync(Session.AccessToken, payorderId, monthName, type));
    }

    private void ToggleAssignAll(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value?.ToString() == "True";
        foreach (var row in employees)
            row.Selected = on;
    }

    private void ToggleGenerateAll(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value?.ToString() == "True";
        foreach (var row in generateRows)
            row.Selected = on;
    }

    private bool IsMonthlySelected(MonthlyPayorderDto row) => selectedMonthly.Contains(row.EmployeePayorderID);

    private void SetMonthlySelected(MonthlyPayorderDto row, ChangeEventArgs e)
    {
        if (row.PaidAmount != 0)
            return;
        if (e.Value is true || e.Value?.ToString() == "True")
            selectedMonthly.Add(row.EmployeePayorderID);
        else
            selectedMonthly.Remove(row.EmployeePayorderID);
    }

    private void ToggleMonthlyAll(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value?.ToString() == "True";
        selectedMonthly.Clear();
        if (!on)
            return;
        foreach (var row in CanDeleteMonthly)
            selectedMonthly.Add(row.EmployeePayorderID);
    }

    private void OpenAssign()
    {
        assignMessage = null;
        assignError = false;
        showAssign = true;
    }

    private void CloseAssign()
    {
        showAssign = false;
        assignMessage = null;
        assignError = false;
    }

    private void OpenNames()
    {
        modalMessage = null;
        modalError = false;
        CancelEdit();
        showNames = true;
    }

    private void CloseNames()
    {
        showNames = false;
        CancelEdit();
        modalMessage = null;
        modalError = false;
    }

    private void StartEdit(SalaryNameDto row)
    {
        editingId = row.Id;
        editName = row.Name;
    }

    private void CancelEdit()
    {
        editingId = 0;
        editName = "";
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddPayorderAsync();
    }

    private async Task AddPayorderAsync()
    {
        modalMessage = null;
        modalError = false;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.saving");
        busy = true;
        try
        {
            var result = await Api.CreateSalaryNameAsync(Session.AccessToken, "payorder", new SaveSalaryNameRequest { Name = newPayorder });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }
            newPayorder = "";
            payorderId = result.Id;
            modalMessage = Locale.T("sal.okName");
            modalError = false;
            await ReloadKeepBusyAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePayorderAsync()
    {
        modalMessage = null;
        modalError = false;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.saving");
        busy = true;
        try
        {
            var result = await Api.UpdateSalaryNameAsync(Session.AccessToken, "payorder", editingId, new SaveSalaryNameRequest { Name = editName });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }
            CancelEdit();
            modalMessage = Locale.T("sal.okName");
            modalError = false;
            await ReloadKeepBusyAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePayorderAsync(SalaryNameDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sal.confirmDelete")))
            return;
        modalMessage = null;
        modalError = false;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.saving");
        busy = true;
        try
        {
            var result = await Api.DeleteSalaryNameAsync(Session.AccessToken, "payorder", row.Id);
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }
            if (payorderId == row.Id)
                payorderId = 0;
            modalMessage = Locale.T("sal.okDelete");
            modalError = false;
            await ReloadKeepBusyAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AssignAsync()
    {
        error = null;
        if (payorderId <= 0)
        {
            Show(Locale.T("sal.needPayorder"), true);
            return;
        }
        if (!await EnsureOnlineAsync())
            return;
        var ids = employees.Where(x => x.Selected).Select(x => x.Emp.EmployeeID).ToList();
        busyTitle = Locale.T("sal.saving");
        busy = true;
        try
        {
            var result = await Api.AssignPayorderAsync(Session.AccessToken, new AssignPayorderRequest
            {
                PayorderNameId = payorderId,
                EmployeeIDs = ids
            });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }
            await LoadEmployeesCoreAsync();
            showAssign = false;
            assignMessage = null;
            Show(Locale.T("sal.okAssign"));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

