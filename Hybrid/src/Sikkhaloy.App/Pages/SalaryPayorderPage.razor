    private async Task DeleteMonthlyAsync(MonthlyPayorderDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sal.confirmPayorder")))
            return;
        await DeleteMonthlyIdsAsync([row.EmployeePayorderID]);
    }

    private async Task DeleteSelectedMonthlyAsync()
    {
        var ids = selectedMonthly.ToList();
        if (ids.Count == 0)
        {
            Show(Locale.T("sal.needDelete"), true);
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sal.confirmBulk", ids.Count)))
            return;
        await DeleteMonthlyIdsAsync(ids);
    }

    private async Task DeleteMonthlyIdsAsync(IReadOnlyList<int> ids)
    {
        error = null;
        if (!await EnsureOnlineAsync())
            return;
        busyTitle = Locale.T("sal.saving");
        busy = true;
        try
        {
            var result = ids.Count == 1
                ? await Api.DeleteMonthlyPayorderAsync(Session.AccessToken, ids[0])
                : await Api.DeleteMonthlyPayordersAsync(Session.AccessToken, new DeleteMonthlyPayordersRequest
                {
                    EmployeePayorderIds = ids.ToList()
                });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }
            await LoadMonthlyCoreAsync();
            Show(result.Count > 1 ? Locale.T("sal.okDeleteCount", result.Count) : Locale.T("sal.okDelete"));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }

    private void ClosePopup() => popupText = "";

    private void Show(string value, bool err = false)
    {
        if (showNames)
        {
            modalMessage = value;
            modalError = err;
            return;
        }
        if (showAssign)
        {
            assignMessage = value;
            assignError = err;
            return;
        }
        popupText = value;
        popupError = err;
        error = err ? value : null;
    }

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("sal.failed") : Locale.T(key);

    private IEnumerable<SalaryLineDto> VisibleAllowances(MonthlyPayorderDto row)
    {
        foreach (var line in row.Allowances.Where(x => x.Amount != 0))
            yield return line;
        var extra = row.Allowance - row.Allowances.Sum(x => x.Amount);
        if (Math.Abs(extra) >= 0.01m)
            yield return new SalaryLineDto { Name = Locale.T("sal.other"), Amount = extra };
    }

    private IEnumerable<SalaryLineDto> VisibleDeductions(MonthlyPayorderDto row)
    {
        foreach (var line in row.Deductions.Where(x => x.Amount != 0))
            yield return line;
        var extra = row.Deduction - row.Deductions.Sum(x => x.Amount);
        if (Math.Abs(extra) >= 0.01m)
            yield return new SalaryLineDto { Name = Locale.T("sal.other"), Amount = extra };
    }

    private static string Money(decimal value) => value.ToString("0.##");

