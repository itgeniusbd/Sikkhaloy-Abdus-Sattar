@page "/staff/salary/payorder"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page emp-page sal-page">
    <h1>@Locale.T("sal.payorder")</h1>
    <p class="muted no-print">@Locale.T("sal.crumb")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error no-print">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok no-print">@message</div>
    }

    <div class="structure-card no-print">
        <div class="inline-add">
            <input type="text" placeholder="@Locale.T("sal.payorderPlaceholder")" @bind="newPayorder" disabled="@busy" />
            <button type="button" class="primary" disabled="@busy" @onclick="AddPayorderAsync">@Locale.T("sal.addName")</button>
        </div>
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act">@Locale.T("sal.delete")</th>
                    <th class="act">@Locale.T("sal.edit")</th>
                    <th>@Locale.T("sal.payorderName")</th>
                    <th>@Locale.T("sal.created")</th>
                </tr>
            </thead>
            <tbody>
            @if (names.Count == 0 && !busy)
            {
                <tr><td colspan="4" class="empty-row">@Locale.T("sal.empty")</td></tr>
            }
            else
            {
                @foreach (var row in names)
                {
                    <tr>
                        <td class="act">
                            <button type="button" class="link-btn danger" disabled="@busy" @onclick="() => DeletePayorderAsync(row)">@Locale.T("sal.delete")</button>
                        </td>
                        <td class="act">
                            @if (editingId == row.Id)
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="SavePayorderAsync">@Locale.T("sal.update")</button>
                                <button type="button" class="link-btn" disabled="@busy" @onclick="CancelEdit">@Locale.T("sal.cancel")</button>
                            }
                            else
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("sal.edit")</button>
                            }
                        </td>
                        <td>
                            @if (editingId == row.Id)
                            {
                                <input type="text" @bind="editName" disabled="@busy" />
                            }
                            else
                            {
                                @row.Name
                            }
                        </td>
                        <td>@(row.Created?.ToString("d MMM yyyy") ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="filter-row no-print">
        <select @bind="payorderId" @bind:after="OnFilterChangedAsync" disabled="@busy">
            <option value="0">@Locale.T("sal.selectPayorder")</option>
            @foreach (var row in names)
            {
                <option value="@row.Id">@row.Name</option>
            }
        </select>
        <select @bind="monthName" @bind:after="LoadMonthlyAsync" disabled="@busy">
            <option value="">@Locale.T("sal.selectMonth")</option>
            @foreach (var month in months)
            {
                <option value="@month.Name">@month.Name</option>
            }
        </select>
        <label class="choice-inline">
            <input type="radio" name="po-type" checked="@(type == "%")" @onchange="@(() => SetType("%"))" />
            <span>@Locale.T("emp.all")</span>
        </label>
        <label class="choice-inline">
            <input type="radio" name="po-type" checked="@(type == "Teacher")" @onchange="@(() => SetType("Teacher"))" />
            <span>@Locale.T("emp.teacher")</span>
        </label>
        <label class="choice-inline">
            <input type="radio" name="po-type" checked="@(type == "Staff")" @onchange="@(() => SetType("Staff"))" />
            <span>@Locale.T("emp.staff")</span>
        </label>
    </div>

    <div class="structure-card no-print">
        <h2 class="emp-list-title">@Locale.T("sal.assignPayorder")</h2>
        <p class="muted">@Locale.T("sal.assignPayorderHint")</p>
        <div class="sal-scroll">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th class="act">
                            <input type="checkbox" checked="@AllAssignChecked" disabled="@(busy || employees.Count == 0)"
                                   @onchange="e => ToggleAssignAll(e)" />
                        </th>
                        <th>@Locale.T("emp.id")</th>
                        <th>@Locale.T("emp.name")</th>
                        <th>@Locale.T("emp.designation")</th>
                        <th>@Locale.T("emp.type")</th>
                        <th>@Locale.T("emp.phone")</th>
                        <th>@Locale.T("sal.payorderName")</th>
                        <th>@Locale.T("emp.bank")</th>
                    </tr>
                </thead>
                <tbody>
                @if (employees.Count == 0 && !busy)
                {
                    <tr><td colspan="8" class="empty-row">@Locale.T("sal.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in employees)
                    {
                        <tr>
                            <td class="act"><input type="checkbox" @bind="row.Selected" disabled="@busy" /></td>
                            <td>@row.Emp.ID</td>
                            <td>@row.Emp.Name</td>
                            <td>@row.Emp.Designation</td>
                            <td>@row.Emp.EmployeeType</td>
                            <td>@row.Emp.Phone</td>
                            <td>@(row.Emp.PayorderName ?? "—")</td>
                            <td>@(row.Emp.BankAccNo ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn-serial" disabled="@(busy || payorderId <= 0)" @onclick="AssignAsync">@Locale.T("sal.update")</button>
    </div>

    <div class="structure-card no-print">
        <h2 class="emp-list-title">@Locale.T("sal.generateList")</h2>
        <div class="sal-scroll">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th class="act">
                            <input type="checkbox" checked="@AllGenerateChecked" disabled="@(busy || !generateRows.Any())"
                                   @onchange="e => ToggleGenerateAll(e)" />
                        </th>
                        <th>@Locale.T("emp.id")</th>
                        <th>@Locale.T("emp.name")</th>
                        <th>@Locale.T("emp.phone")</th>
                        <th>@Locale.T("emp.designation")</th>
                        <th>@Locale.T("emp.type")</th>
                        <th class="num">@Locale.T("emp.salary")</th>
                        <th>@Locale.T("emp.bank")</th>
                    </tr>
                </thead>
                <tbody>
                @if (!generateRows.Any() && !busy)
                {
                    <tr><td colspan="8" class="empty-row">@Locale.T("sal.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in generateRows)
                    {
                        <tr>
                            <td class="act"><input type="checkbox" @bind="row.Selected" disabled="@busy" /></td>
                            <td>@row.Emp.ID</td>
                            <td>@row.Emp.Name</td>
                            <td>@row.Emp.Phone</td>
                            <td>@row.Emp.Designation</td>
                            <td>@row.Emp.EmployeeType</td>
                            <td class="num">@Money(row.Emp.Salary)</td>
                            <td>@(row.Emp.BankAccNo ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <button type="button" class="btn-serial" disabled="@busy" @onclick="GenerateAsync">@Locale.T("sal.generate")</button>
    </div>

    <div class="sal-scroll">
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("emp.id")</th>
                    <th>@Locale.T("emp.name")</th>
                    <th class="num">@Locale.T("sal.basic")</th>
                    <th>@Locale.T("sal.wd")</th>
                    <th>@Locale.T("sal.present")</th>
                    <th>@Locale.T("sal.abs")</th>
                    <th>@Locale.T("sal.late")</th>
                    <th>@Locale.T("sal.leave")</th>
                    <th>@Locale.T("sal.fineCount")</th>
                    <th>@Locale.T("sal.allowance")</th>
                    <th>@Locale.T("sal.addBonus")</th>
                    <th class="num">@Locale.T("sal.gross")</th>
                    <th>@Locale.T("sal.deduction")</th>
                    <th>@Locale.T("sal.addFine")</th>
                    <th class="num">@Locale.T("sal.net")</th>
                    <th class="act no-print">@Locale.T("sal.delete")</th>
                </tr>
            </thead>
            <tbody>
            @if (monthly.Count == 0 && !busy)
            {
                <tr><td colspan="16" class="empty-row">@Locale.T("sal.empty")</td></tr>
            }
            else
            {
                @foreach (var row in monthly)
                {
                    <tr>
                        <td>@row.ID</td>
                        <td>@row.Name</td>
                        <td class="num">@Money(row.PayorderAmount)</td>
                        <td>@row.WorkingDays</td>
                        <td>@row.PresentDays</td>
                        <td>@row.AbsDays</td>
                        <td>@row.LateDays</td>
                        <td>@row.LeaveDays</td>
                        <td>@row.FineCountDays</td>
                        <td class="sal-lines">
                            @foreach (var line in row.Allowances)
                            {
                                <div>@line.Name: @Money(line.Amount)</div>
                            }
                        </td>
                        <td class="sal-lines no-print">
                            @foreach (var line in row.Bonuses)
                            {
                                <div class="sal-line">
                                    <span>@line.Name</span>
                                    <input type="number" step="0.01" @bind="line.Amount" disabled="@busy" />
                                </div>
                            }
                        </td>
                        <td class="num">@Money(row.GrossSalary)</td>
                        <td class="sal-lines">
                            @foreach (var line in row.Deductions)
                            {
                                <div>@line.Name: @Money(line.Amount)</div>
                            }
                        </td>
                        <td class="sal-lines no-print">
                            <div class="sal-line">
                                <span>@Locale.T("sal.attendanceFine")</span>
                                <input type="number" step="0.01" @bind="row.AttendanceFine" disabled="@busy" />
                            </div>
                            @foreach (var line in row.Fines)
                            {
                                <div class="sal-line">
                                    <span>@line.Name</span>
                                    <input type="number" step="0.01" @bind="line.Amount" disabled="@busy" />
                                </div>
                            }
                        </td>
                        <td class="num">@Money(row.NetSalary)</td>
                        <td class="act no-print">
                            @if (row.PaidAmount == 0)
                            {
                                <button type="button" class="link-btn danger" disabled="@busy" @onclick="() => DeleteMonthlyAsync(row)">@Locale.T("sal.delete")</button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (monthly.Count > 0)
    {
        <button type="button" class="btn-serial no-print" disabled="@busy" @onclick="UpdateBonusFineAsync">@Locale.T("sal.bonusFineUpdate")</button>
    }
</div>

@code {
    private readonly List<SalaryNameDto> names = [];
    private readonly List<SalaryMonthDto> months = [];
    private readonly List<Pick> employees = [];
    private readonly List<MonthlyPayorderDto> monthly = [];
    private string newPayorder = "";
    private string editName = "";
    private string type = "%";
    private string monthName = "";
    private int payorderId;
    private int editingId;
    private bool busy;
    private string? error;
    private string? message;

    private IEnumerable<Pick> generateRows => employees.Where(x => x.Emp.PayorderNameId == payorderId);
    private bool AllAssignChecked => employees.Count > 0 && employees.All(x => x.Selected);
    private bool AllGenerateChecked => generateRows.Any() && generateRows.All(x => x.Selected);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            names.Clear();
            months.Clear();
            names.AddRange(await Api.GetSalaryNamesAsync(Session.AccessToken, "payorder"));
            months.AddRange(await Api.GetSalaryMonthsAsync(Session.AccessToken));
            if (payorderId == 0 && names.Count > 0)
                payorderId = names[0].Id;
            if (string.IsNullOrWhiteSpace(monthName) && months.Count > 0)
            {
                var now = DateTime.Today;
                monthName = months.FirstOrDefault(x => x.Date.Year == now.Year && x.Date.Month == now.Month)?.Name
                            ?? months[0].Name;
            }
            await LoadEmployeesCoreAsync();
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnFilterChangedAsync()
    {
        foreach (var row in employees)
            row.Selected = payorderId > 0 && row.Emp.PayorderNameId == payorderId;
        await LoadMonthlyAsync();
    }

    private async Task SetType(string value)
    {
        type = value;
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            await LoadEmployeesCoreAsync();
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadMonthlyAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadEmployeesCoreAsync()
    {
        employees.Clear();
        var data = await Api.GetPayorderEmployeesAsync(Session.AccessToken, type);
        employees.AddRange(data.Select(x => new Pick
        {
            Emp = x,
            Selected = payorderId > 0 && x.PayorderNameId == payorderId
        }));
    }

    private async Task LoadMonthlyCoreAsync()
    {
        monthly.Clear();
        if (payorderId <= 0 || string.IsNullOrWhiteSpace(monthName))
            return;
        monthly.AddRange(await Api.GetMonthlyPayordersAsync(Session.AccessToken, payorderId, monthName, type));
    }

    private void ToggleAssignAll(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value?.ToString() == "True";
        foreach (var row in employees)
            row.Selected = on;
    }

    private void ToggleGenerateAll(ChangeEventArgs e)
    {
        var on = e.Value is true || e.Value?.ToString() == "True";
        foreach (var row in generateRows)
            row.Selected = on;
    }

    private void StartEdit(SalaryNameDto row)
    {
        editingId = row.Id;
        editName = row.Name;
    }

    private void CancelEdit()
    {
        editingId = 0;
        editName = "";
    }

    private async Task AddPayorderAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.CreateSalaryNameAsync(Session.AccessToken, "payorder", new SaveSalaryNameRequest { Name = newPayorder });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            newPayorder = "";
            payorderId = result.Id;
            message = Locale.T("sal.okName");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SavePayorderAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.UpdateSalaryNameAsync(Session.AccessToken, "payorder", editingId, new SaveSalaryNameRequest { Name = editName });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            CancelEdit();
            message = Locale.T("sal.okName");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeletePayorderAsync(SalaryNameDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sal.confirmDelete")))
            return;
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.DeleteSalaryNameAsync(Session.AccessToken, "payorder", row.Id);
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            if (payorderId == row.Id)
                payorderId = 0;
            message = Locale.T("sal.okDelete");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AssignAsync()
    {
        error = message = null;
        if (payorderId <= 0)
        {
            error = Locale.T("sal.needPayorder");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;
        var ids = employees.Where(x => x.Selected).Select(x => x.Emp.EmployeeID).ToList();
        busy = true;
        try
        {
            var result = await Api.AssignPayorderAsync(Session.AccessToken, new AssignPayorderRequest
            {
                PayorderNameId = payorderId,
                EmployeeIDs = ids
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            message = Locale.T("sal.okAssign");
            await LoadEmployeesCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task GenerateAsync()
    {
        error = message = null;
        var month = months.FirstOrDefault(x => x.Name == monthName);
        var ids = generateRows.Where(x => x.Selected).Select(x => x.Emp.EmployeeID).ToList();
        if (payorderId <= 0 || month is null || ids.Count == 0)
        {
            error = Locale.T("sal.needGenerate");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.GenerateSalaryAsync(Session.AccessToken, new GenerateSalaryRequest
            {
                PayorderNameId = payorderId,
                MonthDate = month.Date,
                MonthName = month.Name,
                EmployeeIDs = ids
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            message = Locale.T("sal.generated", result.Count);
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UpdateBonusFineAsync()
    {
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.UpdateBonusFineAsync(Session.AccessToken, new UpdateBonusFineRequest
            {
                Items = monthly.Select(x => new UpdateBonusFineItem
                {
                    EmployeePayorderID = x.EmployeePayorderID,
                    EmployeeID = x.EmployeeID,
                    AttendanceFine = x.AttendanceFine,
                    Bonuses = x.Bonuses,
                    Fines = x.Fines
                }).ToList()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            message = Locale.T("sal.okBonusFine");
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteMonthlyAsync(MonthlyPayorderDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sal.confirmPayorder")))
            return;
        error = message = null;
        if (!await EnsureOnlineAsync())
            return;
        busy = true;
        try
        {
            var result = await Api.DeleteMonthlyPayorderAsync(Session.AccessToken, row.EmployeePayorderID);
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }
            message = Locale.T("sal.okDelete");
            await LoadMonthlyCoreAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("sal.failed") : Locale.T(key);

    private static string Money(decimal value) => value.ToString("0.##");

    private sealed class Pick
    {
        public PayorderEmployeeDto Emp { get; set; } = new();
        public bool Selected { get; set; }
    }
}
