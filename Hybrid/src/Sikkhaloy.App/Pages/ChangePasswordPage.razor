@page "/profile/password"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject OfflineAuthService OfflineAuth
@inject NavigationManager Nav

<div class="card structure-page inst-page">
    <h1>@Locale.T("profile.changePassword")</h1>
    <p class="muted">@Locale.T("profile.crumb")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok">@message</div>
    }

    <div class="inst-grid" style="max-width: 28rem;">
        <label class="span-2">@Locale.T("profile.old")
            <input type="password" @bind="current" autocomplete="current-password" disabled="@busy" />
        </label>
        <label class="span-2">@Locale.T("profile.new")
            <input type="password" @bind="next" autocomplete="new-password" disabled="@busy" />
        </label>
        <label class="span-2">@Locale.T("profile.again")
            <input type="password" @bind="confirm" autocomplete="new-password" disabled="@busy" />
        </label>
    </div>

    <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveAsync">@Locale.T("profile.change")</button>
</div>

@code {
    private string current = "";
    private string next = "";
    private string confirm = "";
    private bool busy;
    private string? error;
    private string? message;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
            Nav.NavigateTo("/login", replace: true);
    }

    private async Task SaveAsync()
    {
        error = null;
        message = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("profile.needOnline");
            return;
        }

        busy = true;
        try
        {
            if (!await Api.PingAsync())
            {
                error = Locale.T("profile.needOnline");
                return;
            }

            var result = await Api.ChangePasswordAsync(Session.AccessToken, new ChangePasswordRequest
            {
                CurrentPassword = current,
                NewPassword = next,
                ConfirmPassword = confirm
            });
            if (!result.Succeeded)
            {
                error = Locale.T(result.Error ?? "profile.needOnline");
                return;
            }

            if (Session.Current is not null)
                await OfflineAuth.UpdateCachedPasswordAsync(Session.Current.UserName, next);
            current = next = confirm = "";
            message = Locale.T("profile.pwChanged");
        }
        catch (HttpRequestException)
        {
            error = Locale.T("profile.needOnline");
        }
        finally
        {
            busy = false;
        }
    }
}
