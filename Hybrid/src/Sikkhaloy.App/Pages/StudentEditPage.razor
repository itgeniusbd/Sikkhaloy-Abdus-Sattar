@page "/students/new"
@page "/students/{LocalId:guid}"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject SyncEngine Sync
@inject NavigationManager Nav
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card edit-page adm-page">
    <header class="adm-hero">
        <div class="adm-hero-copy">
            <span class="adm-hero-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M12 3 2 8l10 5 10-5-10-5Z"/>
                    <path d="M6 10.5V16c0 .8 2.7 3 6 3s6-2.2 6-3v-5.5"/>
                    <path d="M22 8v6"/>
                </svg>
            </span>
            <div>
                <p class="sa-kicker">@Locale.T("edit.kicker")</p>
                <h1>@(isNew ? Locale.T("edit.new") : Locale.T("edit.existing"))</h1>
                <p>@Locale.T("edit.hint")</p>
            </div>
        </div>
        <span class="adm-last-id @(string.IsNullOrWhiteSpace(lastEntryId) ? "is-empty" : null)">
            @Locale.T("edit.lastId", string.IsNullOrWhiteSpace(lastEntryId) ? "—" : lastEntryId)
        </span>
    </header>
    <EditForm Model="model" OnValidSubmit="CompleteAsync">
        <section class="edit-section required-sec open">
            <div class="edit-sec-head required">
                <h2>@Locale.T("edit.secStudent")</h2>
                <span class="edit-badge req">@Locale.T("edit.badgeReq")</span>
            </div>
            <div class="edit-body">
                <div class="adm-last-inline">
                    <strong>@Locale.T("edit.lastId", string.IsNullOrWhiteSpace(lastEntryId) ? "—" : lastEntryId)</strong>
                </div>
                <div class="edit-grid">
                    <label>
                        @Locale.T("edit.id")
                        <span class="id-input-wrap @idState">
                            <input value="@model.StudentCode"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="@Locale.T("edit.idPh")"
                                   @oninput="OnIdInput"
                                   @onkeydown="OnIdKeyDown" />
                            @if (idState == "valid")
                            {
                                <span class="id-mark ok" aria-hidden="true">✓</span>
                            }
                            else if (idState == "invalid")
                            {
                                <span class="id-mark bad" aria-hidden="true">!</span>
                            }
                            @if (showSuggestions)
                            {
                                <div class="id-suggest">
                                    @if (idState == "invalid")
                                    {
                                        <div class="id-suggest-warn">@Locale.T("edit.id.exists")</div>
                                    }
                                    @foreach (var item in suggestions)
                                    {
                                        <button type="button" class="@(item == highlightId ? "active" : null)"
                                                @onmousedown:preventDefault
                                                @onclick="() => SelectId(item)">@item</button>
                                    }
                                </div>
                            }
                        </span>
                        @if (idState == "invalid")
                        {
                            <span class="id-msg">@Locale.T("edit.id.exists")</span>
                        }
                    </label>
                    <label>@Locale.T("edit.mobile")
                        <input value="@model.SMSPhoneNo"
                               maxlength="11"
                               inputmode="numeric"
                               autocomplete="tel"
                               placeholder="@Locale.T("edit.mobilePh")"
                               class="@(phoneInvalid ? "is-bad" : null)"
                               @oninput="OnPhoneInput" />
                        @if (phoneInvalid)
                        {
                            <span class="id-msg">@Locale.T("edit.mobileInvalid")</span>
                        }
                    </label>
                    <label>@Locale.T("edit.session")
                        <input value="@sessionName" disabled />
                    </label>
                    <label>@Locale.T("edit.name")
                        <InputText @bind-Value="model.StudentsName" placeholder="@Locale.T("edit.namePh")" />
                    </label>
                    <label>@Locale.T("edit.gender")
                        <InputSelect @bind-Value="model.Gender">
                            <option value="Male">@Locale.T("male")</option>
                            <option value="Female">@Locale.T("female")</option>
                        </InputSelect>
                    </label>
                    <label>@Locale.T("edit.father")
                        <InputText @bind-Value="model.FathersName" class="@(fatherInvalid ? "is-bad" : null)" placeholder="@Locale.T("edit.fatherPh")" />
                        @if (fatherInvalid)
                        {
                            <span class="id-msg">@Locale.T("edit.fatherNeed")</span>
                        }
                    </label>
                </div>
            </div>
        </section>

        <section class="edit-section required-sec open">
            <div class="edit-sec-head required">
                <h2>@Locale.T("edit.secAcademic")</h2>
                <span class="edit-badge req">@Locale.T("edit.badgeReq")</span>
            </div>
            <div class="edit-body">
                <div class="edit-grid">
                    <label>@Locale.T("edit.class")
                        <InputSelect @bind-Value="selectedClassId" @bind-Value:after="OnClassChanged" class="@(classInvalid ? "is-bad" : null)">
                            <option value="0">@Locale.T("edit.classSelect")</option>
                            @foreach (var item in classes)
                            {
                                <option value="@item.ClassID">@item.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>@Locale.T("edit.roll")
                        <InputText @bind-Value="model.RollNo" />
                    </label>
                    @if (sections.Count > 0)
                    {
                        <label>@Locale.T("edit.section")
                            <InputSelect @bind-Value="selectedSectionId">
                                <option value="0">@Locale.T("edit.none")</option>
                                @if (selectedSectionId != 0 && sections.All(x => x.ServerId != selectedSectionId))
                                {
                                    <option value="@selectedSectionId">@(model.SectionName ?? selectedSectionId.ToString())</option>
                                }
                                @foreach (var item in sections)
                                {
                                    <option value="@item.ServerId">@item.Name</option>
                                }
                            </InputSelect>
                        </label>
                    }
                    @if (shifts.Count > 0)
                    {
                        <label>@Locale.T("edit.shift")
                            <InputSelect @bind-Value="selectedShiftId">
                                <option value="0">@Locale.T("edit.none")</option>
                                @if (selectedShiftId != 0 && shifts.All(x => x.ServerId != selectedShiftId))
                                {
                                    <option value="@selectedShiftId">@(model.ShiftName ?? selectedShiftId.ToString())</option>
                                }
                                @foreach (var item in shifts)
                                {
                                    <option value="@item.ServerId">@item.Name</option>
                                }
                            </InputSelect>
                        </label>
                    }
                    @if (groups.Count > 0)
                    {
                        <label>@Locale.T("edit.group")
                            <InputSelect @bind-Value="selectedGroupId">
                                <option value="0">@Locale.T("edit.none")</option>
                                @if (selectedGroupId != 0 && groups.All(x => x.ServerId != selectedGroupId))
                                {
                                    <option value="@selectedGroupId">@(model.GroupName ?? selectedGroupId.ToString())</option>
                                }
                                @foreach (var item in groups)
                                {
                                    <option value="@item.ServerId">@item.Name</option>
                                }
                            </InputSelect>
                        </label>
                    }
                </div>
                @if (classInvalid)
                {
                    <p class="id-msg" style="margin-top: 0.55rem;">@Locale.T("edit.classNeed")</p>
                }
                    @if (classes.Count == 0)
                {
                    <p class="muted" style="margin-top: 0.6rem;">@Locale.T("edit.noClasses")</p>
                }
            </div>
        </section>

        <section class="edit-section optional-sec open">
            <div class="edit-sec-head optional" style="cursor: default;">
                <h2>@Locale.T("edit.secPhotos")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
            </div>
            <div class="edit-body">
                <p class="adm-photo-hint">@Locale.T("edit.photoHint")</p>
                <div class="adm-photos">
                    <div class="adm-photo-card">
                        <span>@Locale.T("edit.stuPhoto")</span>
                        <label class="sm-photo adm-photo">
                            @if (!string.IsNullOrWhiteSpace(studentPhoto))
                            {
                                <img src="@studentPhoto" alt="" />
                            }
                            else
                            {
                                <span class="sm-photo-empty">@Locale.T("si.noPhoto")</span>
                            }
                            <span class="sm-photo-edit" title="@Locale.T("sm.photo")">✎</span>
                            <InputFile class="sm-photo-file"
                                       accept="image/*,.jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       OnChange="e => OnPhotoAsync(e, false)"
                                       disabled="@busy" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(studentPhoto))
                        {
                            <button type="button" class="adm-photo-clear" @onclick="() => studentPhoto = null">@Locale.T("edit.photoClear")</button>
                        }
                    </div>
                    <div class="adm-photo-card">
                        <span>@Locale.T("edit.guardPhoto")</span>
                        <label class="sm-photo adm-photo">
                            @if (!string.IsNullOrWhiteSpace(guardianPhoto))
                            {
                                <img src="@guardianPhoto" alt="" />
                            }
                            else
                            {
                                <span class="sm-photo-empty">@Locale.T("si.noPhoto")</span>
                            }
                            <span class="sm-photo-edit" title="@Locale.T("sm.guardianPhoto")">✎</span>
                            <InputFile class="sm-photo-file"
                                       accept="image/*,.jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       OnChange="e => OnPhotoAsync(e, true)"
                                       disabled="@busy" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(guardianPhoto))
                        {
                            <button type="button" class="adm-photo-clear" @onclick="() => guardianPhoto = null">@Locale.T("edit.photoClear")</button>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="edit-section optional-sec @(openExtra ? "open" : null)">
            <button type="button" class="edit-sec-head optional" @onclick="() => openExtra = !openExtra">
                <h2>@Locale.T("edit.secExtra")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
                <span class="edit-chevron">▼</span>
            </button>
            @if (openExtra)
            {
                <div class="edit-body">
                    <div class="edit-grid">
                        <label>@Locale.T("edit.dob")
                            <InputDate @bind-Value="model.DateofBirth" />
                        </label>
                        <label>@Locale.T("edit.legal")
                            <InputText @bind-Value="model.LegalIdentity" />
                        </label>
                        <label>@Locale.T("edit.blood")
                            <InputSelect @bind-Value="model.BloodGroup">
                                <option value="">@Locale.T("edit.none")</option>
                                <option value="Unknown">Unknown</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </InputSelect>
                        </label>
                        <label>@Locale.T("edit.religion")
                            <InputSelect @bind-Value="model.Religion">
                                <option value="Islam">Islam</option>
                                <option value="Hinduism">Hinduism</option>
                                <option value="Buddhism">Buddhism</option>
                                <option value="Christianity">Christianity</option>
                            </InputSelect>
                        </label>
                        <label>@Locale.T("edit.email")
                            <InputText @bind-Value="model.StudentEmailAddress" />
                        </label>
                        <label class="span-3">@Locale.T("edit.permAddr")
                            <InputTextArea @bind-Value="model.StudentPermanentAddress" />
                        </label>
                        <label class="span-3">
                            <span class="addr-row">@Locale.T("edit.localAddr")
                                <button type="button" class="same-addr" @onclick="CopyAddress">@Locale.T("edit.sameAddr")</button>
                            </span>
                            <InputTextArea @bind-Value="model.StudentsLocalAddress" />
                        </label>
                    </div>
                </div>
            }
        </section>

        <section class="edit-section optional-sec @(openParents ? "open" : null)">
            <button type="button" class="edit-sec-head optional" @onclick="() => openParents = !openParents">
                <h2>@Locale.T("edit.secParents")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
                <span class="edit-chevron">▼</span>
            </button>
            @if (openParents)
            {
                <div class="edit-body">
                    <div class="edit-grid">
                        <label>@Locale.T("edit.fatherPhone")
                            <InputText @bind-Value="model.FatherPhoneNumber" maxlength="13" />
                        </label>
                        <label>@Locale.T("edit.fatherJob")
                            <InputText @bind-Value="model.FatherOccupation" />
                        </label>
                        <label>@Locale.T("edit.mother")
                            <InputText @bind-Value="model.MothersName" />
                        </label>
                        <label>@Locale.T("edit.motherPhone")
                            <InputText @bind-Value="model.MotherPhoneNumber" maxlength="13" />
                        </label>
                        <label>@Locale.T("edit.motherJob")
                            <InputText @bind-Value="model.MotherOccupation" />
                        </label>
                    </div>
                </div>
            }
        </section>

        <section class="edit-section optional-sec @(openGuardian ? "open" : null)">
            <button type="button" class="edit-sec-head optional" @onclick="() => openGuardian = !openGuardian">
                <h2>@Locale.T("edit.secGuardian")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
                <span class="edit-chevron">▼</span>
            </button>
            @if (openGuardian)
            {
                <div class="edit-body">
                    <div class="edit-grid">
                        <label>@Locale.T("edit.guardianName")
                            <InputText @bind-Value="model.GuardianName" />
                        </label>
                        <label>@Locale.T("edit.relation")
                            <InputText @bind-Value="model.GuardianRelationshipwithStudent" />
                        </label>
                        <label>@Locale.T("edit.guardianPhone")
                            <InputText @bind-Value="model.GuardianPhoneNumber" maxlength="13" />
                        </label>
                    </div>
                </div>
            }
        </section>

        <section class="edit-section optional-sec @(openPrev ? "open" : null)">
            <button type="button" class="edit-sec-head optional" @onclick="() => openPrev = !openPrev">
                <h2>@Locale.T("edit.secPrev")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
                <span class="edit-chevron">▼</span>
            </button>
            @if (openPrev)
            {
                <div class="edit-body">
                    <div class="edit-grid">
                        <label class="span-2">@Locale.T("edit.prevSchool")
                            <InputText @bind-Value="model.PrevSchoolName" />
                        </label>
                        <label>@Locale.T("edit.prevClass")
                            <InputText @bind-Value="model.PrevClass" />
                        </label>
                        <label>@Locale.T("edit.prevYear")
                            <InputText @bind-Value="model.PrevExamYear" />
                        </label>
                        <label>@Locale.T("edit.prevGrade")
                            <InputText @bind-Value="model.PrevExamGrade" />
                        </label>
                    </div>
                </div>
            }
        </section>

        <section class="edit-section optional-sec @(openNotes ? "open" : null)">
            <button type="button" class="edit-sec-head optional" @onclick="() => openNotes = !openNotes">
                <h2>@Locale.T("edit.secNotes")</h2>
                <span class="edit-badge opt">@Locale.T("edit.badgeOpt")</span>
                <span class="edit-chevron">▼</span>
            </button>
            @if (openNotes)
            {
                <div class="edit-body">
                    <div class="edit-grid">
                        <label class="span-3">@Locale.T("edit.other")
                            <InputTextArea @bind-Value="model.OtherDetails" />
                        </label>
                    </div>
                </div>
            }
        </section>

        <section class="adm-actions">
            <div class="adm-checks">
                @if (isNew)
                {
                    <label class="adm-check">
                        <input type="checkbox" @bind="sendAdmissionSms" disabled="@busy" />
                        <span>@Locale.T("edit.sendSms")</span>
                    </label>
                }
                <label class="adm-check">
                    <input type="checkbox" @bind="printForm" disabled="@busy" />
                    <span>@Locale.T("edit.print")</span>
                </label>
            </div>
            @if (isNew)
            {
                <div class="adm-sms-banner">
                    <p>@Locale.T("edit.smsHint")</p>
                    <a href="sms/templates">@Locale.T("edit.smsSettings")</a>
                </div>
            }
            <div class="adm-btns">
                <button class="adm-btn is-save" type="submit" disabled="@(busy || idState == "invalid" || idState == "checking")">
                    @(isNew ? Locale.T("edit.complete") : Locale.T("edit.update"))
                </button>
                @if (isNew)
                {
                    <button class="adm-btn is-pay" type="button" disabled="@(busy || idState == "invalid" || idState == "checking")" @onclick="() => SaveAsync(true)">
                        @Locale.T("edit.goPayOrder")
                    </button>
                }
                <a class="adm-back" href="students">@Locale.T("edit.back")</a>
            </div>
        </section>
    </EditForm>
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <NetBanner Text="@error" />
    }
    @if (!string.IsNullOrWhiteSpace(okMessage))
    {
        <div class="ok">@okMessage</div>
    }
</div>

@code {
    [Parameter] public Guid LocalId { get; set; }

    private StudentDto model = new() { Gender = "Male", Religion = "Islam" };
    private IReadOnlyList<SchoolClassDto> classes = [];
    private IReadOnlyList<ClassPartDto> sections = [];
    private IReadOnlyList<ClassPartDto> shifts = [];
    private IReadOnlyList<ClassPartDto> groups = [];
    private ClassStructureDto? structure;
    private int selectedClassId;
    private int selectedSectionId;
    private int selectedShiftId;
    private int selectedGroupId;
    private string sessionName = "";
    private bool isNew = true;
    private bool busy;
    private string? error;
    private string? okMessage;
    private string idState = "";
    private string? lastEntryId;
    private bool phoneInvalid;
    private bool classInvalid;
    private bool fatherInvalid;
    private bool sendAdmissionSms = true;
    private bool printForm;
    private string? studentPhoto;
    private string? guardianPhoto;
    private List<string> suggestions = [];
    private string? highlightId;
    private CancellationTokenSource? idCheckCts;
    private bool idSuggestOpen;
    private bool openExtra;
    private bool openParents;
    private bool openGuardian;
    private bool openPrev;
    private bool openNotes;

    private bool lookupsReady;
    private string? loadedKey;

    private bool showSuggestions =>
        idSuggestOpen && (suggestions.Count > 0 || idState == "invalid");

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadFromRouteAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            await LoadFromRouteAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private bool IsNewRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        return path.Equals("students/new", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadFromRouteAsync()
    {
        if (!Session.IsAuthenticated || Session.Current is null)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        if (!lookupsReady)
        {
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
                await Sync.RefreshClassesAsync(Session.Current, Session.AccessToken);

            classes = await Sync.ListClassesAsync(Session.Current.SchoolID);
            structure = await Sync.GetClassStructureAsync(Session.Current.SchoolID);
            var years = await Sync.ListYearsAsync(Session.Current.SchoolID);
            sessionName = years.FirstOrDefault(x => x.EducationYearID == Session.Current.EducationYearID)?.Name
                          ?? Session.Current.SchoolName;
            lookupsReady = true;
        }

        var openingNew = IsNewRoute();
        var key = openingNew ? "new" : LocalId.ToString("N");
        if (loadedKey == key)
            return;
        loadedKey = key;

        if (openingNew)
            await ResetNewAsync();
        else
            await LoadExistingAsync();
    }

    private async Task ResetNewAsync()
    {
        isNew = true;
        model = new StudentDto { Gender = "Male", Religion = "Islam" };
        selectedClassId = 0;
        selectedSectionId = 0;
        selectedShiftId = 0;
        selectedGroupId = 0;
        idState = "";
        suggestions = [];
        highlightId = null;
        idSuggestOpen = false;
        error = null;
        okMessage = null;
        phoneInvalid = false;
        classInvalid = false;
        fatherInvalid = false;
        sendAdmissionSms = true;
        printForm = false;
        studentPhoto = null;
        guardianPhoto = null;
        openExtra = false;
        openParents = false;
        openGuardian = false;
        openPrev = false;
        openNotes = false;
        await LoadPartsAsync();
        await LoadLastIdAsync();
    }

    private async Task LoadExistingAsync()
    {
        isNew = false;
        var existing = LocalId == Guid.Empty ? null : await Sync.GetStudentAsync(LocalId);
        if (existing is null)
        {
            await ResetNewAsync();
            isNew = false;
            error = Locale.T("report.notFound");
            return;
        }

        model = existing;
        if (string.IsNullOrWhiteSpace(model.Gender))
            model.Gender = "Male";
        model.BloodGroup ??= "";
        if (string.IsNullOrWhiteSpace(model.Religion))
            model.Religion = "Islam";

        selectedClassId = model.ClassID ?? 0;
        selectedSectionId = model.SectionID ?? 0;
        selectedShiftId = model.ShiftID ?? 0;
        selectedGroupId = model.SubjectGroupID ?? 0;
        idState = "";
        suggestions = [];
        highlightId = null;
        idSuggestOpen = false;
        error = null;
        okMessage = null;
        phoneInvalid = false;
        classInvalid = false;
        fatherInvalid = false;
        sendAdmissionSms = false;
        printForm = false;
        studentPhoto = model.PhotoDataUrl;
        guardianPhoto = null;
        if (model.ServerId is int sid && sid > 0 && Session.Current is not null)
        {
            studentPhoto ??= Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, sid);
            guardianPhoto = Sync.GetGuardianPhotoDataUrl(Session.Current.SchoolID, sid);
        }
        openExtra = false;
        openParents = false;
        openGuardian = false;
        openPrev = false;
        openNotes = false;
        await LoadPartsAsync();
        await LoadLastIdAsync();
        if (!string.IsNullOrWhiteSpace(model.StudentCode))
            await CheckIdAsync();
    }

    public override void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        idCheckCts?.Cancel();
        idCheckCts?.Dispose();
        base.Dispose();
    }

    private async Task OnClassChanged()
    {
        classInvalid = selectedClassId <= 0;
        await LoadPartsAsync();
        if (sections.All(x => x.ServerId != selectedSectionId))
            selectedSectionId = 0;
        if (shifts.All(x => x.ServerId != selectedShiftId))
            selectedShiftId = 0;
        if (groups.All(x => x.ServerId != selectedGroupId))
            selectedGroupId = 0;
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        model.SMSPhoneNo = NormalizeBdMobile(e.Value?.ToString() ?? "");
        phoneInvalid = model.SMSPhoneNo.Length > 0 && !IsBdMobile(model.SMSPhoneNo);
    }

    private static string NormalizeBdMobile(string raw)
    {
        var digits = new string((raw ?? "").Where(char.IsDigit).ToArray());
        if (digits.StartsWith("880") && digits.Length >= 13)
            digits = digits[2..];
        return digits.Length > 11 ? digits[..11] : digits;
    }

    private static bool IsBdMobile(string? raw)
    {
        var digits = NormalizeBdMobile(raw ?? "");
        return digits.Length == 11 && digits.StartsWith("01", StringComparison.Ordinal)
               && digits[2] is >= '3' and <= '9';
    }

    private async Task OnPhotoAsync(InputFileChangeEventArgs e, bool guardian)
    {
        var file = e.File;
        if (file is null)
            return;
        try
        {
            await using var stream = file.OpenReadStream(2_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var raw = ms.ToArray();
            if (raw.Length == 0)
            {
                error = Locale.T("sm.badPhoto");
                return;
            }

            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(raw)}";
            var compressed = await JS.InvokeAsync<string>("sikkhaloyCompressImage", dataUrl, 300, 0.7, 80_000);
            if (string.IsNullOrWhiteSpace(compressed) || !compressed.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            {
                error = Locale.T("sm.badPhoto");
                return;
            }

            if (guardian)
                guardianPhoto = compressed;
            else
                studentPhoto = compressed;
            error = null;
        }
        catch
        {
            error = Locale.T("sm.badPhoto");
        }
    }

    private async Task TrySavePhotosAsync()
    {
        if (Session.Current is null || (string.IsNullOrWhiteSpace(studentPhoto) && string.IsNullOrWhiteSpace(guardianPhoto)))
            return;

        try
        {
        var saved = await Sync.GetStudentAsync(model.LocalId)
                    ?? await Sync.FindStudentByCodeAsync(Session.Current.SchoolID, Session.Current.EducationYearID, model.StudentCode ?? "");
        var serverId = saved?.ServerId ?? model.ServerId ?? 0;
        if (serverId <= 0)
            return;

        if (!string.IsNullOrWhiteSpace(studentPhoto))
        {
            Sync.SaveStudentPhoto(Session.Current.SchoolID, serverId, studentPhoto);
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                await Api.SaveStudentPhotoAsync(Session.AccessToken, new SaveStudentPhotoRequest
                {
                    StudentID = serverId,
                    ImageBase64 = studentPhoto,
                    IsGuardian = false
                });
            }
        }

        if (!string.IsNullOrWhiteSpace(guardianPhoto))
        {
            Sync.SaveGuardianPhoto(Session.Current.SchoolID, serverId, guardianPhoto);
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                await Api.SaveStudentPhotoAsync(Session.AccessToken, new SaveStudentPhotoRequest
                {
                    StudentID = serverId,
                    ImageBase64 = guardianPhoto,
                    IsGuardian = true
                });
            }
        }
        }
        catch
        {
        }
    }

    private async Task LoadPartsAsync()
    {
