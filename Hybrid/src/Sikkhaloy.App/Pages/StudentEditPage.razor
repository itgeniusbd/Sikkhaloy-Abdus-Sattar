    private void CopyAddress() =>
        model.StudentsLocalAddress = model.StudentPermanentAddress;

    private async Task OnIdInput(ChangeEventArgs e)
    {
        model.StudentCode = (e.Value?.ToString() ?? "").Replace(" ", "");
        idSuggestOpen = true;
        await CheckIdAsync();
    }

    private async Task OnIdKeyDown(KeyboardEventArgs e)
    {
        if (!showSuggestions || suggestions.Count == 0)
            return;

        if (e.Key == "ArrowDown")
        {
            var index = Math.Max(suggestions.IndexOf(highlightId ?? ""), -1);
            highlightId = suggestions[(index + 1) % suggestions.Count];
        }
        else if (e.Key == "ArrowUp")
        {
            var index = suggestions.IndexOf(highlightId ?? "");
            highlightId = suggestions[index <= 0 ? suggestions.Count - 1 : index - 1];
        }
        else if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(highlightId))
        {
            await SelectId(highlightId);
        }
        else if (e.Key == "Escape")
        {
            suggestions = [];
            highlightId = null;
            idSuggestOpen = false;
        }
    }

    private async Task SelectId(string id)
    {
        model.StudentCode = id;
        suggestions = [];
        highlightId = null;
        idSuggestOpen = false;
        await CheckIdAsync();
    }

    private async Task LoadLastIdAsync()
    {
        if (Session.Current is null)
            return;
        var check = await Sync.CheckStudentIdAsync(
            Session.Current.SchoolID,
            "",
            null,
            null,
            Session.AccessToken);
        lastEntryId = check.LastEntryId;
    }

    private async Task CheckIdAsync()
    {
        if (Session.Current is null)
            return;

        idCheckCts?.Cancel();
        idCheckCts = new CancellationTokenSource();
        var token = idCheckCts.Token;
        var code = model.StudentCode?.Trim() ?? "";
        if (code.Length == 0)
        {
            idState = "";
            suggestions = [];
            highlightId = null;
            return;
        }

        idState = "checking";
        try
        {
            await Task.Delay(250, token);
            var check = await Sync.CheckStudentIdAsync(
                Session.Current.SchoolID,
                code,
                isNew ? null : model.LocalId,
                isNew ? null : model.ServerId,
                Session.AccessToken,
                token);
            if (token.IsCancellationRequested)
                return;
            lastEntryId = check.LastEntryId ?? lastEntryId;
            idState = check.Exists ? "invalid" : "valid";
            suggestions = check.Suggestions
                .Where(x => !string.Equals(x, code, StringComparison.OrdinalIgnoreCase))
                .ToList();
            highlightId = suggestions.FirstOrDefault();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task CompleteAsync() => SaveAsync(false);

    private async Task SaveAsync(bool goPayOrder)
    {
        if (Session.Current is null)
            return;

        phoneInvalid = !IsBdMobile(model.SMSPhoneNo);
        classInvalid = selectedClassId <= 0;
        fatherInvalid = string.IsNullOrWhiteSpace(model.FathersName);
        if (string.IsNullOrWhiteSpace(model.StudentCode)
            || string.IsNullOrWhiteSpace(model.StudentsName)
            || fatherInvalid
            || phoneInvalid
            || classInvalid)
        {
            error = fatherInvalid && !phoneInvalid && !classInvalid && !string.IsNullOrWhiteSpace(model.StudentCode) && !string.IsNullOrWhiteSpace(model.StudentsName)
                ? Locale.T("edit.fatherNeed")
                : classInvalid && IsBdMobile(model.SMSPhoneNo) && !string.IsNullOrWhiteSpace(model.StudentCode) && !string.IsNullOrWhiteSpace(model.StudentsName)
                    ? Locale.T("edit.classNeed")
                    : phoneInvalid && !string.IsNullOrWhiteSpace(model.StudentCode) && !string.IsNullOrWhiteSpace(model.StudentsName)
                        ? Locale.T("edit.mobileInvalid")
                        : Locale.T("edit.required");
            return;
        }

        var check = await Sync.CheckStudentIdAsync(
            Session.Current.SchoolID,
            model.StudentCode,
            isNew ? null : model.LocalId,
            isNew ? null : model.ServerId,
            Session.AccessToken);
        lastEntryId = check.LastEntryId ?? lastEntryId;
        if (check.Exists)
        {
            idState = "invalid";
            error = Locale.T("edit.id.exists");
            return;
        }
        idState = "valid";

        model.SMSPhoneNo = NormalizeBdMobile(model.SMSPhoneNo ?? "");
        model.ClassID = selectedClassId;
        model.ClassName = classes.FirstOrDefault(x => x.ClassID == model.ClassID)?.Name;
        model.SectionID = sections.Count == 0 || selectedSectionId == 0 ? null : selectedSectionId;
        model.SectionName = sections.FirstOrDefault(x => x.ServerId == selectedSectionId)?.Name;
        model.ShiftID = shifts.Count == 0 || selectedShiftId == 0 ? null : selectedShiftId;
        model.ShiftName = shifts.FirstOrDefault(x => x.ServerId == selectedShiftId)?.Name;
        model.SubjectGroupID = groups.Count == 0 || selectedGroupId == 0 ? null : selectedGroupId;
        model.GroupName = groups.FirstOrDefault(x => x.ServerId == selectedGroupId)?.Name;
        if (string.IsNullOrWhiteSpace(model.Religion))
            model.Religion = "Islam";

        if (!IsNewRoute() && LocalId != Guid.Empty)
        {
            isNew = false;
            if (model.LocalId == Guid.Empty)
                model.LocalId = LocalId;
            var current = await Sync.GetStudentAsync(model.LocalId);
            if (current?.ServerId is > 0)
                model.ServerId = current.ServerId;
            if (current?.StudentClassServerId is > 0)
                model.StudentClassServerId = current.StudentClassServerId;
        }

        busy = true;
        error = null;
        okMessage = null;
        var wasNew = isNew;
        try
        {
            await Sync.SaveStudentAsync(model, Session.Current);
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
                await Sync.RunOnceAsync(Session.Current, Session.AccessToken, force: true);

            var savedId = model.StudentCode ?? "";
            await TrySavePhotosAsync();
            var smsNote = wasNew ? await TrySendAdmissionSmsAsync() : null;

            if (goPayOrder)
            {
                Nav.NavigateTo($"/accounts/pay-order?class={selectedClassId}&id={Uri.EscapeDataString(savedId)}");
                return;
            }

            if (printForm)
            {
                Nav.NavigateTo($"/students/details/{model.LocalId}");
                return;
            }

            if (wasNew)
            {
                await ResetNewAsync();
                loadedKey = "new";
                lastEntryId = string.IsNullOrWhiteSpace(lastEntryId) ? savedId : lastEntryId;
                okMessage = string.IsNullOrWhiteSpace(smsNote)
                    ? Locale.T("edit.saved", lastEntryId ?? savedId)
                    : $"{Locale.T("edit.saved", lastEntryId ?? savedId)} {smsNote}";
            }
            else
            {
                okMessage = Locale.T("edit.updated", savedId);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message.StartsWith("edit.", StringComparison.OrdinalIgnoreCase)
                ? Locale.T(ex.Message)
                : ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<string?> TrySendAdmissionSmsAsync()
    {
        if (!isNew || !sendAdmissionSms || string.IsNullOrWhiteSpace(Session.AccessToken))
            return null;

        try
        {
            var text = await BuildAdmissionSmsAsync();
            var result = await Api.SendOfficeSmsAsync(Session.AccessToken, new SendOfficeSmsRequest
            {
                Mode = "numbers",
                Text = text,
                Phones = model.SMSPhoneNo
            });
            if (!result.Succeeded)
            {
                await Api.QueueOfficeSmsAsync(model.SMSPhoneNo ?? "", text);
                return Locale.T("edit.smsQueued");
            }
            return Locale.T("edit.smsSent");
        }
        catch
        {
            try
            {
                var queued = await BuildAdmissionSmsAsync();
                await Api.QueueOfficeSmsAsync(model.SMSPhoneNo ?? "", queued);
                return Locale.T("edit.smsQueued");
            }
            catch
            {
                return Locale.T("edit.smsFail");
            }
        }
    }

    private async Task<string> BuildAdmissionSmsAsync()
    {
        var name = model.StudentsName ?? "";
        var id = model.StudentCode ?? "";
        var className = model.ClassName ?? "";
        var roll = model.RollNo ?? "";
        var school = Session.Current?.SchoolName ?? "";
        var date = DateTime.Today.ToString("dd MMM yyyy");

        if (!string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            try
            {
                var templates = await Api.GetSmsTemplatesAsync(Session.AccessToken, "Admission");
                var tpl = templates.FirstOrDefault(x => x.IsActive && string.Equals(x.TemplateType, "AdmissionConfirm", StringComparison.OrdinalIgnoreCase))
                          ?? templates.FirstOrDefault(x => x.IsActive);
                if (!string.IsNullOrWhiteSpace(tpl?.MessageTemplate))
                {
                    return tpl.MessageTemplate
                        .Replace("{StudentName}", name)
                        .Replace("{ID}", id)
                        .Replace("{Class}", className)
                        .Replace("{RollNo}", roll)
                        .Replace("{AdmissionDate}", date)
                        .Replace("{SchoolName}", school);
                }
            }
            catch
            {
            }
        }

        return Locale.IsBengali
            ? $"অভিনন্দন! {name} আপনি {className} শ্রেণীতে ভর্তি হয়েছেন। আইডি: {id}, রোল: {roll}। ধন্যবাদ - {school}"
            : $"Congratulation!! {name} You have been admitted into class: {className}. ID: {id}. Roll No: {roll}. Please save this information. Regards: {school}";
    }
}
