@page "/authority/page-access"
@layout AuthorityLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav

<div class="card ab-page access-page">
    <h1>@Locale.T("auth.m.pageAccess")</h1>
    <p class="muted">@Locale.T("al.accessHint")</p>
    <div class="access-bar">
        <select class="access-select" @bind="userName" @bind:after="OnUserChanged" disabled="@busy">
            <option value="">@Locale.T("al.selectUser")</option>
            @foreach (var item in users)
            {
                <option value="@item.UserName">@item.Name</option>
            }
        </select>
        @if (pages.Count > 0)
        {
            <span class="access-count">@Locale.T("access.picked", selectedCount, pages.Count)</span>
        }
        <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="SaveAsync">@Locale.T("access.update")</button>
    </div>
    @if (users.Count == 0 && !busy)
    {
        <p class="muted">@Locale.T("al.noUsers")</p>
    }
    <div class="access-grid">
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("access.category")</th>
                    <th>@Locale.T("access.subCategory")</th>
                    <th class="access-all">
                        <label>
                            <input type="checkbox" checked="@allChecked" disabled="@(pages.Count == 0 || busy)" @onchange="ToggleAll" />
                            @Locale.T("access.pageTitle")
                        </label>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (pages.Count == 0)
                {
                    <tr><td colspan="3" class="empty-row">@Locale.T("access.empty")</td></tr>
                }
                else
                {
                    @foreach (var row in pages)
                    {
                        <tr class="@(row.Allowed ? "is-allowed" : null)">
                            @if (row.ShowGroup)
                            {
                                <td class="access-cat" rowspan="@row.Span">@Locale.Menu(row.Category)</td>
                                <td class="access-sub" rowspan="@row.Span">@Locale.Menu(row.SubCategory)</td>
                            }
                            <td>
                                <label class="access-check">
                                    <input type="checkbox" checked="@row.Allowed" disabled="@busy" @onchange="e => ToggleRow(row, e)" />
                                    <span>@Locale.Menu(row.PageTitle)</span>
                                </label>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <div class="acc-result-back" @onclick="ClosePopup">
        <div class="acc-result @(popupError ? "is-err" : "is-ok")" @onclick:stopPropagation="true">
            <div class="acc-result-icon">@(popupError ? "!" : "✓")</div>
            <h3>@(popupError ? Locale.T("sms.errorTitle") : Locale.T("acc.success"))</h3>
            <p>@popupText</p>
            <button type="button" class="acc-btn acc-btn-primary" @onclick="ClosePopup">@Locale.T("acc.ok")</button>
        </div>
    </div>
}

@code {
    private readonly List<AuthAccessUserDto> users = [];
    private List<PageRow> pages = [];
    private string userName = "", busyTitle = "", popupText = "";
    private bool busy, popupError;
    private bool allChecked => pages.Count > 0 && pages.All(x => x.Allowed);
    private int selectedCount => pages.Count(x => x.Allowed);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated) { Nav.NavigateTo("/login", replace: true); return; }
        if (!Session.IsAuthority) { Nav.NavigateTo("/dashboard", replace: true); return; }
        await LoadAsync();
    }

    private async Task OnUserChanged() => await LoadAsync();

    private void ToggleAll(ChangeEventArgs e)
    {
        var on = e.Value is true or "true";
        foreach (var row in pages)
            row.Allowed = on;
    }

    private static void ToggleRow(PageRow row, ChangeEventArgs e) =>
        row.Allowed = e.Value is true or "true";

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            Show(Locale.T("al.needUser"), true);
            return;
        }
        await SetBusyAsync(Locale.T("ab.saving"));
        try
        {
            if (!await OnlineAsync()) return;
            var result = await Api.SaveAuthorityPageAccessAsync(Session.AccessToken!, new AuthAccessSaveRequest
            {
                UserName = userName,
                LinkIDs = pages.Where(x => x.Allowed).Select(x => x.LinkID).ToList()
            });
            if (!result.Succeeded) { Show(Err(result.Error), true); return; }
            Show(Locale.T(result.Message ?? "al.accessSaved"), false);
            await LoadAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task LoadAsync()
    {
        await SetBusyAsync(Locale.T("acc.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            var data = await Api.GetAuthorityPageAccessAsync(Session.AccessToken!, userName);
            users.Clear();
            users.AddRange(data.Users);
            pages = BuildRows(data.Pages);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private static List<PageRow> BuildRows(IReadOnlyList<Sikkhaloy.Shared.Access.PageAccessRowDto> source)
    {
        var rows = source.Select(x => new PageRow
        {
            LinkID = x.LinkID,
            Category = x.Category,
            SubCategory = x.SubCategory,
            PageTitle = x.PageTitle,
            Allowed = x.Allowed
        }).ToList();

        for (var i = 0; i < rows.Count;)
        {
            var span = 1;
            while (i + span < rows.Count
                   && rows[i].Category == rows[i + span].Category
                   && rows[i].SubCategory == rows[i + span].SubCategory)
                span++;
            rows[i].ShowGroup = true;
            rows[i].Span = span;
            for (var j = 1; j < span; j++)
                rows[i + j].ShowGroup = false;
            i += span;
        }
        return rows;
    }

    private void ClosePopup() => popupText = "";
    private void Show(string text, bool err) { popupText = text; popupError = err; }
    private string Err(string? error) =>
        string.IsNullOrWhiteSpace(error) ? Locale.T("ab.failed")
        : error.Contains('.') ? Locale.T(error) : error;
    private async Task SetBusyAsync(string title) { busyTitle = title; busy = true; await InvokeAsync(StateHasChanged); await Task.Delay(40); }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }

    private sealed class PageRow
    {
        public int LinkID { get; set; }
        public string Category { get; set; } = "";
        public string SubCategory { get; set; } = "";
        public string PageTitle { get; set; } = "";
        public bool Allowed { get; set; }
        public bool ShowGroup { get; set; }
        public int Span { get; set; } = 1;
    }
}
