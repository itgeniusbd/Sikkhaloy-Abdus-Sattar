@page "/committee/unpaid"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page committee-page sms-mod cm-unp-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">Committee / @Locale.T("cm.unpaid")</p>
            <h1>@Locale.T("cm.unpaid")</h1>
            <p class="cm-col-lead">@Locale.T("cm.unpaidSub")</p>
        </div>
    </header>

    <div class="cm-col-find no-print">
        <input type="text" placeholder="@Locale.T("cm.enterReceipt")" value="@sn" disabled="@busy" autocomplete="off"
               @oninput="OnSnInput" @onkeydown="OnFindKey" />
        <button type="button" class="cm-act cm-act-success" disabled="@busy" @onclick="FindAsync">@Locale.T("cm.find")</button>
    </div>

    @if (receipt.Found)
    {
        <section class="cm-unp-donor">
            <div class="cm-col-photo">
                @if (!string.IsNullOrWhiteSpace(receipt.PhotoDataUrl))
                {
                    <img src="@receipt.PhotoDataUrl" alt="" />
                }
                else
                {
                    <span>@Initial(receipt.MemberName)</span>
                }
            </div>
            <div class="cm-col-meta">
                <h2>@receipt.MemberName</h2>
                <small>@receipt.MemberType</small>
                <span class="cm-status @(receipt.Status == "Active" ? "is-on" : "is-off")">
                    @(receipt.Status == "Active" ? Locale.T("cm.activeMember") : Locale.T("cm.inactiveMember"))
                </span>
            </div>
            <div class="cm-unp-stats">
                <article class="is-total">
                    <small>@Locale.T("cm.totalDonation")</small>
                    <b>৳ @Tk(receipt.TotalDonation)</b>
                </article>
                <article class="is-paid">
                    <small>@Locale.T("cm.paidDonation")</small>
                    <b>৳ @Tk(receipt.PaidDonation)</b>
                </article>
                <article class="is-due">
                    <small>@Locale.T("cm.dueAmount")</small>
                    <b>৳ @Tk(receipt.DueDonation)</b>
                </article>
            </div>
            <ul class="cm-unp-facts">
                <li><b>@Locale.T("cm.phone")</b><span>@receipt.SmsNumber</span></li>
                <li><b>@Locale.T("cm.address")</b><span>@receipt.Address</span></li>
                <li><b>@Locale.T("cm.memberType")</b><span>@receipt.MemberType</span></li>
            </ul>
        </section>

        <section class="cm-col-grid">
            <div class="cm-col-table">
                <table class="mgrid">
                    <thead>
                        <tr>
                            <th>@Locale.T("cm.donationCategory")</th>
                            <th>@Locale.T("cm.desc")</th>
                            <th>@Locale.T("cm.paidAmount")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in receipt.Lines)
                    {
                        <tr>
                            <td>@line.DonationCategory</td>
                            <td>@line.Description</td>
                            <td class="cm-mem-num is-paid">৳ @Tk(line.PaidAmount)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <footer class="cm-col-bar no-print">
                <div class="cm-col-pay">
                    <label>
                        <span>@Locale.T("cm.receiptNo")</span>
                        <input type="text" value="@receipt.CommitteeMoneyReceiptSn" readonly />
                    </label>
                    <label>
                        <span>@Locale.T("cm.payMethod")</span>
                        <input type="text" value="@receipt.AccountName" readonly />
                    </label>
                    <label>
                        <span>@Locale.T("cm.paidDate")</span>
                        <input type="text" value="@(receipt.PaidDate?.ToString("d MMM yyyy"))" readonly />
                    </label>
                    <b>@Locale.T("cm.total"): ৳ @Tk(receipt.TotalAmount)</b>
                    <button type="button" class="cm-act cm-act-success" disabled="@busy" @onclick="() => showConfirm = true">
                        @Locale.T("cm.unpaidBtn")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(receipt.ReceivedBy))
                {
                    <p class="cm-recv">@Locale.T("cm.recvBy", receipt.ReceivedBy)</p>
                }
            </footer>
        </section>
    }
    else if (searched)
    {
        <p class="empty-row">@Locale.T("cm.emptyUnpaid")</p>
    }
</div>

@if (showConfirm)
{
    <div class="acc-result-back" @onclick="() => showConfirm = false">
        <div class="acc-result is-err" @onclick:stopPropagation="true">
            <div class="acc-result-icon">!</div>
            <h3>@Locale.T("cm.unpaidBtn")</h3>
            <p>@Locale.T("cm.confirmUnpaid")</p>
            <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="UnpaidAsync">@Locale.T("cm.unpaidBtn")</button>
            <button type="button" class="acc-btn" @onclick="() => showConfirm = false">@Locale.T("cm.cancel")</button>
        </div>
    </div>
}

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("exam.pleaseWait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private UnpaidReceiptDto receipt = new();
    private string sn = "", busyTitle = "", popupText = "";
    private bool busy, popupError, searched, showConfirm;

    private void OnSnInput(ChangeEventArgs e) => sn = e.Value?.ToString() ?? "";

    private Task OnFindKey(KeyboardEventArgs e) =>
        e.Key == "Enter" ? FindAsync() : Task.CompletedTask;

    private async Task FindAsync()
    {
        if (string.IsNullOrWhiteSpace(sn))
        {
            Show(Locale.T("cm.needReceipt"), true);
            return;
        }
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken)) { Show(Locale.T("subj.needOnline"), true); return; }
            receipt = await Api.GetUnpaidReceiptAsync(Session.AccessToken!, sn);
            searched = true;
            if (!receipt.Found) { Show(Locale.T("cm.emptyUnpaid"), true); return; }
            _ = FillPhotoAsync(receipt.CommitteeMemberId);
        }
        catch (Exception ex) { Show(ex.Message, true); }
    }

    private async Task UnpaidAsync()
    {
        showConfirm = false;
        await SetBusyAsync(Locale.T("cm.saving"));
        try
        {
            var result = await Api.UnpaidReceiptAsync(Session.AccessToken!, sn);
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            receipt = new UnpaidReceiptDto();
            searched = false;
            Show(Locale.T(result.Message ?? "cm.unpaidDone"));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private static string Tk(decimal n) => n.ToString("0.##");
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "D" : name.Trim()[..1];
    private void Show(string value, bool err = false) { popupText = value; popupError = err; }
    private void ClosePopup() => popupText = "";
    private string FormatErr(CommitteeResult result) =>
        string.IsNullOrWhiteSpace(result.Error) ? Locale.T("cm.fail")
        : result.Error.StartsWith("cm.", StringComparison.OrdinalIgnoreCase) ? Locale.T(result.Error) : result.Error;
    private async Task SetBusyAsync(string title) { busyTitle = title; busy = true; await InvokeAsync(StateHasChanged); await Task.Delay(40); }

    private async Task FillPhotoAsync(int id)
    {
        if (id <= 0 || string.IsNullOrWhiteSpace(Session.AccessToken)) return;
        try
        {
            var url = await Api.GetCommitteeMemberPhotoAsync(Session.AccessToken!, id);
            if (receipt.CommitteeMemberId != id || string.IsNullOrWhiteSpace(url)) return;
            receipt.PhotoDataUrl = url;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }
}
