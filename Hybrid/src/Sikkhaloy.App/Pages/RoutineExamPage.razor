@page "/routine/exam"
@page "/routine/exam-bn"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page emp-page acc-page exam-page routine-page exam-routine-page">
    <div class="rt-exam-head">
        <h1>@Locale.T("rt.examEn")</h1>
    </div>
    <div class="rt-exam-bar rt-exam-bar-grid no-print">
        <div class="rt-exam-group">
            <span>@Locale.T("rt.classCol")</span>
            <button type="button" class="acc-btn" disabled="@busy" @onclick="AddColumn">@Locale.T("rt.add")</button>
            <button type="button" class="acc-btn" disabled="@busy" @onclick="RemoveColumn">@Locale.T("rt.remove")</button>
            <em>(@sheet.Columns.Count)</em>
        </div>
        <div class="rt-exam-group">
            <span>@Locale.T("rt.row")</span>
            <button type="button" class="acc-btn" disabled="@busy" @onclick="AddRow">@Locale.T("rt.add")</button>
            <button type="button" class="acc-btn" disabled="@busy" @onclick="RemoveRow">@Locale.T("rt.remove")</button>
            <em>(@sheet.Rows.Count)</em>
        </div>
        <div class="rt-exam-group">
            <button type="button" class="acc-btn" disabled="@busy" @onclick="RefreshSubjectsAsync">@Locale.T("rt.refresh")</button>
        </div>
    </div>
    <div class="rt-exam-bar no-print">
        <button type="button" class="acc-btn rt-exam-load" disabled="@busy" @onclick="LoadSavedAsync">@Locale.T("rt.load")</button>
        <button type="button" class="acc-btn rt-exam-del" disabled="@busy" @onclick="DeleteAsync">@Locale.T("sms.delete")</button>
        <button type="button" class="acc-btn rt-exam-save" disabled="@busy" @onclick="SaveAsync">@Locale.T("rt.save")</button>
        <button type="button" class="acc-btn rt-exam-print" @onclick="PrintAsync">@Locale.T("exam.print")</button>
        <label class="rt-exam-field">
            <span>@Locale.T("rt.routineName")</span>
            <input type="text" @bind="sheet.RoutineName" disabled="@busy" placeholder="@Locale.T("rt.examNameHint")" />
        </label>
        <label class="rt-exam-field">
            <span>@Locale.T("rt.routineList")</span>
            <select @bind="loadId" disabled="@busy">
                <option value="0">@Locale.T("rt.selectExam")</option>
                @foreach (var item in sheet.Saved)
                {
                    <option value="@item.RoutineID">@item.Name (@item.CreatedDate.ToString("dd MMM yyyy"))</option>
                }
            </select>
        </label>
    </div>

    <PrintHeader Subtitle="@(string.IsNullOrWhiteSpace(sheet.RoutineName) ? Locale.T("rt.examEn") : sheet.RoutineName)" />

    <div class="rt-exam-wrap">
        <table class="rt-exam-table" style="@($"--er-rows:{Math.Max(sheet.Rows.Count, 1)}")">
            <thead>
                <tr>
                    <th>@Locale.T("rt.date")</th>
                    <th>@Locale.T("rt.day")</th>
                    <th>@Locale.T("rt.time")</th>
                    @foreach (var col in sheet.Columns)
                    {
                        <th>
                            <div class="rt-exam-class no-print">
                                <span>@Locale.T("rt.classLabel"):</span>
                                <select value="@col.ClassID" disabled="@busy" @onchange="e => OnClassColAsync(col, e)">
                                    <option value="0">@Locale.T("si.selectClass")</option>
                                    @foreach (var item in sheet.Classes)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </div>
                            <span class="print-only">@ClassTitle(col)</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var row in sheet.Rows)
            {
                <tr>
                    <td>
                        <input type="date" class="no-print" value="@ToIso(row.ExamDate)" disabled="@busy"
                               @onchange="e => SetDate(row, e.Value?.ToString())" />
                        <span class="print-only">@row.ExamDate</span>
                    </td>
                    <td>@DisplayDay(row)</td>
                    <td>
                        <div class="rt-exam-slot">
                            <div class="rt-exam-time no-print">
                                <RoutineTimePicker Value="@ParseTime(row.StartTime)" ValueChanged="t => SetStart(row, t)" Disabled="busy" Placeholder="@Locale.T("rt.start")" />
                                <span>-</span>
                                <RoutineTimePicker Value="@ParseTime(row.EndTime)" ValueChanged="t => SetEnd(row, t)" Disabled="busy" Placeholder="@Locale.T("rt.end")" />
                            </div>
                            <div class="rt-exam-range print-only">@row.StartTime – @row.EndTime</div>
                            <div class="rt-exam-dur">@DisplayDuration(row)</div>
                        </div>
                    </td>
                    @foreach (var col in sheet.Columns)
                    {
                        var cell = row.Cells.FirstOrDefault(x => x.ColumnIndex == col.ColumnIndex);
                        <td>
                            @if (cell is not null)
                            {
                                <div class="rt-exam-cell no-print">
                                    <select @bind="cell.SubjectID" @bind:after="() => SyncSubjectText(cell, col)" disabled="@busy">
                                        <option value="0">@Locale.T("rt.selectSubject")</option>
                                        @foreach (var item in col.Subjects)
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }
                                    </select>
                                    <div class="rt-exam-meta">
                                        <input type="text" class="rt-exam-extra" @bind="cell.ExtraInfo" disabled="@busy"
                                               placeholder="@Locale.T("rt.extraInfo")" />
                                        <input type="text" class="rt-exam-cell-time" @bind="cell.TimeText" disabled="@busy"
                                               placeholder="@Locale.T("rt.cellTimeHint")" />
                                    </div>
                                </div>
                                <div class="rt-exam-print-cell print-only">
                                    @if (!string.IsNullOrWhiteSpace(SubjectName(cell, col)))
                                    {
                                        <div class="rt-exam-print-sub">@SubjectName(cell, col)</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(cell.ExtraInfo) || !string.IsNullOrWhiteSpace(cell.TimeText))
                                    {
                                        <div class="rt-exam-print-meta">
                                            @if (!string.IsNullOrWhiteSpace(cell.ExtraInfo))
                                            {
                                                <span class="rt-exam-print-extra">@cell.ExtraInfo</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(cell.TimeText))
                                            {
                                                <span class="rt-exam-print-time">@cell.TimeText</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="() => popupText = null" />
}

@code {
    private ExamRoutineSheetDto sheet = new();
    private int loadId;
    private bool busy, popupError;
    private string? popupText, busyTitle;

    protected override Task OnInitializedAsync() => BootAsync();

    private async Task BootAsync()
    {
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            sheet = await Api.GetExamRoutineAsync(Session.AccessToken!, 0);
            EnsureCells();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void AddColumn()
    {
        var idx = sheet.Columns.Count;
        sheet.Columns.Add(new ExamRoutineColumnDto { ColumnIndex = idx });
        foreach (var row in sheet.Rows)
            row.Cells.Add(new ExamRoutineCellDto { ColumnIndex = idx });
    }

    private void RemoveColumn()
    {
        if (sheet.Columns.Count <= 1) return;
        var idx = sheet.Columns.Count - 1;
        sheet.Columns.RemoveAt(idx);
        foreach (var row in sheet.Rows)
            row.Cells.RemoveAll(x => x.ColumnIndex == idx);
    }

    private void AddRow()
    {
        var row = new ExamRoutineRowDto { Duration = DefaultDuration() };
        foreach (var col in sheet.Columns)
            row.Cells.Add(new ExamRoutineCellDto { ColumnIndex = col.ColumnIndex });
        sheet.Rows.Add(row);
    }

    private void RemoveRow()
    {
        if (sheet.Rows.Count <= 1) return;
        sheet.Rows.RemoveAt(sheet.Rows.Count - 1);
    }

    private async Task OnClassColAsync(ExamRoutineColumnDto col, ChangeEventArgs e)
    {
        col.ClassID = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        col.ClassName = sheet.Classes.FirstOrDefault(x => x.Id == col.ClassID)?.Name ?? "";
        col.Subjects.Clear();
        if (col.ClassID <= 0) return;
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            col.Subjects.AddRange(await Api.GetExamRoutineSubjectsAsync(Session.AccessToken!, col.ClassID));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task RefreshSubjectsAsync()
    {
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            foreach (var col in sheet.Columns.Where(x => x.ClassID > 0))
            {
                col.Subjects.Clear();
                col.Subjects.AddRange(await Api.GetExamRoutineSubjectsAsync(Session.AccessToken!, col.ClassID));
            }
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task LoadSavedAsync()
    {
        if (loadId <= 0) return;
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            sheet = await Api.GetExamRoutineAsync(Session.AccessToken!, loadId);
            EnsureCells();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task SaveAsync()
    {
        await SetBusyAsync(Locale.T("rt.saving"));
        try
        {
            if (!await OnlineAsync()) return;
            Reindex();
            var result = await Api.SaveExamRoutineAsync(Session.AccessToken!, new SaveExamRoutineRequest
            {
                RoutineID = sheet.RoutineID,
                RoutineName = sheet.RoutineName,
                Columns = sheet.Columns,
                Rows = sheet.Rows
            });
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            sheet.RoutineID = result.Count;
            Show(Locale.T(result.Message ?? "rt.examSaved"));
            var saved = await Api.GetExamRoutineAsync(Session.AccessToken!, sheet.RoutineID);
            sheet.Saved = saved.Saved;
            loadId = sheet.RoutineID;
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (sheet.RoutineID <= 0) { Show(Locale.T("rt.needExam"), true); return; }
        await SetBusyAsync(Locale.T("rt.saving"));
        try
        {
            var result = await Api.DeleteExamRoutineAsync(Session.AccessToken!, sheet.RoutineID);
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            Show(Locale.T(result.Message ?? "rt.examDeleted"));
            await BootAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void EnsureCells()
    {
        if (sheet.Columns.Count == 0)
            sheet.Columns.Add(new ExamRoutineColumnDto { ColumnIndex = 0 });
        if (sheet.Rows.Count == 0)
            sheet.Rows.Add(new ExamRoutineRowDto { Duration = DefaultDuration() });
        foreach (var row in sheet.Rows)
        {
            foreach (var col in sheet.Columns)
            {
                if (row.Cells.All(x => x.ColumnIndex != col.ColumnIndex))
                    row.Cells.Add(new ExamRoutineCellDto { ColumnIndex = col.ColumnIndex });
            }
        }
    }

    private void Reindex()
    {
        for (var i = 0; i < sheet.Columns.Count; i++)
            sheet.Columns[i].ColumnIndex = i;
        foreach (var row in sheet.Rows)
        {
            for (var i = 0; i < sheet.Columns.Count; i++)
            {
                var cell = row.Cells.FirstOrDefault(x => x.ColumnIndex == sheet.Columns[i].ColumnIndex)
                           ?? row.Cells.ElementAtOrDefault(i);
                if (cell is not null)
                    cell.ColumnIndex = i;
            }
        }
    }

    private void SyncSubjectText(ExamRoutineCellDto cell, ExamRoutineColumnDto col)
    {
        cell.SubjectText = col.Subjects.FirstOrDefault(x => x.Id == cell.SubjectID)?.Name ?? "";
    }

    private string ClassTitle(ExamRoutineColumnDto col) =>
        string.IsNullOrWhiteSpace(col.ClassName) ? Locale.T("rt.classLabel") : Locale.T("rt.classLabel") + ": " + col.ClassName;

    private static string SubjectName(ExamRoutineCellDto cell, ExamRoutineColumnDto col) =>
        col.Subjects.FirstOrDefault(x => x.Id == cell.SubjectID)?.Name ?? cell.SubjectText ?? "";

    private void SetDate(ExamRoutineRowDto row, string? iso)
    {
        if (!DateTime.TryParse(iso, out var dt))
        {
            row.ExamDate = "";
            row.DayName = "";
            return;
        }
        row.ExamDate = dt.ToString("dd/MM/yyyy");
        row.DayName = Locale.IsBengali ? BnDay(dt.DayOfWeek) : dt.DayOfWeek.ToString();
    }

    private void SetStart(ExamRoutineRowDto row, TimeOnly? value)
    {
        row.StartTime = FormatTime(value);
        row.Duration = DurationText(row.StartTime, row.EndTime);
    }

    private void SetEnd(ExamRoutineRowDto row, TimeOnly? value)
    {
        row.EndTime = FormatTime(value);
        row.Duration = DurationText(row.StartTime, row.EndTime);
    }

    private string DisplayDay(ExamRoutineRowDto row)
    {
        if (TryParseExamDate(row.ExamDate, out var dt))
            return Locale.IsBengali ? BnDay(dt.DayOfWeek) : dt.DayOfWeek.ToString();
        return Locale.IsBengali ? BnDayName(row.DayName) : row.DayName;
    }

    private string DisplayDuration(ExamRoutineRowDto row)
    {
        if (DateTime.TryParse(row.StartTime, out var a) && DateTime.TryParse(row.EndTime, out var b) && b > a)
            return FormatHours((b - a).TotalHours);
        return FormatHours(ParseHours(row.Duration) ?? 3);
    }

    private string DefaultDuration() => FormatHours(3);

    private string DurationText(string start, string end)
    {
        if (!DateTime.TryParse(start, out var a) || !DateTime.TryParse(end, out var b) || b <= a)
            return DefaultDuration();
        return FormatHours((b - a).TotalHours);
    }

    private string FormatHours(double hours)
    {
        var n = hours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        if (!Locale.IsBengali)
            return n + (Math.Abs(hours - 1) < 0.001 ? " hour" : " hours");
        return ToBnDigits(n) + " ঘণ্টা";
    }

    private static double? ParseHours(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var match = System.Text.RegularExpressions.Regex.Match(FromBnDigits(text), @"\d+(\.\d+)?");
        return match.Success && double.TryParse(match.Value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n)
            ? n : null;
    }

    private static bool TryParseExamDate(string date, out DateTime dt)
    {
        if (DateTime.TryParseExact(date, ["dd/MM/yyyy", "d/M/yyyy", "dd-MMM-yyyy"], System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
            return true;
        return DateTime.TryParse(date, out dt);
    }

    private static string ToBnDigits(string value)
    {
        var chars = value.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            if (chars[i] is >= '0' and <= '9')
                chars[i] = (char)('০' + (chars[i] - '0'));
        }
        return new string(chars);
    }

    private static string FromBnDigits(string value)
    {
        var chars = value.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            if (chars[i] is >= '০' and <= '৯')
                chars[i] = (char)('0' + (chars[i] - '০'));
        }
        return new string(chars);
    }

    private static string BnDayName(string day) => day?.Trim() switch
    {
        "Saturday" or "Sat" => "শনিবার",
        "Sunday" or "Sun" => "রবিবার",
        "Monday" or "Mon" => "সোমবার",
        "Tuesday" or "Tue" => "মঙ্গলবার",
        "Wednesday" or "Wed" => "বুধবার",
        "Thursday" or "Thu" => "বৃহস্পতিবার",
        "Friday" or "Fri" => "শুক্রবার",
        _ => day ?? ""
    };

    private static string ToIso(string date)
    {
        if (DateTime.TryParseExact(date, ["dd/MM/yyyy", "d/M/yyyy"], System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt))
            return dt.ToString("yyyy-MM-dd");
        return DateTime.TryParse(date, out var any) ? any.ToString("yyyy-MM-dd") : "";
    }

    private static TimeOnly? ParseTime(string text) =>
        DateTime.TryParse(text, out var dt) ? TimeOnly.FromDateTime(dt) : null;

    private static string FormatTime(TimeOnly? value) =>
        value is null ? "" : DateTime.Today.Add(value.Value.ToTimeSpan()).ToString("h:mm tt");

    private static string BnDay(DayOfWeek day) => day switch
    {
        DayOfWeek.Saturday => "শনিবার",
        DayOfWeek.Sunday => "রবিবার",
        DayOfWeek.Monday => "সোমবার",
        DayOfWeek.Tuesday => "মঙ্গলবার",
        DayOfWeek.Wednesday => "বুধবার",
        DayOfWeek.Thursday => "বৃহস্পতিবার",
        _ => "শুক্রবার"
    };

    private Task PrintAsync() => JS.InvokeVoidAsync("sikkhaloyPrintExamRoutine").AsTask();
    private void Show(string value, bool err = false) { popupText = value; popupError = err; }
    private string FormatErr(RoutineResult result) =>
        string.IsNullOrWhiteSpace(result.Error) ? Locale.T("rt.fail")
        : result.Error.StartsWith("rt.", StringComparison.OrdinalIgnoreCase) ? Locale.T(result.Error) : result.Error;
    private async Task SetBusyAsync(string title)
    {
        busyTitle = title;
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
