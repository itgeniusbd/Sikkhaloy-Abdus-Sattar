@page "/exam/pass-marks"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page">
    <h1>@Locale.T("exam.passTitle")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <select @bind="examId" @bind:after="OnExamAsync" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.Exams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <select @bind="subExamId" @bind:after="LoadRowsAsync" disabled="@busy">
            <option value="0">@Locale.T("exam.allSub")</option>
            @foreach (var item in filters.SubExams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
    </div>

    <table class="mgrid">
        <thead>
            <tr>
                <th>@Locale.T("exam.subject")</th>
                <th>@Locale.T("exam.subExam")</th>
                <th>@Locale.T("exam.fullMark")</th>
                <th>
                    @Locale.T("exam.passMark")
                    <button type="button" class="acc-btn acc-btn-primary" style="margin-left:0.4rem;" disabled="@busy" @onclick="RoundPass">@Locale.T("exam.roundPass")</button>
                </th>
            </tr>
        </thead>
        <tbody>
        @if (rows.Count == 0 && !busy)
        {
            <tr><td colspan="4" class="empty-row">@Locale.T("exam.empty")</td></tr>
        }
        else
        {
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.SubjectName</td>
                    <td>@(row.SubExamName ?? "")</td>
                    <td>@row.FullMarks</td>
                    <td><input type="number" step="0.01" @bind="row.Sub_PassMarks" disabled="@busy" /></td>
                </tr>
            }
        }
        </tbody>
    </table>

    @if (rows.Count > 0)
    {
        <p class="exam-hint">@Locale.T("exam.passWarn")</p>
        <button type="button" class="acc-btn acc-btn-primary no-print" disabled="@busy" @onclick="SaveAsync">@Locale.T("exam.changePass")</button>
    }
</div>

@if (busy)
{
    <div class="acc-loading-back">
        <div class="acc-loading">
            <div class="acc-spinner"></div>
            <p>@Locale.T("acc.loading")</p>
            <div class="acc-prog-track"><div class="acc-prog-fill is-run"></div></div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="exam.failed" OnClose="ClosePopup" />
}

@code {
    private ExamFilterDto filters = new();
    private readonly List<PassMarkRowDto> rows = [];
    private int classId, examId, subExamId;
    private bool busy, popupError;
    private string? popupText;

    protected override Task OnInitializedAsync() => LoadFiltersAsync();

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "pass", classId, examId); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task OnClassAsync()
    {
        examId = 0;
        subExamId = 0;
        rows.Clear();
        await LoadFiltersAsync();
    }

    private async Task OnExamAsync()
    {
        subExamId = 0;
        await LoadFiltersAsync();
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        rows.Clear();
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try { rows.AddRange(await Api.GetExamPassMarksAsync(Session.AccessToken!, classId, examId, subExamId)); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void RoundPass()
    {
        foreach (var row in rows)
            row.Sub_PassMarks = Math.Floor(row.Sub_PassMarks);
    }

    private async Task SaveAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            var result = await Api.SaveExamPassMarksAsync(Session.AccessToken!, new SavePassMarksRequest { ClassID = classId, ExamID = examId, Rows = rows.ToList() });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "exam.failed"), true); return; }
            Show(Locale.T("exam.saved"));
            await LoadRowsAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void Show(string text, bool err = false) { popupText = text; popupError = err; }
    private void ClosePopup() => popupText = null;
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
