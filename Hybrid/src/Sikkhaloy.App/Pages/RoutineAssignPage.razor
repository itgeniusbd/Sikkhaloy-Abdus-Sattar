@page "/routine/assign"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card structure-page emp-page acc-page exam-page routine-page">
    <h1>@Locale.T("rt.assignTitle")</h1>
    <div class="filter-row no-print">
        <select @bind="classInput" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        @if (groups.Count > 0)
        {
            <select @bind="groupInput" @bind:after="LoadGridAsync" disabled="@busy">
                <option value="0">@Locale.T("sms.allGroup")</option>
                @foreach (var item in groups)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (sections.Count > 0)
        {
            <select @bind="sectionInput" @bind:after="LoadGridAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allSection")</option>
                @foreach (var item in sections)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (shifts.Count > 0)
        {
            <select @bind="shiftInput" @bind:after="LoadGridAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allShift")</option>
                @foreach (var item in shifts)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        <select @bind="routineInfoId" @bind:after="LoadGridAsync" disabled="@busy">
            <option value="0">@Locale.T("rt.selectName")</option>
            @foreach (var item in ReadyRoutines)
            {
                <option value="@item.RoutineInfoID">@item.Name (@item.PeriodCount)</option>
            }
        </select>
    </div>
    <p class="muted no-print"><a href="staff/teachers/subjects">@Locale.T("rt.assignTeacherHint")</a></p>

    @if (ReadyRoutines.Count == 0)
    {
        <p class="rt-hint">@Locale.T("rt.needCreateFirst") <a href="/routine/create">@Locale.T("rt.goCreate")</a></p>
    }
    else if (ClassId <= 0 || routineInfoId <= 0)
    {
        <p class="rt-hint">@Locale.T("rt.needClassRoutine")</p>
    }
    else if (sheet.Periods.Count == 0)
    {
        <p class="rt-hint">@Locale.T("rt.needCreateFirst") <a href="/routine/create">@Locale.T("rt.goCreate")</a></p>
    }
    else if (saved.Days.Count > 0)
    {
        <p class="rt-hint">@Locale.T("rt.alreadyHint") <a href="/routine/edit">@Locale.T("rt.goEdit")</a> · <a href="/routine/class">@Locale.T("rt.goView")</a></p>
        <div class="rt-wrap">
            <table class="rt-grid rt-view">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var period in saved.Periods)
                        {
                            <th>
                                <span class="rt-period">@period.Period</span>
                                <span class="rt-dur">@period.Duration</span>
                                <span class="rt-time">@period.TimeRange</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var day in saved.Days)
                {
                    <tr>
                        <th class="rt-day">@day.Day</th>
                        @foreach (var cell in day.Cells)
                        {
                            <td>
                                <div class="rt-sub">@cell.SubjectName</div>
                                <div>@cell.TeacherName</div>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else if (sheet.Days.Count == 0)
    {
        <p class="rt-hint">@Locale.T("rt.alreadyHint") <a href="/routine/edit">@Locale.T("rt.goEdit")</a> · <a href="/routine/class">@Locale.T("rt.goView")</a></p>
    }

    @if (sheet.Days.Count > 0)
    {
        <div class="rt-wrap">
            <table class="rt-grid rt-assign">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var period in sheet.Periods)
                        {
                            <th>
                                <span class="rt-period">@period.Period</span>
                                <span class="rt-dur">@period.Duration</span>
                                <span class="rt-time">@period.TimeRange</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var day in sheet.Days)
                {
                    <tr>
                        <th class="rt-day">@day.Day</th>
                        @foreach (var cell in day.Cells)
                        {
                            <td>
                                <select value="@cell.SubjectID" disabled="@busy" @onchange="e => OnSubjectAsync(day, cell, e)">
                                    <option value="0">@Locale.T("rt.selectSubject")</option>
                                    @foreach (var item in sheet.Subjects)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                                <select value="@cell.TeacherID" disabled="@busy" @onchange="e => OnTeacher(day, cell, e)">
                                    <option value="0">@Locale.T("rt.selectTeacher")</option>
                                    @foreach (var item in cell.Teachers)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="filter-row no-print">
            <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="SaveAsync">@Locale.T("rt.createBtn")</button>
        </div>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="() => popupText = null" />
}

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [], sections = [], shifts = [];
    private readonly List<RoutineNameDto> routines = [];
    private ClassStructureDto? structure;
    private ClassRoutineSheetDto sheet = new(), saved = new();
    private string classInput = "0", groupInput = "0", sectionInput = "0", shiftInput = "0";
    private int routineInfoId;
    private bool busy, popupError;
    private string? popupText, busyTitle;

    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int GroupId => int.TryParse(groupInput, out var n) ? n : 0;
    private int SectionId => int.TryParse(sectionInput, out var n) ? n : 0;
    private int ShiftId => int.TryParse(shiftInput, out var n) ? n : 0;
    private List<RoutineNameDto> ReadyRoutines =>
        routines.Where(x => x.Used || x.PeriodCount > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            structure = await Api.GetClassStructureAsync(Session.AccessToken!);
            classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
            routines.AddRange(await Api.GetRoutineNamesAsync(Session.AccessToken!, false));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task OnClassAsync()
    {
        groupInput = sectionInput = shiftInput = "0";
        groups.Clear(); sections.Clear(); shifts.Clear();
        if (structure is not null && ClassId > 0)
        {
            var parts = structure.AssignedParts(ClassId);
            groups.AddRange(parts.Groups);
            sections.AddRange(parts.Sections);
            shifts.AddRange(parts.Shifts);
        }
        await LoadGridAsync();
    }

    private async Task LoadGridAsync()
    {
        if (ClassId <= 0 || routineInfoId <= 0) { sheet = new(); saved = new(); return; }
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            if (!await OnlineAsync()) return;
            sheet = await Api.GetRoutineAssignAsync(Session.AccessToken!, ClassId, GroupId, SectionId, ShiftId, routineInfoId);
            saved = sheet.Days.Count == 0
                ? await Api.GetRoutineViewAsync(Session.AccessToken!, ClassId, GroupId, SectionId, ShiftId, routineInfoId, false)
                : new();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task OnSubjectAsync(RoutineDayRowDto day, RoutineCellDto cell, ChangeEventArgs e)
    {
        cell.SubjectID = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        cell.TeacherID = 0;
        cell.Teachers.Clear();
        if (cell.SubjectID <= 0) return;
        await SetBusyAsync(Locale.T("sms.loading"));
        try
        {
            var taken = TakenTeachers(day, cell);
            cell.Teachers.AddRange((await Api.GetRoutineTeachersAsync(Session.AccessToken!, ClassId, cell.SubjectID, day.Day, cell.StartTime, cell.EndTime, 0))
                .Where(x => !taken.Contains(x.Id)));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void OnTeacher(RoutineDayRowDto day, RoutineCellDto cell, ChangeEventArgs e)
    {
        var next = int.TryParse(e.Value?.ToString(), out var n) ? n : 0;
        if (next > 0 && TakenTeachers(day, cell).Contains(next))
        {
            cell.TeacherID = 0;
            Show(Locale.T("rt.teacherBusy"), true);
            return;
        }
        cell.TeacherID = next;
    }

    private HashSet<int> TakenTeachers(RoutineDayRowDto day, RoutineCellDto cell)
    {
        var taken = new HashSet<int>();
        foreach (var other in day.Cells)
        {
            if (other == cell || other.TeacherID <= 0)
                continue;
            if (TimesOverlap(cell.StartTime, cell.EndTime, other.StartTime, other.EndTime))
                taken.Add(other.TeacherID);
        }
        return taken;
    }

    private static bool TimesOverlap(string? startA, string? endA, string? startB, string? endB)
    {
        if (!DateTime.TryParse(startA, out var a) || !DateTime.TryParse(endA, out var b)
            || !DateTime.TryParse(startB, out var c) || !DateTime.TryParse(endB, out var d))
            return string.Equals(startA, startB, StringComparison.OrdinalIgnoreCase);
        return DateTime.Today.Add(a.TimeOfDay) < DateTime.Today.Add(d.TimeOfDay)
            && DateTime.Today.Add(c.TimeOfDay) < DateTime.Today.Add(b.TimeOfDay);
    }

    private async Task SaveAsync()
    {
        await SetBusyAsync(Locale.T("rt.saving"));
        try
        {
            if (!await OnlineAsync()) return;
            var result = await Api.AssignClassRoutineAsync(Session.AccessToken!, BuildRequest());
            if (!result.Succeeded) { Show(FormatErr(result), true); return; }
            Show(Locale.T(result.Message ?? "rt.assigned"));
            await LoadGridAsync();
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private AssignRoutineRequest BuildRequest()
    {
        var req = new AssignRoutineRequest
        {
            ClassID = ClassId,
            RoutineInfoID = routineInfoId,
            GroupID = GroupId,
            SectionID = SectionId,
            ShiftID = ShiftId
        };
        foreach (var day in sheet.Days)
        {
            foreach (var cell in day.Cells)
            {
                req.Cells.Add(new AssignRoutineCell
                {
                    Day = day.Day,
                    RoutineTimeID = cell.RoutineTimeID,
                    SubjectID = cell.SubjectID,
                    TeacherID = cell.TeacherID,
                    StartTime = cell.StartTime,
                    EndTime = cell.EndTime
                });
            }
        }
        return req;
    }

    private void Show(string value, bool err = false) { popupText = value; popupError = err; }
    private string FormatErr(RoutineResult result) =>
        string.IsNullOrWhiteSpace(result.Error) ? Locale.T("rt.fail")
        : result.Error.StartsWith("rt.", StringComparison.OrdinalIgnoreCase) ? Locale.T(result.Error) : result.Error;
    private async Task SetBusyAsync(string title)
    {
        busyTitle = title;
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
