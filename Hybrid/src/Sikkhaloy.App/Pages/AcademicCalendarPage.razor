@page "/basic-settings/academic-calendar"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card sa-page cal-page">
    <header class="sa-head sj-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("cal.kicker")</p>
            <h1>@Locale.T("cal.title")</h1>
            <p class="sa-lead">@Locale.T("cal.lead")</p>
        </div>
        <button type="button" class="btn-print" @onclick="PrintAsync">@Locale.T("cal.print")</button>
    </header>

    <PrintHeader Subtitle="@Locale.T("cal.title")" />

    <div class="cal-forms no-print">
        <article class="cal-card is-weekly">
            <h3>@Locale.T("cal.weekly")</h3>
            <p>@Locale.T("cal.weeklyHint")</p>
            <div class="cal-fields">
                <label class="cal-field">@Locale.T("cal.from")
                    <input type="date" @bind="weekStart" disabled="@busy" />
                </label>
                <label class="cal-field">@Locale.T("cal.to")
                    <input type="date" @bind="weekEnd" disabled="@busy" />
                </label>
            </div>
            <div class="cal-days">
                @foreach (var day in WeekOptions)
                {
                    <label class="cal-chip @(weekDays.Contains(day) ? "is-on" : null)">
                        <input type="checkbox" checked="@weekDays.Contains(day)" disabled="@busy"
                               @onchange="e => ToggleDay(day, e)" />
                        <span>@Locale.T($"cal.day.{day}")</span>
                    </label>
                }
            </div>
            <button type="button" class="btn-primary" disabled="@busy" @onclick="AddWeeklyAsync">@Locale.T("cal.addWeekly")</button>
        </article>
        <article class="cal-card">
            <h3>@Locale.T("cal.range")</h3>
            <p>@Locale.T("cal.rangeHint")</p>
            <div class="cal-fields">
                <label class="cal-field span-2">@Locale.T("cal.name")
                    <input type="text" placeholder="@Locale.T("cal.name")" @bind="rangeName" disabled="@busy" />
                </label>
                <label class="cal-field">@Locale.T("cal.from")
                    <input type="date" @bind="rangeStart" disabled="@busy" />
                </label>
                <label class="cal-field">@Locale.T("cal.to")
                    <input type="date" @bind="rangeEnd" disabled="@busy" />
                </label>
            </div>
            <button type="button" class="btn-primary" disabled="@busy" @onclick="AddRangeAsync">@Locale.T("cal.save")</button>
        </article>
        <article class="cal-card">
            <h3>@Locale.T("cal.single")</h3>
            <p>@Locale.T("cal.singleHint")</p>
            <div class="cal-fields">
                <label class="cal-field span-2">@Locale.T("cal.name")
                    <input type="text" placeholder="@Locale.T("cal.name")" @bind="singleName" disabled="@busy" />
                </label>
                <label class="cal-field span-2">@Locale.T("cal.date")
                    <input type="date" @bind="singleDate" disabled="@busy" />
                </label>
            </div>
            <button type="button" class="btn-primary" disabled="@busy" @onclick="AddSingleAsync">@Locale.T("cal.save")</button>
        </article>
    </div>

    <div class="cal-board">
        <div class="cal-nav no-print">
            <button type="button" class="cal-nav-btn" disabled="@busy" @onclick="PrevMonth">‹</button>
            <strong>@viewMonth.ToString("MMMM yyyy")</strong>
            <button type="button" class="cal-nav-btn" disabled="@busy" @onclick="NextMonth">›</button>
        </div>
        <div class="cal-grid">
            @foreach (var day in WeekOptions)
            {
                <div class="cal-dow @(day == "Friday" ? "is-friday" : null)">@Locale.T($"cal.day.{day}")</div>
            }
            @foreach (var cell in MonthCells())
            {
                var names = NamesOn(cell.Date).ToList();
                <div class="@CellClass(cell, names.Count > 0)">
                    @if (cell.InMonth)
                    {
                        <span class="cal-num">@cell.Date.Day</span>
                        @foreach (var name in names)
                        {
                            <span class="cal-event">@name</span>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <div class="cal-list no-print">
        <div class="cal-tabs">
            <button type="button" class="@(tab == "weekly" ? "is-on" : null)" @onclick='() => tab = "weekly"'>
                @Locale.T("cal.tabWeekly") <em>@weekly.Count</em>
            </button>
            <button type="button" class="@(tab == "other" ? "is-on" : null)" @onclick='() => tab = "other"'>
                @Locale.T("cal.tabOther") <em>@other.Count</em>
            </button>
        </div>
        <div class="sj-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Locale.T("cal.name")</th>
                        <th>@Locale.T("cal.date")</th>
                        <th class="act"></th>
                    </tr>
                </thead>
                <tbody>
                @{
                    var list = tab == "weekly" ? weekly : other;
                }
                @if (list.Count == 0)
                {
                    <tr><td colspan="4" class="empty-row">@Locale.T("cal.empty")</td></tr>
                }
                else
                {
                    var n = 0;
                    @foreach (var row in list)
                    {
                        n++;
                        <tr>
                            <td>@n</td>
                            <td>
                                @if (editingId == row.HolidayID)
                                {
                                    <input @bind="editName" disabled="@busy" />
                                }
                                else
                                {
                                    <span class="@(row.IsWeekly ? "pill pill-old" : "pill pill-new")">@row.HolidayName</span>
                                }
                            </td>
                            <td>
                                @if (editingId == row.HolidayID)
                                {
                                    <input type="date" @bind="editDate" disabled="@busy" />
                                }
                                else
                                {
                                    @row.HolidayDate.ToString("dddd, d MMM yyyy")
                                }
                            </td>
                            <td class="act">
                                @if (editingId == row.HolidayID)
                                {
                                    <button type="button" class="cls-act cls-act-edit" disabled="@busy" @onclick="() => SaveEditAsync(row)">@Locale.T("subj.update")</button>
                                    <button type="button" class="cls-act cls-act-del" disabled="@busy" @onclick="CancelEdit">@Locale.T("subj.cancel")</button>
                                }
                                else
                                {
                                    <button type="button" class="cls-act cls-act-edit" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("subj.edit")</button>
                                    <button type="button" class="cls-act cls-act-del" disabled="@busy" @onclick="() => DeleteAsync(row)">@Locale.T("subj.delete")</button>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<ExamBusyOverlay Busy="saving" Title="@Locale.T("cal.saving")" Message="@Locale.T("cal.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private static readonly string[] WeekOptions =
        ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

    private readonly List<HolidayDto> holidays = [];
    private readonly HashSet<string> weekDays = [];
    private DateTime viewMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime weekStart = DateTime.Today;
    private DateTime weekEnd = DateTime.Today.AddMonths(1);
    private DateTime rangeStart = DateTime.Today;
    private DateTime rangeEnd = DateTime.Today;
    private DateTime singleDate = DateTime.Today;
    private DateTime editDate = DateTime.Today;
    private string rangeName = "";
    private string singleName = "";
    private string editName = "";
    private string tab = "weekly";
    private int editingId;
    private bool busy;
    private bool saving;
    private string? error;
    private string popupText = "";
    private bool popupError;

    private List<HolidayDto> weekly => holidays.Where(x => x.IsWeekly).ToList();
    private List<HolidayDto> other => holidays.Where(x => !x.IsWeekly).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            Show(Locale.T("subj.needOnline"), true);
            return;
        }

        await LoadAsync();
    }

    private void ClosePopup() => popupText = "";
    private void Show(string value, bool err = false)
    {
        popupText = value;
        popupError = err;
        error = err ? value : null;
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
            {
                Show(Locale.T("subj.needOnline"), true);
                return;
            }

            holidays.Clear();
            holidays.AddRange(await Api.GetHolidaysAsync(Session.AccessToken));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void PrevMonth() => viewMonth = viewMonth.AddMonths(-1);
    private void NextMonth() => viewMonth = viewMonth.AddMonths(1);

    private void ToggleDay(string day, ChangeEventArgs e)
    {
        var on = e.Value is bool flag && flag || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (on) weekDays.Add(day);
        else weekDays.Remove(day);
    }

    private async Task AddWeeklyAsync()
    {
        if (weekDays.Count == 0)
        {
            Show(Locale.T("cal.needDay"), true);
            return;
        }

        await RunAsync(() => Api.AddWeeklyHolidaysAsync(Session.AccessToken!, new WeeklyHolidayRequest
        {
            StartDate = weekStart,
            EndDate = weekEnd,
            Days = weekDays.ToList()
        }));
    }

    private async Task AddRangeAsync()
    {
        if (string.IsNullOrWhiteSpace(rangeName))
        {
            Show(Locale.T("cal.needName"), true);
            return;
        }

        await RunAsync(() => Api.AddRangeHolidaysAsync(Session.AccessToken!, new RangeHolidayRequest
        {
            HolidayName = rangeName.Trim(),
            StartDate = rangeStart,
            EndDate = rangeEnd
        }));
        if (!popupError)
            rangeName = "";
    }

    private async Task AddSingleAsync()
    {
        if (string.IsNullOrWhiteSpace(singleName))
        {
            Show(Locale.T("cal.needName"), true);
            return;
        }

        await RunAsync(() => Api.AddHolidayAsync(Session.AccessToken!, new SaveHolidayRequest
        {
            HolidayName = singleName.Trim(),
            HolidayDate = singleDate
        }));
        if (!popupError)
            singleName = "";
    }

    private void StartEdit(HolidayDto row)
    {
        editingId = row.HolidayID;
        editName = row.HolidayName;
        editDate = row.HolidayDate;
        popupText = "";
        error = null;
    }

    private void CancelEdit()
    {
        editingId = 0;
        editName = "";
    }

    private async Task SaveEditAsync(HolidayDto row)
    {
        await RunAsync(() => Api.UpdateHolidayAsync(Session.AccessToken!, row.HolidayID, new SaveHolidayRequest
        {
            HolidayName = editName.Trim(),
            HolidayDate = editDate
        }));
        if (!popupError)
            CancelEdit();
    }

    private async Task DeleteAsync(HolidayDto row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("cal.deleteConfirm")))
            return;
        await RunAsync(() => Api.DeleteHolidayAsync(Session.AccessToken!, row.HolidayID));
    }

    private async Task RunAsync(Func<Task<HolidayResult>> action)
    {
        popupText = "";
        error = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return;
        }

        saving = true;
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
        try
        {
            var result = await action();
            if (!result.Succeeded)
            {
                Show(Locale.T(result.Error ?? "cal.failed"), true);
                return;
            }

            Show(Locale.T("cal.ok"));
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            saving = false;
            busy = false;
        }
    }

    private IEnumerable<(DateTime Date, bool InMonth)> MonthCells()
    {
        var first = viewMonth;
        var offset = ((int)first.DayOfWeek + 1) % 7;
        var start = first.AddDays(-offset);
        for (var i = 0; i < 42; i++)
        {
            var date = start.AddDays(i);
            yield return (date, date.Month == viewMonth.Month);
        }
    }

    private IEnumerable<string> NamesOn(DateTime date)
    {
        var names = holidays
            .Where(x => x.HolidayDate.Date == date.Date)
            .Select(x => x.HolidayName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (holidays.Any(x => x.IsWeekly && x.HolidayDate.DayOfWeek == date.DayOfWeek)
            && !names.Exists(n => n.Equals("Weekly Holiday", StringComparison.OrdinalIgnoreCase)))
            names.Add("Weekly Holiday");
        return names;
    }

    private static string CellClass((DateTime Date, bool InMonth) cell, bool holiday)
    {
        var cls = "cal-cell";
        if (!cell.InMonth) cls += " is-out";
        if (cell.Date.Date == DateTime.Today) cls += " is-today";
        if (holiday) cls += " is-holiday";
        if (cell.Date.DayOfWeek == DayOfWeek.Friday) cls += " is-friday";
        return cls;
    }

    private async Task PrintAsync() =>
        await JS.InvokeVoidAsync("sikkhaloyPrint");
}
