    private sealed class EmpSlice
    {
        public string Name { get; init; } = "";
        public int Count { get; init; }
        public string Color { get; init; } = "";
        public double Pct { get; init; }
        public string Path { get; init; } = "";
        public double LabelX { get; init; }
        public double LabelY { get; init; }
    }

    private List<EmpSlice> BuildEmpSlices()
    {
        var items = online.Employees.Where(x => x.Count > 0).ToList();
        var total = items.Sum(x => x.Count);
        if (total <= 0)
            return [];

        const double cx = 110;
        const double cy = 86;
        const double radius = 78;
        var explode = items.Count > 1 ? 7.0 : 0;
        var slices = new List<EmpSlice>(items.Count);
        double start = 0;
        for (var i = 0; i < items.Count; i++)
        {
            var pct = 100.0 * items[i].Count / total;
            if (i == items.Count - 1)
                pct = Math.Max(0, 100.0 - start);
            var mid = start + pct / 2.0;
            slices.Add(new EmpSlice
            {
                Name = EmpLabel(items[i].Name),
                Count = items[i].Count,
                Color = EmpColor(i),
                Pct = pct,
                Path = PiePath(start, pct, cx, cy, radius, explode),
                LabelX = PolarX(mid, radius * 0.58 + explode, cx),
                LabelY = PolarY(mid, radius * 0.58 + explode, cy)
            });
            start += pct;
        }
        return slices;
    }

    private static string PiePath(double startPct, double pct, double cx, double cy, double radius, double explode)
    {
        if (pct <= 0.001)
            return "";
        var mid = startPct + pct / 2.0;
        cx = PolarX(mid, explode, cx);
        cy = PolarY(mid, explode, cy);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        if (pct >= 99.999)
        {
            return string.Create(inv,
                $"M {cx - radius:0.###} {cy:0.###} A {radius} {radius} 0 1 1 {cx + radius:0.###} {cy:0.###} A {radius} {radius} 0 1 1 {cx - radius:0.###} {cy:0.###} Z");
        }

        var start = startPct / 100.0 * 360.0 - 90.0;
        var end = (startPct + pct) / 100.0 * 360.0 - 90.0;
        var large = pct > 50 ? 1 : 0;
        var rad1 = start * Math.PI / 180.0;
        var rad2 = end * Math.PI / 180.0;
        var x1 = cx + radius * Math.Cos(rad1);
        var y1 = cy + radius * Math.Sin(rad1);
        var x2 = cx + radius * Math.Cos(rad2);
        var y2 = cy + radius * Math.Sin(rad2);
        return string.Create(inv,
            $"M {cx:0.###} {cy:0.###} L {x1:0.###} {y1:0.###} A {radius} {radius} 0 {large} 1 {x2:0.###} {y2:0.###} Z");
    }

    private async Task SendBirthdaySmsAsync()
    {
        if (BirthdaySmsDisabled)
            return;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            message = Locale.T("dash.bdayNeedOnline");
            messageError = true;
            return;
        }

        birthdaySmsBusy = true;
        message = null;
        await PaintAsync();
        try
        {
            var result = await Api.SendBirthdaySmsAsync(Session.AccessToken);
            if (!result.Succeeded)
            {
                if (string.Equals(result.Error, "dash.bdayAlready", StringComparison.OrdinalIgnoreCase))
                    online.BirthdaySmsSent = true;
                message = FormatSmsError(result.Error, result.Balance, result.Message);
                messageError = true;
                return;
            }

            online.BirthdaySmsSent = true;
            online.SmsRemaining = result.Balance;
            var msg = result.Failed > 0
                ? Locale.T("sms.sentFail", result.Sent, result.Failed)
                : Locale.T("sms.sentOne");
            if (result.LocalMode)
                msg += " " + Locale.T("sms.localSent");
            message = msg;
            messageError = false;
        }
        catch (Exception ex)
        {
            message = ex.Message;
            messageError = true;
        }
        finally
        {
            birthdaySmsBusy = false;
        }
    }

    private string FormatSmsError(string? error, int balance, string? fallback)
    {
        if (string.Equals(error, "sms.low", StringComparison.OrdinalIgnoreCase))
            return Locale.T("sms.low", balance);
        if (!string.IsNullOrWhiteSpace(error) && error.StartsWith("dash.", StringComparison.OrdinalIgnoreCase))
            return Locale.T(error);
        if (!string.IsNullOrWhiteSpace(error) && error.StartsWith("sms.", StringComparison.OrdinalIgnoreCase))
            return Locale.T(error);
        return string.IsNullOrWhiteSpace(fallback) ? Locale.T("sms.fail") : fallback;
    }

    private string? PhotoOf(StudentDto student)
    {
        if (!string.IsNullOrWhiteSpace(student.PhotoDataUrl))
            return student.PhotoDataUrl;
        if (Session.Current is null || student.ServerId is not int id || id <= 0)
            return null;
        return Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, id);
    }

    private static IReadOnlyList<StudentDto> BdayLoop(IReadOnlyList<StudentDto> students)
    {
        if (students.Count == 0)
            return [];
        var group = new List<StudentDto>();
        while (group.Count < 6)
            group.AddRange(students);
        group.AddRange(group);
        return group;
    }

    private static string BdayTrackStyle(int count)
    {
        var n = Math.Max(1, count);
        var group = 0;
        while (group < 6)
            group += n;
        return $"--dash-bday-secs:{Math.Max(18, group * 4)}s";
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "S";
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private static int Age(DateTime? dob)
    {
        if (dob is null) return 0;
        var today = DateTime.Today;
        var age = today.Year - dob.Value.Year;
        if (dob.Value.Date > today.AddYears(-age)) age--;
        return Math.Max(age, 0);
    }

    private static int AgeWillBe(DateTime? dob) => Age(dob) + 1;

