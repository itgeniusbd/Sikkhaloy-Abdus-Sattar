    private void PrevMonth() => calMonth = calMonth.AddMonths(-1);
    private void NextMonth() => calMonth = calMonth.AddMonths(1);

    private IEnumerable<(DateTime Date, bool InMonth)> MonthCells()
    {
        var first = calMonth;
        var offset = ((int)first.DayOfWeek + 1) % 7;
        var start = first.AddDays(-offset);
        for (var i = 0; i < 42; i++)
        {
            var date = start.AddDays(i);
            yield return (date, date.Month == calMonth.Month);
        }
    }

    private List<string> HolidayNames(DateTime date)
    {
        var names = holidays
            .Where(x => x.HolidayDate.Date == date.Date)
            .Select(x => x.HolidayName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (IsWeeklyOff(date.DayOfWeek)
            && !names.Exists(n => n.Equals("Weekly Holiday", StringComparison.OrdinalIgnoreCase)))
            names.Add("Weekly Holiday");
        return names;
    }

    private bool IsWeeklyOff(DayOfWeek day) =>
        holidays.Any(x => x.IsWeekly && x.HolidayDate.DayOfWeek == day);

    private static bool IsOffDay(string day) =>
        day is "Friday" or "Saturday";

    private static bool IsOffDay(DayOfWeek day) =>
        day is DayOfWeek.Friday or DayOfWeek.Saturday;

    private static string CalCellClass((DateTime Date, bool InMonth) cell, bool holiday)
    {
        var cls = "dash-cal-cell";
        if (!cell.InMonth) cls += " is-out";
        if (IsOffDay(cell.Date.DayOfWeek)) cls += " is-off";
        if (cell.Date.DayOfWeek == DayOfWeek.Friday) cls += " is-friday";
        if (cell.Date.Date == DateTime.Today) cls += " is-today";
        if (holiday) cls += " is-holiday";
        return cls;
    }

    private sealed class SessPt
    {
        public string Name { get; init; } = "";
        public int Count { get; init; }
        public double X { get; init; }
        public double Y { get; init; }
    }

    private List<SessPt> BuildSessionPoints()
    {
        var items = online.Sessions;
        var n = items.Count;
        var max = Math.Max(1, items.Select(x => x.Count).DefaultIfEmpty(0).Max());
        var plotW = SessW - SessPadL - SessPadR;
        var plotH = SessH - SessPadT - SessPadB;
        var pts = new List<SessPt>(n);
        for (var i = 0; i < n; i++)
        {
            var x = n <= 1 ? SessPadL + plotW / 2 : SessPadL + i * plotW / (n - 1);
            var y = SessPadT + (1 - items[i].Count / (double)max) * plotH;
            pts.Add(new SessPt { Name = items[i].Name, Count = items[i].Count, X = x, Y = y });
        }
        return pts;
    }

    private static string SessionArea(List<SessPt> pts)
    {
        if (pts.Count == 0)
            return "";
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var bottom = SessH - SessPadB;
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Create(inv, $"M {pts[0].X:0.##} {bottom:0.##}"));
        foreach (var p in pts)
            sb.Append(string.Create(inv, $" L {p.X:0.##} {p.Y:0.##}"));
        sb.Append(string.Create(inv, $" L {pts[^1].X:0.##} {bottom:0.##} Z"));
        return sb.ToString();
    }

    private static string SessionLine(List<SessPt> pts)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return string.Join(" ", pts.Select(p => string.Create(inv, $"{p.X:0.##},{p.Y:0.##}")));
    }

    private static double PolarX(double midPct, double radius = 73, double cx = 100)
    {
        var rad = (midPct / 100.0 * 360.0 - 90.0) * Math.PI / 180.0;
        return cx + radius * Math.Cos(rad);
    }

    private static double PolarY(double midPct, double radius = 73, double cy = 100)
    {
        var rad = (midPct / 100.0 * 360.0 - 90.0) * Math.PI / 180.0;
        return cy + radius * Math.Sin(rad);
    }

    private static string DonutPath(double startPct, double pct, double cx = 100, double cy = 100, double rOuter = 90, double rInner = 56)
    {
        if (pct <= 0.001)
            return "";
        if (pct >= 99.999)
        {
            return string.Create(System.Globalization.CultureInfo.InvariantCulture,
                $"M {cx + rOuter} {cy} A {rOuter} {rOuter} 0 1 1 {cx - rOuter} {cy} A {rOuter} {rOuter} 0 1 1 {cx + rOuter} {cy} M {cx + rInner} {cy} A {rInner} {rInner} 0 1 0 {cx - rInner} {cy} A {rInner} {rInner} 0 1 0 {cx + rInner} {cy}");
        }

        var start = startPct / 100.0 * 360.0 - 90.0;
        var end = (startPct + pct) / 100.0 * 360.0 - 90.0;
        var large = pct > 50 ? 1 : 0;
        var (x1, y1) = Point(start, rOuter);
        var (x2, y2) = Point(end, rOuter);
        var (x3, y3) = Point(end, rInner);
        var (x4, y4) = Point(start, rInner);
        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"M {x1:0.###} {y1:0.###} A {rOuter} {rOuter} 0 {large} 1 {x2:0.###} {y2:0.###} L {x3:0.###} {y3:0.###} A {rInner} {rInner} 0 {large} 0 {x4:0.###} {y4:0.###} Z");

        (double X, double Y) Point(double deg, double radius)
        {
            var rad = deg * Math.PI / 180.0;
            return (cx + radius * Math.Cos(rad), cy + radius * Math.Sin(rad));
        }
    }

