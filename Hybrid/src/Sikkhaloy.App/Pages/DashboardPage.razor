@page "/dashboard"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject SyncEngine Sync
@inject ISyncApiClient Api
@inject NavigationManager Nav

<style>
    .dash-page .dash-class-card .toolbar { margin-bottom: 0.35rem; }
    .dash-page .dash-class-card h2 {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.01em;
    }
    .dash-page .dash-class-card .toolbar a {
        font-size: 0.82rem;
        font-weight: 700;
        color: #0f766e;
        white-space: nowrap;
    }
    .dash-page table.dash-class-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }
    .dash-page table.dash-class-table th,
    .dash-page table.dash-class-table td {
        padding: 0.42rem 0.45rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
        text-align: left;
        color: #0f172a;
    }
    .dash-page table.dash-class-table thead th {
        color: #64748b;
        font-weight: 700;
        font-size: 0.8rem;
        border-bottom: 1px solid #e2e8f0;
        background: transparent;
    }
    .dash-page table.dash-class-table tbody td:nth-child(n+2),
    .dash-page table.dash-class-table thead th:nth-child(n+2),
    .dash-page table.dash-class-table tfoot th:nth-child(n+2) {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .dash-page table.dash-class-table tbody tr:last-child td { border-bottom: none; }
    .dash-page table.dash-class-table tfoot th {
        color: #0f172a;
        font-weight: 800;
        font-size: 0.9rem;
        border-top: 1px solid #e2e8f0;
        border-bottom: none;
        padding-top: 0.5rem;
    }
    .dash-page .dash-sms-card h2 { margin-bottom: 0.65rem; }
    .dash-page .dash-sms-card h2 a { color: inherit; text-decoration: none; }
    .dash-page .dash-sms-card h2 a:hover { color: #0f766e; }
    .dash-page .dash-sms {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
        margin-bottom: 0.9rem;
    }
    .dash-page .dash-sms div {
        background: #f8fafc;
        border-radius: 12px;
        padding: 0.55rem 0.65rem;
        text-align: center;
    }
    .dash-page .dash-sms strong { display: block; font-size: 1.25rem; }
    .dash-page .dash-sms span { color: #64748b; font-size: 0.72rem; font-weight: 700; }
    .dash-sms-stack { margin-bottom: 0.85rem; }
    .dash-sms-stack-labels {
        display: flex;
        align-items: flex-end;
        min-height: 2.35rem;
        margin-bottom: 0.28rem;
    }
    .dash-sms-stack-labels span {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        min-width: 0;
        overflow: hidden;
        line-height: 1.15;
        text-align: center;
        color: #334155;
        font-weight: 800;
        font-size: 0.68rem;
        font-variant-numeric: tabular-nums;
    }
    .dash-sms-stack-labels em {
        font-style: normal;
        font-weight: 600;
        font-size: 0.6rem;
        color: #64748b;
    }
    .dash-sms-stack-bar {
        display: flex;
        height: 18px;
        border-radius: 5px;
        overflow: hidden;
        background: #e2e8f0;
    }
    .dash-sms-stack-bar i {
        display: block;
        height: 100%;
        min-width: 0;
        cursor: pointer;
    }
    .dash-sms-ring {
        position: relative;
        width: min(100%, 230px);
        margin: 0.15rem auto 0;
        aspect-ratio: 1;
        overflow: visible;
        flex-shrink: 0;
    }
    .dash-page .dash-sms-card { overflow: visible; }
    .dash-sms-ring svg { width: 100%; height: 100%; display: block; }
    .dash-sms-ring path { cursor: pointer; transition: opacity 0.12s ease; }
    .dash-sms-ring.is-hovering path { opacity: 0.38; }
    .dash-sms-ring.is-hovering path.is-hot { opacity: 1; }
    .dash-sms-ring circle { pointer-events: none; }
    .dash-sms-tip {
        position: absolute;
        transform: translate(-50%, -125%);
        background: var(--tip, #e11d48);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.18rem 0.42rem;
        border-radius: 4px;
        pointer-events: none;
        white-space: nowrap;
        z-index: 2;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.18);
    }
    .dash-sms-tip::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -5px;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: var(--tip, #e11d48);
        border-bottom-width: 0;
    }
    .dash-sms-tip small {
        display: block;
        font-weight: 600;
        opacity: 0.92;
        font-size: 0.64rem;
    }
    .dash-page .dash-board {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.85rem;
        margin-bottom: 0.85rem;
        align-items: stretch;
    }
    .dash-page .dash-col {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-width: 0;
        min-height: 0;
    }
    .dash-page .dash-panel h2,
    .dash-page .dash-session-card h2,
    .dash-page .dash-quick h2 {
        text-align: center;
    }
    .dash-page .dash-class-card .toolbar,
    .dash-page .dash-cal .toolbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 0.35rem;
    }
    .dash-page .dash-class-card .toolbar h2,
    .dash-page .dash-cal .toolbar h2 {
        grid-column: 2;
        text-align: center;
    }
    .dash-page .dash-class-card .toolbar a,
    .dash-page .dash-cal .toolbar a {
        grid-column: 3;
        justify-self: end;
    }
    .dash-page .dash-quad {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto 1fr;
        gap: 0.85rem;
        margin: 0;
        flex: 1 1 auto;
        min-height: 0;
        align-items: stretch;
    }
    .dash-page .dash-quad > .dash-panel {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .dash-page .dash-class-card { min-width: 0; }
    .dash-page table.dash-class-table th,
    .dash-page table.dash-class-table td {
        padding: 0.28rem 0.3rem;
        font-size: 0.8rem;
    }
    .dash-page table.dash-class-table thead th { font-size: 0.72rem; }
    .dash-page table.dash-class-table tfoot th { font-size: 0.8rem; padding-top: 0.38rem; }
    .dash-page table.dash-class-table a.dash-class-link {
        color: #0f766e;
        font-weight: 700;
        text-decoration: none;
    }
    .dash-page table.dash-class-table a.dash-class-link:hover { text-decoration: underline; }
    .dash-page .dash-quad .dash-panel { padding: 0.55rem 0.7rem 0.55rem; }
    .dash-page .dash-quad .dash-gender {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.1rem 0 0;
        min-height: 0;
    }
    .dash-page .dash-quad .dash-gender .dash-donut {
        width: 118px;
        height: 118px;
        flex: 0 0 118px;
        margin: 0 auto;
    }
    .dash-page .dash-quad .dash-gender .dash-donut-hole {
        width: 76px;
        height: 76px;
    }
    .dash-page .dash-quad .dash-gender .dash-donut-hole strong { font-size: 1.15rem; }
    .dash-page .dash-quad .dash-gender .dash-donut-hole small { font-size: 0.68rem; }
    .dash-page .dash-quad .dash-gender .dash-legend {
        width: 100%;
        max-width: 210px;
        gap: 0.4rem;
    }
    .dash-page .dash-quad .dash-gender .dash-legend li {
        justify-content: flex-start;
        font-size: 0.88rem;
    }
    .dash-page .dash-quad .dash-sms {
        margin-bottom: 0.28rem;
        gap: 0.28rem;
    }
    .dash-page .dash-quad .dash-sms div { padding: 0.22rem 0.32rem; }
    .dash-page .dash-quad .dash-sms strong { font-size: 0.92rem; }
    .dash-page .dash-quad .dash-sms-ring { width: min(100%, 92px); flex-shrink: 0; }
    .dash-page .dash-quad .dash-sms-stack { margin-bottom: 0.4rem; flex-shrink: 0; }
    .dash-page .dash-quad .dash-sms-stack-labels { min-height: 1.35rem; }
    .dash-page .dash-quad .dash-sms-stack-bar { height: 12px; }
    .dash-page .dash-quad .dash-emp {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-height: 0;
        padding: 0.15rem 0 0;
    }
    .dash-page .dash-quad .dash-pie {
        width: min(100%, 168px);
        height: auto;
        display: block;
        overflow: visible;
        filter: drop-shadow(0 8px 10px rgba(15, 23, 42, 0.14));
    }
    .dash-page .dash-quad .dash-emp .dash-legend {
        width: 100%;
        max-width: 210px;
        gap: 0.38rem;
    }
    .dash-page .dash-quad .dash-emp .dash-legend li { font-size: 0.86rem; }
    .dash-page .dash-quad .dash-bars {
        flex: 1 1 auto;
        align-content: center;
        min-height: 0;
        gap: 0.45rem;
    }
    .dash-page .dash-quad .dash-bar { height: 8px; }
    .dash-page .dash-quad .dash-bar-row { font-size: 0.84rem; }
    .dash-cal .toolbar { margin-bottom: 0.45rem; }
    .dash-cal .toolbar h2 { margin: 0; font-size: 1.02rem; font-weight: 800; }
    .dash-cal .toolbar a { font-size: 0.8rem; font-weight: 700; color: #0f766e; }
    .dash-cal-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.4rem;
        margin-bottom: 0.45rem;
    }
    .dash-cal-nav strong { font-size: 0.92rem; }
    .dash-cal-nav button {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 8px;
        background: #ecfdf5;
        color: #0f766e;
        font-size: 1.15rem;
        font-weight: 800;
        cursor: pointer;
        line-height: 1;
    }
    .dash-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 3px;
    }
    .dash-cal-dow {
        text-align: center;
        font-size: 0.68rem;
        font-weight: 800;
        color: #0f766e;
        padding: 0.2rem 0;
    }
    .dash-cal-dow.is-off { color: #dc2626; }
    .dash-cal-dow.is-friday { color: #dc2626; }
    .dash-cal-cell {
        min-height: 34px;
        border-radius: 8px;
        background: #f8fafc;
        text-align: center;
        padding: 0.22rem 0.1rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: #0f172a;
    }
    .dash-cal-cell.is-out { color: #cbd5e1; background: transparent; }
    .dash-cal-cell.is-off { color: #dc2626; }
    .dash-cal-cell.is-friday { background: #fecaca; color: #b91c1c; }
    .dash-cal-cell.is-out.is-off { color: #fca5a5; }
    .dash-cal-cell.is-out.is-friday { background: #fee2e2; }
    .dash-cal-cell.is-holiday { background: #ffe4e6; color: #9f1239; }
    .dash-cal-cell.is-today span {
        display: inline-grid;
        place-items: center;
        min-width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        background: #0f766e;
        color: #fff;
    }
    .dash-cal-cell.is-today.is-off span { background: #0f766e; color: #fff; }
    .dash-cal-cell small {
        display: block;
        font-size: 0.52rem;
        font-weight: 700;
        color: #e11d48;
        line-height: 1.15;
        padding: 0 1px;
        word-break: break-word;
    }
    .dash-session-card {
        margin: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 300px;
    }
    .dash-session-card h2 { margin: 0 0 0.45rem; font-size: 1.02rem; font-weight: 800; }
    .dash-line {
        position: relative;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 260px;
    }
    .dash-line svg {
        width: 100%;
        flex: 1 1 auto;
        height: 100%;
        min-height: 260px;
        aspect-ratio: 840 / 340;
        display: block;
    }
    .dash-line-labels {
        display: flex;
        justify-content: space-between;
        gap: 0;
        margin-top: -0.15rem;
        padding: 0 0.35rem;
    }
    .dash-line-labels span {
        flex: 1 1 0;
        min-width: 0;
        text-align: center;
        line-height: 1.15;
    }
    .dash-line-labels b {
        display: block;
        font-size: 0.72rem;
        font-weight: 800;
        color: #0f172a;
    }
    .dash-line-labels em {
        display: block;
        font-style: normal;
        font-size: 0.62rem;
        color: #64748b;
        font-weight: 600;
    }
    @@media (max-width: 1100px) {
        .dash-page .dash-board,
        .dash-page .dash-quad { grid-template-columns: 1fr; }
    }
    .dash-due-foot {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px 18px 18px;
    }
    .dash-due-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }
    .dash-due-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin: 0;
        border: 0;
        border-radius: 10px;
        font: inherit;
        font-weight: 800;
        line-height: 1.25;
        text-decoration: none;
        cursor: pointer;
        padding: 0.72rem 0.7rem;
        box-sizing: border-box;
    }
    .dash-due-btn.is-due {
        background: #0d9488;
        color: #fff;
        box-shadow: 0 6px 14px rgba(13, 148, 136, 0.28);
    }
    .dash-due-btn.is-later {
        background: #f59e0b;
        color: #1c1917;
        box-shadow: 0 6px 14px rgba(245, 158, 11, 0.28);
    }
    .dash-due-btn.is-pay {
        width: 100%;
        min-height: 52px;
        padding: 0.95rem 1rem;
        font-size: 1.08rem;
        background: #16a34a;
        color: #fff;
        box-shadow: 0 10px 20px rgba(22, 163, 74, 0.3);
    }
    .dash-due-btn:hover { filter: brightness(1.06); text-decoration: none; color: inherit; }
    .dash-due-btn.is-due:hover, .dash-due-btn.is-pay:hover { color: #fff; }
    .dash-page { overflow-x: hidden; }
    .dash-page .dash-lists > .dash-bday {
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }
    .dash-page .dash-bday-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.55rem;
        margin-bottom: 0.5rem;
        min-width: 0;
    }
    .dash-page .dash-bday-head h2 {
        margin: 0;
        text-align: left;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .dash-page .dash-bday-sms {
        flex-shrink: 0;
        height: 32px;
        padding: 0 0.75rem;
        border: 0;
        border-radius: 8px;
        background: #0f766e;
        color: #fff;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(15, 118, 110, 0.22);
    }
    .dash-page .dash-bday-sms:hover { filter: brightness(1.06); }
    .dash-page .dash-bday-sms:disabled {
        background: #94a3b8;
        box-shadow: none;
        cursor: not-allowed;
        filter: none;
    }
    .dash-page .dash-bday-viewport,
    .dash-page .dash-bday-empty {
        height: 232px;
    }
    .dash-page .dash-bday-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        text-align: center;
    }
    .dash-page .dash-bday-viewport {
        position: relative;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 14px, #000 calc(100% - 14px), transparent);
    }
    .dash-page .dash-bday-track {
        position: absolute;
        left: 0;
        top: 0;
        display: flex;
        gap: 0.7rem;
        height: 100%;
        width: max-content;
        animation: dash-bday-slide var(--dash-bday-secs, 24s) linear infinite;
    }
    .dash-page .dash-bday-track:hover { animation-play-state: paused; }
    .dash-page .dash-bday-card {
        flex: 0 0 168px;
        width: 168px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0.7rem 0.55rem 0.6rem;
        border-radius: 14px;
        text-decoration: none;
        color: inherit;
        box-sizing: border-box;
        background: linear-gradient(180deg, #f0fdfa 0%, #fff 55%);
        border: 1px solid #ccfbf1;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
    }
    .dash-page .dash-bday-card.is-soon {
        background: linear-gradient(180deg, #fff7ed 0%, #fff 55%);
        border-color: #fed7aa;
    }
    .dash-page .dash-bday-card:hover { text-decoration: none; transform: translateY(-2px); }
    .dash-page .dash-bday-card img,
    .dash-page .dash-bday-ph {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        object-position: center top;
        flex-shrink: 0;
        margin-bottom: 0.45rem;
        background: #e2e8f0;
        border: 3px solid #fff;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
    }
    .dash-page .dash-bday-ph {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #0f766e;
        background: #ccfbf1;
    }
    .dash-page .dash-bday-card.is-soon .dash-bday-ph {
        color: #9a3412;
        background: #ffedd5;
    }
    .dash-page .dash-bday-card strong {
        display: block;
        font-size: 0.86rem;
        line-height: 1.25;
        max-width: 100%;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    .dash-page .dash-bday-card span,
    .dash-page .dash-bday-card em {
        display: block;
        margin-top: 0.18rem;
        font-size: 0.72rem;
        color: #64748b;
        font-style: normal;
    }
    .dash-page .dash-bday-card em { color: #0f766e; font-weight: 800; }
    .dash-page .dash-bday-card.is-soon em { color: #c2410c; }
    @@keyframes dash-bday-slide {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .dash-page .dash-bday-track { animation: none; }
    }
</style>

<div class="dash-page">
    <div class="dash-hero">
        <div>
            <h1>@Locale.T("dash.hello")</h1>
            <p>@Locale.T("dash.today", Session.Current?.SchoolName ?? "", DateTime.Now.ToString("dd MMMM yyyy"))</p>
        </div>
        <div class="dash-hero-actions">
            <span class="dash-pending-pill">@Locale.T("dash.pending"): @stats.PendingSync</span>
            <button class="btn-primary" @onclick="SyncNow" disabled="@busy">@(busy ? Locale.T("students.syncing") : Locale.T("students.sync"))</button>
        </div>
    </div>

    @if (showDueModal && access.HasDue && !access.IsBlocked)
    {
        <div class="inv-modal-back no-print" @onclick="() => showDueModal = false">
            <div class="inv-modal is-warn" @onclick:stopPropagation="true">
                <div class="inv-modal-head">
                    <h4>@Locale.T("dash.dueNotice")</h4>
                    <button type="button" class="inv-modal-x" @onclick="() => showDueModal = false">&times;</button>
                </div>
                <div class="inv-modal-body">
                    @if (access.DaysUntilExpiry >= 0)
                    {
                        <p class="inv-days">@BillDaysText()</p>
                        <p>@Locale.T("dash.billHint")</p>
                    }
                    <p>@Locale.T("dash.dueRecords", access.DueCount.ToString())</p>
                    <div class="inv-due-box">@Locale.T("dash.dueAmount", access.Due.ToString("N2"))</div>
                    <p>@Locale.T("dash.dueDetail")</p>
                </div>
                <div class="inv-modal-foot dash-due-foot">
                    <div class="dash-due-row">
                        <a class="dash-due-btn is-due" href="invoice/due">@Locale.T("dash.billPay")</a>
                        <button type="button" class="dash-due-btn is-later" @onclick="() => showDueModal = false">@Locale.T("dash.dueLater")</button>
                    </div>
                    <a class="dash-due-btn is-pay" href="invoice/due">@Locale.T("inv.payOnline")</a>
                </div>
            </div>
        </div>
    }

    @if (Locale.IsNetNotice(message))
    {
        <ResultPopup Text="@message" Error="true" OnClose="() => message = null" />
    }
    else if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@(messageError ? "error" : "ok")">@message</div>
    }

    @if (ShowSyncHint)
    {
        <div class="notice">@Locale.T("dash.needFirstSync")</div>
    }

    <section class="dash-quick">
        <h2>@Locale.T("dash.quick")</h2>
        <div class="dash-quick-grid">
            <a class="dash-quick-card is-teal" href="students/new">
                <span class="dash-quick-ico">@NewIcon</span>
                <h3>@Locale.T("dash.admission")</h3>
                <p>@Locale.T("dash.admission.desc")</p>
