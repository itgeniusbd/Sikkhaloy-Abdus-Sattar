}

@code {
    private DashboardStats stats = new();
    private DashboardOverviewDto online = new();
    private SubscriptionStatusDto access = new();
    private readonly List<HolidayDto> holidays = [];
    private DateTime calMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool busy;
    private bool birthdaySmsBusy;
    private bool autoTried;
    private bool messageError;
    private string? message;
    private bool BirthdaySmsDisabled =>
        birthdaySmsBusy
        || online.BirthdaySmsSent
        || stats.BirthdaysToday.Count == 0
        || string.IsNullOrWhiteSpace(Session.AccessToken);
    private string BirthdaySmsLabel =>
        online.BirthdaySmsSent
            ? Locale.T("dash.bdaySent")
            : birthdaySmsBusy
                ? Locale.T("sms.sending")
                : Locale.T("dash.bdaySms");

    private static readonly string[] CalWeekdays =
        ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

    private const double SessW = 840;
    private const double SessH = 340;
    private const double SessPadL = 22;
    private const double SessPadR = 22;
    private const double SessPadT = 16;
    private const double SessPadB = 20;

    private double MalePct => stats.TotalStudents == 0 ? 0 : 100.0 * stats.MaleCount / stats.TotalStudents;
    private double FemalePct => stats.TotalStudents == 0 ? 0 : 100.0 * stats.FemaleCount / stats.TotalStudents;
    private int? smsHover;
    private int EmpTotal => online.Employees.Sum(x => x.Count);
    private int BloodMax => Math.Max(1, stats.BloodGroups.Select(x => x.Count).DefaultIfEmpty(0).Max());
    private static double Pct(int count, int max) => max <= 0 ? 0 : 100.0 * count / max;
    private bool showDueModal;
    private bool ShowSyncHint =>
        stats.TotalStudents == 0
        && (!string.IsNullOrWhiteSpace(Sync.LastError) || (!Sync.IsOnline && autoTried));
    private IEnumerable<double> SessionGridYs
    {
        get
        {
            var plotH = SessH - SessPadT - SessPadB;
            for (var i = 0; i <= 3; i++)
                yield return SessPadT + plotH * i / 3.0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        if (Session.IsStudent)
        {
            Nav.NavigateTo("/student", replace: true);
            return;
        }

        if (Session.IsAuthority)
        {
            Nav.NavigateTo("/authority", replace: true);
            return;
        }

        Session.Changed += OnSessionChanged;
        Sync.StateChanged += OnSyncChanged;
        autoTried = true;
        await LoadAsync();
    }

    private void OnSessionChanged() => _ = InvokeAsync(LoadAsync);
    private void OnSyncChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshLocalAsync();
        try
        {
            var cached = await Api.PeekDashboardOverviewAsync();
            if (cached is not null)
            {
                online = cached;
                StateHasChanged();
            }
        }
        catch
        {
        }
    });

    public override void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Sync.StateChanged -= OnSyncChanged;
        base.Dispose();
    }

    private async Task LoadAsync()
    {
        var current = Session.Current;
        if (current is null)
            return;

        try
        {
            var localTask = Sync.GetDashboardAsync(current.SchoolID, current.EducationYearID);
            var cachedTask = Api.PeekDashboardOverviewAsync();
            stats = await localTask;
            var cached = await cachedTask;
            if (cached is not null
                && (cached.Sessions.Count > 0 || cached.SmsByYear.Count > 0 || cached.Employees.Count > 0))
                online = cached;
            if (!busy && !string.IsNullOrWhiteSpace(Sync.LastError) && stats.TotalStudents == 0)
            {
                message = TranslateSyncError(Sync.LastError);
                messageError = true;
            }
        }
        catch (Exception ex)
        {
            message = TranslateSyncError(ex.Message);
            messageError = true;
        }

        StateHasChanged();
        _ = LoadOnlineAsync();
    }

    private async Task RefreshLocalAsync()
    {
        var current = Session.Current;
        if (current is null)
            return;
        try
        {
            stats = await Sync.GetDashboardAsync(current.SchoolID, current.EducationYearID);
        }
        catch
        {
        }
        StateHasChanged();
    }

    private async Task LoadOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
            return;
        try
        {
            if (!await Api.PingAsync())
                return;
            var fresh = await Api.GetDashboardOverviewAsync(Session.AccessToken);
            if (fresh.SmsByYear.Count == 0 && online.SmsByYear.Count > 0)
            {
                fresh.SmsByYear = [.. online.SmsByYear];
                fresh.SmsSent = fresh.SmsByYear.Sum(x => x.Count);
            }
            online = fresh;
            access = await Api.GetSubscriptionStatusAsync(Session.AccessToken);
            Session.SetAccess(access);
            try
            {
                holidays.Clear();
                holidays.AddRange(await Api.GetHolidaysAsync(Session.AccessToken));
            }
            catch
            {
            }
            if (access.IsBlocked)
            {
                Nav.NavigateTo("/invoice/due", replace: true);
                return;
            }
            showDueModal = access.HasDue;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task SyncNow()
    {
        if (Session.Current is null)
            return;

        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            message = Locale.T("dash.needLogin");
            messageError = true;
            return;
        }

        busy = true;
        message = null;
        messageError = false;
        await PaintAsync();
        try
        {
            await Sync.RunOnceAsync(Session.Current, Session.AccessToken, force: true);
            await LoadAsync();
            if (!string.IsNullOrWhiteSpace(Sync.LastError))
            {
                message = TranslateSyncError(Sync.LastError);
                messageError = true;
            }
            else
            {
                message = Sync.IsOnline ? Locale.T("students.synced") : Locale.T("students.offlineQueued");
                messageError = !Sync.IsOnline;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PaintAsync()
    {
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private string EmptyStudentsText()
    {
        if (stats.PendingSync > 0)
            return Locale.T("dash.emptyQueued");
        if (ShowSyncHint)
            return Locale.T("dash.empty");
        return Locale.T("dash.emptyNew");
    }

    private static readonly string[] SmsColors =
    [
        "#26a69a", "#42a5f5", "#ffca28", "#66bb6a", "#ef5350", "#ffa726",
        "#7e57c2", "#26c6da", "#ec407a", "#8d6e63", "#9ccc65", "#5c6bc0",
