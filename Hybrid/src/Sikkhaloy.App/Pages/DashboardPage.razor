    private sealed class SmsSlice
    {
        public string Name { get; init; } = "";
        public int Count { get; init; }
        public string Color { get; init; } = "";
        public double Pct { get; init; }
        public string Path { get; init; } = "";
        public double MarkerX { get; init; }
        public double MarkerY { get; init; }
        public bool ShowBarLabel { get; init; }
    }

    private List<SmsSlice> BuildSmsSlices()
    {
        var items = online.SmsByYear.Where(x => x.Count > 0).ToList();
        var total = items.Sum(x => x.Count);
        if (total <= 0)
            return [];

        var slices = new List<SmsSlice>(items.Count);
        double start = 0;
        for (var i = 0; i < items.Count; i++)
        {
            var pct = 100.0 * items[i].Count / total;
            if (i == items.Count - 1)
                pct = Math.Max(0, 100.0 - start);
            var mid = start + pct / 2.0;
            slices.Add(new SmsSlice
            {
                Name = items[i].Name,
                Count = items[i].Count,
                Color = SmsColors[i % SmsColors.Length],
                Pct = pct,
                Path = DonutPath(start, pct),
                MarkerX = PolarX(mid),
                MarkerY = PolarY(mid),
                ShowBarLabel = pct >= 6.5 || items.Count <= 4
            });
            start += pct;
        }
        return slices;
    }

