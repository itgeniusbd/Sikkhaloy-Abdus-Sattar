@page "/student-info/id-cards"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject SyncEngine Sync
@inject IJSRuntime JS

<div class="card structure-page emp-page emp-id-page">
    <h1>@Locale.T("si.idCards")</h1>
    <p class="muted no-print">@Locale.T("si.crumb")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error no-print">@error</div>
    }

    <div class="filter-row no-print">
        <select @bind="classInput" @bind:after="OnClassChanged" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        @if (groups.Count > 0)
        {
            <select @bind="groupInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allGroup")</option>
                @foreach (var item in groups)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (sections.Count > 0)
        {
            <select @bind="sectionInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allSection")</option>
                @foreach (var item in sections)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (shifts.Count > 0)
        {
            <select @bind="shiftInput" @bind:after="LoadAsync" disabled="@busy">
                <option value="0">@Locale.T("si.allShift")</option>
                @foreach (var item in shifts)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        <input class="id-find" type="text" placeholder="@Locale.T("si.idsHint")" @bind="ids" disabled="@busy" />
        <button type="button" class="btn-serial" disabled="@busy" @onclick="FindAsync">@Locale.T("si.find")</button>
        <label class="sid-file-btn">
            @Locale.T("si.signBrowse")
            <InputFile OnChange="OnSignFile" accept=".jpg,.jpeg,.png,.gif,.bmp" />
        </label>
        <button type="button" class="btn-serial" disabled="@(busy || cards.Count == 0)" @onclick="PrintAsync">@Locale.T("si.print")</button>
        <input class="id-find" type="text" placeholder="@Locale.T("si.changeTitle")" @bind="idTitle" @bind:event="oninput" @bind:after="SavePrefsAsync" />
        <div class="sid-color-wrap">
            <button type="button" class="btn-serial" @onclick="() => colorOpen = !colorOpen">@Locale.T("si.chooseColor")</button>
            @if (colorOpen)
            {
                <div class="sid-color-menu">
                    <p>@Locale.T("si.colorBg")</p>
                    <label>@Locale.T("si.colorHead") <input type="color" value="@headBg" @oninput="e => SetColor(c => headBg = c, e)" /></label>
                    <label>@Locale.T("si.colorName") <input type="color" value="@barBg" @oninput="e => SetColor(c => barBg = c, e)" /></label>
                    <label>@Locale.T("si.colorAddress") <input type="color" value="@footBg" @oninput="e => SetColor(c => footBg = c, e)" /></label>
                    <p>@Locale.T("si.colorFont")</p>
                    <label>@Locale.T("si.colorHead") <input type="color" value="@headFg" @oninput="e => SetColor(c => headFg = c, e)" /></label>
                    <label>@Locale.T("si.colorName") <input type="color" value="@barFg" @oninput="e => SetColor(c => barFg = c, e)" /></label>
                    <label>@Locale.T("si.colorAddress") <input type="color" value="@footFg" @oninput="e => SetColor(c => footFg = c, e)" /></label>
                </div>
            }
        </div>
    </div>

    <div class="alert-info no-print">@Locale.T("si.printHint")</div>

    @if (cards.Count == 0 && !busy)
    {
        <p class="muted">@Locale.T("si.empty")</p>
    }
    else
    {
        <div class="sid-grid" style="@ColorStyle">
            @foreach (var card in cards)
            {
                <article class="sid-card">
                    <header class="sid-head">
                        @if (!string.IsNullOrWhiteSpace(card.LogoDataUrl))
                        {
                            <img class="sid-logo" src="@card.LogoDataUrl" alt="" />
                        }
                        else
                        {
                            <span class="sid-logo empty">@Locale.T("si.idTitle")</span>
                        }
                        <div>
                            <strong>@card.SchoolName</strong>
                            <small class="sid-tag">@HeaderLine(card)</small>
                        </div>
                    </header>
                    <div class="sid-photo-wrap">
                        <span class="sid-swoosh" aria-hidden="true"></span>
                        @if (!string.IsNullOrWhiteSpace(card.PhotoDataUrl))
                        {
                            <img class="sid-photo" src="@card.PhotoDataUrl" alt="" />
                        }
                        else
                        {
                            <span class="sid-photo empty">@Locale.T("si.noPhoto")</span>
                        }
                    </div>
                    <div class="sid-body">
                        <h2 class="sid-name">@Dash(card.StudentsName)</h2>
                        <p class="sid-idline">@TitleText @card.ID</p>
                        <div class="sid-flourish" aria-hidden="true"><i></i></div>
                        <ul>
                            <li>
                                <span class="sid-ico">@PersonIcon</span>
                                <span><b>@Locale.T("si.father")</b> : @Dash(card.FathersName)</span>
                            </li>
                            <li>
                                <span class="sid-ico">@CalIcon</span>
                                <span><b>@Locale.T("si.dob")</b> : @(card.DateofBirth?.ToString("dd/MM/yyyy") ?? "-")</span>
                            </li>
                            <li>
                                <span class="sid-ico">@BookIcon</span>
                                <span><b>@Locale.T("si.class")</b> : @ClassLine(card)</span>
                            </li>
                            <li>
                                <span class="sid-ico">@HomeIcon</span>
                                <span><b>@Locale.T("si.address")</b> : @Dash(StudentAddress(card))</span>
                            </li>
                            <li>
                                <span class="sid-ico">@PhoneIcon</span>
                                <span><b>@Locale.T("si.mobile")</b> : @Dash(card.Phone)</span>
                            </li>
                        </ul>
                    </div>
                    <footer class="sid-foot">
                        <svg class="sid-foot-bg" viewBox="0 0 220 46" preserveAspectRatio="none" aria-hidden="true">
                            <path class="sid-foot-purple" d="M0 16 C48 16 78 8 118 8 C142 8 154 22 176 30 C192 36 206 32 220 28 L220 46 L0 46 Z" />
                            <path class="sid-foot-teal" d="M148 14 C172 4 196 24 220 22 L220 46 L170 46 C162 30 152 16 148 14 Z" />
                        </svg>
                        <div class="sid-foot-phone">
                            @PhoneIcon
                            <span>@Dash(FooterPhone(card))</span>
                        </div>
                        <div class="sid-sign-col">
                            @if (!string.IsNullOrWhiteSpace(signDataUrl))
                            {
                                <img class="sid-sign" src="@signDataUrl" alt="" />
                            }
                            <em>@Locale.T("si.principal")</em>
                        </div>
                    </footer>
                </article>
            }
        </div>
    }
</div>

@code {
    private const string PrefKey = "sikkhaloy.sid";
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [];
    private readonly List<ClassPartDto> sections = [];
    private readonly List<ClassPartDto> shifts = [];
    private readonly List<StudentIdCardDto> cards = [];
    private ClassStructureDto? structure;
    private string classInput = "0";
    private string groupInput = "0";
    private string sectionInput = "0";
    private string shiftInput = "0";
    private string ids = "";
    private string idTitle = "Student ID";
    private string headBg = "#5c2d82";
    private string headFg = "#ffffff";
    private string barBg = "#26c6c1";
    private string barFg = "#1a1a1a";
    private string footBg = "#5c2d82";
    private string footFg = "#ffffff";
    private string schoolAddress = "";
    private string schoolPhone = "";
    private string? signDataUrl;
    private bool colorOpen;
    private bool busy;
    private bool prefsLoaded;
    private string? error;

    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int GroupId => int.TryParse(groupInput, out var n) ? n : 0;
    private int SectionId => int.TryParse(sectionInput, out var n) ? n : 0;
    private int ShiftId => int.TryParse(shiftInput, out var n) ? n : 0;
    private string TitleText => string.IsNullOrWhiteSpace(idTitle) ? Locale.T("si.idBar") : idTitle.Trim();
    private string ColorStyle =>
        $"--sid-head-bg:{headBg};--sid-head-fg:{headFg};--sid-bar-bg:{barBg};--sid-bar-fg:{barFg};--sid-foot-bg:{footBg};--sid-foot-fg:{footFg};--sid-accent:{barBg};--sid-border:{headBg};";

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureOnlineAsync())
            return;
        structure = await Api.GetClassStructureAsync(Session.AccessToken);
        classes.Clear();
        classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
        if (Session.Current is not null)
        {
            var header = Sync.GetSchoolHeader(Session.Current.SchoolID);
            schoolAddress = header.Address ?? "";
            schoolPhone = header.Phone ?? "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || prefsLoaded)
            return;
        prefsLoaded = true;
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", PrefKey);
            if (string.IsNullOrWhiteSpace(json))
                return;
            var prefs = System.Text.Json.JsonSerializer.Deserialize<CardPrefs>(json);
            if (prefs is null)
                return;
            if (!string.IsNullOrWhiteSpace(prefs.Title))
                idTitle = prefs.Title;
            if (IsColor(prefs.HeadBg))
                headBg = prefs.HeadBg!;
            if (IsColor(prefs.HeadFg))
                headFg = prefs.HeadFg!;
            if (IsColor(prefs.BarBg))
                barBg = prefs.BarBg!;
            if (IsColor(prefs.BarFg))
                barFg = prefs.BarFg!;
            if (IsColor(prefs.FootBg))
                footBg = prefs.FootBg!;
            if (IsColor(prefs.FootFg))
                footFg = prefs.FootFg!;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private async Task OnClassChanged()
    {
        groupInput = sectionInput = shiftInput = "0";
        ApplyParts();
        await LoadAsync();
    }

    private void ApplyParts()
    {
        groups.Clear();
        sections.Clear();
        shifts.Clear();
        if (structure is null || ClassId <= 0)
            return;
        var parts = structure.AssignedParts(ClassId);
        groups.AddRange(parts.Groups);
        sections.AddRange(parts.Sections);
        shifts.AddRange(parts.Shifts);
    }

    private Task FindAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        if (!await EnsureOnlineAsync())
            return;
        if (string.IsNullOrWhiteSpace(ids) && ClassId <= 0)
        {
            cards.Clear();
            return;
        }

        busy = true;
        try
        {
            var data = await Api.GetStudentIdCardsAsync(Session.AccessToken, ClassId, GroupId, SectionId, ShiftId, ids);
            cards.Clear();
            cards.AddRange(data);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OnSignFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;
        await using var stream = file.OpenReadStream(512_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        signDataUrl = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task SetColor(Action<string> set, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        if (!IsColor(value))
            return;
        set(value);
        await SavePrefsAsync();
    }

    private async Task SavePrefsAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new CardPrefs
            {
                Title = idTitle,
                HeadBg = headBg,
                HeadFg = headFg,
                BarBg = barBg,
                BarFg = barFg,
                FootBg = footBg,
                FootFg = footFg
            });
            await JS.InvokeVoidAsync("localStorage.setItem", PrefKey, json);
        }
        catch
        {
        }
    }

    private async Task PrintAsync() =>
        await JS.InvokeVoidAsync("sikkhaloyPrint", "portrait", true);

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }

    private static string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private string HeaderLine(StudentIdCardDto card)
    {
        if (!string.IsNullOrWhiteSpace(card.SchoolAddress))
            return card.SchoolAddress.Trim();
        return schoolAddress;
    }

    private string ClassLine(StudentIdCardDto card)
    {
        var cls = Dash(card.ClassName);
        if (string.IsNullOrWhiteSpace(card.RollNo))
            return cls;
        return $"{cls} · {card.RollNo.Trim()}";
    }

    private string FooterPhone(StudentIdCardDto card)
    {
        if (!string.IsNullOrWhiteSpace(schoolPhone))
            return schoolPhone.Trim();
        return Dash(card.Phone);
    }

    private static string? StudentAddress(StudentIdCardDto card) =>
        string.IsNullOrWhiteSpace(card.PermanentAddress) ? card.LocalAddress : card.PermanentAddress;

    private static bool IsColor(string? value) =>
        value is { Length: 7 } && value[0] == '#';

    private static readonly MarkupString PersonIcon = new(
        """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"/></svg>""");
    private static readonly MarkupString CalIcon = new(
        """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3v18H4V4h3V2zm13 8H4v10h16V10z"/></svg>""");
    private static readonly MarkupString BookIcon = new(
        """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M6 4h11a3 3 0 0 1 3 3v13H8a2 2 0 0 0-2 2V4zm2 2v12h10V7a1 1 0 0 0-1-1H8z"/></svg>""");
    private static readonly MarkupString HomeIcon = new(
        """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 3 3 12h2v8h6v-5h2v5h6v-8h2L12 3z"/></svg>""");
    private static readonly MarkupString PhoneIcon = new(
        """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.5 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .7-.3 1L6.6 10.8z"/></svg>""");

    private sealed class CardPrefs
    {
        public string? Title { get; set; }
        public string? HeadBg { get; set; }
        public string? HeadFg { get; set; }
        public string? BarBg { get; set; }
        public string? BarFg { get; set; }
        public string? FootBg { get; set; }
        public string? FootFg { get; set; }
    }
}
