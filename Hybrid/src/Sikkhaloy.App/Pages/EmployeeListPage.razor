@page "/staff/employees"
@page "/staff/employees/deactivated"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="card structure-page emp-page">
    <h1>@(deactivated ? Locale.T("emp.deactivated") : Locale.T("emp.list"))</h1>
    <p class="muted no-print">@Locale.T("emp.crumb")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error no-print">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok no-print">@message</div>
    }

    <div class="filter-row no-print">
        <label class="choice-inline">
            <input type="radio" name="etype" checked="@(type == "%")" @onchange="@(() => SetType("%"))" />
            <span>@Locale.T("emp.all")</span>
        </label>
        <label class="choice-inline">
            <input type="radio" name="etype" checked="@(type == "Teacher")" @onchange="@(() => SetType("Teacher"))" />
            <span>@Locale.T("emp.teacher")</span>
        </label>
        <label class="choice-inline">
            <input type="radio" name="etype" checked="@(type == "Staff")" @onchange="@(() => SetType("Staff"))" />
            <span>@Locale.T("emp.staff")</span>
        </label>
        <input type="text" placeholder="@Locale.T("emp.search")" @bind="query" @bind:event="oninput" />
        <button type="button" class="btn-serial" disabled="@busy" @onclick="LoadAsync">@Locale.T("emp.find")</button>
        <button type="button" class="link-btn" disabled="@busy" @onclick="PrintAsync">@Locale.T("emp.print")</button>
        <button type="button" class="link-btn" @onclick="ToggleStatus">
            @(deactivated ? Locale.T("emp.activeHint") : Locale.T("emp.deactivatedHint"))
        </button>
    </div>

    <p class="muted">@Locale.T("emp.count", rows.Count)</p>

    <table class="mgrid">
        <thead>
            <tr>
                <th class="no-print">@(deactivated ? Locale.T("emp.reactivate") : Locale.T("emp.deactivate"))</th>
                <th>@Locale.T("emp.id")</th>
                <th>@Locale.T("emp.name")</th>
                <th>@Locale.T("emp.father")</th>
                <th>@Locale.T("emp.phone")</th>
                <th>@Locale.T("emp.designation")</th>
                <th class="no-print">@Locale.T("emp.type")</th>
                <th class="no-print">@Locale.T("emp.salary")</th>
                <th>@Locale.T("emp.bank")</th>
            </tr>
        </thead>
        <tbody>
        @if (rows.Count == 0 && !busy)
        {
            <tr><td colspan="9" class="empty-row">@Locale.T("emp.empty")</td></tr>
        }
        else
        {
            @foreach (var row in rows)
            {
                <tr>
                    <td class="act no-print">
                        <button type="button" class="link-btn @(deactivated ? null : "danger")" disabled="@busy"
                                @onclick="() => SetStatusAsync(row)">
                            @(deactivated ? Locale.T("emp.reactivate") : Locale.T("emp.deactivate"))
                        </button>
                    </td>
                    <td>
                        <input class="no-print emp-cell" @bind="row.ID" disabled="@busy" />
                        <span class="print-only">@row.ID</span>
                    </td>
                    <td>@row.Name</td>
                    <td>@row.FatherName</td>
                    <td>@row.Phone</td>
                    <td>@row.Designation</td>
                    <td class="no-print">
                        <input class="emp-cell" @bind="row.EmployeeType" disabled="@busy" />
                    </td>
                    <td class="no-print">
                        <input class="emp-cell" type="number" step="0.01" @bind="row.Salary" disabled="@busy" />
                    </td>
                    <td>
                        <input class="no-print emp-cell" @bind="row.BankAccNo" disabled="@busy" />
                        <span class="print-only">@row.BankAccNo</span>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>

    @if (!deactivated && rows.Count > 0)
    {
        <button type="button" class="btn-serial no-print" disabled="@busy" @onclick="SaveAsync">@Locale.T("emp.save")</button>
    }
</div>

@code {
    private readonly List<EmployeeListDto> rows = [];
    private string type = "%";
    private string query = "";
    private bool deactivated;
    private bool busy;
    private string? error;
    private string? message;

    private bool statusReady;

    protected override async Task OnParametersSetAsync()
    {
        var next = Nav.Uri.Contains("/staff/employees/deactivated", StringComparison.OrdinalIgnoreCase);
        if (statusReady && next == deactivated)
            return;
        deactivated = next;
        statusReady = true;
        await LoadAsync();
    }

    private async Task SetType(string value)
    {
        type = value;
        await LoadAsync();
    }

    private void ToggleStatus()
    {
        Nav.NavigateTo(deactivated ? "/staff/employees" : "/staff/employees/deactivated");
    }

    private async Task LoadAsync()
    {
        error = message = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("subj.needOnline");
            return;
        }

        busy = true;
        try
        {
            if (!await Api.PingAsync())
            {
                error = Locale.T("subj.needOnline");
                return;
            }

            var data = await Api.GetEmployeesAsync(
                Session.AccessToken, type, deactivated ? "Deactivate" : "Active", query);
            rows.Clear();
            rows.AddRange(data);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveAsync()
    {
        error = message = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
            return;

        busy = true;
        try
        {
            foreach (var row in rows)
            {
                var result = await Api.UpdateEmployeeAsync(Session.AccessToken, row.EmployeeID, new UpdateEmployeeRequest
                {
                    ID = row.ID,
                    EmployeeType = row.EmployeeType,
                    Salary = row.Salary,
                    BankAccNo = row.BankAccNo ?? ""
                });
                if (!result.Succeeded)
                {
                    error = Translate(result.Error);
                    return;
                }
            }

            message = Locale.T("emp.saved");
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetStatusAsync(EmployeeListDto row)
    {
        error = message = null;
        if (!deactivated)
        {
            var ok = await JS.InvokeAsync<bool>("confirm", Locale.T("emp.confirmDeactivate"));
            if (!ok)
                return;
        }

        busy = true;
        try
        {
            var result = await Api.SetEmployeeStatusAsync(Session.AccessToken, row.EmployeeID, new SetJobStatusRequest
            {
                JobStatus = deactivated ? "Active" : "Deactivate"
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PrintAsync() =>
        await JS.InvokeVoidAsync("sikkhaloyPrint", "landscape", false);

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("emp.failed") : Locale.T(key);
}
