@page "/sms/records"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="sms-rec-page">
    <header class="sms-rec-hero">
        <div class="sms-rec-hero-copy">
            <span class="sms-rec-hero-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
            </span>
            <div>
                <h1>@Locale.T("sms.recordsTitle")</h1>
                <p>@Locale.T("sms.recordsLead")</p>
            </div>
        </div>
        <div class="sms-rec-hero-side">
            <span class="sms-rec-balance">@Locale.T("sms.remainSmall", sheet.Balance)</span>
            <div class="sms-rec-hero-art" aria-hidden="true">
                <svg viewBox="0 0 88 88" fill="none">
                    <rect x="28" y="8" width="32" height="56" rx="6" fill="#fff" stroke="#0f766e" stroke-width="2"/>
                    <rect x="32" y="14" width="24" height="38" rx="2" fill="#ecfdf5"/>
                    <circle cx="44" cy="58" r="2.2" fill="#0f766e"/>
                    <rect x="12" y="22" width="22" height="12" rx="6" fill="#34d399"/>
                    <rect x="54" y="30" width="22" height="12" rx="6" fill="#5eead4"/>
                    <circle cx="20" cy="48" r="10" fill="#a7f3d0"/>
                </svg>
            </div>
        </div>
    </header>

    @if (sheet.LocalMode)
    {
        <div class="sms-local-note no-print">@Locale.T("sms.localNote")</div>
    }

    <section class="sms-rec-stats">
        <article class="sms-rec-stat is-sent">
            <span class="sms-rec-stat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
            </span>
            <div>
                <small>@Locale.T("sms.statSent")</small>
                <strong>@N(sheet.TotalSent)</strong>
            </div>
        </article>
        <article class="sms-rec-stat is-recv">
            <span class="sms-rec-stat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <div>
                <small>@Locale.T("sms.statRecipients")</small>
                <strong>@N(sheet.TotalRecipients)</strong>
            </div>
        </article>
        <article class="sms-rec-stat is-ok">
            <span class="sms-rec-stat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-5.2"/></svg>
            </span>
            <div>
                <small>@Locale.T("sms.statOk")</small>
                <strong>@N(sheet.Successful)</strong>
                <em>@Pct(sheet.Successful)</em>
            </div>
        </article>
        <article class="sms-rec-stat is-fail">
            <span class="sms-rec-stat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5"/><path d="M12 16h.01"/></svg>
            </span>
            <div>
                <small>@Locale.T("sms.statFail")</small>
                <strong>@N(sheet.Failed)</strong>
                <em>@Pct(sheet.Failed)</em>
            </div>
        </article>
        <article class="sms-rec-stat is-cost">
            <span class="sms-rec-stat-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
            </span>
            <div>
                <small>@Locale.T("sms.statCost")</small>
                <strong>৳ @sheet.TotalCost.ToString("N2")</strong>
            </div>
        </article>
    </section>

    <div class="sms-rec-filters no-print">
        <div class="sms-rec-dates">
            <input type="date" @bind="fromDate" disabled="@busy" />
            <span>–</span>
            <input type="date" @bind="toDate" disabled="@busy" />
        </div>
        <select class="sms-rec-kind-sel" @bind="kind" disabled="@busy">
            <option value="">@Locale.T("sms.allTypes")</option>
            <option value="group">@Locale.T("sms.kindGroup")</option>
            <option value="individual">@Locale.T("sms.kindIndividual")</option>
            <option value="system">@Locale.T("sms.kindSystem")</option>
        </select>
        <input type="text" class="sms-rec-search" placeholder="@Locale.T("sms.phonePurpose")" @bind="search" @bind:event="oninput" @onkeydown="OnSearchKey" disabled="@busy" />
        <button type="button" class="sms-rec-filter" disabled="@busy" @onclick="() => SearchAsync()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg>
            @Locale.T("sms.filter")
        </button>
        <button type="button" class="sms-rec-reset" disabled="@busy" @onclick="ResetAsync">@Locale.T("sms.reset")</button>
    </div>

    <div class="sms-rec-range">@Locale.T("sms.rangeTotal", FromLabel, ToLabel, N(sheet.TotalSent))</div>

    @Pager

    <div class="sms-rec-table-wrap @(busy ? "is-busy" : null)">
        <table class="sms-rec-table">
            <thead>
                <tr>
                    <th>@Locale.T("sms.sl")</th>
                    <th>@Locale.T("sms.recipient")</th>
                    <th>@Locale.T("sms.msgDetails")</th>
                    <th>@Locale.T("sms.textCount")</th>
                    <th>@Locale.T("sms.smsCount")</th>
                    <th>@Locale.T("sms.purpose")</th>
                    <th>@Locale.T("sms.sentTime")</th>
                    <th class="no-print"></th>
                </tr>
            </thead>
            <tbody>
            @if (busy && sheet.Rows.Count == 0)
            {
                @for (var i = 0; i < 6; i++)
                {
                    <tr class="sms-rec-skel"><td colspan="8"><span></span></td></tr>
                }
            }
            else if (sheet.Rows.Count == 0)
            {
                <tr><td colspan="8" class="empty-row">@Locale.T("sms.noRecords")</td></tr>
            }
            else
            {
                var sl = (sheet.Page - 1) * sheet.PageSize;
                @foreach (var row in sheet.Rows)
                {
                    sl++;
                    <tr>
                        <td>@sl</td>
                        <td>
                            <div class="sms-rec-who">
                                <span class="sms-rec-av">@Initial(row.RecipientName)</span>
                                <div>
                                    <strong>@DisplayName(row)</strong>
                                    <small>@row.PhoneNumber</small>
                                </div>
                            </div>
                        </td>
                        <td class="sms-rec-msg">@row.TextSMS</td>
                        <td>@(row.TextCount > 0 ? row.TextCount : row.TextSMS.Length)</td>
                        <td>@row.SMSCount</td>
                        <td>@row.PurposeOfSMS</td>
                        <td class="sms-rec-when">@row.Date.ToString("dd-MMM-yy (h:mm tt)")</td>
                        <td class="no-print">
                            <button type="button" class="sms-rec-more" title="@Locale.T("sms.details")" @onclick="() => detail = row">⋯</button>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @Pager
</div>

@if (detail is not null)
{
    <div class="acc-result-back" @onclick="() => detail = null">
        <div class="acc-result sms-rec-detail" @onclick:stopPropagation="true">
            <h3>@Locale.T("sms.details")</h3>
            <p class="sms-rec-detail-meta">@DisplayName(detail) · @detail.PhoneNumber</p>
            <p class="sms-rec-detail-text">@detail.TextSMS</p>
            <button type="button" class="acc-btn acc-btn-primary" @onclick="() => detail = null">@Locale.T("sms.close")</button>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="true" ErrorTitle="sms.errorTitle" OnClose="() => popupText = null" />
}

@code {
    private SmsRecordsDto sheet = new();
    private DateTime? fromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? toDate = DateTime.Today;
    private string search = "";
    private string kind = "";
    private int page = 1;
    private int pageSize = 10;
    private bool busy;
    private string? popupText;
    private SmsRecordDto? detail;

    private string FromLabel => fromDate?.ToString("dd MMM yyyy") ?? "";
    private string ToLabel => toDate?.ToString("dd MMM yyyy") ?? "";

    private RenderFragment Pager => __builder =>
    {
        <div class="sms-rec-pager no-print">
            <div class="sms-rec-pager-size">
                @Locale.T("sms.rowsPerPage")
                <select value="@pageSize" disabled="@busy" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                @Locale.T("sms.items")
            </div>
            <div class="sms-rec-pages">
                @foreach (var n in PageNumbers)
                {
                    <button type="button" class="@(n == page ? "is-on" : null)" disabled="@busy" @onclick="() => GoPageAsync(n)">@n</button>
                }
            </div>
        </div>
    };

    private IEnumerable<int> PageNumbers
    {
        get
        {
            var total = Math.Max(1, sheet.TotalPages);
            var start = Math.Max(1, page - 2);
            var end = Math.Min(total, start + 4);
            start = Math.Max(1, end - 4);
            for (var i = start; i <= end; i++) yield return i;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        search = "";
        kind = "";
        page = 1;
        pageSize = 10;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size)) return;
        pageSize = size;
        page = 1;
        await LoadAsync();
    }

    private Task GoPageAsync(int n)
    {
        if (n == page || n < 1 || n > Math.Max(1, sheet.TotalPages)) return Task.CompletedTask;
        page = n;
        return LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                popupText = Locale.T("subj.needOnline");
                return;
            }
            sheet = await Api.GetSmsRecordsAsync(Session.AccessToken!, fromDate, toDate, search, kind, page, pageSize);
            page = sheet.Page;
            pageSize = sheet.PageSize;
        }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private static string N(int value) => value.ToString("N0");

    private string Pct(int part)
    {
        if (sheet.TotalSent <= 0) return "0.00%";
        return ((part * 100m) / sheet.TotalSent).ToString("N2") + "%";
    }

    private static string Initial(string name)
    {
        var t = (name ?? "").Trim();
        return t.Length == 0 ? "?" : t[..1].ToUpperInvariant();
    }

    private static string DisplayName(SmsRecordDto row) =>
        string.IsNullOrWhiteSpace(row.RecipientName) ? row.PhoneNumber : row.RecipientName;
}
