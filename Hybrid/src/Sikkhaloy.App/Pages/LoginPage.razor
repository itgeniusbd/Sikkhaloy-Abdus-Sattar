@page "/login"
@layout EmptyLayout
@inherits LocaleAwareComponent
@inject ISyncApiClient Api
@inject OfflineAuthService OfflineAuth
@inject AppSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Globalization

<div class="dc-login">
    <div class="bg"></div>
    <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span><span class="blob b4"></span>
    <span class="pt"></span><span class="pt"></span><span class="pt"></span><span class="pt"></span><span class="pt"></span>
    <span class="pt"></span><span class="pt"></span><span class="pt"></span><span class="pt"></span><span class="pt"></span>
    <span class="shape sq1"></span><span class="shape sq2"></span><span class="shape sq3"></span>
    <span class="shape plus"><svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg></span>
    <span class="shape ring-d"></span>
    <span class="shape dots4"><svg viewBox="0 0 46 46" fill="#16a34a"><circle cx="6" cy="6" r="3"/><circle cx="23" cy="6" r="3"/><circle cx="40" cy="6" r="3"/><circle cx="6" cy="23" r="3"/><circle cx="23" cy="23" r="3"/><circle cx="40" cy="23" r="3"/><circle cx="6" cy="40" r="3"/><circle cx="23" cy="40" r="3"/><circle cx="40" cy="40" r="3"/></svg></span>

    <div class="top">
        <a href="/" class="mini-brand">
            <span class="cap-wrap">
                <span class="cap"><img src="_content/Sikkhaloy.App/img/hybrid-logo.png?v=2" alt="Sikkhaloy Hybrid" /></span>
            </span>
            <span class="t"><small>SIKKHALOY.COM</small><b>শিক্ষা<i>লয়</i><u>.</u></b></span>
        </a>
        <div class="top-right">
            <a href="tel:09638669966" class="hotline">@PhoneIcon 09638 66 99 66</a>
            <div class="lang-sw">
                <button type="button" class="@(Locale.IsBengali ? "on" : null)" @onclick='() => Locale.Set("bn")'>BN</button>
                <button type="button" class="@(!Locale.IsBengali ? "on" : null)" @onclick='() => Locale.Set("en")'>EN</button>
            </div>
        </div>
    </div>

    <a href="/" class="back">@BackIcon @Locale.T("login.back")</a>

    <div class="wrap">
        <div class="card @(_shake ? "shake" : null)" @ref="_card">
            <div class="lc-left">
                <span class="big-cap">
                    <span class="pulse"></span><span class="pulse p2"></span>
                    @CapGreenSvg
                </span>
                <h2>@Locale.T("login.left.title") <span class="hl">&nbsp;</span></h2>
                <p class="sub">@Locale.T("login.left.sub")</p>
                <ul class="lc-list">
                    <li><span class="ck">@CheckIcon</span><span>@Locale.T("login.left.1")</span></li>
                    <li><span class="ck">@CheckIcon</span><span>@Locale.T("login.left.2")</span></li>
                    <li><span class="ck">@CheckIcon</span><span>@Locale.T("login.left.3")</span></li>
                    <li><span class="ck">@CheckIcon</span><span>@Locale.T("login.left.4")</span></li>
                </ul>
                <div class="rfid-scene" aria-hidden="true">
                    <div class="rf-card">RFID</div>
                    <span class="rf-wave"></span><span class="rf-wave w2"></span>
                    <div class="rf-reader"><div class="rf-screen"><span class="ok">✓</span><span class="pc">৯৬%</span></div></div>
                </div>
                <div class="mini-stat">
                    <div class="mst"><b>@Fmt(_inst)</b><small>@Locale.T("home.stat.inst")</small></div>
                    <div class="mst"><b>@Fmt(_stu)</b><small>@Locale.T("home.stat.stu")</small></div>
                    <div class="mst"><b>@Fmt(_tea)</b><small>@Locale.T("home.stat.tea")</small></div>
                </div>
            </div>

            <div class="lc-right">
                <h1>@Locale.T("login.heading") <em>@Locale.T("login.dash")</em></h1>
                @if (apiChecked && !apiUp)
                {
                    @* server status is shown only when the API is unreachable *@
                    <p class="srv-off" role="status"><span class="dot"></span>@Locale.T("login.server", Locale.T("offline"))</p>
                }

                @if (!string.IsNullOrWhiteSpace(message) && !Locale.IsNetNotice(message))
                {
                    <div class="err-msg show">@WarnIcon <span>@message</span></div>
                }

                <EditForm Model="model" OnValidSubmit="LoginAsync">
                    <div class="field f1">
                        <label>@Locale.T("login.user")</label>
                        <div class="inp">
                            <InputText @bind-Value="model.UserName" autocomplete="username" placeholder="@Locale.T("login.userPh")" class="@(UserFilled ? "filled" : null)" />
                            <span class="ic">@UserIcon</span>
                        </div>
                    </div>
                    <div class="field f2">
                        <label>@Locale.T("login.password")</label>
                        <div class="inp">
                            <input type="@(_showPass ? "text" : "password")" @bind="model.Password" autocomplete="current-password" placeholder="@Locale.T("login.passPh")" class="@(PassFilled ? "filled" : null)" />
                            <span class="ic">@LockSmallIcon</span>
                            <button type="button" class="eye" @onclick="() => _showPass = !_showPass" tabindex="-1" aria-label="@Locale.T("login.password")">
                                @(_showPass ? EyeOffIcon : EyeIcon)
                            </button>
                        </div>
                    </div>
                    <div class="opts">
                        <label class="remember">
                            <input type="checkbox" @bind="_remember" />
                            <span class="box">@CheckIcon</span>
                            <span>@Locale.T("login.remember")</span>
                        </label>
                        <a href="/#contact" class="forgot">@Locale.T("login.forgot")</a>
                    </div>
                    <button class="login-btn @(busy ? "loading" : null)" type="submit" disabled="@busy">
                        <span class="spinner"></span>
                        <span class="txt">@(busy ? Locale.T("login.busy") : Locale.T("login.submit"))</span>
                        <svg class="arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                </EditForm>

                <div class="divider">@Locale.T("login.or")</div>
                <p class="register-hint">
                    <span>@Locale.T("login.noAccount")</span>
                    <a href="/#contact">@Locale.T("login.register")</a>
                </p>
            </div>
        </div>
        <p class="foot-note">© @FooterYears <b>Sikkhaloy.com</b> · @Locale.T("login.powered") <b>IT Genius</b> <span class="rr"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></span> · @PhoneIcon <a href="tel:09638669966" style="font-weight:700;color:var(--muted)">09638 66 99 66</a></p>
    </div>
</div>

@if (Locale.IsNetNotice(message))
{
    <ResultPopup Text="@message" Error="true" OnClose="() => message = null" />
}
<ExamBusyOverlay Busy="busy" Title="@Locale.T("login.busy")" Message="@Locale.T("login.wait")" />

@code {
    private const string RememberKey = "sikkhaloy.rememberUser";
    private ElementReference _card;
    private bool _cardBound;
    private readonly LoginRequest model = new();
    private bool busy, apiChecked, apiUp, _remember, _showPass, _shake;
    private string? message;
    private int _inst, _stu, _tea;

    private bool UserFilled => !string.IsNullOrWhiteSpace(model.UserName);
    private bool PassFilled => !string.IsNullOrWhiteSpace(model.Password);

    /// <summary>"২০১৫ - ২০২৬" (Bangla digits in BN, Latin in EN); the end year is the running year in Bangladesh time.</summary>
    private string FooterYears
    {
        get
        {
            var text = $"2015 - {DateTime.UtcNow.AddHours(6).Year}";   // Asia/Dhaka = UTC+6, no DST
            if (!Locale.IsBengali)
                return text;
            var chars = text.ToCharArray();
            for (var i = 0; i < chars.Length; i++)
                if (chars[i] is >= '0' and <= '9')
                    chars[i] = (char)('\u09E6' + (chars[i] - '0'));
            return new string(chars);
        }
    }

    private static readonly MarkupString CapGreenSvg = Cap("#86efac");
    private static readonly MarkupString CheckIcon = Icon("M20 6L9 17l-5-5");
    private static readonly MarkupString UserIcon = Icon("M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z");
    private static readonly MarkupString LockSmallIcon = (MarkupString)"""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>""";
    private static readonly MarkupString EyeIcon = Icon("M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z");
    private static readonly MarkupString EyeOffIcon = Icon("M17.9 17.9A10.4 10.4 0 0 1 12 19c-6.5 0-10.5-7-10.5-7a19 19 0 0 1 5.1-5.9M9.9 4.2A10.9 10.9 0 0 1 12 5c6.5 0 10.5 7 10.5 7a19 19 0 0 1-2.2 3.2M14.1 14.1a3 3 0 0 1-4.2-4.2M2 2l20 20");
    private static readonly MarkupString BackIcon = Icon("M19 12H5M11 18l-6-6 6-6");
    private static readonly MarkupString PhoneIcon = Icon("M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.6a2 2 0 0 1 1.7 2.1z");
    private static readonly MarkupString WarnIcon = Icon("M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01");

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo(Session.HomePath, replace: true);
            return;
        }

        apiUp = await Api.PingAsync();
        apiChecked = true;
        try
        {
            var stats = await Api.GetPublicStatsAsync();
            _inst = stats.Institutions;
            _stu = stats.Students;
            _tea = stats.Teachers;
        }
        catch
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            await JS.InvokeVoidAsync("sikkhaloyLoginCard.bind", _card);
            _cardBound = true;
        }
        catch (JSException)
        {
        }
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", RememberKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                model.UserName = saved;
                _remember = true;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
        }
    }

    public override void Dispose()
    {
        if (_cardBound)
        {
            _ = JS.InvokeVoidAsync("sikkhaloyLoginCard.unbind");
            _cardBound = false;
        }
        base.Dispose();
    }

    private async Task LoginAsync()
    {
        busy = true;
        message = null;
        model.DeviceId = OfflineAuthService.GetOrCreateDeviceId();
        StateHasChanged();
        await Task.Yield();
        try
        {
            var userName = model.UserName.Trim();
            LoginResponse cached;
            try
            {
                cached = await OfflineAuth.TryOfflineLoginAsync(userName, model.Password);
            }
            catch
            {
                cached = new LoginResponse { Succeeded = false, Error = "login.firstOnline" };
            }

            if (cached.Succeeded && cached.Session is not null)
            {
                Session.Set(cached, notify: false);
                _ = SaveRememberAsync();
                busy = false;
                Nav.NavigateTo(Session.HomePath);
                _ = CompleteOnlineLoginAsync();
                return;
            }

            LoginResponse result;
            try
            {
                result = await Api.LoginAsync(model);
                apiUp = true;
            }
            catch (Exception)
            {
                result = new LoginResponse { Succeeded = false, Error = "login.needOnline" };
                apiUp = false;
            }

            if (!result.Succeeded || result.Session is null)
            {
                if (apiUp)
                {
                    message = TranslateError(result.Error);
                    await ShakeAsync();
                    return;
                }

                result = cached.Succeeded ? cached : await OfflineAuth.TryOfflineLoginAsync(userName, model.Password);
                if (!result.Succeeded && result.Error == "login.firstOnline")
                    result.Error = "login.needOnline";
            }

            if (!result.Succeeded || result.Session is null)
            {
                message = TranslateError(result.Error);
                await ShakeAsync();
                return;
            }

            EnterApp(result);
            if (apiUp)
                _ = OfflineAuth.CacheOnlineLoginAsync(result, model.Password);
        }
        catch (Exception ex)
        {
            try
            {
                var offline = await OfflineAuth.TryOfflineLoginAsync(model.UserName?.Trim() ?? "", model.Password);
                if (offline.Succeeded && offline.Session is not null)
                {
                    EnterApp(offline);
                    return;
                }
            }
            catch
            {
            }

            message = TranslateError(ex.Message);
            await ShakeAsync();
        }
        finally
        {
            if (!Session.IsAuthenticated)
                busy = false;
        }
    }

    private async Task ShakeAsync()
    {
        _shake = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        _shake = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(450);
        _shake = false;
    }

    private void EnterApp(LoginResponse result)
    {
        Session.Set(result);
        _ = SaveRememberAsync();
        busy = false;
        Nav.NavigateTo(Session.HomePath);
    }

    private async Task CompleteOnlineLoginAsync()
    {
        try
        {
            var result = await Api.LoginAsync(model);
            if (result.Succeeded && result.Session is not null)
            {
                apiUp = true;
                Session.ApplyServerLogin(result);
                await OfflineAuth.CacheOnlineLoginAsync(result, model.Password);
            }
        }
        catch
        {
        }

        Session.NotifyChanged();
    }

    private async Task SaveRememberAsync()
    {
        try
        {
            if (_remember)
                await JS.InvokeVoidAsync("localStorage.setItem", RememberKey, model.UserName.Trim());
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", RememberKey);
        }
        catch (JSException)
        {
        }
    }

    private string TranslateError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
            return Locale.T("login.failed");
        if (error.StartsWith("login.", StringComparison.OrdinalIgnoreCase))
            return Locale.T(error);
        if (error.Contains("NULL at ordinal", StringComparison.OrdinalIgnoreCase)
            || error.Contains("IsDBNull", StringComparison.OrdinalIgnoreCase))
            return Locale.T("login.failed");
        return error;
    }

    private string Fmt(int n) =>
        n.ToString("N0", Locale.IsBengali ? CultureInfo.GetCultureInfo("bn-BD") : CultureInfo.InvariantCulture);

    private static MarkupString Cap(string color) =>
        (MarkupString)$"""<svg viewBox="0 0 24 24" fill="none" stroke="{color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z" fill="{color}" stroke="none"/><path d="M6 12.5V17c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path d="M22 10v6"/></svg>""";

    private static MarkupString Icon(string d) =>
        (MarkupString)$"""<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="{d}"/></svg>""";
}
