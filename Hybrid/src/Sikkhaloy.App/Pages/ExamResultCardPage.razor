@page "/exam/result-card"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject SyncEngine Sync

<div class="card structure-page emp-page acc-page exam-page">
    <h1 class="no-print">@Locale.T("exam.rcardTitle")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        @if (filters.Groups.Count > 0)
        {
            <select @bind="groupId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.selectGroup")</option>
                @foreach (var item in filters.Groups)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        @if (filters.Sections.Count > 0)
        {
            <select @bind="sectionId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allSection")</option>
                @foreach (var item in filters.Sections)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        @if (filters.Shifts.Count > 0)
        {
            <select @bind="shiftId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allShift")</option>
                @foreach (var item in filters.Shifts)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        <select @bind="examId" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.Exams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <input type="text" @bind="studentIds" disabled="@busy" placeholder="@Locale.T("exam.studentIdsHint")" title="@Locale.T("exam.studentIds")" />
        <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="LoadAsync">@Locale.T("exam.load")</button>
        @if (sheet.Students.Count > 0)
        {
            <button type="button" class="acc-btn acc-btn-primary" @onclick="PrintAsync">@Locale.T("exam.print")</button>
            @if (sheet.Students.Count > PrintBatch)
            {
                <span class="rc-print-pager">
                    <button type="button" class="acc-btn" disabled="@(printPage <= 0)" @onclick="PrevPrintPage" title="@Locale.T("exam.printPrev")">◀</button>
                    <strong>@Locale.T("exam.printBatch", PrintFrom, PrintTo, sheet.Students.Count)</strong>
                    <button type="button" class="acc-btn" disabled="@(printPage >= PrintPageCount - 1)" @onclick="NextPrintPage" title="@Locale.T("exam.printNext")">▶</button>
                </span>
            }
            <label class="rc-print-opt">
                <input type="checkbox" @bind="hidePhoto" />
                @Locale.T("exam.hidePhoto")
            </label>
        }
    </div>

    @foreach (var student in VisibleStudents)
    {
        <div class="exam-rcard @(bangla ? "is-bn" : null) @(hidePhoto ? "hide-photo" : null)">
            @if (!string.IsNullOrWhiteSpace(nameLogoUrl))
            {
                <div class="rc-head is-custom">
                    <img class="rc-name-logo" src="@nameLogoUrl" alt="" />
                    @if (!string.IsNullOrWhiteSpace(PhotoOf(student)))
                    {
                        <img class="rc-stu-photo" src="@PhotoOf(student)" alt="" />
                    }
                </div>
            }
            else
            {
                <div class="rc-head">
                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img class="rc-logo" src="@logoUrl" alt="" />
                    }
                    else { <span></span> }
                    <div>
                        <h2>@N(sheet.SchoolName)</h2>
                        @if (!string.IsNullOrWhiteSpace(sheet.Address)) { <p>@N(sheet.Address)</p> }
                        @if (!string.IsNullOrWhiteSpace(sheet.Phone)) { <p>@Locale.T("exam.phone"): @N(sheet.Phone)</p> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(PhotoOf(student)))
                    {
                        <img class="rc-stu-photo" src="@PhotoOf(student)" alt="" />
                    }
                    else { <span></span> }
                </div>
            }
            <div class="rc-title">
                <p class="Exam_name">@Locale.T("exam.rcardTitle")</p>
                <p class="title">@N(student.ExamName)</p>
            </div>
            <div class="rc-top">
                <div class="rc-left">
                    <table class="info-table">
                        <tr>
                            <td class="is-lbl">@Locale.T("exam.nameLbl")</td>
                            <td colspan="3"><b>@student.StudentsName</b></td>
                        </tr>
                        <tr>
                            <td class="is-lbl">@Locale.T("exam.classLbl")</td>
                            <td>@N(student.ClassName) @(string.IsNullOrWhiteSpace(student.SectionName) ? "" : " - " + N(student.SectionName))</td>
                            @if (!string.IsNullOrWhiteSpace(student.GroupName))
                            {
                                <td class="is-lbl">@Locale.T("exam.groupLbl")</td>
                                <td>@N(student.GroupName)</td>
                            }
                            else if (!string.IsNullOrWhiteSpace(student.ShiftName))
                            {
                                <td class="is-lbl">@Locale.T("exam.shiftLbl")</td>
                                <td>@N(student.ShiftName)</td>
                            }
                            else
                            {
                                <td></td><td></td>
                            }
                        </tr>
                        <tr>
                            <td class="is-lbl">@Locale.T("exam.rollLbl")</td>
                            <td>@N(student.RollNo)</td>
                            <td class="is-lbl">@Locale.T("exam.idLbl")</td>
                            <td>@N(student.ID)</td>
                        </tr>
                    </table>
                    <div class="rc-stats">
                        <table class="summary">
                            <tr class="summary-header">
                                <td>@Locale.T("exam.obtainedMarks")</td>
                                <td>%</td>
                                <td>@Locale.T("exam.average")</td>
                                <td>@Locale.T("exam.grade")</td>
                                <td>@Locale.T("exam.gpa")</td>
                                @if (!sheet.HideClassPosition) { <td>@Locale.T("exam.pc")</td> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <td>@Locale.T("exam.ps")</td> }
                                <td>@Locale.T("exam.comment")</td>
                            </tr>
                            <tr class="summary-values">
                                <td>@MarksOf(student)</td>
                                <td>@PctOf(student)</td>
                                <td>@AvgOf(student)</td>
                                <td>@student.Grade</td>
                                <td>@N(student.Point.ToString("0.00"))</td>
                                @if (!sheet.HideClassPosition) { <td>@PosOf(student.PositionClass)</td> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <td>@PosOf(student.PositionSection)</td> }
                                <td>@CommentOf(student)</td>
                            </tr>
                        </table>
                        <table class="att-table">
                            <tr class="summary-header">
                                <td>@Locale.T("exam.wd")</td>
                                <td>@Locale.T("exam.pre")</td>
                                <td>@Locale.T("exam.absentShort")</td>
                                <td>@Locale.T("exam.lateAbs")</td>
                                <td>@Locale.T("exam.leave")</td>
                                <td>@Locale.T("exam.late")</td>
                            </tr>
                            <tr class="summary-values">
                                <td>@N(student.WorkingDays)</td>
                                <td>@N(student.PresentDays)</td>
                                <td>@N(student.AbsentDays)</td>
                                <td>@N(student.LateAbsDays)</td>
                                <td>@N(student.LeaveDays)</td>
                                <td>@N(student.LateDays)</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="grade-chart">
                    <table>
                        <tr>
                            <th>@Locale.T("exam.marksLbl")</th>
                            <th>@Locale.T("exam.grade")</th>
                            <th>@Locale.T("exam.point")</th>
                        </tr>
                        @foreach (var band in sheet.Grades)
                        {
                            <tr>
                                <td>@N(band.Marks)</td>
                                <td>@band.Grade</td>
                                <td>@N(band.Point.ToString("0.0"))</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            <div style="overflow-x:auto;margin-top:8px;">
                @if (sheet.HasSubExams)
                {
                    <table class="marks-table">
                        <thead>
                            <tr>
                                <th rowspan="2">@Locale.T("exam.subject")</th>
                                @foreach (var name in sheet.SubExamNames)
                                {
                                    <th colspan="@SubCols">@N(name)</th>
                                }
                                <th rowspan="2">@Locale.T("exam.marksLbl")</th>
                                <th rowspan="2">@Locale.T("exam.grade")</th>
                                <th rowspan="2">@Locale.T("exam.gpa")</th>
                                @if (!sheet.HideClassPosition) { <th rowspan="2">@Locale.T("exam.pc")</th> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <th rowspan="2">@Locale.T("exam.ps")</th> }
                            </tr>
                            <tr>
                                @foreach (var _ in sheet.SubExamNames)
                                {
                                    <th>@Locale.T("exam.om")</th>
                                    @if (!sheet.HideFullMark) { <th>@Locale.T("exam.fm")</th> }
                                    @if (!sheet.HidePassMark) { <th>@Locale.T("exam.pm")</th> }
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var subject in student.Subjects)
                        {
                            <tr class="@(subject.Failed ? "is-fail" : null)">
                                <td class="is-name">@subject.SubjectName</td>
                                @foreach (var name in sheet.SubExamNames)
                                {
                                    var sub = subject.Subs.FirstOrDefault(x => x.SubExamName == name);
                                    <td>@MarkCell(sub?.Obtained)</td>
                                    @if (!sheet.HideFullMark) { <td>@(sub is null ? "-" : N(sub.FullMark.ToString("0")))</td> }
                                    @if (!sheet.HidePassMark) { <td>@(sub is null ? "-" : N(sub.PassMark.ToString("0")))</td> }
                                }
                                <td>@SubjectMarksOf(subject)</td>
                                <td>@subject.Grade</td>
                                <td>@N(subject.Point.ToString("0.0"))</td>
                                @if (!sheet.HideClassPosition) { <td>@PosOf(subject.PositionClass)</td> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <td>@PosOf(subject.PositionSection)</td> }
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="marks-table">
                        <thead>
                            <tr>
                                <th>@Locale.T("exam.subject")</th>
                                <th>@Locale.T("exam.om")</th>
                                @if (!sheet.HideFullMark) { <th>@Locale.T("exam.fm")</th> }
                                @if (!sheet.HidePassMark) { <th>@Locale.T("exam.pm")</th> }
                                <th>@Locale.T("exam.grade")</th>
                                <th>@Locale.T("exam.point")</th>
                                @if (!sheet.HideClassPosition) { <th>@Locale.T("exam.pc")</th> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <th>@Locale.T("exam.ps")</th> }
                                <th>@Locale.T("exam.hmc")</th>
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <th>@Locale.T("exam.hms")</th> }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var subject in student.Subjects)
                        {
                            <tr class="@(subject.Failed ? "is-fail" : null)">
                                <td class="is-name">@subject.SubjectName</td>
                                <td>@MarkCell(subject.Obtained)</td>
                                @if (!sheet.HideFullMark) { <td>@N(subject.FullMark.ToString("0"))</td> }
                                @if (!sheet.HidePassMark) { <td>@N(subject.PassMark.ToString("0"))</td> }
                                <td>@subject.Grade</td>
                                <td>@N(subject.Point.ToString("0.0"))</td>
                                @if (!sheet.HideClassPosition) { <td>@PosOf(subject.PositionClass)</td> }
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <td>@PosOf(subject.PositionSection)</td> }
                                <td>@N(subject.HighestClass)</td>
                                @if (sheet.HasSections && !sheet.HideSecPosition) { <td>@N(subject.HighestSection)</td> }
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <div class="rc-foot">
                <div><div class="rc-sign"></div><div>@Locale.T("exam.classTeacher")</div></div>
                <div><div class="rc-sign"></div><div>@Locale.T("exam.guardian")</div></div>
                <div><div class="rc-sign"></div><div>@Locale.T("exam.principal")</div></div>
            </div>
            <p class="note">@Locale.T("exam.rcardNote")</p>
        </div>
    }
    @if (!busy && loaded && sheet.Students.Count == 0)
    {
        <p class="empty-row">@Locale.T("exam.empty")</p>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@Locale.T("exam.loadingCards")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <div class="acc-result-back" @onclick="() => popupText = null">
        <div class="acc-result is-err" @onclick:stopPropagation="true">
            <div class="acc-result-icon">!</div>
            <h3>@Locale.T("exam.loadFailed")</h3>
            <p>@popupText</p>
            <button type="button" class="acc-btn acc-btn-primary" @onclick="() => popupText = null">@Locale.T("acc.ok")</button>
        </div>
    </div>
}

@code {
    private ExamFilterDto filters = new();
    private ExamResultCardSheetDto sheet = new();
    private int classId, examId;
    private string groupId = "0", sectionId = "0", shiftId = "0", studentIds = "", logoUrl = "", nameLogoUrl = "";
    private bool busy, loaded, hidePhoto;
    private bool bangla => Locale.IsBengali;
    private string? popupText;
    private const int PrintBatch = 25;
    private int printPage;
    private int PrintPageCount => Math.Max(1, (int)Math.Ceiling(sheet.Students.Count / (double)PrintBatch));
    private int PrintFrom => sheet.Students.Count == 0 ? 0 : printPage * PrintBatch + 1;
    private int PrintTo => Math.Min(sheet.Students.Count, (printPage + 1) * PrintBatch);
    private IEnumerable<ExamCardStudentDto> VisibleStudents =>
        sheet.Students.Skip(printPage * PrintBatch).Take(PrintBatch);
    private int SubCols => 1 + (sheet.HideFullMark ? 0 : 1) + (sheet.HidePassMark ? 0 : 1);

    protected override async Task OnInitializedAsync()
    {
        var schoolId = Session.Current?.SchoolID ?? 0;
        logoUrl = Sync.GetSchoolLogoDataUrl(schoolId) ?? "";
        nameLogoUrl = Sync.GetSchoolNameLogoDataUrl(schoolId) ?? "";
        await LoadFiltersAsync();
    }

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "result", classId, examId, groupId, sectionId, shiftId); }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private async Task OnClassAsync()
    {
        examId = 0; groupId = "0"; sectionId = "0"; shiftId = "0"; sheet = new(); loaded = false;
        await LoadFiltersAsync();
    }

    private Task LoadJoinAsync() => LoadFiltersAsync();

    private async Task LoadAsync()
    {
        sheet = new(); loaded = true; printPage = 0;
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "result", classId, examId, groupId, sectionId, shiftId);
            sheet = await Api.GetExamResultCardsAsync(Session.AccessToken!, classId, examId, groupId, sectionId, shiftId, studentIds);
        }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("window.print").AsTask();
    private void PrevPrintPage() { if (printPage > 0) printPage--; }
    private void NextPrintPage() { if (printPage < PrintPageCount - 1) printPage++; }
    private string PhotoOf(ExamCardStudentDto student)
    {
        if (student.StudentID <= 0 || Session.Current is null) return "";
        return Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, student.StudentID) ?? "";
    }
    private string CommentOf(ExamCardStudentDto student)
    {
        if (!string.IsNullOrWhiteSpace(student.Comment)) return student.Comment;
        var grade = student.Grade.Trim().ToUpperInvariant();
        if (!bangla)
        {
            return grade switch
            {
                "A+" => "Outstanding",
                "A" => "Excellent",
                "A-" => "Very Good",
                "B" => "Good",
                "C" => "Satisfactory",
                "D" => "Acceptable",
                "F" => "Fail",
                _ => "Good"
            };
        }
        return grade switch
        {
            "A+" => "চমৎকার",
            "A" => "ভালো",
            "A-" => "মোটামুটি ভালো",
            "B" => "বেশি ভালো নয়",
            "C" => "সন্তোষজনক নয়",
            "D" => "খুব খারাপ",
            "F" => "অকৃতকার্য",
            _ => "ভালো"
        };
    }
    private string N(string? text)
    {
        if (!bangla || string.IsNullOrEmpty(text)) return text ?? "";
        var chars = text.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            if (chars[i] is >= '0' and <= '9')
                chars[i] = (char)('\u09E6' + (chars[i] - '0'));
        }
        return new string(chars);
    }
    private string MarkCell(string? obtained)
    {
        var text = string.IsNullOrWhiteSpace(obtained) ? "-" : obtained;
        if (bangla && (text.Equals("Abs", StringComparison.OrdinalIgnoreCase) || text.Equals("A", StringComparison.OrdinalIgnoreCase)))
            text = "অনুপ";
        return N(text);
    }
    private string MarksOf(ExamCardStudentDto student) =>
        N($"{(student.Total % 1 == 0 ? student.Total.ToString("0") : student.Total.ToString("0.0"))}/{student.FullTotal.ToString("0")}");
    private string SubjectMarksOf(ExamCardSubjectDto subject)
    {
        var full = subject.FullMark % 1 == 0 ? subject.FullMark.ToString("0") : subject.FullMark.ToString("0.0");
        if (string.IsNullOrWhiteSpace(subject.Obtained) || subject.Obtained == "-")
            return N($"-/{full}");
        return N($"{(bangla && subject.Obtained.Equals("Abs", StringComparison.OrdinalIgnoreCase) ? "অনুপ" : subject.Obtained)}/{full}");
    }
    private string PctOf(ExamCardStudentDto student)
    {
        var text = student.Percentage?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(text)) return "-";
        return N(text.EndsWith("%", StringComparison.Ordinal) ? text : text + "%");
    }
    private string AvgOf(ExamCardStudentDto student) =>
        string.IsNullOrWhiteSpace(student.Average) ? "-" : N(student.Average);
    private string PosOf(string value) => string.IsNullOrWhiteSpace(value) || value == "0" ? "-" : N(value);
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            popupText = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }
}
