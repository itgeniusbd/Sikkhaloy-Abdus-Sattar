@page "/accounts/reports/my-accounts"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="card structure-page emp-page acc-page rpt-page ie-rpt my-rpt">
    <div class="rpt-filters no-print">
        <input type="date" value="@fromText" @onchange="OnFrom" title="@Locale.T("rpt.from")" />
        <input type="date" value="@toText" @onchange="OnTo" title="@Locale.T("rpt.to")" />
        <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="LoadAsync">@Locale.T("acc.submit")</button>
        <button type="button" class="acc-btn rpt-print" disabled="@busy" @onclick="PrintAsync">@Locale.T("rpt.print")</button>
    </div>
    <h1>@Locale.T("rpt.myTitle") @if (!string.IsNullOrWhiteSpace(DateLabel)) { <small>@DateLabel</small> }</h1>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="error">@error</div> }
    @if (data is not null)
    {
        <div class="my-widgets">
            <ReportWidget Css="user" Icon="user" Label="@(data.Designation ?? Locale.T("rpt.designation"))" Amount="@data.UserName" />
            <ReportWidget Css="paid" Icon="money" Label="@Locale.T("rpt.income")" Amount="@($"{Tk(data.Income)} {Locale.T("acc.tk")}")" />
            <ReportWidget Css="ex" Icon="area" Label="@Locale.T("rpt.expense")" Amount="@($"{Tk(data.Expense)} {Locale.T("acc.tk")}")" />
            <ReportWidget Css="late" Icon="calc" Label="@Locale.T("rpt.balance")" Amount="@($"{Tk(data.Balance)} {Locale.T("acc.tk")}")" />
            <ReportWidget Css="subm" Icon="card" Label="@Locale.T("rpt.submitted")" Amount="@($"{Tk(data.Submitted)} {Locale.T("acc.tk")}")" />
            <ReportWidget Css="con" Icon="wallet" Label="@Locale.T("rpt.remaining")" Amount="@($"{Tk(data.Remaining)} {Locale.T("acc.tk")}")" />
        </div>
        <div class="rpt-tabs no-print">
            <button type="button" class="@(tab == 0 ? "active" : null)" @onclick="() => tab = 0">@Locale.T("rpt.income")</button>
            <button type="button" class="@(tab == 1 ? "active" : null)" @onclick="() => tab = 1">@Locale.T("rpt.expense")</button>
        </div>
        @foreach (var group in tab == 0 ? data.IncomeGroups : data.ExpenseGroups)
        {
            <div class="rpt-cat-head"><span>@group.Category</span><span>@Tk(group.Total) @Locale.T("acc.tk")</span></div>
            <table class="mgrid">
                <thead><tr><th>@Locale.T("rpt.account")</th><th>@Locale.T("rpt.details")</th><th class="num">@Locale.T("rpt.amount")</th><th>@Locale.T("rpt.date")</th></tr></thead>
                <tbody>
                @foreach (var line in group.Lines)
                {
                    <tr>
                        <td>@line.AccountName</td>
                        <td>@line.Details</td>
                        <td class="num">@Tk(line.Amount)</td>
                        <td>@line.Date.ToString("d MMM yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
</div>

@if (busy)
{
    <div class="acc-loading-back">
        <div class="acc-loading">
            <div class="acc-spinner"></div>
            <p>@Locale.T("acc.loading")</p>
            <div class="acc-prog-track"><div class="acc-prog-fill is-run"></div></div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int Reg { get; set; }

    private MyAccountsDto? data;
    private string fromText = "", toText = "", error = "";
    private bool busy;
    private int tab;

    private string DateLabel => RangeLabel(fromText, toText);

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null) { Nav.NavigateTo("/login", replace: true); return; }
        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        fromText = Iso(start);
        toText = Iso(DateTime.Today);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        error = "";
        await PaintAsync();
        try { data = await Api.GetMyAccountsAsync(Session.AccessToken, Reg, Parse(fromText), Parse(toText)); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void OnFrom(ChangeEventArgs e) => fromText = e.Value?.ToString() ?? "";
    private void OnTo(ChangeEventArgs e) => toText = e.Value?.ToString() ?? "";
    private Task PrintAsync() => JS.InvokeVoidAsync("sikkhaloyPrint", "portrait", false).AsTask();
    private async Task PaintAsync() { await InvokeAsync(StateHasChanged); await Task.Delay(40); }
    private static DateTime? Parse(string? text) => DateTime.TryParse(text, out var day) ? day.Date : null;
    private static string Iso(DateTime day) => day.ToString("yyyy-MM-dd");
    private static string Tk(decimal n) => n.ToString("N0");

    private static string RangeLabel(string fromRaw, string toRaw)
    {
        var from = Parse(fromRaw);
        var to = Parse(toRaw);
        if (from is null && to is null) return "";
        if (from is not null && to is not null)
        {
            var a = from.Value.ToString("d MMM yyyy");
            var b = to.Value.ToString("d MMM yyyy");
            return from.Value == to.Value ? a : $"({a} To {b})";
        }
        if (from is not null) return $"After {from.Value:d MMM yyyy}";
        return $"Before {to!.Value:d MMM yyyy}";
    }
}
