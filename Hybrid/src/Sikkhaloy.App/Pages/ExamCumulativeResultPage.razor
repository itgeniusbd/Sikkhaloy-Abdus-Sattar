@page "/exam/cumulative-result"
@page "/exam/cumulative-result-card"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@inject SyncEngine Sync

<div class="card structure-page emp-page acc-page exam-page exam-cu-result-page">
    <h1 class="no-print">@Locale.T("exam.cuResultCard")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        @if (filters.Groups.Count > 0)
        {
            <select @bind="groupId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.selectGroup")</option>
                @foreach (var item in filters.Groups)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        @if (filters.Sections.Count > 0)
        {
            <select @bind="sectionId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allSection")</option>
                @foreach (var item in filters.Sections)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        @if (filters.Shifts.Count > 0)
        {
            <select @bind="shiftId" @bind:after="LoadJoinAsync" disabled="@busy">
                <option value="0">@Locale.T("exam.allShift")</option>
                @foreach (var item in filters.Shifts)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        }
        <select @bind="examId" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.CumulativeExams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <input type="text" @bind="studentIds" disabled="@busy" placeholder="@Locale.T("exam.studentIdsHint")" title="@Locale.T("exam.studentIds")" />
        <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="LoadAsync">@Locale.T("exam.load")</button>
        @if (sheet.Students.Count > 0)
        {
            <button type="button" class="acc-btn acc-btn-primary" @onclick="PrintAsync">@Locale.T("exam.print")</button>
            @if (sheet.Students.Count > PrintBatch)
            {
                <span class="rc-print-pager">
                    <button type="button" class="acc-btn" disabled="@(printPage <= 0)" @onclick="PrevPrintPage" title="@Locale.T("exam.printPrev")">◀</button>
                    <strong>@Locale.T("exam.printBatch", PrintFrom, PrintTo, sheet.Students.Count)</strong>
                    <button type="button" class="acc-btn" disabled="@(printPage >= PrintPageCount - 1)" @onclick="NextPrintPage" title="@Locale.T("exam.printNext")">▶</button>
                </span>
            }
            <label class="rc-print-opt">
                <input type="checkbox" @bind="hidePhoto" />
                @Locale.T("exam.hidePhoto")
            </label>
        }
    </div>
    <div class="filter-row no-print rc-sign-row">
        <div class="rc-sign-field">
            <input type="text" @bind="teacherLabel" @bind:event="oninput" disabled="@busy" placeholder="@Locale.T("exam.classTeacher")" title="@Locale.T("exam.classTeacher")" />
            <label class="sid-file-btn">
                @Locale.T("exam.uploadSign")
                <InputFile OnChange="OnTeacherSign" accept=".jpg,.jpeg,.png,.gif,.bmp" />
            </label>
        </div>
        <div class="rc-sign-field">
            <input type="text" @bind="guardianLabel" @bind:event="oninput" disabled="@busy" placeholder="@Locale.T("exam.guardian")" title="@Locale.T("exam.guardian")" />
            <label class="sid-file-btn">
                @Locale.T("exam.uploadSign")
                <InputFile OnChange="OnGuardianSign" accept=".jpg,.jpeg,.png,.gif,.bmp" />
            </label>
        </div>
        <div class="rc-sign-field">
            <input type="text" @bind="principalLabel" @bind:event="oninput" disabled="@busy" placeholder="@Locale.T("exam.principal")" title="@Locale.T("exam.principal")" />
            <label class="sid-file-btn">
                @Locale.T("exam.uploadSign")
                <InputFile OnChange="OnPrincipalSign" accept=".jpg,.jpeg,.png,.gif,.bmp" />
            </label>
        </div>
    </div>

    @foreach (var student in VisibleStudents)
    {
        <div class="exam-rcard rc-modern exam-cu-card @SubsClass(student.CuSubjects.Count) @ExamColsClass(sheet.Exams.Count) @(bangla ? "is-bn" : null) @(hidePhoto ? "hide-photo" : null)">
            @if (!string.IsNullOrWhiteSpace(nameLogoUrl))
            {
                <div class="rc-head is-custom">
                    <img class="rc-name-logo" src="@nameLogoUrl" alt="" />
                    @if (!string.IsNullOrWhiteSpace(PhotoOf(student)))
                    {
                        <img class="rc-stu-photo" src="@PhotoOf(student)" alt="" />
                    }
                </div>
            }
            else
            {
                <div class="rc-head">
                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img class="rc-logo" src="@logoUrl" alt="" />
                    }
                    else { <span></span> }
                    <div class="rc-inst">
                        <h2>@N(sheet.SchoolName)</h2>
                        @if (!string.IsNullOrWhiteSpace(sheet.Address)) { <p>@N(sheet.Address)</p> }
                        @if (!string.IsNullOrWhiteSpace(sheet.Phone)) { <p>@Locale.T("exam.phone"): @N(sheet.Phone)</p> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(PhotoOf(student)))
                    {
                        <img class="rc-stu-photo" src="@PhotoOf(student)" alt="" />
                    }
                    else { <span></span> }
                </div>
            }
            <div class="rc-title">
                <p class="Exam_name">@Locale.T("exam.rcardTitle")</p>
                <p class="title">@N(student.ExamName)</p>
            </div>
            <div class="rc-top">
                <div class="rc-band">
                    <section class="rc-panel">
                        <h4>@Locale.T("exam.stuInfo")</h4>
                        <dl class="rc-dl">
                            <div class="span-2">
                                <dt>@Locale.T("exam.nameLbl")</dt>
                                <dd>@student.StudentsName</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.idLbl")</dt>
                                <dd>@Dash(student.ID)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.rollLbl")</dt>
                                <dd>@Dash(student.RollNo)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.classLbl")</dt>
                                <dd>@Dash(student.ClassName)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.groupLbl")</dt>
                                <dd>@Dash(student.GroupName)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.sectionLbl")</dt>
                                <dd>@Dash(student.SectionName)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.shiftLbl")</dt>
                                <dd>@Dash(student.ShiftName)</dd>
                            </div>
                        </dl>
                    </section>
                    <section class="rc-panel">
                        <h4>@Locale.T("exam.attSummary")</h4>
                        <dl class="rc-dl">
                            <div>
                                <dt>@Locale.T("exam.workingDays")</dt>
                                <dd>@AttVal(student.WorkingDays)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.present")</dt>
                                <dd>@AttVal(student.PresentDays)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.absent")</dt>
                                <dd>@AttVal(student.AbsentDays)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.late")</dt>
                                <dd>@AttVal(student.LateDays)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.lateAbsent")</dt>
                                <dd>@AttVal(student.LateAbsDays)</dd>
                            </div>
                            <div>
                                <dt>@Locale.T("exam.leave")</dt>
                                <dd>@AttVal(student.LeaveDays)</dd>
                            </div>
                        </dl>
                    </section>
                    <div class="grade-chart">
                        <table>
                            <thead>
                                <tr>
                                    <th>@Locale.T("exam.marksLbl")</th>
                                    <th>@Locale.T("exam.grade")</th>
                                    <th>@Locale.T("exam.point")</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var band in sheet.Grades)
                            {
                                <tr>
                                    <td>@N(band.Marks)</td>
                                    <td>@band.Grade</td>
                                    <td>@N(band.Point.ToString("0.0"))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="rc-sum">
                    <div class="rc-metric is-marks">
                        <span>@Locale.T("exam.obtainedMarks")</span>
                        <b>@MarksOf(student)</b>
                    </div>
                    <div class="rc-metric is-pct">
                        <span>@Locale.T("exam.percentage")</span>
                        <b>@PctOf(student)</b>
                    </div>
                    <div class="rc-metric is-avg">
                        <span>@Locale.T("exam.average")</span>
                        <b>@AvgOf(student)</b>
                    </div>
                    <div class="rc-metric is-grade">
                        <span>@Locale.T("exam.grade")</span>
                        <b>@Dash(student.Grade)</b>
                    </div>
                    <div class="rc-metric is-gpa">
                        <span>@Locale.T("exam.gpa")</span>
                        <b>@N(student.Point.ToString("0.00"))</b>
                    </div>
                    @if (!sheet.HideClassPosition)
                    {
                        <div class="rc-metric is-pc">
                            <span>@Locale.T("exam.pc")</span>
                            <b>@PosOf(student.PositionClass)</b>
                        </div>
                    }
                    @if (sheet.HasSections && !sheet.HideSecPosition)
                    {
                        <div class="rc-metric is-ps">
                            <span>@Locale.T("exam.ps")</span>
                            <b>@PosOf(student.PositionSection)</b>
                        </div>
                    }
                    <div class="rc-metric is-cmt">
                        <span>@Locale.T("exam.comment")</span>
                        <b>@CommentOf(student)</b>
                    </div>
                </div>
            </div>

            <div class="rc-marks">
                <table class="marks-table">
                    <thead>
                        <tr>
                            <th rowspan="2">@Locale.T("exam.subjects")</th>
                            @foreach (var exam in sheet.Exams)
                            {
                                <th colspan="3">@N(exam.ExamName) (@N(exam.Percentage)%)</th>
                            }
                            <th colspan="@CuCols" class="is-cu">@Locale.T("exam.cuResult")</th>
                        </tr>
                        <tr>
                            @foreach (var _ in sheet.Exams)
                            {
                                <th>@Locale.T("exam.fm")</th>
                                <th>@Locale.T("exam.pm")</th>
                                <th>@Locale.T("exam.om")</th>
                            }
                            <th class="is-cu">@Locale.T("exam.fm")</th>
                            <th class="is-cu">@Locale.T("exam.om")</th>
                            <th class="is-cu">@Locale.T("exam.grade")</th>
                            <th class="is-cu">@Locale.T("exam.gpa")</th>
                            @if (!sheet.HideClassPosition) { <th class="is-cu is-pos">@Locale.T("exam.pc")</th> }
                            @if (sheet.HasSections && !sheet.HideSecPosition) { <th class="is-cu is-pos">@Locale.T("exam.ps")</th> }
                            <th class="is-cu is-pos">@Locale.T("exam.hmc")</th>
                            @if (sheet.HasSections && !sheet.HideSecPosition) { <th class="is-cu is-pos">@Locale.T("exam.hms")</th> }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var subject in student.CuSubjects)
                    {
                        <tr>
                            <td class="is-name">@subject.SubjectName</td>
                            @foreach (var exam in sheet.Exams)
                            {
                                var cell = subject.Exams.FirstOrDefault(x => x.ExamID == exam.ExamID);
                                <td>@N(cell?.FullMark ?? "-")</td>
                                <td>@N(cell?.PassMark ?? "-")</td>
                                <td>@MarkCell(cell?.Obtained)</td>
                            }
                            <td class="is-cu">@N(subject.CuFull)</td>
                            <td class="is-cu">@N(subject.CuObtained)</td>
                            <td class="is-cu">@subject.Grade</td>
                            <td class="is-cu">@N(subject.Point)</td>
                            @if (!sheet.HideClassPosition) { <td class="is-cu">@PosOf(subject.PositionClass)</td> }
                            @if (sheet.HasSections && !sheet.HideSecPosition) { <td class="is-cu">@PosOf(subject.PositionSection)</td> }
                            <td class="is-cu">@N(subject.HighestClass)</td>
                            @if (sheet.HasSections && !sheet.HideSecPosition) { <td class="is-cu">@N(subject.HighestSection)</td> }
                        </tr>
                    }
                    <tr class="is-total">
                        <td class="is-name">@Locale.T("exam.total")</td>
                        @foreach (var _ in sheet.Exams)
                        {
                            <td></td><td></td><td></td>
                        }
                        <td class="is-cu">@N(student.FullTotal.ToString("0.##"))</td>
                        <td class="is-cu">@N(student.Total.ToString("0.##"))</td>
                        <td class="is-cu">@student.Grade</td>
                        <td class="is-cu">@N(student.Point.ToString("0.00"))</td>
                        @if (!sheet.HideClassPosition) { <td class="is-cu">@PosOf(student.PositionClass)</td> }
                        @if (sheet.HasSections && !sheet.HideSecPosition) { <td class="is-cu">@PosOf(student.PositionSection)</td> }
                        <td class="is-cu">@N(student.HighestClass)</td>
                        @if (sheet.HasSections && !sheet.HideSecPosition) { <td class="is-cu">@N(student.HighestSection)</td> }
                    </tr>
                    </tbody>
                </table>
            </div>

            <div class="rc-fill"></div>
            <div class="rc-bottom">
            <div class="rc-foot">
                <div>
                    <div class="rc-sign">
                        @if (!string.IsNullOrWhiteSpace(TeacherSign)) { <img src="@TeacherSign" alt="" /> }
                    </div>
                    <div>@SignLbl(teacherLabel, "exam.classTeacher")</div>
                </div>
                <div>
                    <div class="rc-sign">
                        @if (!string.IsNullOrWhiteSpace(GuardianSign)) { <img src="@GuardianSign" alt="" /> }
                    </div>
                    <div>@SignLbl(guardianLabel, "exam.guardian")</div>
                </div>
                <div>
                    <div class="rc-sign">
                        @if (!string.IsNullOrWhiteSpace(PrincipalSign)) { <img src="@PrincipalSign" alt="" /> }
                    </div>
                    <div>@SignLbl(principalLabel, "exam.principal")</div>
                </div>
            </div>
            @if (!bangla)
            {
                <p class="note">@Locale.T("exam.rcardNote")</p>
            }
            </div>
        </div>
    }
    @if (!busy && loaded && sheet.Students.Count == 0)
    {
        <p class="empty-row">@Locale.T("exam.empty")</p>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@Locale.T("exam.loadingCards")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="true" ErrorTitle="exam.loadFailed" OnClose="() => popupText = null" />
}

@code {
    private ExamFilterDto filters = new();
    private CumulativeResultCardSheetDto sheet = new();
    private int classId, examId;
    private string groupId = "0", sectionId = "0", shiftId = "0", studentIds = "", logoUrl = "", nameLogoUrl = "";
    private bool busy, loaded, hidePhoto;
    private string teacherLabel = "", guardianLabel = "", principalLabel = "";
    private string? teacherSignUrl, guardianSignUrl, principalSignUrl;
    private string TeacherSign => teacherSignUrl ?? sheet.TeacherSignDataUrl ?? LocalSign("teacher");
    private string GuardianSign => guardianSignUrl ?? LocalSign("guardian");
    private string PrincipalSign => principalSignUrl ?? sheet.PrincipalSignDataUrl ?? LocalSign("principal");
    private bool bangla => Locale.IsBengali;
    private string? popupText;
    private const int PrintBatch = 25;
    private int printPage;
    private int PrintPageCount => Math.Max(1, (int)Math.Ceiling(sheet.Students.Count / (double)PrintBatch));
    private int PrintFrom => sheet.Students.Count == 0 ? 0 : printPage * PrintBatch + 1;
    private int PrintTo => Math.Min(sheet.Students.Count, (printPage + 1) * PrintBatch);
    private IEnumerable<CumulativeCardStudentDto> VisibleStudents =>
        sheet.Students.Skip(printPage * PrintBatch).Take(PrintBatch);
    private int CuCols => 5 + (sheet.HideClassPosition ? 0 : 1) + (sheet.HasSections && !sheet.HideSecPosition ? 2 : 0);

    protected override async Task OnInitializedAsync()
    {
        teacherLabel = Locale.T("exam.classTeacher");
        guardianLabel = Locale.T("exam.guardian");
        principalLabel = Locale.T("exam.principal");
        var schoolId = Session.Current?.SchoolID ?? 0;
        logoUrl = Sync.GetSchoolLogoDataUrl(schoolId) ?? "";
        nameLogoUrl = Sync.GetSchoolNameLogoDataUrl(schoolId) ?? "";
        await LoadFiltersAsync();
    }

    private async Task LoadFiltersAsync()
    {
        await ShowBusyAsync();
        try
        {
            if (!await OnlineAsync()) return;
            filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "cumulative-result", classId, examId, groupId, sectionId, shiftId);
        }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private async Task OnClassAsync()
    {
        examId = 0; groupId = "0"; sectionId = "0"; shiftId = "0"; sheet = new(); loaded = false;
        await LoadFiltersAsync();
    }

    private Task LoadJoinAsync() => LoadFiltersAsync();

    private async Task LoadAsync()
    {
        if (classId <= 0 || examId <= 0) return;
        popupText = null;
        sheet = new(); loaded = true; printPage = 0;
        await ShowBusyAsync();
        try
        {
            if (!await OnlineAsync()) return;
            filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "cumulative-result", classId, examId, groupId, sectionId, shiftId);
            sheet = await Api.GetCumulativeResultCardsAsync(Session.AccessToken!, classId, examId, groupId, sectionId, shiftId, studentIds);
            var schoolId = Session.Current?.SchoolID ?? 0;
            foreach (var student in sheet.Students)
            {
                if (schoolId > 0 && student.StudentID > 0 && !string.IsNullOrWhiteSpace(student.PhotoDataUrl))
                    Sync.SaveStudentPhoto(schoolId, student.StudentID, student.PhotoDataUrl);
            }
        }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("sikkhaloyPrintLandscape").AsTask();
    private void PrevPrintPage() { if (printPage > 0) printPage--; }
    private void NextPrintPage() { if (printPage < PrintPageCount - 1) printPage++; }
    private string PhotoOf(ExamCardStudentDto student)
    {
        if (!string.IsNullOrWhiteSpace(student.PhotoDataUrl)) return student.PhotoDataUrl;
        if (student.StudentID <= 0 || Session.Current is null) return "";
        return Sync.GetStudentPhotoDataUrl(Session.Current.SchoolID, student.StudentID) ?? "";
    }
    private string CommentOf(ExamCardStudentDto student)
    {
        if (!string.IsNullOrWhiteSpace(student.Comment)) return student.Comment;
        var grade = (student.Grade ?? "").Replace("<", "").Replace(">", "").Trim().ToUpperInvariant();
        return grade switch
        {
            "A+" => Locale.T("exam.cmtA"),
            "A" or "A-" => Locale.T("exam.cmtAm"),
            "B" or "B+" or "B-" => Locale.T("exam.cmtB"),
            "C" or "C+" or "C-" => Locale.T("exam.cmtC"),
            "D" or "D+" or "D-" => Locale.T("exam.cmtD"),
            "F" => Locale.T("exam.cmtF"),
            _ => Locale.T("exam.cmtGood")
        };
    }
    private string N(string? text)
    {
        if (!bangla || string.IsNullOrEmpty(text)) return text ?? "";
        var chars = text.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            if (chars[i] is >= '0' and <= '9')
                chars[i] = (char)('\u09E6' + (chars[i] - '0'));
        }
        return new string(chars);
    }
    private string MarkCell(string? obtained)
    {
        var text = string.IsNullOrWhiteSpace(obtained) ? "-" : obtained;
        if (bangla && (text.Equals("Abs", StringComparison.OrdinalIgnoreCase) || text.Equals("A", StringComparison.OrdinalIgnoreCase)))
            text = "অনুপ";
        return N(text);
    }
    private string MarksOf(ExamCardStudentDto student) =>
        N($"{(student.Total % 1 == 0 ? student.Total.ToString("0") : student.Total.ToString("0.0"))}/{student.FullTotal.ToString("0")}");
    private string PctOf(ExamCardStudentDto student)
    {
        var text = student.Percentage?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(text)) return "-";
        return N(text.EndsWith("%", StringComparison.Ordinal) ? text : text + "%");
    }
    private string AvgOf(ExamCardStudentDto student) =>
        string.IsNullOrWhiteSpace(student.Average) ? "-" : N(student.Average);
    private string PosOf(string value) => string.IsNullOrWhiteSpace(value) || value == "0" || value == "-" ? "-" : N(value);
    private string Dash(string? value)
    {
        var text = (value ?? "").Trim();
        if (text.Length == 0 || text is "-" or "—" or "–" or ".") return "";
        return N(text);
    }
    private string AttVal(string? value)
    {
        var text = (value ?? "").Trim();
        if (text.Length == 0 || text is "-" or "—" or "–" or "." or "0" or "০") return "";
        return N(text);
    }
    private static string SubsClass(int count) =>
        count <= 7 ? "rc-subs-lg" : count <= 10 ? "rc-subs-md" : count <= 12 ? "rc-subs-sm" : "rc-subs-xs";
    private static string ExamColsClass(int count) =>
        count <= 2 ? "rc-cu-exams-sm" : count == 3 ? "rc-cu-exams-md" : "rc-cu-exams-lg";
    private string SignLbl(string value, string fallbackKey) =>
        string.IsNullOrWhiteSpace(value) ? Locale.T(fallbackKey) : value;
    private string LocalSign(string kind)
    {
        var schoolId = Session.Current?.SchoolID ?? 0;
        return schoolId <= 0 ? "" : Sync.GetExamSignDataUrl(schoolId, kind) ?? "";
    }
    private Task OnTeacherSign(InputFileChangeEventArgs e) => OnSignFile(e, "teacher");
    private Task OnGuardianSign(InputFileChangeEventArgs e) => OnSignFile(e, "guardian");
    private Task OnPrincipalSign(InputFileChangeEventArgs e) => OnSignFile(e, "principal");
    private async Task OnSignFile(InputFileChangeEventArgs e, string kind)
    {
        var file = e.File;
        if (file is null) return;
        await using var stream = file.OpenReadStream(400_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        if (kind == "teacher") teacherSignUrl = dataUrl;
        else if (kind == "guardian") guardianSignUrl = dataUrl;
        else principalSignUrl = dataUrl;
        var schoolId = Session.Current?.SchoolID ?? 0;
        if (schoolId > 0) Sync.SaveExamSign(schoolId, kind, dataUrl);
        if (kind == "guardian") return;
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync()) return;
        try
        {
            await Api.SaveExamAdmitSignAsync(Session.AccessToken!, new SaveExamSignRequest
            {
                Kind = kind,
                Image = dataUrl
            });
        }
        catch
        {
        }
    }
    private async Task ShowBusyAsync()
    {
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            popupText = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }
}
