@page "/exam/analytical"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page emp-page acc-page exam-page">
    <h1 class="no-print">@Locale.T("exam.analytical")</h1>
    <div class="filter-row no-print">
        <select @bind="classId" @bind:after="OnClassAsync" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in filters.Classes)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        <select @bind="examId" @bind:after="LoadAsync" disabled="@busy">
            <option value="0">@Locale.T("exam.selectExam")</option>
            @foreach (var item in filters.Exams)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>
        @if (sheet.TotalStudents > 0)
        {
            <button type="button" class="acc-btn acc-btn-primary" @onclick="PrintAsync">@Locale.T("exam.print")</button>
        }
    </div>

    @if (sheet.TotalStudents > 0)
    {
        <div class="exam-ana-head">
            <h2>@sheet.SchoolName</h2>
            <h4>@Locale.T("exam.analytical")</h4>
            <p>@sheet.ClassName — @sheet.ExamName</p>
        </div>
        <div class="exam-ana-tabs no-print">
            <button type="button" class="@(tab == 0 ? "is-on" : null)" @onclick="() => tab = 0">@Locale.T("exam.gradeDist")</button>
            <button type="button" class="@(tab == 1 ? "is-on" : null)" @onclick="() => tab = 1">@Locale.T("exam.subjectStats")</button>
            <button type="button" class="@(tab == 2 ? "is-on" : null)" @onclick="() => tab = 2">@Locale.T("exam.unSummary")</button>
            <button type="button" class="@(tab == 3 ? "is-on" : null)" @onclick="() => tab = 3">@Locale.T("exam.unStudents")</button>
            <button type="button" class="@(tab == 4 ? "is-on" : null)" @onclick="() => tab = 4">@Locale.T("exam.passFail")</button>
        </div>

        @if (tab == 0)
        {
            <h3>@Locale.T("exam.gradeDist")</h3>
            <table class="mgrid">
                <thead><tr><th>@Locale.T("exam.grade")</th><th>@Locale.T("exam.stuCount")</th><th>@Locale.T("exam.pct")</th></tr></thead>
                <tbody>
                @foreach (var row in OrderedGradeDistribution)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td>@row.Count</td>
                        <td>
                            <div class="exam-bar"><span style="width:@row.Percentage.ToString("0.##")%"></span></div>
                            @row.Percentage.ToString("0.00")%
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else if (tab == 1)
        {
            <h3>@Locale.T("exam.subjectStats")</h3>
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>@Locale.T("exam.subject")</th>
                        @foreach (var grade in GradeHeaders)
                        {
                            <th>@grade</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var subject in sheet.SubjectStats)
                {
                    <tr>
                        <td>@subject.SubjectName</td>
                        @foreach (var grade in GradeHeaders)
                        {
                            <td>@(subject.Grades.FirstOrDefault(x => string.Equals(x.Label, grade, StringComparison.OrdinalIgnoreCase))?.Count ?? 0)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        }
        else if (tab == 2)
        {
            <h3>@Locale.T("exam.unSummary")</h3>
            @if (sheet.UnsuccessfulSummary.Count == 0)
            {
                <p>@Locale.T("exam.noFail")</p>
            }
            else
            {
                <table class="mgrid">
                    <thead><tr><th>@Locale.T("exam.subject")</th><th>@Locale.T("exam.failedStu")</th></tr></thead>
                    <tbody>
                    @foreach (var row in sheet.UnsuccessfulSummary)
                    {
                        <tr><td>@row.Label</td><td>@row.Count</td></tr>
                    }
                    </tbody>
                </table>
            }
        }
        else if (tab == 3)
        {
            <h3>@Locale.T("exam.unStudents")</h3>
            @if (sheet.UnsuccessfulStudents.Count == 0)
            {
                <p>@Locale.T("exam.noFail")</p>
            }
            else
            {
                <table class="mgrid">
                    <thead>
                        <tr>
                            <th>@Locale.T("exam.id")</th>
                            <th>@Locale.T("exam.name")</th>
                            <th>@Locale.T("exam.roll")</th>
                            <th>@Locale.T("exam.subjects")</th>
                            <th>@Locale.T("exam.failSubCount")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in sheet.UnsuccessfulStudents)
                    {
                        <tr>
                            <td>@row.ID</td>
                            <td>@row.Name</td>
                            <td>@row.RollNo</td>
                            <td>@row.FailedSubjects</td>
                            <td>@FailSubjectCount(row)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
        else
        {
            <h3>@Locale.T("exam.passFail")</h3>
            <table class="mgrid">
                <thead><tr><th></th><th>@Locale.T("exam.stuCount")</th><th>@Locale.T("exam.pct")</th></tr></thead>
                <tbody>
                    <tr>
                        <td>@Locale.T("exam.passed")</td>
                        <td>@sheet.Passed</td>
                        <td>@(sheet.TotalStudents == 0 ? "0.00" : (sheet.Passed * 100.0 / sheet.TotalStudents).ToString("0.00"))%</td>
                    </tr>
                    <tr>
                        <td>@Locale.T("exam.failedStu")</td>
                        <td>@sheet.Failed</td>
                        <td>@(sheet.TotalStudents == 0 ? "0.00" : (sheet.Failed * 100.0 / sheet.TotalStudents).ToString("0.00"))%</td>
                    </tr>
                    <tr>
                        <td>@Locale.T("exam.total")</td>
                        <td>@sheet.TotalStudents</td>
                        <td>100%</td>
                    </tr>
                </tbody>
            </table>
        }
    }
    else if (!busy && examId > 0)
    {
        <p class="empty-row">@Locale.T("exam.empty")</p>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@Locale.T("exam.loadingAnalytical")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="true" ErrorTitle="exam.failed" OnClose="() => popupText = null" />
}

@code {
    private ExamFilterDto filters = new();
    private ExamAnalyticalDto sheet = new();
    private int classId, examId, tab;
    private bool busy;
    private string? popupText;
    private IReadOnlyList<string> GradeHeaders => sheet.SubjectStats
        .SelectMany(x => x.Grades.Select(g => g.Label?.Trim() ?? ""))
        .Concat(sheet.GradeDistribution.Select(g => g.Label?.Trim() ?? ""))
        .Where(g => !string.IsNullOrWhiteSpace(g))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(GradeRank)
        .ThenBy(g => g, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IEnumerable<ExamStatRowDto> OrderedGradeDistribution
    {
        get
        {
            var map = sheet.GradeDistribution
                .Where(x => !string.IsNullOrWhiteSpace(x.Label))
                .GroupBy(x => x.Label.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
            foreach (var grade in GradeHeaders)
            {
                if (map.TryGetValue(grade, out var row))
                    yield return row;
                else
                    yield return new ExamStatRowDto { Label = grade, Count = 0, Percentage = 0 };
            }
        }
    }

    private static int FailSubjectCount(ExamFailStudentDto row)
    {
        if (row.FailCount > 0) return row.FailCount;
        if (string.IsNullOrWhiteSpace(row.FailedSubjects)) return 0;
        return row.FailedSubjects.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
    }

    private static int GradeRank(string grade) => grade.Trim().ToUpperInvariant() switch
    {
        "A+" => 1,
        "A" => 2,
        "A-" => 3,
        "B+" => 4,
        "B" => 5,
        "B-" => 6,
        "C+" => 7,
        "C" => 8,
        "C-" => 9,
        "D+" => 10,
        "D" => 11,
        "D-" => 12,
        "F" => 13,
        _ => 50
    };

    protected override Task OnInitializedAsync() => LoadFiltersAsync();

    private async Task LoadFiltersAsync()
    {
        if (!await OnlineAsync()) return;
        busy = true;
        try { filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "result", classId, examId); }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private async Task OnClassAsync()
    {
        examId = 0; sheet = new();
        await LoadFiltersAsync();
    }

    private async Task LoadAsync()
    {
        sheet = new();
        if (classId <= 0 || examId <= 0) return;
        if (!await OnlineAsync()) return;
        busy = true;
        try
        {
            filters = await Api.GetExamFiltersAsync(Session.AccessToken!, "result", classId, examId);
            sheet = await Api.GetExamAnalyticalAsync(Session.AccessToken!, classId, examId);
        }
        catch (Exception ex) { popupText = ex.Message; }
        finally { busy = false; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("window.print").AsTask();
    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            popupText = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }
}
