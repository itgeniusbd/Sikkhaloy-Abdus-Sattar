@page "/student/password"
@layout StudentLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject OfflineAuthService OfflineAuth
@inject NavigationManager Nav

<div class="sp-page">
    <h1>@Locale.T("stu.password")</h1>
    <article class="sp-card">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="sp-empty" style="color:#b91c1c">@error</p>
        }
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="sp-empty" style="color:#15803d">@message</p>
        }
        <label class="auth-field">@Locale.T("profile.old")
            <input type="password" @bind="current" autocomplete="current-password" disabled="@busy" />
        </label>
        <label class="auth-field">@Locale.T("profile.new")
            <input type="password" @bind="next" autocomplete="new-password" disabled="@busy" />
        </label>
        <label class="auth-field">@Locale.T("profile.again")
            <input type="password" @bind="confirm" autocomplete="new-password" disabled="@busy" />
        </label>
        <button type="button" class="sp-card-go" disabled="@busy" @onclick="SaveAsync">@Locale.T("profile.change")</button>
    </article>
</div>

@code {
    private string current = "";
    private string next = "";
    private string confirm = "";
    private bool busy;
    private string? error;
    private string? message;

    protected override void OnInitialized()
    {
        if (!Session.IsStudent)
            Nav.NavigateTo(Session.HomePath, replace: true);
    }

    private async Task SaveAsync()
    {
        error = null;
        message = null;
        if (string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            error = Locale.T("profile.needOnline");
            return;
        }

        busy = true;
        try
        {
            var result = await Api.ChangePasswordAsync(Session.AccessToken, new ChangePasswordRequest
            {
                CurrentPassword = current,
                NewPassword = next,
                ConfirmPassword = confirm
            });
            if (!result.Succeeded)
            {
                error = Locale.T(result.Error ?? "profile.needOnline");
                return;
            }

            await OfflineAuth.UpdateCachedPasswordAsync(Session.Current?.UserName ?? "", next);
            current = next = confirm = "";
            message = Locale.T("profile.pwChanged");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
