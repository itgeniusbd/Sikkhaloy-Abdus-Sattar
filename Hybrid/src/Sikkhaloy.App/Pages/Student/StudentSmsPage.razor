@page "/student/sms"
@layout StudentLayout
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject NavigationManager Nav
@inject StudentNoticeInbox Inbox

<div class="sp-page">
    <div class="sp-page-h">
        <h1>@Locale.T("stu.sms")</h1>
        <button type="button" class="sp-mark-all" disabled="@(!HasUnread)" @onclick="MarkAllAsync">
            @Locale.T("stu.markAllRead")
        </button>
    </div>
    <div class="sp-report-filters">
        <div class="sp-report-dates">
            <label>
                <span>@Locale.T("stu.fromDate")</span>
                <input type="date" @bind="fromDate" />
            </label>
            <label>
                <span>@Locale.T("stu.toDate")</span>
                <input type="date" @bind="toDate" />
            </label>
            <button type="button" class="sp-report-go-ico" disabled="@loading" @onclick="LoadAsync" title="@Locale.T("stu.search")" aria-label="@Locale.T("stu.search")">
                @SearchIco
            </button>
        </div>
    </div>
    @if (loading)
    {
        <article class="sp-card"><p class="sp-empty">@Locale.T("stu.loading")</p></article>
    }
    else if (rows.Count == 0)
    {
        <article class="sp-card"><p class="sp-empty">@Locale.T("stu.empty")</p></article>
    }
    else
    {
        @foreach (var row in rows)
        {
            var unread = !Inbox.IsSmsRead(row);
            <article class="sp-card @(unread ? "is-unread" : null)" style="margin-bottom:0.7rem">
                <div class="sp-notice">
                    <button type="button" class="sp-notice-title @(unread ? "is-new" : null)" @onclick="() => MarkAsync(row)">
                        @(string.IsNullOrWhiteSpace(row.Purpose) ? Locale.T("stu.sms") : row.Purpose)
                    </button>
                    <small>@row.Phone • @(row.Date?.ToString("d MMM yyyy h:mm tt") ?? "")</small>
                    <p>@row.Text</p>
                </div>
            </article>
        }
    }
</div>

@code {
    private IReadOnlyList<StudentPortalSmsDto> rows = [];
    private DateTime? fromDate;
    private DateTime? toDate;
    private bool loading = true;
    private static readonly MarkupString SearchIco = (MarkupString)"""<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.4-3.4"/></svg>""";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!Session.IsStudent) { Nav.NavigateTo(Session.HomePath, replace: true); return; }
        Inbox.Changed += OnInboxChanged;
        SetCurrentMonth();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(Session.AccessToken))
                rows = await Api.GetStudentPortalSmsAsync(Session.AccessToken, fromDate, toDate);
        }
        catch { rows = []; }
        loading = false;
    }

    private bool HasUnread =>
        Inbox.SmsUnread > 0 || rows.Any(x => !Inbox.IsSmsRead(x));

    private async Task MarkAsync(StudentPortalSmsDto row)
    {
        if (Inbox.IsSmsRead(row))
            return;
        await Inbox.MarkSmsReadAsync(row);
    }

    private Task MarkAllAsync() => Inbox.MarkAllSmsAsync(rows);

    private void SetCurrentMonth()
    {
        var today = DateTime.Today;
        fromDate = new DateTime(today.Year, today.Month, 1);
        toDate = fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void OnInboxChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Inbox.Changed -= OnInboxChanged;
        base.Dispose();
    }
}
