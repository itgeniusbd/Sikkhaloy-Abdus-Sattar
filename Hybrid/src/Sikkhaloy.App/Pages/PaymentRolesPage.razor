@page "/accounts/roles"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page acc-page acc-mod-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("acc.roles")</p>
            <h1>@Locale.T("acc.roles")</h1>
            <p class="sa-lead">@Locale.T("acc.rolesHint")</p>
        </div>
    </header>

    <div class="sal-bar no-print">
        <section class="sal-box is-sid acc-grow">
            <span class="sal-box-h">@Locale.T("acc.roleName")</span>
            <input class="si-find-input" type="text" placeholder="@Locale.T("acc.roleName")" @bind="name" disabled="@busy" />
        </section>
        <section class="sal-box is-month">
            <span class="sal-box-h">@Locale.T("acc.numberOfPay")</span>
            <input type="number" min="1" @bind="pays" disabled="@busy" />
        </section>
        <section class="sal-box is-sid">
            <span class="sal-box-h">@Locale.T("acc.desc")</span>
            <input class="si-find-input" type="text" placeholder="@Locale.T("acc.desc")" @bind="desc" disabled="@busy" />
        </section>
        <button type="button" class="sal-gen" disabled="@busy" @onclick="AddAsync">@Locale.T("acc.add")</button>
    </div>

    <div class="sj-grid">
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act">@Locale.T("sal.edit")</th>
                    <th>@Locale.T("acc.roleName")</th>
                    <th>@Locale.T("acc.pays")</th>
                    <th>@Locale.T("acc.desc")</th>
                    <th class="act">@Locale.T("sal.delete")</th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0 && !busy)
            {
                <tr><td colspan="5" class="empty-row">@Locale.T("acc.empty")</td></tr>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="act">
                            @if (editId == row.RoleID)
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => SaveAsync(row)">@Locale.T("si.update")</button>
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => editId = 0">@Locale.T("sal.cancel")</button>
                            }
                            else
                            {
                                <button type="button" class="link-btn" disabled="@busy" @onclick="() => StartEdit(row)">@Locale.T("sal.edit")</button>
                            }
                        </td>
                        <td>
                            @if (editId == row.RoleID)
                            {
                                <input type="text" @bind="editName" disabled="@busy" />
                            }
                            else { @row.Role }
                        </td>
                        <td>
                            @if (editId == row.RoleID)
                            {
                                <input type="number" min="1" @bind="editPays" disabled="@busy" />
                            }
                            else { @row.NumberOfPay }
                        </td>
                        <td>
                            @if (editId == row.RoleID)
                            {
                                <input type="text" @bind="editDesc" disabled="@busy" />
                            }
                            else { @row.Description }
                        </td>
                        <td class="act">
                            <button type="button" class="link-btn danger" disabled="@busy" @onclick="() => AskDelete(row.RoleID)">@Locale.T("sal.delete")</button>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (confirmDeleteId is int delId)
{
    <div class="acc-result-back" @onclick="() => confirmDeleteId = null">
        <div class="acc-result is-ok" @onclick:stopPropagation="true">
            <div class="acc-result-icon">!</div>
            <h3>@Locale.T("sal.delete")</h3>
            <p>@Locale.T("acc.confirmDelete")</p>
            <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="() => DeleteAsync(delId)">@Locale.T("sal.delete")</button>
            <button type="button" class="acc-btn acc-btn-ghost" disabled="@busy" @onclick="() => confirmDeleteId = null">@Locale.T("cls.cancel")</button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(popupText) && !busy)
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="acc.failed" OnClose="ClosePopup" />
}

@code {
    private readonly List<PaymentRoleDto> rows = [];
    private string name = "";
    private int pays = 1;
    private string desc = "";
    private int editId;
    private string editName = "";
    private int editPays = 1;
    private string? editDesc;
    private bool busy, popupError;
    private string busyTitle = "";
    private string? popupText;
    private int? confirmDeleteId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.loading");
        try
        {
            rows.Clear();
            rows.AddRange(await Api.GetPaymentRolesAsync(Session.AccessToken!));
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task AddAsync()
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.CreatePaymentRoleAsync(Session.AccessToken!, new SavePaymentRoleRequest
            {
                Role = name, NumberOfPay = pays, Description = desc
            });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            name = desc = "";
            pays = 1;
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void StartEdit(PaymentRoleDto row)
    {
        editId = row.RoleID;
        editName = row.Role;
        editPays = row.NumberOfPay;
        editDesc = row.Description;
    }

    private async Task SaveAsync(PaymentRoleDto row)
    {
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.UpdatePaymentRoleAsync(Session.AccessToken!, row.RoleID, new SavePaymentRoleRequest
            {
                Role = editName, NumberOfPay = editPays, Description = editDesc
            });
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            editId = 0;
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private void AskDelete(int id) => confirmDeleteId = id;

    private async Task DeleteAsync(int id)
    {
        confirmDeleteId = null;
        if (id <= 0) { Show(Locale.T("acc.failed"), true); return; }
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.DeletePaymentRoleAsync(Session.AccessToken!, id);
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            await ReloadQuietAsync();
            Show(Locale.T("acc.saved"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task ReloadQuietAsync()
    {
        rows.Clear();
        rows.AddRange(await Api.GetPaymentRolesAsync(Session.AccessToken!));
    }

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        { Show(Locale.T("subj.needOnline"), true); return false; }
        return true;
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
    }

    private void ClosePopup() => popupText = null;
}
