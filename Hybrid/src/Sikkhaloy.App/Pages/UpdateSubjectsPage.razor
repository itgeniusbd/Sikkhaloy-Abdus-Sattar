@page "/student-mgmt/subjects"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS

<div class="card structure-page emp-page">
    <h1>@Locale.T("sm.updateSubjects")</h1>
    <p class="muted">@Locale.T("sm.crumb")</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="ok">@message</div>
    }

    <div class="si-tabs">
        <button type="button" class="@(tab == "student" ? "active" : null)" @onclick="@(() => tab = "student")">@Locale.T("sm.subjStudentTab")</button>
        <button type="button" class="@(tab == "class" ? "active" : null)" @onclick="ShowClassTab">@Locale.T("sm.subjClassTab")</button>
    </div>

    <div class="filter-row">
        <select @bind="classInput" @bind:after="OnClassChanged" disabled="@busy">
            <option value="0">@Locale.T("si.selectClass")</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassID">@item.Name</option>
            }
        </select>
        @if (groups.Count > 0)
        {
            <select @bind="groupInput" @bind:after="OnFilterChanged" disabled="@busy">
                <option value="0">@Locale.T("si.allGroup")</option>
                @foreach (var item in groups)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (sections.Count > 0)
        {
            <select @bind="sectionInput" @bind:after="OnFilterChanged" disabled="@busy">
                <option value="0">@Locale.T("si.allSection")</option>
                @foreach (var item in sections)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (shifts.Count > 0)
        {
            <select @bind="shiftInput" @bind:after="OnFilterChanged" disabled="@busy">
                <option value="0">@Locale.T("si.allShift")</option>
                @foreach (var item in shifts)
                {
                    <option value="@item.ServerId">@item.Name</option>
                }
            </select>
        }
        @if (tab == "student")
        {
            <select @bind="subjectInput" @bind:after="LoadStudentsAsync" disabled="@busy">
                <option value="0">@Locale.T("sm.pickSubject")</option>
                @foreach (var item in catalog)
                {
                    <option value="@item.SubjectID">@item.SubjectName</option>
                }
            </select>
        }
    </div>

    @if (tab == "student")
    {
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act"><input type="checkbox" checked="@allSelected" disabled="@busy" @onchange="ToggleAll" /></th>
                    <th>@Locale.T("si.id")</th>
                    <th>@Locale.T("si.roll")</th>
                    <th>@Locale.T("si.name")</th>
                    <th>@Locale.T("si.subjectType")</th>
                </tr>
            </thead>
            <tbody>
            @if (students.Count == 0 && !busy)
            {
                <tr><td colspan="5" class="empty-row">@Locale.T("si.empty")</td></tr>
            }
            else
            {
                @foreach (var row in students)
                {
                    <tr class="@(row.Selected ? "is-allowed" : null)">
                        <td class="act"><input type="checkbox" @bind="row.Selected" disabled="@busy" /></td>
                        <td>@row.ID</td>
                        <td>@row.RollNo</td>
                        <td>@row.StudentsName</td>
                        <td>
                            <span class="readm-type">
                                <label class="choice-inline">
                                    <input type="radio" name="stype-@row.StudentClassID" checked="@(row.SubjectType == "Compulsory")"
                                           @onchange="@(() => row.SubjectType = "Compulsory")" />
                                    <span>@Locale.T("si.compulsory")</span>
                                </label>
                                <label class="choice-inline">
                                    <input type="radio" name="stype-@row.StudentClassID" checked="@(row.SubjectType == "Optional")"
                                           @onchange="@(() => row.SubjectType = "Optional")" />
                                    <span>@Locale.T("si.optional")</span>
                                </label>
                            </span>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveOneAsync">@Locale.T("si.update")</button>
    }
    else
    {
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("si.subject")</th>
                    <th class="act">@Locale.T("si.select")</th>
                    <th>@Locale.T("si.subjectType")</th>
                </tr>
            </thead>
            <tbody>
            @if (classSubjects.Count == 0 && !busy)
            {
                <tr><td colspan="3" class="empty-row">@Locale.T("si.empty")</td></tr>
            }
            else
            {
                @foreach (var row in classSubjects)
                {
                    <tr class="@(row.Selected ? "is-allowed" : null)">
                        <td>@row.SubjectName</td>
                        <td class="act">
                            <input type="checkbox" checked="@row.Selected" disabled="@busy"
                                   @onchange="e => ToggleSubject(row, e)" />
                        </td>
                        <td>
                            <span class="readm-type">
                                <label class="choice-inline">
                                    <input type="radio" name="ctype-@row.SubjectID" disabled="@busy"
                                           checked="@(row.SubjectType == "Compulsory")"
                                           @onchange="@(() => row.SubjectType = "Compulsory")" />
                                    <span>@Locale.T("si.compulsory")</span>
                                </label>
                                <label class="choice-inline">
                                    <input type="radio" name="ctype-@row.SubjectID" disabled="@busy"
                                           checked="@(row.SubjectType == "Optional")"
                                           @onchange="@(() => row.SubjectType = "Optional")" />
                                    <span>@Locale.T("si.optional")</span>
                                </label>
                            </span>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        <button type="button" class="btn-serial" disabled="@busy" @onclick="SaveClassAsync">@Locale.T("si.update")</button>
    }
</div>

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly List<ClassPartDto> groups = [];
    private readonly List<ClassPartDto> sections = [];
    private readonly List<ClassPartDto> shifts = [];
    private readonly List<SubjectDto> catalog = [];
    private readonly List<SmStudentRowDto> students = [];
    private readonly List<ClassSubjectRowDto> classSubjects = [];
    private ClassStructureDto? structure;
    private string classInput = "0";
    private string groupInput = "0";
    private string sectionInput = "0";
    private string shiftInput = "0";
    private string subjectInput = "0";
    private string tab = "student";
    private bool busy;
    private bool allSelected;
    private string? error;
    private string? message;

    private int ClassId => int.TryParse(classInput, out var n) ? n : 0;
    private int GroupId => int.TryParse(groupInput, out var n) ? n : 0;
    private int SectionId => int.TryParse(sectionInput, out var n) ? n : 0;
    private int ShiftId => int.TryParse(shiftInput, out var n) ? n : 0;
    private int SubjectId => int.TryParse(subjectInput, out var n) ? n : 0;

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureOnlineAsync())
            return;
        structure = await Api.GetClassStructureAsync(Session.AccessToken);
        classes.Clear();
        classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
        catalog.Clear();
        catalog.AddRange((await Api.GetSubjectsAsync(Session.AccessToken)).OrderBy(x => x.SN ?? 999).ThenBy(x => x.SubjectName));
    }

    private async Task ShowClassTab()
    {
        tab = "class";
        await LoadClassSubjectsAsync();
    }

    private async Task OnClassChanged()
    {
        groupInput = sectionInput = shiftInput = "0";
        ApplyParts();
        await OnFilterChanged();
    }

    private async Task OnFilterChanged()
    {
        if (tab == "student")
            await LoadStudentsAsync();
        else
            await LoadClassSubjectsAsync();
    }

    private void ApplyParts()
    {
        groups.Clear();
        sections.Clear();
        shifts.Clear();
        if (structure is null || ClassId <= 0)
            return;
        groups.AddRange(structure.Groups.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        sections.AddRange(structure.Sections.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
        shifts.AddRange(structure.Shifts.Where(x => x.ClassID == ClassId).OrderBy(x => x.Name));
    }

    private async Task LoadStudentsAsync()
    {
        error = message = null;
        students.Clear();
        if (ClassId <= 0 || SubjectId <= 0 || !await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            students.AddRange(await Api.GetSmStudentsAsync(
                Session.AccessToken, ClassId, GroupId, SectionId, ShiftId, null, SubjectId));
            allSelected = students.Count > 0 && students.All(x => x.Selected);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadClassSubjectsAsync()
    {
        error = message = null;
        classSubjects.Clear();
        if (ClassId <= 0 || !await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            classSubjects.AddRange(await Api.GetClassSubjectsAsync(Session.AccessToken, ClassId, GroupId));
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        allSelected = e.Value is true or "true";
        foreach (var row in students)
            row.Selected = allSelected;
    }

    private void ToggleSubject(ClassSubjectRowDto row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true or "true";
        if (!row.Selected)
            row.SubjectType = "Compulsory";
    }

    private async Task SaveOneAsync()
    {
        error = message = null;
        if (SubjectId <= 0)
        {
            error = Locale.T("si.needSubject");
            return;
        }
        if (students.Count == 0)
        {
            error = Locale.T("sm.needStudents");
            return;
        }
        if (!await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            var result = await Api.SaveSmOneSubjectAsync(Session.AccessToken, new SaveOneSubjectRequest
            {
                SubjectID = SubjectId,
                Items = students.Select(x => new SaveOneSubjectItem
                {
                    StudentID = x.StudentID,
                    StudentClassID = x.StudentClassID,
                    Selected = x.Selected,
                    SubjectType = x.SubjectType
                }).ToList()
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            message = Locale.T("sm.okOneSubject");
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveClassAsync()
    {
        error = message = null;
        var picked = classSubjects.Where(x => x.Selected).Select(x => new SaveStudentSubjectItem
        {
            SubjectID = x.SubjectID,
            SubjectType = string.IsNullOrWhiteSpace(x.SubjectType) ? "Compulsory" : x.SubjectType
        }).ToList();
        if (ClassId <= 0)
        {
            error = Locale.T("si.needClass");
            return;
        }
        if (picked.Count == 0)
        {
            error = Locale.T("si.needSubject");
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", Locale.T("sm.confirmClassSubjects")))
            return;
        if (!await EnsureOnlineAsync())
            return;

        busy = true;
        try
        {
            var result = await Api.SaveSmClassSubjectsAsync(Session.AccessToken, new ReplaceClassSubjectsRequest
            {
                ClassID = ClassId,
                SubjectGroupID = GroupId,
                SectionID = SectionId,
                ShiftID = ShiftId,
                Items = picked
            });
            if (!result.Succeeded)
            {
                error = Translate(result.Error);
                return;
            }

            message = Locale.T("sm.okClassSubjects", result.Count);
        }
        catch (HttpRequestException)
        {
            error = Locale.T("subj.needOnline");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            error = Locale.T("subj.needOnline");
            return false;
        }
        return true;
    }

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("si.failed") : Locale.T(key);
}
