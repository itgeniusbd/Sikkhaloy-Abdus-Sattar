@page "/accounts/unpaid-receipt"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page acc-page acc-mod-page mr-check-page acc-unpaid-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("acc.unpaid")</p>
            <h1>@Locale.T("acc.unpaid")</h1>
            <p class="sa-lead">@Locale.T("acc.unpaidHint")</p>
        </div>
    </header>

    <div class="sal-bar no-print">
        <section class="sal-box is-sid acc-grow">
            <span class="sal-box-h">@Locale.T("acc.receiptNo")</span>
            <input class="si-find-input" type="text" placeholder="@Locale.T("acc.receiptNo")" @bind="query" disabled="@busy"
                   @onkeydown="OnFindKey" />
        </section>
        <button type="button" class="sal-gen" disabled="@busy" @onclick="LoadAsync">@Locale.T("acc.find")</button>
    </div>

    @if (detail is not null)
    {
        @if (detail.Student is not null)
        {
            <div class="acc-person">
                <strong>@detail.Student.Name</strong> (@detail.Student.ID)<br />
                @detail.Student.ClassName · @Locale.T("att.rollNo") @detail.Student.RollNo
            </div>
        }
        <div class="acc-receipt-meta">
            <span>@Locale.T("acc.receiptNo"): <strong>@detail.ReceiptNo</strong></span>
            <span>@detail.PaidDate.ToString("dd-MMM-yyyy")</span>
        </div>
        <div class="sj-grid">
            <table class="mgrid">
                <thead>
                    <tr>
                        <th>@Locale.T("acc.roleName")</th>
                        <th>@Locale.T("acc.payFor")</th>
                        <th>@Locale.T("acc.paid")</th>
                        <th>@Locale.T("acc.due")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in detail.Lines)
                {
                    <tr>
                        <td>@line.Role</td>
                        <td>@line.PayFor</td>
                        <td>@line.PaidAmount.ToString("0.##")</td>
                        <td class="acc-due">@line.Due.ToString("0.##")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="acc-total">@Locale.T("acc.total"): @detail.TotalAmount.ToString("0.##")</p>
        <div class="sal-bar no-print acc-actions-only">
            <button type="button" class="sal-del" disabled="@busy" @onclick="UnpaidAsync">@Locale.T("acc.unpaidBtn")</button>
        </div>
    }
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText) && !busy)
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="acc.failed" OnClose="ClosePopup" />
}

@code {
    private string query = "";
    private ReceiptDetailDto? detail;
    private bool busy, popupError;
    private string busyTitle = "";
    private string? popupText;

    private Task OnFindKey(KeyboardEventArgs e) =>
        e.Key == "Enter" ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        detail = null;
        if (string.IsNullOrWhiteSpace(query)) { Show(Locale.T("acc.needReceipt"), true); return; }
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.loading");
        try
        {
            detail = await Api.GetMoneyReceiptAsync(Session.AccessToken!, query.Trim());
            if (detail is null) Show(Locale.T("acc.empty"), true);
        }
        catch (HttpRequestException) { Show(Locale.T("subj.needOnline"), true); }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task UnpaidAsync()
    {
        if (detail is null) return;
        if (!await OnlineAsync()) return;
        await SetBusyAsync("si.saving");
        try
        {
            var result = await Api.UnpaidMoneyReceiptAsync(Session.AccessToken!, detail.MoneyReceiptID);
            if (!result.Succeeded) { Show(Locale.T(result.Error ?? "acc.failed"), true); return; }
            detail = null;
            Show(Locale.T("acc.unpaidOk"), false);
        }
        catch (Exception ex) { Show(ex.Message, true); }
        finally { busy = false; }
    }

    private async Task<bool> OnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        { Show(Locale.T("subj.needOnline"), true); return false; }
        return true;
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
    }

    private void ClosePopup() => popupText = null;
}
