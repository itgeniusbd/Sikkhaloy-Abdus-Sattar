@page "/student-mgmt/notice"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api

<div class="card sa-page si-info-page si-signup-page sm-cc-page sm-notice-page students-card notice-page">
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("sm.crumb")</p>
            <h1>@Locale.T("sm.notice")</h1>
            <p class="sa-lead">@Locale.T("sm.noticeHint")</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText) && !confirmDelete)
    {
        <NetBanner Text="@error" />
    }

    <section class="notice-compose">
        <div class="notice-classes">
            <div class="notice-class-head">
                <b>@Locale.T("sm.classes")</b>
                <span class="muted">@Locale.T("sm.classPicked", classChecks.Count, classes.Count)</span>
                <label class="choice-inline">
                    <input type="checkbox" checked="@AllClassesSelected" disabled="@(busy || classes.Count == 0)"
                           @onchange="ToggleAllClasses" />
                    <span>@Locale.T("sm.selectAll")</span>
                </label>
                <button type="button" class="link-btn" disabled="@(busy || classChecks.Count == 0)" @onclick="ClearClasses">
                    @Locale.T("sm.clearAll")
                </button>
            </div>
            <div class="notice-class-grid">
                @foreach (var item in classes)
                {
                    var on = classChecks.Contains(item.ClassID);
                    <label class="notice-chip @(on ? "on" : null)">
                        <input type="checkbox" checked="@on" disabled="@busy"
                               @onchange="e => ToggleClass(item.ClassID, e)" />
                        <span>@item.Name</span>
                    </label>
                }
            </div>
        </div>

        <div class="notice-fields">
            <div class="si-tabs">
                <button type="button" class="@(!isHomeWork ? "active" : null)" disabled="@busy"
                        @onclick="@(() => isHomeWork = false)">@Locale.T("sm.general")</button>
                <button type="button" class="@(isHomeWork ? "active" : null)" disabled="@busy"
                        @onclick="@(() => isHomeWork = true)">@Locale.T("sm.homework")</button>
            </div>
            <label>@Locale.T("sm.title")
                <input type="text" @bind="title" disabled="@busy" placeholder="@Locale.T("sm.title")" />
            </label>
            <label>@Locale.T("sm.body")
                <textarea @bind="body" disabled="@busy" placeholder="@Locale.T("sm.body")"></textarea>
            </label>
            <div class="si-signup-foot">
                <div class="sal-actions">
                    <button type="button" class="sal-gen" disabled="@busy" @onclick="PublishAsync">@Locale.T("sm.publish")</button>
                </div>
            </div>
        </div>
    </section>

    <div class="notice-history-head">
        <h2 class="emp-list-title">@Locale.T("sm.noticeList")</h2>
        <span class="el-count">
            @notices.Count
            @if (SelectedCount > 0)
            {
                <em>@Locale.T("si.picked", SelectedCount)</em>
            }
        </span>
        <div class="sal-actions">
            <button type="button" class="sal-del" disabled="@(busy || SelectedCount == 0)" @onclick="AskDelete">@Locale.T("si.delete")</button>
        </div>
    </div>
    <div class="sj-grid">
        <table class="mgrid">
            <thead>
                <tr>
                    <th class="act">
                        <label class="si-check">
                            <input type="checkbox" checked="@allSelected" disabled="@(busy || notices.Count == 0)" @onchange="ToggleAll" />
                        </label>
                    </th>
                    <th>@Locale.T("sm.date")</th>
                    <th>@Locale.T("sm.type")</th>
                    <th>@Locale.T("sm.title")</th>
                    <th>@Locale.T("sm.classes")</th>
                    <th>@Locale.T("sm.user")</th>
                </tr>
            </thead>
            <tbody>
            @if (notices.Count == 0 && !busy)
            {
                <tr><td colspan="6" class="empty-row">@Locale.T("si.empty")</td></tr>
            }
            else
            {
                @foreach (var row in notices)
                {
                    <tr class="@(row.Selected ? "is-on" : null)">
                        <td class="act">
                            <label class="si-check">
                                <input type="checkbox" checked="@row.Selected" disabled="@busy"
                                       @onchange="e => ToggleRow(row, e)" />
                            </label>
                        </td>
                        <td class="notice-date">@(row.InsertDate?.ToString("dd-MMM-yy h:mm tt") ?? "—")</td>
                        <td>
                            <span class="@(row.IsHomeWork ? "pill pill-old" : "pill pill-new")">
                                @(row.IsHomeWork ? Locale.T("sm.homework") : Locale.T("sm.general"))
                            </span>
                        </td>
                        <td>
                            <div class="notice-title">@row.NoticeTitle</div>
                            @if (!string.IsNullOrWhiteSpace(row.Notice))
                            {
                                <div class="muted notice-preview">@row.Notice</div>
                            }
                        </td>
                        <td>
                            <div class="notice-class-pills">
                                @foreach (var name in ClassNames(row.Classes))
                                {
                                    <span class="pill">@name</span>
                                }
                            </div>
                        </td>
                        <td>@row.UserName</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (confirmDelete)
{
    <div class="acc-result-back" @onclick="() => confirmDelete = false">
        <div class="acc-result is-ok" @onclick:stopPropagation="true">
            <div class="acc-result-icon">!</div>
            <h3>@Locale.T("si.delete")</h3>
            <p>@Locale.T("sm.confirmNotice")</p>
            <button type="button" class="acc-btn acc-btn-primary" disabled="@busy" @onclick="DeleteAsync">@Locale.T("si.delete")</button>
            <button type="button" class="acc-btn acc-btn-ghost" disabled="@busy" @onclick="() => confirmDelete = false">@Locale.T("cls.cancel")</button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private readonly List<SchoolClassDto> classes = [];
    private readonly HashSet<int> classChecks = [];
    private readonly List<NoticeDto> notices = [];
    private string title = "";
    private string body = "";
    private string busyTitle = "";
    private string popupText = "";
    private bool isHomeWork;
    private bool busy;
    private bool popupError;
    private bool confirmDelete;
    private bool allSelected;
    private string? error;

    private bool AllClassesSelected => classes.Count > 0 && classChecks.Count == classes.Count;
    private int SelectedCount => notices.Count(x => x.Selected);

    protected override async Task OnInitializedAsync()
    {
        await SetBusyAsync("si.loading");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            var structure = await Api.GetClassStructureAsync(Session.AccessToken);
            classes.Clear();
            classes.AddRange(structure.Classes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name));
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void ToggleClass(int classId, ChangeEventArgs e)
    {
        if (e.Value is true or "true")
            classChecks.Add(classId);
        else
            classChecks.Remove(classId);
    }

    private void ToggleAllClasses(ChangeEventArgs e)
    {
        classChecks.Clear();
        if (e.Value is true or "true")
        {
            foreach (var item in classes)
                classChecks.Add(item.ClassID);
        }
    }

    private void ClearClasses() => classChecks.Clear();

    private void ToggleAll(ChangeEventArgs e)
    {
        allSelected = e.Value is true or "true";
        foreach (var row in notices)
            row.Selected = allSelected;
    }

    private void ToggleRow(NoticeDto row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true or "true";
        allSelected = notices.Count > 0 && notices.All(x => x.Selected);
    }

    private static IEnumerable<string> ClassNames(string? text) =>
        (text ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private async Task LoadAsync()
    {
        notices.Clear();
        notices.AddRange(await Api.GetNoticesAsync(Session.AccessToken));
        allSelected = false;
    }

    private async Task PublishAsync()
    {
        error = null;
        popupText = "";
        if (string.IsNullOrWhiteSpace(title))
        {
            Show(Locale.T("sm.needTitle"), true);
            return;
        }
        if (classChecks.Count == 0)
        {
            Show(Locale.T("sm.needClass"), true);
            return;
        }

        await SetBusyAsync("si.saving");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            var result = await Api.SaveNoticeAsync(Session.AccessToken, new SaveNoticeRequest
            {
                NoticeTitle = title.Trim(),
                Notice = body,
                IsHomeWork = isHomeWork,
                ClassIDs = classChecks.ToList()
            });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }

            title = body = "";
            classChecks.Clear();
            await LoadAsync();
            Show(Locale.T("sm.okNotice"), false);
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void AskDelete()
    {
        if (SelectedCount == 0)
        {
            Show(Locale.T("sm.needNotice"), true);
            return;
        }
        confirmDelete = true;
    }

    private async Task DeleteAsync()
    {
        confirmDelete = false;
        error = null;
        popupText = "";
        var ids = notices.Where(x => x.Selected).Select(x => x.StudentNoticeId).ToList();
        if (ids.Count == 0)
        {
            Show(Locale.T("sm.needNotice"), true);
            return;
        }

        await SetBusyAsync("si.saving");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            var result = await Api.DeleteNoticesAsync(Session.AccessToken, new DeleteNoticesRequest { NoticeIDs = ids });
            if (!result.Succeeded)
            {
                Show(Translate(result.Error), true);
                return;
            }

            await LoadAsync();
            Show(Locale.T("sm.okDeleteNotice"), false);
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }

    private string Translate(string? key) =>
        string.IsNullOrWhiteSpace(key) ? Locale.T("si.failed") : Locale.T(key);

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
        error = isError ? text : null;
    }

    private void ClosePopup() => popupText = "";
}
