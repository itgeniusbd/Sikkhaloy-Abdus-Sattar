@page "/attendance/leave-report"
@inherits LocaleAwareComponent
@inject AppSession Session
@inject ISyncApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="card sa-page si-info-page si-id-page sm-cc-page students-card att-records-page leave-report-page att-leave-report-page">
    <PrintHeader Subtitle="@Locale.T("att.leaveReport")" />
    <header class="sa-head no-print">
        <div>
            <p class="sa-kicker">@Locale.T("att.scheduleHint")</p>
            <h1>@Locale.T("att.leaveReport")</h1>
            <p class="sa-lead">@Locale.T("att.leaveReportHint")</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(error) && string.IsNullOrWhiteSpace(popupText))
    {
        <NetBanner Text="@error" />
    }

    <div class="sal-bar no-print">
        <section class="sal-box is-type">
            <span class="sal-box-h">@Locale.T("att.type")</span>
            <span class="readm-type">
                <label class="choice-inline">
                    <input type="radio" name="lr-type" checked="@(type == "Student")" @onchange='() => ChangeType("Student")' />
                    <span>@Locale.T("att.student")</span>
                </label>
                <label class="choice-inline">
                    <input type="radio" name="lr-type" checked="@(type == "Employee")" @onchange='() => ChangeType("Employee")' />
                    <span>@Locale.T("att.employee")</span>
                </label>
            </span>
        </section>
        <section class="sal-box">
            <span class="sal-box-h">@Locale.T("att.from")</span>
            <input type="date" @bind="from" disabled="@busy" />
        </section>
        <section class="sal-box">
            <span class="sal-box-h">@Locale.T("att.to")</span>
            <input type="date" @bind="to" disabled="@busy" />
        </section>
        <div class="sal-actions">
            <button type="button" class="sal-gen" disabled="@busy" @onclick="FilterAsync">@Locale.T("si.find")</button>
            <button type="button" class="link-btn" disabled="@busy" @onclick="LoadAllAsync">@Locale.T("att.all")</button>
            <button type="button" class="link-btn" disabled="@busy" @onclick="PrintAsync">@Locale.T("si.print")</button>
        </div>
        <span class="el-count">@Locale.T("att.recordsCount", rows.Count)</span>
    </div>

    <div class="sj-grid att-table-wrap">
        <table class="mgrid">
            <thead>
                <tr>
                    <th>@Locale.T("att.type")</th>
                    <th>@Locale.T("si.id")</th>
                    <th>@Locale.T("si.name")</th>
                    <th>@Locale.T("si.class") / @Locale.T("emp.designation")</th>
                    <th>@Locale.T("att.leaveType")</th>
                    <th>@Locale.T("att.from")</th>
                    <th>@Locale.T("att.to")</th>
                    <th>@Locale.T("att.daysCount")</th>
                    <th>@Locale.T("att.reason")</th>
                    <th class="no-print">@Locale.T("att.reprint")</th>
                </tr>
            </thead>
            <tbody>
            @if (rows.Count == 0 && !busy)
            {
                <tr><td colspan="10" class="empty-row">@Locale.T("att.empty")</td></tr>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <tr>
                        <td>
                            <span class="type-badge @(row.Type == "Employee" ? "type-emp" : "type-stu")">
                                @(row.Type == "Employee" ? Locale.T("att.employee") : Locale.T("att.student"))
                            </span>
                        </td>
                        <td>@row.ID</td>
                        <td>@row.Name</td>
                        <td>@row.ClassOrDesignation</td>
                        <td>@row.LeaveType</td>
                        <td>@row.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@row.EndDate.ToString("dd MMM yyyy")</td>
                        <td>@row.Days</td>
                        <td>@row.Description</td>
                        <td class="act no-print">
                            @if (row.Type != "Employee")
                            {
                                <button type="button" class="link-btn" disabled="@busy"
                                        @onclick="() => Reprint(row)">@Locale.T("att.reprint")</button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<ExamBusyOverlay Busy="busy" Title="@busyTitle" Message="@Locale.T("emp.wait")" />
@if (!string.IsNullOrWhiteSpace(popupText))
{
    <ResultPopup Text="@popupText" Error="popupError" ErrorTitle="sms.errorTitle" OnClose="ClosePopup" />
}

@code {
    private readonly List<LeaveReportRowDto> rows = [];
    private string type = "Student";
    private string busyTitle = "";
    private string popupText = "";
    private DateTime? from;
    private DateTime? to;
    private bool busy;
    private bool popupError;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync(null, null);

    private Task ChangeType(string value)
    {
        type = value;
        return LoadAsync(from, to);
    }

    private Task LoadAllAsync()
    {
        from = null;
        to = null;
        return LoadAsync(null, null);
    }

    private Task FilterAsync() => LoadAsync(from, to);

    private async Task LoadAsync(DateTime? start, DateTime? end)
    {
        error = null;
        await SetBusyAsync("si.loading");
        try
        {
            if (!await EnsureOnlineAsync())
                return;
            rows.Clear();
            rows.AddRange(await Api.GetLeaveReportAsync(Session.AccessToken!, type, start, end));
        }
        catch (HttpRequestException)
        {
            Show(Locale.T("subj.needOnline"), true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
        finally
        {
            busy = false;
        }
    }

    private void Reprint(LeaveReportRowDto row) =>
        Nav.NavigateTo($"/attendance/student/leave/print/{row.LeaveID}?from=report");

    private Task PrintAsync() => JS.InvokeVoidAsync("sikkhaloyPrint", "landscape", false).AsTask();

    private async Task SetBusyAsync(string key)
    {
        busyTitle = Locale.T(key);
        busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(40);
    }

    private void Show(string text, bool isError)
    {
        popupError = isError;
        popupText = text;
        error = isError ? text : null;
    }

    private void ClosePopup()
    {
        popupText = "";
        error = null;
    }

    private async Task<bool> EnsureOnlineAsync()
    {
        if (string.IsNullOrWhiteSpace(Session.AccessToken) || !await Api.PingAsync())
        {
            Show(Locale.T("subj.needOnline"), true);
            return false;
        }
        return true;
    }
}
