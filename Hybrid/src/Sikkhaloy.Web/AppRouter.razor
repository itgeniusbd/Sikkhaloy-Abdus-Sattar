@using Microsoft.EntityFrameworkCore
@using Sikkhaloy.App
@using Sikkhaloy.App.Services
@using Sikkhaloy.LocalData
@inject IDbContextFactory<LocalDbContext> DbFactory
@inject SyncLoopService SyncLoop
@inject SessionPersist Persist
@implements IDisposable

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="card" style="margin: 2rem auto; max-width: 560px;">
        <h1>SIKKHALOY Hybrid</h1>
        <p class="error">@error</p>
    </div>
}
else if (!ready)
{
    <p style="padding: 2rem; text-align: center;">লোড হচ্ছে...</p>
}
else
{
    <Routes />
}

@code {
    private bool ready;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await LocalDbContext.EnsureSchemaAsync(db);
            SyncLoop.Start();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ready || !string.IsNullOrWhiteSpace(error))
            return;

        await Persist.TryRestoreAsync();
        Persist.StartWatching();
        ready = true;
        StateHasChanged();
    }

    public void Dispose() => Persist.Dispose();
}
